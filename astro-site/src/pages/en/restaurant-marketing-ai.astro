---
// GENERADO por scripts/astro-migration/fase6-generate-marketing.py — NO editar a mano.
// Fase 6: la página de la SPA (src/pages/MarketingRestaurante.tsx) se monta TAL CUAL como
// island client:only (D5, patrón Fase 5); el head SEO sale server-side del
// head-module (claves i18n verbatim de la SPA — SEOHead/Helmet son la spec).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../i18n/config';
import { head } from '../../lib/marketing-heads/marketing-restaurante';
import MarketingRestauranteIsland from '../../islands/marketing/MarketingRestauranteIsland';

const lang = 'en';
const h = head(lang);
---

<BaseLayout
  title={h.title}
  description={h.description}
  keywords={h.keywords}
  lang={lang}
  alternates={{"es": "/marketing-restaurante-ia", "en": "/en/restaurant-marketing-ai", "fr": "/fr/marketing-restaurant-ia", "de": "/de/restaurant-marketing-ki", "it": "/it/marketing-ristorante-ia", "pt": "/pt/marketing-restaurante-ia-pt", "nl": "/nl/restaurant-marketing-ai-nl"}}
  ogImage={`${SITE}${h.ogImage ?? '/og-image.jpg'}`}
>
  {h.schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <MarketingRestauranteIsland client:only="react" />
</BaseLayout>
