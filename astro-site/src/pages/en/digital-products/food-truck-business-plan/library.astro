---
// /en/digital-products/food-truck-business-plan/library — dashboard post-pago de Food Truck Business Plan Kit (tienda EN).
// COPIA de pages/en/digital-products/restaurant-financial-plan-templates/library.astro, escrita A MANO
// (el generador de la zona app salta las entradas con lang ≠ 'es').
// Island client:only="react": ProtectedRoute lee localStorage en render síncrono (ReferenceError
// bajo SSR) → sin pase SSR, igual que el ES.
// whatsapp={false}: el dashboard monta su PROPIO WhatsAppProductSupport (React, lang="en").
// miselup={false}: la tarjeta lateral de Miselup es solo de la tienda ES (TIENDA §3.9); sin esto
// BaseLayout la montaría por el libraryPath del registro zona-app.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import FunctionsOriginPatch from '../../../../components/FunctionsOriginPatch.astro';
import FoodTruckBusinessPlanLibraryIsland from '../../../../islands/library/FoodTruckBusinessPlanLibraryIsland';
---

<BaseLayout title="Food Truck Business Plan Kit — Dashboard | AI Chef Pro" lang="en" noindex whatsapp={false} miselup={false}>
  <FunctionsOriginPatch />
  <FoodTruckBusinessPlanLibraryIsland client:only="react" />
</BaseLayout>
