---
// /en/digital-products/ai-prompts-for-restaurants/access — access gate del Gastro Pro Prompts eBook (tienda EN).
// Escrita A MANO (fase5-generate-zona-app.py salta las entradas de zona-app.ts con lang ≠ 'es').
// En lugar del gate vanilla del ES (AccessGate.tsx, sin `product` en el body) se monta el gate
// COMPARTIDO ProductAccessGate con lang="en" y productId explícito: verify-purchase → JWT en
// localStorage (storageKey propio) → dashboard. Patrón = restaurant-inventory-templates/access.astro.
// Island client:only="react" (window/localStorage en cliente; sin pase SSR). El <title> va en el
// BaseLayout porque el shim de react-helmet-async anula el Helmet cliente (= COPY.en.title del gate).
// Props de dinero = entrada `ai-prompts-for-restaurants` de lib/zona-app.ts y de verify-purchase.ts.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import FunctionsOriginPatch from '../../../../components/FunctionsOriginPatch.astro';
import ProductAccessGate from '../../../../../../src/components/shared/ProductAccessGate';
---

<BaseLayout title="Verifying access... | AI Chef Pro" lang="en" noindex>
  <FunctionsOriginPatch />
  <ProductAccessGate
    client:only="react"
    productId="ai-prompts-for-restaurants"
    storageKey="ai-prompts-for-restaurants-jwt"
    dashboardPath="/en/digital-products/ai-prompts-for-restaurants/library"
    landingPath="/en/digital-products/ai-prompts-for-restaurants"
    productLabel="Gastro Pro Prompts eBook"
    lang="en"
  />
</BaseLayout>
