---
// /en/digital-products/food-cost-menu-engineering-guide — Food Cost + Menu Engineering Guide (tienda internacional EN).
// COPIA de pages/en/digital-products/mobile-bar-business-plan.astro (thin wrapper: data → plantilla, SEO → BaseLayout)
// con la plantilla de la línea Guías, GuiaLandingPage, y lang="en". Edición inglesa del ES
// (pages/guia-food-cost-ingenieria-menu.astro) por SPEC guia-food-cost-en D1/D14: misma plantilla, mismos
// componentes; solo cambian los datos (data/productos-en/guias/food-cost-menu-engineering-guide.ts).
//
// - basePath SIN «/en»: BaseLayout ya antepone el prefijo del idioma (con «/en» saldría /en/en/…).
// - hreflang recíproco con el gemelo ES vía alternatesFamilia('guia-food-cost-ingenieria-menu') (lib/tienda.ts).
// - whatsapp={false}: la plantilla pinta su propio botón de soporte (como el ES).
// - omitGlobalApp: el SoftwareApplication global lleva ofertas en EUR y rating; en la tienda EN
//   no puede salir ninguno de los dos (tienda-gate.py).
// - miselup={false}: la tarjeta de Miselup es solo para la tienda ES (TIENDA §3.9).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuiaLandingPage from '../../../components/pages/GuiaLandingPage.astro';
import data from '../../../data/productos-en/guias/food-cost-menu-engineering-guide';
import { alternatesFamilia } from '../../../lib/tienda';

const lang = 'en';
const hreflang = alternatesFamilia('guia-food-cost-ingenieria-menu');

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO, SPEC D14) para que Vite la inline en build.
// data.stripeEnvKey documenta cuál es; aquí se resuelve literal. Sin la env var (el Payment Link
// lo crea John), el CTA cae a '#comprar' como en el resto de la línea.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_FOOD_COST_MENU_ENGINEERING_GUIDE || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  miselup={false}
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/digital-products/${data.slug}`}
  locales={hreflang.locales}
  alternates={hreflang.alternates}
  ogImage={data.seo.ogImage}
>
  <GuiaLandingPage data={data} stripeLink={stripeLink} lang={lang} />
</BaseLayout>
