---
// /en/digital-products/food-cost-menu-engineering-guide/access — access gate de Food Cost + Menu Engineering Guide
// (tienda EN). COPIA de pages/en/digital-products/mobile-bar-business-plan/access.astro, escrita A MANO:
// fase5-generate-zona-app.py salta las entradas de zona-app.ts con lang ≠ 'es' (TIENDA §3). En lugar
// del gate del ES (GuiaFoodCostAccessGate) se monta el gate COMPARTIDO ProductAccessGate con lang="en" (su
// COPY.en ya existe): mismo flujo verify-purchase → JWT en localStorage → dashboard. Island client:only="react"
// (window/localStorage en cliente; sin pase SSR). El <title> va en el BaseLayout porque el shim de
// react-helmet-async anula el Helmet cliente (= COPY.en.title del gate). Props de dinero = entrada
// `food-cost-menu-engineering-guide` de lib/zona-app.ts y de verify-purchase.ts.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import FunctionsOriginPatch from '../../../../components/FunctionsOriginPatch.astro';
import ProductAccessGate from '../../../../../../src/components/shared/ProductAccessGate';
---

<BaseLayout title="Verifying access... | AI Chef Pro" lang="en" noindex>
  <FunctionsOriginPatch />
  <ProductAccessGate
    client:only="react"
    productId="food-cost-menu-engineering-guide"
    storageKey="food-cost-menu-engineering-guide-jwt"
    dashboardPath="/en/digital-products/food-cost-menu-engineering-guide/library"
    landingPath="/en/digital-products/food-cost-menu-engineering-guide"
    productLabel="Food Cost + Menu Engineering Guide"
    lang="en"
  />
</BaseLayout>
