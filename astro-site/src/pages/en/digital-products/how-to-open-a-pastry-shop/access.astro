---
// /en/digital-products/how-to-open-a-pastry-shop/access — access gate de How to Open a Pastry Shop (tienda EN).
// COPIA de pages/en/digital-products/food-cost-menu-engineering-guide/access.astro, escrita A MANO:
// fase5-generate-zona-app.py salta las entradas de zona-app.ts con lang ≠ 'es' (TIENDA §3). En lugar
// del gate del ES (GuiaPasteleriaAccessGate) se monta el gate COMPARTIDO ProductAccessGate con lang="en" (su
// COPY.en ya existe): mismo flujo verify-purchase → JWT en localStorage → dashboard. Island client:only="react"
// (window/localStorage en cliente; sin pase SSR). El <title> va en el BaseLayout porque el shim de
// react-helmet-async anula el Helmet cliente (= COPY.en.title del gate). Props de dinero = entrada
// `how-to-open-a-pastry-shop` de lib/zona-app.ts y de verify-purchase.ts.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import FunctionsOriginPatch from '../../../../components/FunctionsOriginPatch.astro';
import ProductAccessGate from '../../../../../../src/components/shared/ProductAccessGate';
---

<BaseLayout title="Verifying access... | AI Chef Pro" lang="en" noindex>
  <FunctionsOriginPatch />
  <ProductAccessGate
    client:only="react"
    productId="how-to-open-a-pastry-shop"
    storageKey="how-to-open-a-pastry-shop-jwt"
    dashboardPath="/en/digital-products/how-to-open-a-pastry-shop/library"
    landingPath="/en/digital-products/how-to-open-a-pastry-shop"
    productLabel="How to Open a Pastry Shop"
    lang="en"
  />
</BaseLayout>
