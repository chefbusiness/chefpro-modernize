---
// Fase 8B.6 — Archives de categoría del blog EN: /en/blog/category/{slug}.
//
// DECISIÓN DE RUTA — 'category', no el espejo literal 'categoria':
//   · El árbol ES usa /blog/categoria/… porque HEREDA el historial de WordPress
//     (URLs indexadas + 301 vivos en public/_redirects). Ahí no se toca nada.
//   · El árbol EN es NUEVO: enblog.aichef.pro solo publicaba /{slug} y su mapa
//     301 se escribe ahora, así que no hay ninguna URL de categoría que
//     preservar. Con cero coste de migración, la forma nativa gana: una URL en
//     inglés con la palabra 'categoria' dentro es ruido para el usuario y una
//     señal incoherente para el motor.
//   · No hay motivo técnico en contra: son árboles de ficheros distintos
//     (src/pages/blog/categoria/ vs src/pages/en/blog/category/), sin colisión
//     posible ni siquiera con el slug 'ai-chef-pro', que existe en ambos idiomas.
// El segmento se define UNA vez en lib/blog.ts (ROUTE_SEGMENTS) y todos los
// enlaces salen de categoryPath(): si algún día cambia, cambia en un solo sitio.
//
// Solo se generan categorías CON posts (nada de archives vacías/thin).
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { SITE } from '../../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
} from '../../../../lib/blog';

export async function getStaticPaths() {
  // Taxonomía EN + posts EN: esta archive nunca puede mezclar posts del blog ES.
  const posts = await getPublishedPosts('en');
  return getCategories('en')
    .filter((c) => posts.some((p) => p.data.category === c.slug))
    .map((c) => ({
      params: { category: c.slug },
      props: { cat: c, posts: posts.filter((p) => p.data.category === c.slug) },
    }));
}

const lang = 'en';
const { cat, posts } = Astro.props;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${cat.name} — AI Chef Pro Blog`,
    description: cat.description,
    url: `${SITE}${categoryPath(cat.slug, lang)}`,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/en` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
      {
        '@type': 'ListItem',
        position: 3,
        name: cat.name,
        item: `${SITE}${categoryPath(cat.slug, lang)}`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${cat.name} | AI Chef Pro Blog`}
  description={cat.description}
  lang={lang}
  basePath={`/blog/category/${cat.slug}`}
  locales={['en']}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted-foreground">
      <a href="/en" class="hover:text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href={blogBase(lang)} class="hover:text-primary">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{cat.name}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl font-bold text-foreground md:text-4xl">{cat.name}</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{cat.description}</p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
