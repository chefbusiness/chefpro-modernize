---
// Fase 8B.6 — Hub del blog EN /en/blog: página 1 del listado + navegación por
// categorías. Las páginas 2+ viven en /en/blog/page/{n} (ver DECISIÓN de
// segmentos nativos en src/lib/blog.ts).
//
// hreflang: locales={['en']} — el blog EN NO es traducción del ES (contenido y
// slugs distintos), así que solo se declara el propio idioma + x-default a esta
// misma URL. Declarar un par ES↔EN sería falso.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { SITE } from '../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
  listPagePath,
  POSTS_PER_PAGE,
} from '../../../lib/blog';

const lang = 'en';
const posts = await getPublishedPosts(lang);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const catsWithPosts = getCategories(lang).filter((c) =>
  posts.some((p) => p.data.category === c.slug)
);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'AI Chef Pro Blog',
    description:
      'Artificial intelligence for restaurants and hospitality: guides, tools, prompts and professional kitchen technique.',
    url: `${SITE}${blogBase(lang)}`,
    inLanguage: 'en',
    publisher: { '@type': 'Organization', name: 'AI Chef Pro', url: SITE },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/en` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
    ],
  },
];
---

<BaseLayout
  title="AI for Restaurants Blog | AI Chef Pro"
  description="Practical artificial intelligence for restaurants: AI tools, professional prompts, food cost control, food safety and kitchen management. The AI Chef Pro blog."
  lang={lang}
  basePath="/blog"
  locales={['en']}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="AI Chef Pro Blog" href={`${SITE}${blogBase(lang)}/rss.xml`} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold text-foreground md:text-5xl">The AI Chef Pro Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Artificial intelligence for restaurants and hospitality: hands-on guides,
        professional prompts, cost control and high-end kitchen technique.
      </p>
    </header>

    {catsWithPosts.length > 0 && (
      <nav aria-label="Blog categories" class="mb-10 flex flex-wrap justify-center gap-3">
        {catsWithPosts.map((c) => (
          <a
            href={categoryPath(c.slug, lang)}
            class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
          >{c.name}</a>
        ))}
      </nav>
    )}

    {pagePosts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {pagePosts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
      </div>
    ) : (
      <p class="text-center text-muted-foreground">Coming soon: we are moving the blog over.</p>
    )}

    {totalPages > 1 && (
      <nav aria-label="Pagination" class="mt-12 flex items-center justify-center gap-4">
        <span class="text-sm text-muted-foreground">Page 1 of {totalPages}</span>
        <a
          href={listPagePath(2, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Next →</a>
      </nav>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>
