---
// Landing comercial EN, solo este idioma. No pasa por fase6-generate-marketing.py:
// no hay gemela ES/FR/DE/IT/PT/NL en este cambio, y el registro de marketing
// exige los siete slugs. El head usa el mismo BaseLayout que /en/pricing
// (hreflang solo en), y el cuerpo reutiliza Header, Footer, Pricing y ProductBanner.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Pricing from '../../components/Pricing.astro';
import ProductBanner from '../../components/blog/ProductBanner.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { SITE } from '../../i18n/config';

type CatalogueRow = { url: string; title: string; image: string; price: string };

// Importar el JSON desde la página lo busca en dist/pages/data y el build aborta.
// El catálogo se lee en el servidor, en el mismo sitio que product-banners.mjs.
const catalogue = JSON.parse(
  readFileSync(join(process.cwd(), 'src/data/digital-products-catalogue.json'), 'utf8'),
) as { en: CatalogueRow[] };

const lang = 'en';
const basePath = '/recipe-costing-software';
const canonical = `${SITE}/en/recipe-costing-software`;

const title = 'Recipe Costing Software for Restaurants | AI Chef Pro';
const description =
  'Recipe costing software for restaurants: a costed recipe card, plate cost, food cost % and a suggested menu price. Member €10/month for 10,000 credits. Premium from €25/month.';
const keywords =
  'recipe costing software, food costing software, menu costing software, menu pricing software, plate cost, restaurant food cost';

const h1 = 'Recipe costing software for restaurants';

// CTAs de esta landing. La franja de precios usa el helper compartido
// (utm_source=web, utm_medium=landing-recipe-costing), igual que /en/menu-engineering-software.
const ctaHref =
  'https://enapp.aichef.pro/?utm_source=aichef&utm_medium=landing-recipe-costing&utm_campaign=recipe-costing-software';

const enProducts = catalogue.en;

function bannerFor(slug: string) {
  const row = enProducts.find((product) => product.url.split('/').filter(Boolean).pop() === slug);
  if (!row) {
    throw new Error(`EN catalogue has no product «${slug}»`);
  }
  const href = new URL(row.url);
  href.searchParams.set('utm_source', 'aichef');
  href.searchParams.set('utm_medium', 'landing');
  href.searchParams.set('utm_campaign', 'productos-digitales');
  href.searchParams.set('utm_content', 'recipe-costing-software');
  return {
    id: slug,
    title: row.title,
    price: row.price,
    image: row.image,
    href: href.toString(),
    catalogue: 'en' as const,
  };
}

const kitBanner = bannerFor('food-cost-templates');
const guideBanner = bannerFor('food-cost-menu-engineering-guide');
const financialBanner = bannerFor('restaurant-financial-plan-templates');

const faqs = [
  {
    q: 'What is recipe costing software?',
    a: 'Recipe costing software keeps a card for each dish with the ingredients, the usable yield after trim, the waste and the price you pay. From that card it works out plate cost, food cost %, a suggested menu price and the margin that price leaves you.',
  },
  {
    q: 'How is food costing different from menu costing?',
    a: 'Food costing tells you what one dish costs to make, usually as plate cost and food cost %. Menu costing does the same for every dish on your menu, so you can compare them side by side. Menu pricing is setting what you charge for each dish, based on its cost and the margin you need. Good recipe cards feed all three.',
  },
  {
    q: 'How do AI Chef Pro’s agents cost a recipe?',
    a: 'You give the agents the dish and your ingredient prices, and they build a costed recipe card with a suggested menu price. When a price changes, enter the new number and ask for an updated card. The agents don’t read invoices or connect to suppliers. Recipe costing is included from AI Chef Member, at €10/month for 10,000 credits.',
  },
  {
    q: 'What should I look for in recipe costing software?',
    a: 'Look for a recipe card that stores yield and trim, an easy way to update ingredient prices, plate cost and food cost % on the same card, and a suggested menu price tied to a margin you choose. Also check whether invoice capture and stock counts are included. AI Chef Pro doesn’t do either, so most kitchens keep their inventory system and use the agents for costing and pricing.',
  },
  {
    q: 'What does the membership cost?',
    a: 'AI Chef Member is €10/month and includes 10,000 credits, the 75+ AI agents and email support. Premium Pro is €25/month (85,000 credits), Premium Plus is €50/month (175,000 credits), Premium Max is €95/month with unlimited credits, and Premium Max Annual is €950/year. All plans are billed in euros. There is no free plan and no free trial. Digital packs such as the Food Cost Kit Pro are one-time purchases, sold separately.',
  },
  {
    q: 'Who is recipe costing software for?',
    a: 'Chefs, owners, managers, bakers, pastry chefs, chocolatiers, bartenders and consultants: anyone who prices dishes or drinks from their own ingredient costs.',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/en` },
      { '@type': 'ListItem', position: 2, name: 'Recipe costing software', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    headline: h1,
    description,
    url: canonical,
    inLanguage: 'en',
    isPartOf: { '@type': 'WebSite', name: 'AI Chef Pro', url: SITE },
  },
];

const cardJobs = [
  {
    name: 'Yield, waste and trim',
    detail: 'The usable amount left after you peel, bone or reduce. Waste and trim stay on the card, so you cost the portion on the plate, not the weight on the invoice.',
  },
  {
    name: 'Ingredient price updates',
    detail: 'When a supplier changes a price, you update that line and the plate cost moves with it.',
  },
  {
    name: 'Plate cost and food cost %',
    detail: 'Plate cost is what one portion costs you to make. Food cost % is that cost divided by the menu price. If a portion costs 4.00 and the dish sells for 14.00, food cost is about 29%.',
  },
  {
    name: 'Suggested menu price and margin',
    detail: 'Choose the margin you want and the card suggests the menu price that delivers it.',
  },
];

const audiences = [
  { name: 'Chefs and cooks', detail: 'Price a special or a new dish before it reaches the pass.' },
  { name: 'Owners and managers', detail: 'See food cost % next to the menu price, dish by dish.' },
  { name: 'Bakers, pastry, chocolate and bar', detail: 'Cost a batch, a cake or a pour from the ingredients you buy.' },
  { name: 'Consultants', detail: 'Build costed cards with a client, using the client’s own prices.' },
];

const checklist = [
  'A recipe card that stores yield, waste and trim, not just the purchase quantity.',
  'An easy way to update an ingredient price, with the plate cost following the change.',
  'Food cost % and a suggested menu price based on a margin you choose.',
  'A view across the whole menu, so no dish is priced in isolation.',
  'Pricing you can read before you sign up. On AI Chef Pro, Member is €10/month for 10,000 credits and Premium plans start at €25/month.',
  'A clear line between the monthly subscription and any workbook you buy once.',
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  lang={lang}
  locales={['en']}
  basePath={basePath}
  ogImage={`${SITE}/og-image.jpg`}
>
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-7xl px-4 py-14">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <p class="mb-4 inline-flex rounded-full border border-border bg-card px-3 py-1 text-sm font-medium text-foreground">
        Paid membership
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-foreground text-balance sm:text-5xl">
        {h1}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground text-balance">
        Build a costed recipe card from the ingredients you buy, then turn plate cost into a menu price. Plans start at €10/month.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center justify-center rounded-md bg-accent px-6 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark"
        >
          Start with Member
        </a>
        <a
          href="#pricing"
          class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-6 text-base font-semibold text-foreground transition-colors hover:bg-muted"
        >
          See plans and pricing
        </a>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">
        AI Chef Member · €10/month · 10,000 credits · Cancel anytime
      </p>
    </header>

    <section class="mx-auto max-w-3xl" aria-labelledby="what-it-does">
      <h2 id="what-it-does" class="text-3xl font-bold text-foreground">What recipe costing software does</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Recipe costing software keeps one card per dish: the ingredients, how much of each one survives prep, and what you pay for it. From that card you get what the plate really costs and what you should charge for it.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {cardJobs.map((item) => (
          <li class="rounded-xl border border-border bg-card p-5">
            <h3 class="text-lg font-semibold text-foreground">{item.name}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.detail}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-muted-foreground leading-7">
        Only need the food cost of one plate right now? The free
        <a href="/en/food-cost-calculator-restaurant" class="font-semibold text-primary hover:underline">Food Cost Calculator for Restaurants</a>
        does that without an account. When you want to cost and price every dish you sell, that’s where the agents come in.
      </p>
    </section>

    <div class="mx-auto mt-10 max-w-3xl">
      <ProductBanner {...kitBanner} />
    </div>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="menu-pricing">
      <h2 id="menu-pricing" class="text-3xl font-bold text-foreground">Menu costing and menu pricing</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Menu costing means knowing the plate cost of every dish on the menu you sell, not just one. Menu pricing is deciding what to charge for each dish, based on that cost and the margin you need. You need both: a best-seller can be underpriced and quietly eat into your margin, while a dish priced higher than your guests will pay simply doesn’t sell.
      </p>
      <p class="mt-4 text-muted-foreground leading-7">
        Once every dish is costed, the next question is which ones earn their spot on the menu. That’s
        <a href="/en/menu-engineering-software" class="font-semibold text-primary hover:underline">menu engineering software</a>,
        included in the same membership.
      </p>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="how-agents">
      <h2 id="how-agents" class="text-3xl font-bold text-foreground">How AI Chef Pro’s agents do it</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        AI Chef Pro gives you 75+ AI agents for the kitchen and the business. For costing, you describe the dish, list the ingredients and enter the prices you pay. The agents build a costed recipe card and suggest a menu price. They don’t scan invoices, count stock or connect to your suppliers, so when a price changes, you enter the new number and ask for an updated card.
      </p>
      <ol class="mt-8 space-y-6">
        <li class="rounded-xl border border-border bg-card p-6">
          <h3 class="text-lg font-semibold text-foreground">1. Your dish and your prices</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            Bring the recipe and the prices from your invoices. Type them in or paste them from a spreadsheet.
          </p>
        </li>
        <li class="rounded-xl border border-border bg-card p-6">
          <h3 class="text-lg font-semibold text-foreground">2. A costed recipe card</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            The agents return the card with plate cost and food cost %. The numbers are only as accurate as the prices and waste you enter, so it’s worth weighing your trim at least once.
          </p>
        </li>
        <li class="rounded-xl border border-border bg-card p-6">
          <h3 class="text-lg font-semibold text-foreground">3. A price for the menu</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            From that cost, the agents help you set a menu price. You choose the target; the agents show the margin it implies.
          </p>
        </li>
      </ol>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="who-for">
      <h2 id="who-for" class="text-3xl font-bold text-foreground">Who recipe costing software is for</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        It’s for anyone who prices food or drink from their own costs, whether in the kitchen, behind the bar or at the pastry bench.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {audiences.map((item) => (
          <li class="rounded-xl border border-border bg-card p-5">
            <h3 class="text-lg font-semibold text-foreground">{item.name}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="what-to-look-for">
      <h2 id="what-to-look-for" class="text-3xl font-bold text-foreground">What to look for</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Use this checklist to judge any tool, AI Chef Pro included. For a side-by-side look at ten options, read
        <a href="/en/blog/best-recipe-costing-software-compared" class="font-semibold text-primary hover:underline">Recipe costing software: 10 options compared</a>.
      </p>
      <ol class="mt-6 list-decimal space-y-3 pl-5 text-muted-foreground leading-7">
        {checklist.map((item) => (
          <li>{item}</li>
        ))}
      </ol>
      <p class="mt-6 text-muted-foreground leading-7">
        If you also need invoice scanning, stock counts or a live supplier feed, keep the inventory system that already handles your invoices and use the agents for the recipe card and the price.
      </p>
    </section>

    <div class="mx-auto mt-10 max-w-3xl">
      <ProductBanner {...guideBanner} />
    </div>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="packs">
      <h2 id="packs" class="text-3xl font-bold text-foreground">One-time packs, separate from the membership</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Prefer to work in a spreadsheet, or want a reference next to the agents? These guides and workbooks are one-time purchases, sold separately from the subscription. The Food Cost Kit Pro and the Food Cost + Menu Engineering Guide cover costing and pricing. The Restaurant Financial Plan Kit Pro picks up once the menu is costed, with projections and cash flow for the whole venue. Packs are priced in US dollars; the membership is billed in euros.
      </p>
      <ProductBanner {...financialBanner} />
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="keep-reading">
      <h2 id="keep-reading" class="text-3xl font-bold text-foreground">Keep reading</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        These guides go deeper on specific parts of the work.
      </p>
      <ul class="mt-6 space-y-3 text-muted-foreground">
        <li>
          <a href="/en/blog/best-recipe-costing-software-compared" class="font-semibold text-primary hover:underline">Recipe costing software: 10 options compared</a>
          <span> — a side-by-side comparison of ten tools.</span>
        </li>
        <li>
          <a href="/en/menu-engineering-software" class="font-semibold text-primary hover:underline">Menu engineering software for restaurants</a>
          <span> — what to promote, reprice or take off once the plates are costed.</span>
        </li>
      </ul>
    </section>

    <div class="-mx-4 mt-8">
      <Pricing lang={lang} medium="landing-recipe-costing" schema={false} />
    </div>

    <section class="mx-auto mt-4 max-w-3xl" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="mb-8 text-center text-3xl font-bold text-foreground">Questions about recipe costing software</h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-semibold text-foreground">
              {faq.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mx-auto mt-16 max-w-3xl rounded-2xl border border-border bg-gradient-to-br from-accent-light/20 to-accent/5 p-8 text-center sm:p-10">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Start costing your recipes</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Open the app, choose AI Chef Member at €10/month for 10,000 credits, and build your first costed recipe card from your own ingredient prices. Need more credits? Premium plans start at €25/month. Every plan is on
        <a href="/en/pricing" class="font-semibold text-primary hover:underline">the pricing page</a>.
      </p>
      <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center justify-center rounded-md bg-accent px-6 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark"
        >
          Start with Member
        </a>
        <a
          href="#pricing"
          class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-6 text-base font-semibold text-foreground transition-colors hover:bg-muted"
        >
          Compare plans
        </a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
