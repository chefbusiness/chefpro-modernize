---
// GENERADO por scripts/astro-migration/fase6-generate-marketing.py — NO editar a mano.
// Fase 6: la página de la SPA (src/pages/TestDigitalizacion.tsx) se monta TAL CUAL como
// island client:only (D5, patrón Fase 5); el head SEO sale server-side del
// head-module (claves i18n verbatim de la SPA — SEOHead/Helmet son la spec).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../i18n/config';
import { head } from '../../lib/marketing-heads/test-digitalizacion';
import TestDigitalizacionIsland from '../../islands/marketing/TestDigitalizacionIsland';

const lang = 'en';
const h = head(lang);
---

<BaseLayout
  title={h.title}
  description={h.description}
  keywords={h.keywords}
  lang={lang}
  alternates={{"es": "/test-digitalizacion-restaurante", "en": "/en/restaurant-digitalization-test", "fr": "/fr/test-digitalisation-restaurant", "de": "/de/digitalisierungstest-restaurant", "it": "/it/test-digitalizzazione-ristorante", "pt": "/pt/teste-digitalizacao-restaurante", "nl": "/nl/digitaliseringstest-restaurant"}}
  ogImage={`${SITE}${h.ogImage ?? '/og-image.jpg'}`}
>
  {h.schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <TestDigitalizacionIsland client:only="react" />
</BaseLayout>
