---
// Pricing (EN) — native Astro page (BaseLayout + Header/Footer .astro).
// Pricing verified against the live schemas 2026-07-19. Single source of truth.
// Sign-up / checkout: app.aichef.pro with per-plan UTM.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../i18n/config';

const lang = 'en';
const basePath = '/en/pricing';
const alternates = { es: '/precios', en: '/en/pricing' };

const APP = 'https://app.aichef.pro';
const ctaUrl = (slug: string) =>
  `${APP}/?utm_source=web&utm_medium=pricing&utm_content=${slug}`;

const plans = [
  {
    slug: 'free',
    name: 'AI Chef Member',
    priceBig: 'Free',
    priceSub: '€0 · forever',
    credits: '3,000 credits / month',
    audience: 'For assistants, cooks and anyone who wants to try it with no strings attached.',
    features: [
      'Access to all 70+ AI agents',
      '3,000 credits every month',
      'Cookbooks from cuisines worldwide',
      'Available in 7 languages',
      'No credit card required',
      'Email support',
    ],
    cta: 'Start Free',
    variant: 'outline',
    highlight: false,
  },
  {
    slug: 'premium-pro',
    name: 'AI Chef Premium Pro',
    priceBig: '€25',
    priceSub: '/ month',
    credits: '85,000 credits / month',
    audience: 'For head chefs, executive chefs and restaurant managers.',
    features: [
      'Everything in the free plan',
      '85,000 credits every month',
      'Advanced business tools',
      'Access to every world cuisine',
      'Priority support',
    ],
    cta: 'Choose Premium Pro',
    variant: 'gold',
    highlight: true,
  },
  {
    slug: 'premium-plus',
    name: 'AI Chef Premium Plus',
    priceBig: '€50',
    priceSub: '/ month',
    credits: '175,000 credits / month',
    audience: 'For hospitality entrepreneurs and restaurant chains.',
    features: [
      'Everything in Premium Pro',
      '175,000 credits every month',
      'Advanced business tools',
      'Access to every world cuisine',
      'Premium 24/7 support',
    ],
    cta: 'Choose Premium Plus',
    variant: 'primary',
    highlight: false,
  },
  {
    slug: 'premium-max',
    name: 'AI Chef Premium Max',
    priceBig: '€95',
    priceSub: '/ month',
    credits: 'Unlimited credits',
    audience: 'For demanding operations that use AI every day, with no limits.',
    features: [
      'Everything in Premium Plus',
      'Unlimited credits every month',
      'The only truly unlimited plan',
      'Early access to new features',
      'Premium 24/7 support',
    ],
    cta: 'Choose Premium Max',
    variant: 'primary',
    highlight: false,
  },
  {
    slug: 'premium-max-annual',
    name: 'AI Chef Premium Max Annual',
    priceBig: '€950',
    priceSub: '/ year',
    credits: 'Unlimited credits',
    audience: 'The unlimited option for the whole year, with two months on us.',
    features: [
      'Everything in Premium Max',
      'Unlimited credits all year',
      'Save 2 months (that is €79 / month)',
      'Monthly personalized consulting',
      'Premium 24/7 support',
    ],
    cta: 'Choose Annual Plan',
    variant: 'primary',
    highlight: false,
  },
];

const profiles = [
  {
    title: 'Individual Chef or Cook',
    body: 'Start free with the Member plan and try all 70+ agents. Once AI becomes part of your daily routine, Premium Pro gives you plenty of room with 85,000 credits a month.',
    plan: 'Recommended: Free → Premium Pro',
  },
  {
    title: 'Restaurant',
    body: 'A single venue running its menu, food costs, marketing and management with AI works beautifully on Premium Pro. As volume grows or several people use the suite, Premium Plus multiplies your credits.',
    plan: 'Recommended: Premium Pro → Premium Plus',
  },
  {
    title: 'Group or Chain',
    body: 'Multiple venues, more hands at work and heavy usage need headroom. Premium Plus covers most groups, and Premium Max removes the credit limit entirely, with an annual option to save two months.',
    plan: 'Recommended: Premium Plus → Premium Max',
  },
];

const faqs = [
  {
    q: 'Is there a free plan?',
    a: 'Yes. The AI Chef Member plan is free forever: €0, 3,000 credits every month and access to all 70+ AI agents. It is ideal for genuinely testing the suite before you decide.',
  },
  {
    q: 'Do I need a credit card?',
    a: 'Not for the free plan: you sign up and get started without entering any payment details. You only need a card when you decide to subscribe to a Premium plan.',
  },
  {
    q: 'Can I switch plans anytime?',
    a: 'Yes. You can upgrade or downgrade at any time from your user dashboard. The change applies to your billing cycle with no complicated paperwork.',
  },
  {
    q: 'Can I cancel my subscription?',
    a: 'Yes, at any time and from your own dashboard, with no penalties and no commitment. When you cancel, you keep access until the end of the period you have already paid for.',
  },
  {
    q: 'What happens if I run out of credits?',
    a: 'Your credits renew automatically every month. If you need more before the renewal, you can upgrade to a higher plan at any time, or move to Premium Max, which offers unlimited credits.',
  },
  {
    q: 'Do you provide VAT invoices?',
    a: 'Yes. Every subscription generates its invoice and VAT is applied according to your country’s rules. You can add your tax details during checkout so the invoice is issued correctly.',
  },
];

const title = 'AI Chef Pro Pricing: Plans for Chefs and Restaurants';
const description =
  'AI Chef Pro pricing. Start free with 3,000 credits a month and no card, or pick a Premium plan from €25/month with access to 70+ AI agents for chefs and restaurants.';
const keywords =
  'ai chef pro pricing, ai chef pro plans, ai chef pro free, ai chef pro credits, ai for restaurants pricing, kitchen ai software price';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/en` },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: `${SITE}/en/pricing` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const btnClass = (variant: string) => {
  const base =
    'inline-flex w-full items-center justify-center rounded-md h-11 px-5 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2';
  if (variant === 'gold') return `${base} bg-accent text-accent-foreground hover:bg-accent-dark shadow-md`;
  if (variant === 'outline') return `${base} border border-border bg-background text-foreground hover:bg-accent/10`;
  return `${base} bg-primary text-primary-foreground hover:bg-primary/90`;
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  lang={lang}
  basePath={basePath}
  alternates={alternates}
  locales={['es', 'en']}
  ogImage={`${SITE}/og-image.jpg`}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang="en" />

  <main class="container mx-auto max-w-7xl px-4 py-14">

    <!-- Hero -->
    <header class="mx-auto mb-14 max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
        AI Chef Pro Pricing: Plans for Chefs and Restaurants
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
        Start free, with no card and 3,000 credits a month. When you want more,
        Premium plans start at €25/month, and only the Max plan gives you unlimited
        credits. Every plan includes all 70+ AI agents and 7 languages.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('hero')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Start Free
        </a>
      </div>
    </header>

    <!-- Plans grid -->
    <section aria-label="Plans and pricing" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {plans.map((p) => (
        <article class={`relative flex flex-col rounded-xl border bg-card p-6 shadow-sm ${p.highlight ? 'border-accent ring-2 ring-accent shadow-md' : 'border-border'}`}>
          {p.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground shadow">
              ⭐ Most Popular
            </span>
          )}
          <h2 class="text-base font-semibold text-foreground">{p.name}</h2>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="text-3xl font-bold text-foreground">{p.priceBig}</span>
            <span class="text-sm text-muted-foreground">{p.priceSub}</span>
          </div>
          <p class="mt-2 text-sm font-semibold text-primary">{p.credits}</p>
          <p class="mt-3 text-sm text-muted-foreground">{p.audience}</p>
          <ul class="mt-5 flex-1 space-y-2.5">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-foreground">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={ctaUrl(p.slug)} class={`mt-6 ${btnClass(p.variant)}`}>{p.cta}</a>
        </article>
      ))}
    </section>

    <!-- What is a credit? -->
    <section class="mx-auto mt-20 max-w-3xl rounded-xl border border-border bg-card p-8 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">What Is a Credit?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        A credit is the unit you work with inside AI Chef Pro. Every action an agent
        performs (generating a recipe, calculating food cost, writing a menu, building
        a marketing plan…) uses credits based on its complexity: simple tasks spend
        few, more elaborate ones spend a bit more.
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        The 3,000 free credits are enough to genuinely test the suite, not just take a
        quick look. And if your operation needs to use AI without watching the counter,
        the Premium Max plan gives you unlimited credits.
      </p>
    </section>

    <!-- Comparison table -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Plan Comparison</h2>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="bg-muted/50 text-left">
              <th class="p-4 font-semibold text-foreground">Feature</th>
              <th class="p-4 text-center font-semibold text-foreground">Member</th>
              <th class="p-4 text-center font-semibold text-primary">Premium Pro</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Plus</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Max</th>
              <th class="p-4 text-center font-semibold text-foreground">Max Annual</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Price</th>
              <td class="p-4 text-center text-foreground">Free</td>
              <td class="p-4 text-center text-foreground">€25/mo</td>
              <td class="p-4 text-center text-foreground">€50/mo</td>
              <td class="p-4 text-center text-foreground">€95/mo</td>
              <td class="p-4 text-center text-foreground">€950/yr</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Credits / month</th>
              <td class="p-4 text-center text-foreground">3,000</td>
              <td class="p-4 text-center text-foreground">85,000</td>
              <td class="p-4 text-center text-foreground">175,000</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Unlimited</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Unlimited</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">AI agents</th>
              <td class="p-4 text-center text-foreground">70+</td>
              <td class="p-4 text-center text-foreground">70+</td>
              <td class="p-4 text-center text-foreground">70+</td>
              <td class="p-4 text-center text-foreground">70+</td>
              <td class="p-4 text-center text-foreground">70+</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Languages</th>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Support</th>
              <td class="p-4 text-center text-foreground">Email</td>
              <td class="p-4 text-center text-foreground">Priority</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7 + consulting</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Card required</th>
              <td class="p-4 text-center text-foreground">No</td>
              <td class="p-4 text-center text-foreground">Yes</td>
              <td class="p-4 text-center text-foreground">Yes</td>
              <td class="p-4 text-center text-foreground">Yes</td>
              <td class="p-4 text-center text-foreground">Yes</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Who each plan is for -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Who Each Plan Is For</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {profiles.map((pr) => (
          <div class="flex flex-col rounded-xl border border-border bg-card p-6">
            <h3 class="text-lg font-bold text-foreground">{pr.title}</h3>
            <p class="mt-3 flex-1 text-sm text-muted-foreground">{pr.body}</p>
            <p class="mt-4 text-sm font-semibold text-primary">{pr.plan}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto mt-20 max-w-3xl">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-foreground">
              {f.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-3 text-sm text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Final CTA -->
    <section class="mt-20 rounded-2xl border border-border bg-gradient-to-br from-accent-light/20 to-accent/5 p-10 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Start Today, Free and Card-Free</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Create your account in a minute, get 3,000 credits a month and try all 70+ AI
        agents for chefs and restaurants. Upgrade only when you need to.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('cta-final')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Create My Free Account
        </a>
      </div>
    </section>

  </main>

  <Footer lang="en" />
</BaseLayout>
