---
// /en/digital-products — HUB de la tienda EN. Envoltorio fino, COPIA del de /productos-digitales
// (pages/productos-digitales.astro): mismo BaseLayout con las mismas props, SEO en inglés, y el
// componente DigitalProductsHubPage, que es la copia traducida de ProductosDigitalesHubPage (mismo
// diseño; cualquier cambio en uno se replica en el otro).
//
// hreflang recíproco con el hub ES desde lib/tienda.ts (TIENDAS). omitGlobalApp OBLIGATORIO: el
// SoftwareApplication global del layout lleva ofertas en EUR y un rating (4,8), y en la tienda EN no
// puede salir ninguno de los dos (tienda-gate.py). Los 3 JSON-LD propios los emite el componente.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DigitalProductsHubPage from '../../components/pages/DigitalProductsHubPage.astro';
import { TIENDAS } from '../../lib/tienda';

const lang = 'en';
---

<BaseLayout
  whatsapp={false}
  title="Digital Products for Restaurants — Templates, Guides, AI Prompts | AI Chef Pro"
  description="Restaurant templates, recipe costing spreadsheets, HACCP templates, restaurant ebooks and AI prompts for chefs, managers and owners. English editions coming soon."
  keywords="digital products for restaurants, restaurant templates, recipe costing spreadsheet, food cost excel template, HACCP templates, restaurant ebooks, restaurant business plan template, AI prompts for restaurants, AI Chef Pro"
  lang={lang}
  basePath="/digital-products"
  locales={['es', 'en']}
  alternates={{ es: TIENDAS.es.hubPath, en: TIENDAS.en.hubPath }}
  ogImage="https://aichef.pro/og-digital-products-en.jpg"
  omitGlobalApp
>
  <DigitalProductsHubPage />
</BaseLayout>
