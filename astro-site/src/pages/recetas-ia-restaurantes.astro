---
// GENERADO por scripts/astro-migration/fase6-generate-marketing.py — NO editar a mano.
// Fase 6: la página de la SPA (src/pages/RecetasIARestaurantes.tsx) se monta TAL CUAL como
// island client:only (D5, patrón Fase 5); el head SEO sale server-side del
// head-module (claves i18n verbatim de la SPA — SEOHead/Helmet son la spec).
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../i18n/config';
import { head } from '../lib/marketing-heads/recetas-i-a-restaurantes';
import RecetasIARestaurantesIsland from '../islands/marketing/RecetasIARestaurantesIsland';

const lang = 'es';
const h = head(lang);
---

<BaseLayout
  title={h.title}
  description={h.description}
  keywords={h.keywords}
  lang={lang}
  alternates={{"es": "/recetas-ia-restaurantes", "en": "/en/ai-recipes-for-restaurants", "fr": "/fr/recettes-ia-restaurants", "de": "/de/ki-rezepte-restaurants", "it": "/it/ricette-ia-ristoranti", "pt": "/pt/receitas-ia-restaurantes", "nl": "/nl/ai-recepten-restaurants"}}
  ogImage={`${SITE}${h.ogImage ?? '/og-image.jpg'}`}
>
  {h.schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <RecetasIARestaurantesIsland client:only="react" />
</BaseLayout>
