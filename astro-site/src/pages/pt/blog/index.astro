---
// Fase 9-PT (2026-08-19) — Hub del blog PT /pt/blog: página 1 del listado +
// navegación por categorías. Las páginas 2+ viven en /pt/blog/pagina/{n}.
// Clon del árbol alemán (src/pages/de/blog/), con los segmentos y el copy en
// PT-PT nativo (decisión del roadmap: controlo, restauração, gastronómico).
//
// SEGMENTOS: 'categoria' y 'pagina', las palabras portuguesas ('página' pierde
// el acento porque es un segmento de URL). Salen de ROUTE_SEGMENTS
// (src/lib/blog.ts); sin la entrada `pt` el árbol caería al fallback inglés y
// serviría /pt/blog/category/….
//
// hreflang: locales={['pt']} — el blog PT es contenido NATIVO escrito a partir
// del keyword research de Google.pt (ROADMAP_BLOG_PORTUGUES.md), no la
// traducción del ES ni del EN. Declarar un par que no existe sería falso.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { SITE } from '../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
  listPagePath,
  POSTS_PER_PAGE,
} from '../../../lib/blog';

const lang = 'pt';
const posts = await getPublishedPosts(lang);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const catsWithPosts = getCategories(lang).filter((c) =>
  posts.some((p) => p.data.category === c.slug)
);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog AI Chef Pro',
    description:
      'Inteligência artificial para restaurantes: guias, ferramentas, food cost e técnica de cozinha profissional.',
    url: `${SITE}${blogBase(lang)}`,
    inLanguage: 'pt',
    publisher: { '@type': 'Organization', name: 'AI Chef Pro', url: SITE },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE}/pt` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
    ],
  },
];
---

<BaseLayout
  title="Blog de IA para a Gastronomia | AI Chef Pro"
  description="Inteligência artificial para restaurantes e gastronomia: ferramentas de IA, prompts profissionais, food cost e fichas técnicas, HACCP e gestão de cozinha. O blog do AI Chef Pro."
  lang={lang}
  basePath="/blog"
  locales={['pt']}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Blog AI Chef Pro" href={`${SITE}${blogBase(lang)}/rss.xml`} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold text-foreground md:text-5xl">O Blog do AI Chef Pro</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Inteligência artificial para a restauração: guias práticos, prompts
        profissionais, food cost e técnica de cozinha.
      </p>
    </header>

    {catsWithPosts.length > 0 && (
      <nav aria-label="Categorias do blog" class="mb-10 flex flex-wrap justify-center gap-3">
        {catsWithPosts.map((c) => (
          <a
            href={categoryPath(c.slug, lang)}
            class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
          >{c.name}</a>
        ))}
      </nav>
    )}

    {pagePosts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {pagePosts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
      </div>
    ) : (
      <p class="text-center text-muted-foreground">Em breve: os primeiros artigos estão a caminho.</p>
    )}

    {totalPages > 1 && (
      <nav aria-label="Paginação" class="mt-12 flex items-center justify-center gap-4">
        <span class="text-sm text-muted-foreground">Página 1 de {totalPages}</span>
        <a
          href={listPagePath(2, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Seguinte →</a>
      </nav>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>
