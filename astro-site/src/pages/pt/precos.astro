---
// Preços (PT) — página nativa Astro (BaseLayout + Header/Footer .astro).
// Pricing verificado contra os schemas live 2026-07-19. Fonte única de verdade.
// Registo / checkout: a plataforma do idioma (ver lib/app-url.ts), com UTM por plano.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Pricing from '../../components/Pricing.astro';
import { SITE } from '../../i18n/config';
import { appCtaUrl } from '../../lib/app-url';

const lang = 'pt';
const basePath = '/pt/precos';
const alternates = {
  es: '/precios',
  en: '/en/pricing',
  fr: '/fr/tarifs',
  de: '/de/preise',
  it: '/it/prezzi',
  pt: '/pt/precos',
  nl: '/nl/prijzen',
};

// La plataforma depende del idioma (itapp/enapp/frapp/...). Antes aquí había
// un 'https://app.aichef.pro' clavado, así que TODOS los idiomas mandaban el
// checkout a la plataforma española. Ver astro-site/src/lib/app-url.ts.
const ctaUrl = (slug: string) => appCtaUrl(lang, 'pricing', slug);

const profiles = [
  {
    title: 'Chef ou Cozinheiro Individual',
    body: 'Começa com o plano Membro por 10 €/mês e experimenta os mais de 50 agentes. Quando a IA se tornar parte do teu dia a dia, o Premium Pro dá-te folga de sobra com 85.000 créditos por mês.',
    plan: 'Recomendado: Membro → Premium Pro',
  },
  {
    title: 'Restaurante',
    body: 'Um único local com carta, escandalhos, marketing e gestão apoiados por IA funciona na perfeição com o Premium Pro. Se o volume crescer ou forem várias pessoas a usar a suite, o Premium Plus multiplica os créditos.',
    plan: 'Recomendado: Premium Pro → Premium Plus',
  },
  {
    title: 'Grupo ou Cadeia',
    body: 'Vários locais, mais mãos a trabalhar e uso intensivo pedem margem. O Premium Plus cobre a maioria dos grupos e o Premium Max elimina o limite de créditos por completo, com opção anual para poupar dois meses.',
    plan: 'Recomendado: Premium Plus → Premium Max',
  },
];

const faqs = [
  {
    q: 'Quanto custa o plano Membro?',
    a: 'O plano AI Chef Membro custa 10 € por mês, com 10.000 créditos e acesso aos mais de 50 agentes de IA, sem permanência. É ideal para experimentares a suite a sério antes de decidires.',
  },
  {
    q: 'Preciso de cartão de crédito?',
    a: 'Sim. Todos os planos são pagos com cartão desde o início, sem permanência. Podes cancelar quando quiseres.',
  },
  {
    q: 'Posso mudar de plano quando quiser?',
    a: 'Sim. Podes subir ou descer de plano em qualquer momento a partir do teu painel de utilizador. A mudança aplica-se ao teu ciclo de faturação sem burocracias complicadas.',
  },
  {
    q: 'Posso cancelar a subscrição?',
    a: 'Sim, em qualquer momento e a partir do teu próprio painel, sem penalizações nem fidelização. Ao cancelares, manténs o acesso até ao final do período que já pagaste.',
  },
  {
    q: 'O que acontece se ficar sem créditos?',
    a: 'Os teus créditos renovam-se automaticamente todos os meses. Se precisares de mais antes da renovação, podes subir para um plano superior em qualquer momento, ou para o plano Premium Max, que oferece créditos ilimitados.',
  },
  {
    q: 'Emitem fatura com IVA?',
    a: 'Sim. Cada subscrição gera a sua fatura e o IVA é aplicado de acordo com a legislação do teu país. Podes adicionar os teus dados fiscais durante o pagamento para que a fatura saia correta.',
  },
];

const title = 'Preços do AI Chef Pro: Planos para Chefs e Restaurantes';
const description =
  'Preços do AI Chef Pro: começa com o plano Membro por 10 €/mês e 10.000 créditos, sem permanência, ou um plano Premium desde 25 €/mês, com mais de 50 agentes de IA para restaurantes.';
const keywords =
  'preços ai chef pro, planos ai chef pro, ai chef pro preço mensal, créditos ai chef pro, ia para restaurantes preço, software cozinha ia preço';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE}/pt` },
      { '@type': 'ListItem', position: 2, name: 'Preços', item: `${SITE}/pt/precos` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  lang={lang}
  basePath={basePath}
  alternates={alternates}
  ogImage={`${SITE}/og-image.jpg`}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang="pt" />

  <main class="container mx-auto max-w-7xl px-4 py-14">

    <!-- Hero -->
    <header class="mx-auto mb-14 max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
        Preços do AI Chef Pro: Planos para Chefs e Restaurantes
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
        Começa com o plano Membro por 10 €/mês e 10.000 créditos, sem permanência. Quando quiseres mais,
        os planos Premium começam nos 25 €/mês, e apenas o plano Max te dá créditos
        ilimitados. Todos incluem os mais de 50 agentes de IA e 7 idiomas.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('hero')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Começar Agora
        </a>
      </div>
    </header>

    <!-- Planes (v2 CRO Keak 20-sep-2026): mismo componente que las 7 portadas.
         -mx-4 cancela el px-4 de <main> para que el .container de la sección
         deje el mismo aire lateral que en la home (2rem) y no 1rem + 2rem. -->
    <div class="-mx-4">
      <Pricing lang={lang} medium="pricing" schema={false} />
    </div>

    <!-- O que é um crédito? -->
    <section class="mx-auto mt-20 max-w-3xl rounded-xl border border-border bg-card p-8 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">O Que É um Crédito?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Um crédito é a unidade com que trabalhas dentro do AI Chef Pro. Cada ação de
        um agente (gerar uma receita, calcular um escandalho, redigir uma carta, criar
        um plano de marketing…) consome créditos consoante a sua complexidade: as
        tarefas simples gastam poucos e as mais elaboradas, um pouco mais.
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        Os 10.000 créditos do plano Membro dão para experimentar a suite a sério, não apenas
        para dar uma vista de olhos. E se a tua operação precisar de usar a IA sem
        pensar no contador, o plano Premium Max dá-te créditos ilimitados.
      </p>
    </section>

    <!-- Tabela comparativa -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Comparação de Planos</h2>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="bg-muted/50 text-left">
              <th class="p-4 font-semibold text-foreground">Característica</th>
              <th class="p-4 text-center font-semibold text-foreground">Membro</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Pro</th>
              <th class="p-4 text-center font-semibold text-primary">Premium Plus</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Max</th>
              <th class="p-4 text-center font-semibold text-foreground">Max Anual</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Preço</th>
              <td class="p-4 text-center text-foreground">10 €/mês</td>
              <td class="p-4 text-center text-foreground">25 €/mês</td>
              <td class="p-4 text-center text-foreground">50 €/mês</td>
              <td class="p-4 text-center text-foreground">95 €/mês</td>
              <td class="p-4 text-center text-foreground">950 €/ano</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Créditos / mês</th>
              <td class="p-4 text-center text-foreground">10.000</td>
              <td class="p-4 text-center text-foreground">85.000</td>
              <td class="p-4 text-center text-foreground">175.000</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Ilimitados</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Ilimitados</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Agentes de IA</th>
              <td class="p-4 text-center text-foreground">+50</td>
              <td class="p-4 text-center text-foreground">+50</td>
              <td class="p-4 text-center text-foreground">+50</td>
              <td class="p-4 text-center text-foreground">+50</td>
              <td class="p-4 text-center text-foreground">+50</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Idiomas</th>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Apoio</th>
              <td class="p-4 text-center text-foreground">Email</td>
              <td class="p-4 text-center text-foreground">Prioritário</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7 + consultoria</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Cartão necessário</th>
              <td class="p-4 text-center text-foreground">Sim</td>
              <td class="p-4 text-center text-foreground">Sim</td>
              <td class="p-4 text-center text-foreground">Sim</td>
              <td class="p-4 text-center text-foreground">Sim</td>
              <td class="p-4 text-center text-foreground">Sim</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Para quem é cada plano -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Para Quem É Cada Plano</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {profiles.map((pr) => (
          <div class="flex flex-col rounded-xl border border-border bg-card p-6">
            <h3 class="text-lg font-bold text-foreground">{pr.title}</h3>
            <p class="mt-3 flex-1 text-sm text-muted-foreground">{pr.body}</p>
            <p class="mt-4 text-sm font-semibold text-primary">{pr.plan}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto mt-20 max-w-3xl">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Perguntas Frequentes</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-foreground">
              {f.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-3 text-sm text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="mt-20 rounded-2xl border border-border bg-gradient-to-br from-accent-light/20 to-accent/5 p-10 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Começa Hoje com o Plano Membro</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Cria a tua conta num minuto, recebe 10.000 créditos por mês e experimenta os
        mais de 50 agentes de IA para chefs e restaurantes. Sobes de plano apenas
        quando precisares.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('cta-final')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Criar a Minha Conta Agora
        </a>
      </div>
    </section>

  </main>

  <Footer lang="pt" />
</BaseLayout>
