---
// /pt/produtos-digitais — HUB de la tienda PT. Envoltorio fino, COPIA del de /productos-digitales
// (pages/productos-digitales.astro): mismo BaseLayout con las mismas props, SEO en portugués
// europeo, y el componente DigitalProductsHubPagePt, que es la copia traducida de
// ProductosDigitalesHubPage (mismo diseño; cualquier cambio en uno se replica en los demás).
//
// hreflang recíproco con los demás hubs vía lib/tienda.ts (hubLocales()/hubAlternates() — los añade
// el integrador al consolidar las tiendas por idioma; no se toca tienda.ts desde aquí).
// omitGlobalApp OBLIGATORIO: el SoftwareApplication global del layout lleva ofertas en EUR y un
// rating (4,8), y en la tienda PT no puede salir ninguno de los dos (tienda-gate.py). Los 3
// JSON-LD propios los emite el componente.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DigitalProductsHubPagePt from '../../components/pages/DigitalProductsHubPagePt.astro';
import { hubLocales, hubAlternates } from '../../lib/tienda';

const lang = 'pt';
---

<BaseLayout
  whatsapp={false}
  title="Produtos Digitais para Restauração — Modelos, Guias, Prompts IA | AI Chef Pro"
  description="Modelos para restaurantes, ficheiros Excel de fichas técnicas e food cost, modelos HACCP, eBooks e prompts de IA para chefs, gerentes e proprietários de restaurante. Edições em português a caminho."
  keywords="produtos digitais restauração, modelos excel restaurante, ficha técnica excel, food cost excel, modelos haccp, ebooks restauração, plano de negócio restaurante, prompts ia restauração, AI Chef Pro"
  lang={lang}
  basePath="/produtos-digitais"
  locales={hubLocales()}
  alternates={hubAlternates()}
  ogImage="https://aichef.pro/og-productos-digitales.jpg"
  omitGlobalApp
>
  <DigitalProductsHubPagePt />
</BaseLayout>
