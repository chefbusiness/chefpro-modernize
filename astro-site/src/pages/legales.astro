---
// GENERADO por scripts/astro-migration/fase6-generate-marketing.py — NO editar a mano.
// Fase 6: la página de la SPA (src/pages/Legal.tsx) se monta como island (D5,
// patrón Fase 5); el head SEO sale server-side del head-module (claves i18n
// verbatim de la SPA — SEOHead/Helmet son la spec).
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../i18n/config';
import { head } from '../lib/marketing-heads/legal';
import LegalIsland from '../islands/marketing/LegalIsland';

const lang = 'es';
const h = head(lang);
---

<BaseLayout
  title={h.title}
  description={h.description}
  keywords={h.keywords}
  lang={lang}
  basePath="/legales"
  ogImage={`${SITE}${h.ogImage ?? '/og-image.jpg'}`}
>
  {h.schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <LegalIsland client:only="react" />
</BaseLayout>
