---
// Precios (ES) — página nativa Astro (BaseLayout + Header/Footer .astro).
// Pricing verificado contra los schemas live 2026-07-19. Fuente única de verdad.
// Registro/checkout: la plataforma del idioma (ver lib/app-url.ts) con UTM por plan.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Pricing from '../components/Pricing.astro';
import { SITE } from '../i18n/config';
import { appCtaUrl } from '../lib/app-url';

const lang = 'es';
const basePath = '/precios';
const alternates = {
  es: '/precios',
  en: '/en/pricing',
  fr: '/fr/tarifs',
  de: '/de/preise',
  it: '/it/prezzi',
  pt: '/pt/precos',
  nl: '/nl/prijzen',
};

// La plataforma depende del idioma (itapp/enapp/frapp/...). Antes aquí había
// un 'https://app.aichef.pro' clavado, así que TODOS los idiomas mandaban el
// checkout a la plataforma española. Ver astro-site/src/lib/app-url.ts.
const ctaUrl = (slug: string) => appCtaUrl(lang, 'pricing', slug);

const profiles = [
  {
    title: 'Chef o Cocinero Individual',
    body: 'Empieza con el plan Miembro (10 €/mes, 10.000 créditos) y prueba los más de 75 agentes. Cuando la IA se convierta en parte de tu día a día, Premium Pro te da holgura de sobra con 85.000 créditos al mes.',
    plan: 'Recomendado: Miembro → Premium Pro',
  },
  {
    title: 'Restaurante',
    body: 'Un solo local con carta, escandallos, marketing y gestión apoyados por IA funciona de maravilla con Premium Pro. Si el volumen crece o sois varias personas usando la suite, Premium Plus multiplica los créditos.',
    plan: 'Recomendado: Premium Pro → Premium Plus',
  },
  {
    title: 'Grupo o Cadena',
    body: 'Varios locales, más manos trabajando y uso intensivo piden margen. Premium Plus cubre a la mayoría de grupos y Premium Max elimina el límite de créditos por completo, con opción anual para ahorrar dos meses.',
    plan: 'Recomendado: Premium Plus → Premium Max',
  },
];

const faqs = [
  {
    q: '¿Cuál es el plan de entrada?',
    a: 'El plan AI Chef Miembro: 10 € al mes, 10.000 créditos mensuales y acceso a los más de 75 agentes de IA. Sin permanencia: cambias de plan o cancelas cuando quieras.',
  },
  {
    q: '¿Necesito tarjeta de crédito?',
    a: 'Sí: todos los planes son suscripciones mensuales y se pagan con tarjeta desde el alta. Sin permanencia: puedes cancelar o cambiar de plan cuando quieras desde tu cuenta.',
  },
  {
    q: '¿Puedo cambiar de plan cuando quiera?',
    a: 'Sí. Puedes subir o bajar de plan en cualquier momento desde tu panel de usuario. El cambio se aplica a tu ciclo de facturación sin trámites complicados.',
  },
  {
    q: '¿Puedo cancelar la suscripción?',
    a: 'Sí, en cualquier momento y desde tu propio panel, sin penalizaciones ni permanencia. Al cancelar mantienes el acceso hasta el final del periodo que ya has pagado.',
  },
  {
    q: '¿Qué pasa si me quedo sin créditos?',
    a: 'Tus créditos se renuevan automáticamente cada mes. Si necesitas más antes de la renovación, puedes subir a un plan superior en cualquier momento, o al plan Premium Max, que ofrece créditos ilimitados.',
  },
  {
    q: '¿Emitís factura con IVA?',
    a: 'Sí. Cada suscripción genera su factura y el IVA se aplica según la normativa de tu país. Puedes añadir tus datos fiscales durante el proceso de pago para que la factura salga correcta.',
  },
];

const title = 'Precios de AI Chef Pro: Planes para Chefs y Restaurantes';
const description =
  'Descubre los precios de AI Chef Pro. Plan Miembro por 10 € al mes con 10.000 créditos, y planes Premium desde 25 €/mes, con acceso a más de 75 agentes de IA para chefs y restaurantes.';
const keywords =
  'precios ai chef pro, planes ai chef pro, ai chef pro precio mensual, créditos ai chef pro, ia para restaurantes precio, software cocina ia precio';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Precios', item: `${SITE}/precios` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  lang={lang}
  basePath={basePath}
  alternates={alternates}
  ogImage={`${SITE}/og-image.jpg`}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang="es" />

  <main class="container mx-auto max-w-7xl px-4 py-14">

    <!-- Hero -->
    <header class="mx-auto mb-14 max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
        Precios de AI Chef Pro: Planes para Chefs y Restaurantes
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
        El plan Miembro cuesta 10 €/mes e incluye 10.000 créditos. Cuando quieras más,
        los planes Premium van desde 25 €/mes, y solo el plan Max te da créditos
        ilimitados. Todos incluyen los más de 75 agentes de IA y 7 idiomas.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('hero')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Empezar Ahora
        </a>
      </div>
    </header>

    <!-- Planes (v2 CRO Keak 20-sep-2026): mismo componente que las 7 portadas.
         -mx-4 cancela el px-4 de <main> para que el .container de la sección
         deje el mismo aire lateral que en la home (2rem) y no 1rem + 2rem. -->
    <div class="-mx-4">
      <Pricing lang={lang} medium="pricing" schema={false} />
    </div>

    <!-- ¿Qué es un crédito? -->
    <section class="mx-auto mt-20 max-w-3xl rounded-xl border border-border bg-card p-8 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">¿Qué Es un Crédito?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Un crédito es la unidad con la que trabajas dentro de AI Chef Pro. Cada acción
        de un agente (generar una receta, calcular un escandallo, redactar una carta,
        crear un plan de marketing…) consume créditos según su complejidad: las tareas
        sencillas gastan pocos y las más elaboradas, algo más.
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        Los 10.000 créditos del plan Miembro dan para usar la suite de verdad, no solo para
        echar un vistazo. Y si tu operación necesita usar la IA sin pensar en el
        contador, el plan Premium Max te da créditos ilimitados.
      </p>
    </section>

    <!-- Tabla comparativa -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Comparativa de Planes</h2>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="bg-muted/50 text-left">
              <th class="p-4 font-semibold text-foreground">Característica</th>
              <th class="p-4 text-center font-semibold text-foreground">Miembro</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Pro</th>
              <th class="p-4 text-center font-semibold text-primary">Premium Plus</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Max</th>
              <th class="p-4 text-center font-semibold text-foreground">Max Anual</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Precio</th>
              <td class="p-4 text-center text-foreground">10 €/mes</td>
              <td class="p-4 text-center text-foreground">25 €/mes</td>
              <td class="p-4 text-center text-foreground">50 €/mes</td>
              <td class="p-4 text-center text-foreground">95 €/mes</td>
              <td class="p-4 text-center text-foreground">950 €/año</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Créditos / mes</th>
              <td class="p-4 text-center text-foreground">10.000</td>
              <td class="p-4 text-center text-foreground">85.000</td>
              <td class="p-4 text-center text-foreground">175.000</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Ilimitados</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Ilimitados</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Agentes de IA</th>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Idiomas</th>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Soporte</th>
              <td class="p-4 text-center text-foreground">Email</td>
              <td class="p-4 text-center text-foreground">Prioritario</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7 + consultoría</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Tarjeta requerida</th>
              <td class="p-4 text-center text-foreground">Sí</td>
              <td class="p-4 text-center text-foreground">Sí</td>
              <td class="p-4 text-center text-foreground">Sí</td>
              <td class="p-4 text-center text-foreground">Sí</td>
              <td class="p-4 text-center text-foreground">Sí</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Para quién es cada plan -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Para Quién Es Cada Plan</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {profiles.map((pr) => (
          <div class="flex flex-col rounded-xl border border-border bg-card p-6">
            <h3 class="text-lg font-bold text-foreground">{pr.title}</h3>
            <p class="mt-3 flex-1 text-sm text-muted-foreground">{pr.body}</p>
            <p class="mt-4 text-sm font-semibold text-primary">{pr.plan}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto mt-20 max-w-3xl">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Preguntas Frecuentes</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-foreground">
              {f.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-3 text-sm text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="mt-20 rounded-2xl border border-border bg-gradient-to-br from-accent-light/20 to-accent/5 p-10 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Empieza Hoy, sin Permanencia</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Crea tu cuenta en un minuto, elige el plan Miembro —10 €/mes con 10.000
        créditos— y usa los más de 75 agentes de IA para chefs y restaurantes.
        Subes de plan solo cuando lo necesites.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('cta-final')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Crear mi Cuenta
        </a>
      </div>
    </section>

  </main>

  <Footer lang="es" />
</BaseLayout>
