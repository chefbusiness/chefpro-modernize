---
// /kit-tareas-bar — LÍNEA TAREAS. Thin wrapper: pasa el objeto data al template
// KitTareasLandingPage y el SEO a BaseLayout.
//
// hreflang: alternatesFamilia('kit-tareas-bar') (lib/tienda.ts). Con el gemelo EN vivo (Bar Checklists
// Kit Pro, /en/digital-products/bar-checklist-templates, 18-oct-2026) emite es + en + x-default
// recíprocos; si EN volviera a vivo:false, devuelve locales ['es'] sin alternates y el HTML sería el de
// antes (hreflang es + x-default). Patrón = kit-tareas.astro. Canonical: https://aichef.pro/kit-tareas-bar.
// Meta robots se OMITE (desviación cross-cutting; se añade en el cutover). Patrón = kit-tareas-asador.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import KitTareasLandingPage from '../components/pages/KitTareasLandingPage.astro';
import data from '../data/productos/tareas/kit-tareas-bar';
import { alternatesFamilia } from '../lib/tienda';

const lang = 'es';
const hreflang = alternatesFamilia('kit-tareas-bar');

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO como la SPA, mismo fallback) para que
// Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se resuelve literal.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_TAREAS_BAR || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={hreflang.locales}
  alternates={hreflang.alternates}
  ogImage={data.seo.ogImage}
>
  <KitTareasLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
