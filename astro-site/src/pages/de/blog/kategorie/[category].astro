---
// Fase 9-DE (2026-08-18) — Archives de categoría del blog DE:
// /de/blog/kategorie/{slug}.
//
// El SEGMENTO de la URL lo decide el nombre de ESTE directorio, no
// categoryPath(): Astro enruta por el árbol de ficheros. Por eso la carpeta se
// llama 'kategorie' (minúscula: es un segmento de URL, no prosa alemana) y debe
// coincidir con lo que emite ROUTE_SEGMENTS de src/lib/blog.ts — si no, cada
// enlace de categoría sería un 404.
//
// Sólo se generan categorías CON posts: nada de archives vacías o thin. Con el
// blog recién abierto (0 posts) esto devuelve 0 rutas, que es lo correcto.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { SITE } from '../../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
} from '../../../../lib/blog';

export async function getStaticPaths() {
  // Taxonomía DE + posts DE: esta archive nunca puede mezclar posts de otro blog.
  const posts = await getPublishedPosts('de');
  return getCategories('de')
    .filter((c) => posts.some((p) => p.data.category === c.slug))
    .map((c) => ({
      params: { category: c.slug },
      props: { cat: c, posts: posts.filter((p) => p.data.category === c.slug) },
    }));
}

const lang = 'de';
const { cat, posts } = Astro.props;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${cat.name} — AI Chef Pro Blog`,
    description: cat.description,
    url: `${SITE}${categoryPath(cat.slug, lang)}`,
    inLanguage: 'de',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${SITE}/de` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
      {
        '@type': 'ListItem',
        position: 3,
        name: cat.name,
        item: `${SITE}${categoryPath(cat.slug, lang)}`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${cat.name} | AI Chef Pro Blog`}
  description={cat.description}
  lang={lang}
  basePath={`/blog/kategorie/${cat.slug}`}
  locales={['de']}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Brotkrumen-Navigation" class="mb-6 text-sm text-muted-foreground">
      <a href="/de" class="hover:text-primary">Startseite</a>
      <span class="mx-2">/</span>
      <a href={blogBase(lang)} class="hover:text-primary">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{cat.name}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl font-bold text-foreground md:text-4xl">{cat.name}</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{cat.description}</p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
