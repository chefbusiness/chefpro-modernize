---
// Fase 9-DE (2026-08-18) — Páginas 2+ del listado del blog DE: /de/blog/seite/{n}.
// La página 1 es /de/blog (no se genera /de/blog/seite/1 para no duplicarla).
// El segmento sale del nombre de ESTE directorio y debe coincidir con
// ROUTE_SEGMENTS de src/lib/blog.ts, de donde salen todos los enlaces.
//
// Con 0 posts, getStaticPaths devuelve [] y esta ruta no emite ninguna página:
// es el estado esperado de un blog recién abierto, no un error.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { blogBase, getPublishedPosts, listPagePath, POSTS_PER_PAGE } from '../../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('de');
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  const paths = [];
  for (let n = 2; n <= totalPages; n++) {
    paths.push({
      params: { page: String(n) },
      props: {
        posts: posts.slice((n - 1) * POSTS_PER_PAGE, n * POSTS_PER_PAGE),
        page: n,
        totalPages,
      },
    });
  }
  return paths;
}

const lang = 'de';
const { posts, page, totalPages } = Astro.props;
const prevHref = listPagePath(page - 1, lang);
---

<BaseLayout
  title={`AI Chef Pro Blog — Seite ${page}`}
  description={`KI für Restaurants und Gastronomie — Seite ${page} von ${totalPages} des AI Chef Pro Blogs.`}
  lang={lang}
  basePath={`/blog/seite/${page}`}
  locales={['de']}
>
  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-foreground">AI Chef Pro Blog — Seite {page}</h1>
      <p class="mt-2 text-muted-foreground"><a href={blogBase(lang)} class="text-primary hover:underline">← Zurück zur Blog-Startseite</a></p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => <PostCard post={p} />)}
    </div>

    <nav aria-label="Seitennummerierung" class="mt-12 flex items-center justify-center gap-4">
      <a
        href={prevHref}
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
      >← Zurück</a>
      <span class="text-sm text-muted-foreground">Seite {page} von {totalPages}</span>
      {page < totalPages && (
        <a
          href={listPagePath(page + 1, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Weiter →</a>
      )}
    </nav>
  </main>

  <Footer lang={lang} />
</BaseLayout>
