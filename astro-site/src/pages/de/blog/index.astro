---
// Fase 9-DE (2026-08-18) — Hub del blog DE /de/blog: página 1 del listado +
// navegación por categorías. Las páginas 2+ viven en /de/blog/seite/{n}.
// Clon del árbol francés (src/pages/fr/blog/), con los segmentos y el copy en
// alemán nativo y en Sie-Form (decisión 2026-08-16, coherente con los spokes
// fase10).
//
// SEGMENTOS: 'kategorie' y 'seite', las palabras alemanas en minúscula (los
// sustantivos se capitalizan en prosa, no en un segmento de URL). Salen de
// ROUTE_SEGMENTS (src/lib/blog.ts); sin la entrada `de` el árbol caería al
// fallback inglés y serviría /de/blog/category/….
//
// hreflang: locales={['de']} — el blog DE es contenido NATIVO escrito a partir
// del keyword research de Google.de (ROADMAP_BLOG_ALEMAN.md), no la traducción
// del ES ni del EN. Declarar un par que no existe sería falso.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { SITE } from '../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
  listPagePath,
  POSTS_PER_PAGE,
} from '../../../lib/blog';

const lang = 'de';
const posts = await getPublishedPosts(lang);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const catsWithPosts = getCategories(lang).filter((c) =>
  posts.some((p) => p.data.category === c.slug)
);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'AI Chef Pro Blog',
    description:
      'Künstliche Intelligenz für Restaurants: Guides, Werkzeuge, Kalkulation und professionelle Küchentechnik.',
    url: `${SITE}${blogBase(lang)}`,
    inLanguage: 'de',
    publisher: { '@type': 'Organization', name: 'AI Chef Pro', url: SITE },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${SITE}/de` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
    ],
  },
];
---

<BaseLayout
  title="KI-Blog für die Gastronomie | AI Chef Pro"
  description="Künstliche Intelligenz für Restaurants und Gastronomie: KI-Werkzeuge, professionelle Prompts, Wareneinsatz und Kalkulation, HACCP und Küchenmanagement. Der Blog von AI Chef Pro."
  lang={lang}
  basePath="/blog"
  locales={['de']}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="AI Chef Pro Blog" href={`${SITE}${blogBase(lang)}/rss.xml`} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold text-foreground md:text-5xl">Der AI Chef Pro Blog</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Künstliche Intelligenz für die Gastronomie: praxisnahe Guides,
        professionelle Prompts, Kalkulation und Küchentechnik.
      </p>
    </header>

    {catsWithPosts.length > 0 && (
      <nav aria-label="Blog-Kategorien" class="mb-10 flex flex-wrap justify-center gap-3">
        {catsWithPosts.map((c) => (
          <a
            href={categoryPath(c.slug, lang)}
            class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
          >{c.name}</a>
        ))}
      </nav>
    )}

    {pagePosts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {pagePosts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
      </div>
    ) : (
      <p class="text-center text-muted-foreground">Bald online: Die ersten Artikel sind in Arbeit.</p>
    )}

    {totalPages > 1 && (
      <nav aria-label="Seitennummerierung" class="mt-12 flex items-center justify-center gap-4">
        <span class="text-sm text-muted-foreground">Seite 1 von {totalPages}</span>
        <a
          href={listPagePath(2, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Weiter →</a>
      </nav>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>
