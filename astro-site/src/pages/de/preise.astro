---
// Preise (DE) — native Astro-Seite (BaseLayout + Header/Footer .astro).
// Pricing gegen die Live-Schemas 2026-07-19 verifiziert. Einzige Quelle der Wahrheit.
// Registrierung/Checkout: app.aichef.pro mit UTM pro Tarif.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../i18n/config';

const lang = 'de';
const basePath = '/de/preise';
const alternates = {
  es: '/precios',
  en: '/en/pricing',
  fr: '/fr/tarifs',
  de: '/de/preise',
  it: '/it/prezzi',
  pt: '/pt/precos',
  nl: '/nl/prijzen',
};

const APP = 'https://app.aichef.pro';
const ctaUrl = (slug: string) =>
  `${APP}/?utm_source=web&utm_medium=pricing&utm_content=${slug}`;

const plans = [
  {
    slug: 'gratis',
    name: 'AI Chef Mitglied',
    priceBig: 'Kostenlos',
    priceSub: '0 € · für immer',
    credits: '3.000 Credits / Monat',
    audience: 'Für Hilfskräfte, Köche und alle, die unverbindlich testen möchten.',
    features: [
      'Zugang zu den mehr als 70 KI-Agenten',
      '3.000 Credits pro Monat',
      'Rezeptsammlungen aus aller Welt',
      'Verfügbar in 7 Sprachen',
      'Ohne Kreditkarte',
      'Support per E-Mail',
    ],
    cta: 'Kostenlos starten',
    variant: 'outline',
    highlight: false,
  },
  {
    slug: 'premium-pro',
    name: 'AI Chef Premium Pro',
    priceBig: '25 €',
    priceSub: '/ Monat',
    credits: '85.000 Credits / Monat',
    audience: 'Für Küchenchefs, Chefköche und Restaurantleiter.',
    features: [
      'Alles aus dem kostenlosen Plan',
      '85.000 Credits pro Monat',
      'Erweiterte Business-Tools',
      'Zugang zu allen Küchen der Welt',
      'Priorisierter Support',
    ],
    cta: 'Premium Pro wählen',
    variant: 'gold',
    highlight: true,
  },
  {
    slug: 'premium-plus',
    name: 'AI Chef Premium Plus',
    priceBig: '50 €',
    priceSub: '/ Monat',
    credits: '175.000 Credits / Monat',
    audience: 'Für Gastronomieunternehmer und Restaurantketten.',
    features: [
      'Alles aus dem Premium Pro Plan',
      '175.000 Credits pro Monat',
      'Erweiterte Business-Tools',
      'Zugang zu allen Küchen der Welt',
      'Premium-Support 24/7',
    ],
    cta: 'Premium Plus wählen',
    variant: 'primary',
    highlight: false,
  },
  {
    slug: 'premium-max',
    name: 'AI Chef Premium Max',
    priceBig: '95 €',
    priceSub: '/ Monat',
    credits: 'Unbegrenzte Credits',
    audience: 'Für anspruchsvolle Betriebe, die KI täglich und unbegrenzt nutzen.',
    features: [
      'Alles aus dem Premium Plus Plan',
      'Unbegrenzte Credits pro Monat',
      'Der einzige wirklich unbegrenzte Plan',
      'Frühzeitiger Zugang zu neuen Funktionen',
      'Premium-Support 24/7',
    ],
    cta: 'Premium Max wählen',
    variant: 'primary',
    highlight: false,
  },
  {
    slug: 'premium-max-anual',
    name: 'AI Chef Premium Max Jahresabo',
    priceBig: '950 €',
    priceSub: '/ Jahr',
    credits: 'Unbegrenzte Credits',
    audience: 'Die unbegrenzte Option für das ganze Jahr, mit zwei geschenkten Monaten.',
    features: [
      'Alles aus dem Premium Max Plan',
      'Unbegrenzte Credits das ganze Jahr',
      'Du sparst 2 Monate (entspricht 79 € / Monat)',
      'Individuelle monatliche Beratung',
      'Premium-Support 24/7',
    ],
    cta: 'Jahresabo wählen',
    variant: 'primary',
    highlight: false,
  },
];

const profiles = [
  {
    title: 'Einzelner Koch oder Küchenchef',
    body: 'Starte kostenlos mit dem Mitgliedsplan und teste die mehr als 70 KI-Agenten. Wenn die KI zu einem Teil deines Alltags wird, bietet dir Premium Pro mit 85.000 Credits pro Monat genügend Spielraum.',
    plan: 'Empfohlen: Kostenlos → Premium Pro',
  },
  {
    title: 'Restaurant',
    body: 'Ein einzelner Standort mit KI-gestützter Speisekarte, Kalkulation, Marketing und Management funktioniert hervorragend mit Premium Pro. Wenn das Volumen wächst oder mehrere Personen die Suite nutzen, vervielfacht Premium Plus die Credits.',
    plan: 'Empfohlen: Premium Pro → Premium Plus',
  },
  {
    title: 'Gruppe oder Kette',
    body: 'Mehrere Standorte, mehr Hände und intensive Nutzung erfordern Spielraum. Premium Plus deckt die meisten Gruppen ab und Premium Max hebt das Credit-Limit vollständig auf, mit einer Jahresoption, um zwei Monate zu sparen.',
    plan: 'Empfohlen: Premium Plus → Premium Max',
  },
];

const faqs = [
  {
    q: 'Gibt es einen kostenlosen Plan?',
    a: 'Ja. Der AI Chef Mitglied Plan ist für immer kostenlos: 0 €, 3.000 Credits jeden Monat und Zugang zu den mehr als 70 KI-Agenten. Ideal, um die Suite wirklich zu testen, bevor du dich entscheidest.',
  },
  {
    q: 'Brauche ich eine Kreditkarte?',
    a: 'Nicht für den kostenlosen Plan: Du registrierst dich und legst los, ohne Zahlungsdaten einzugeben. Eine Kreditkarte brauchst du erst, wenn du einen Premium-Tarif abschließt.',
  },
  {
    q: 'Kann ich jederzeit den Plan wechseln?',
    a: 'Ja. Du kannst jederzeit von deinem Benutzer-Dashboard aus auf einen höheren oder niedrigeren Plan wechseln. Die Änderung gilt für deinen Abrechnungszeitraum ohne komplizierte Formalitäten.',
  },
  {
    q: 'Kann ich das Abo kündigen?',
    a: 'Ja, jederzeit und über dein eigenes Dashboard, ohne Strafen oder Mindestlaufzeit. Wenn du kündigst, behältst du den Zugang bis zum Ende des bereits bezahlten Zeitraums.',
  },
  {
    q: 'Was passiert, wenn mir die Credits ausgehen?',
    a: 'Deine Credits werden jeden Monat automatisch erneuert. Wenn du vor der Erneuerung mehr benötigst, kannst du jederzeit auf einen höheren Plan oder auf den Premium Max Plan wechseln, der unbegrenzte Credits bietet.',
  },
  {
    q: 'Stellt ihr eine Rechnung mit MwSt. aus?',
    a: 'Ja. Jedes Abo erzeugt eine Rechnung und die MwSt. wird gemäß den Bestimmungen deines Landes angewendet. Du kannst deine Steuerdaten während des Zahlungsvorgangs hinzufügen, damit die Rechnung korrekt ausgestellt wird.',
  },
];

const title = 'Preise von AI Chef Pro: Pläne für Köche und Restaurants';
const description =
  'Preise von AI Chef Pro: kostenlos mit 3.000 Credits/Monat ohne Kreditkarte, oder Premium ab 25 €/Monat mit über 70 KI-Agenten für Köche und Restaurants.';
const keywords =
  'preise ai chef pro, ai chef pro tarife, ai chef pro kostenlos, ai chef pro credits, ki für restaurants preis, küchensoftware ki preis';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${SITE}/de` },
      { '@type': 'ListItem', position: 2, name: 'Preise', item: `${SITE}/de/preise` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const btnClass = (variant: string) => {
  const base =
    'inline-flex w-full items-center justify-center rounded-md h-11 px-5 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2';
  if (variant === 'gold') return `${base} bg-accent text-accent-foreground hover:bg-accent-dark shadow-md`;
  if (variant === 'outline') return `${base} border border-border bg-background text-foreground hover:bg-accent/10`;
  return `${base} bg-primary text-primary-foreground hover:bg-primary/90`;
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  lang={lang}
  basePath={basePath}
  alternates={alternates}
  ogImage={`${SITE}/og-image.jpg`}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang="de" />

  <main class="container mx-auto max-w-7xl px-4 py-14">

    <!-- Hero -->
    <header class="mx-auto mb-14 max-w-3xl text-center">
      <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
        Preise von AI Chef Pro: Pläne für Köche und Restaurants
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground">
        Starte kostenlos, ohne Kreditkarte und mit 3.000 Credits pro Monat. Wenn du
        mehr brauchst, gibt es Premium-Tarife ab 25 €/Monat, und nur der Max-Tarif
        bietet dir unbegrenzte Credits. Alle enthalten die mehr als 70 KI-Agenten und
        7 Sprachen.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('hero')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Kostenlos starten
        </a>
      </div>
    </header>

    <!-- Tarif-Grid -->
    <section aria-label="Pläne und Preise" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {plans.map((p) => (
        <article class={`relative flex flex-col rounded-xl border bg-card p-6 shadow-sm ${p.highlight ? 'border-accent ring-2 ring-accent shadow-md' : 'border-border'}`}>
          {p.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground shadow">
              ⭐ Am beliebtesten
            </span>
          )}
          <h2 class="text-base font-semibold text-foreground">{p.name}</h2>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="text-3xl font-bold text-foreground">{p.priceBig}</span>
            <span class="text-sm text-muted-foreground">{p.priceSub}</span>
          </div>
          <p class="mt-2 text-sm font-semibold text-primary">{p.credits}</p>
          <p class="mt-3 text-sm text-muted-foreground">{p.audience}</p>
          <ul class="mt-5 flex-1 space-y-2.5">
            {p.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-foreground">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={ctaUrl(p.slug)} class={`mt-6 ${btnClass(p.variant)}`}>{p.cta}</a>
        </article>
      ))}
    </section>

    <!-- Was ist ein Credit? -->
    <section class="mx-auto mt-20 max-w-3xl rounded-xl border border-border bg-card p-8 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Was ist ein Credit?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Ein Credit ist die Einheit, mit der du in AI Chef Pro arbeitest. Jede Aktion
        eines Agenten (ein Rezept generieren, eine Kalkulation erstellen, eine
        Speisekarte schreiben, einen Marketingplan erstellen …) verbraucht Credits je
        nach Komplexität: einfache Aufgaben verbrauchen wenige, aufwändigere etwas mehr.
      </p>
      <p class="mx-auto mt-3 max-w-2xl text-muted-foreground">
        Die 3.000 kostenlosen Credits reichen aus, um die Suite wirklich zu testen,
        nicht nur um einen Blick darauf zu werfen. Und wenn dein Betrieb die KI nutzen
        muss, ohne auf den Zähler zu achten, bietet der Premium Max Plan unbegrenzte
        Credits.
      </p>
    </section>

    <!-- Vergleichstabelle -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Planvergleich</h2>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="bg-muted/50 text-left">
              <th class="p-4 font-semibold text-foreground">Funktion</th>
              <th class="p-4 text-center font-semibold text-foreground">Mitglied</th>
              <th class="p-4 text-center font-semibold text-primary">Premium Pro</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Plus</th>
              <th class="p-4 text-center font-semibold text-foreground">Premium Max</th>
              <th class="p-4 text-center font-semibold text-foreground">Max Jahresabo</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Preis</th>
              <td class="p-4 text-center text-foreground">Kostenlos</td>
              <td class="p-4 text-center text-foreground">25 €/Monat</td>
              <td class="p-4 text-center text-foreground">50 €/Monat</td>
              <td class="p-4 text-center text-foreground">95 €/Monat</td>
              <td class="p-4 text-center text-foreground">950 €/Jahr</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Credits / Monat</th>
              <td class="p-4 text-center text-foreground">3.000</td>
              <td class="p-4 text-center text-foreground">85.000</td>
              <td class="p-4 text-center text-foreground">175.000</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Unbegrenzt</td>
              <td class="p-4 text-center font-semibold text-accent-dark">Unbegrenzt</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">KI-Agenten</th>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
              <td class="p-4 text-center text-foreground">+70</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Sprachen</th>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
              <td class="p-4 text-center text-foreground">7</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Support</th>
              <td class="p-4 text-center text-foreground">E-Mail</td>
              <td class="p-4 text-center text-foreground">Priorisiert</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7</td>
              <td class="p-4 text-center text-foreground">Premium 24/7 + Beratung</td>
            </tr>
            <tr>
              <th scope="row" class="p-4 text-left font-medium text-muted-foreground">Kreditkarte erforderlich</th>
              <td class="p-4 text-center text-foreground">Nein</td>
              <td class="p-4 text-center text-foreground">Ja</td>
              <td class="p-4 text-center text-foreground">Ja</td>
              <td class="p-4 text-center text-foreground">Ja</td>
              <td class="p-4 text-center text-foreground">Ja</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Für wen ist welcher Plan -->
    <section class="mt-20">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Für wen ist welcher Plan</h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {profiles.map((pr) => (
          <div class="flex flex-col rounded-xl border border-border bg-card p-6">
            <h3 class="text-lg font-bold text-foreground">{pr.title}</h3>
            <p class="mt-3 flex-1 text-sm text-muted-foreground">{pr.body}</p>
            <p class="mt-4 text-sm font-semibold text-primary">{pr.plan}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto mt-20 max-w-3xl">
      <h2 class="mb-8 text-center text-2xl font-bold text-foreground md:text-3xl">Häufig gestellte Fragen</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-foreground">
              {f.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-3 text-sm text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Finaler CTA -->
    <section class="mt-20 rounded-2xl border border-border bg-gradient-to-br from-accent-light/20 to-accent/5 p-10 text-center">
      <h2 class="text-2xl font-bold text-foreground md:text-3xl">Starte heute, kostenlos und ohne Kreditkarte</h2>
      <p class="mx-auto mt-4 max-w-2xl text-muted-foreground">
        Erstelle dein Konto in einer Minute, erhalte 3.000 Credits pro Monat und teste
        die mehr als 70 KI-Agenten für Köche und Restaurants. Du wechselst erst dann auf
        einen höheren Plan, wenn du es brauchst.
      </p>
      <div class="mt-7">
        <a href={ctaUrl('cta-final')} class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark">
          Mein Konto erstellen
        </a>
      </div>
    </section>

  </main>

  <Footer lang="de" />
</BaseLayout>
