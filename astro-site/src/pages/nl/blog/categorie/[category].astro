---
// Archief /nl/blog/categorie/{slug}. De map heet 'categorie' omdat
// ROUTE_SEGMENTS.nl die segmenten gebruikt. Een map 'category' zou 404's geven.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { SITE } from '../../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
} from '../../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('nl');
  return getCategories('nl')
    .filter((c) => posts.some((p) => p.data.category === c.slug))
    .map((c) => ({
      params: { category: c.slug },
      props: { cat: c, posts: posts.filter((p) => p.data.category === c.slug) },
    }));
}

const lang = 'nl';
const { cat, posts } = Astro.props;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${cat.name} — Blog AI Chef Pro`,
    description: cat.description,
    url: `${SITE}${categoryPath(cat.slug, lang)}`,
    inLanguage: 'nl',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/nl` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
      {
        '@type': 'ListItem',
        position: 3,
        name: cat.name,
        item: `${SITE}${categoryPath(cat.slug, lang)}`,
      },
    ],
  },
];
---

<BaseLayout
  title={`${cat.name} | Blog AI Chef Pro`}
  description={cat.description}
  lang={lang}
  basePath={`/blog/categorie/${cat.slug}`}
  locales={['nl']}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Kruimelpad" class="mb-6 text-sm text-muted-foreground">
      <a href="/nl" class="hover:text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href={blogBase(lang)} class="hover:text-primary">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{cat.name}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl font-bold text-foreground md:text-4xl">{cat.name}</h1>
      <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{cat.description}</p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
