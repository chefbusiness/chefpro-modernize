---
// Blog NL /nl/blog. Inhoud is native (keyword allergenenlijst en de NL-roadmap),
// geen vertaling van het Italiaanse of Spaanse blog. hreflang alleen nl.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { SITE } from '../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
  listPagePath,
  POSTS_PER_PAGE,
} from '../../../lib/blog';

const lang = 'nl';
const posts = await getPublishedPosts(lang);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const catsWithPosts = getCategories(lang).filter((c) =>
  posts.some((p) => p.data.category === c.slug)
);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog AI Chef Pro',
    description:
      'Kunstmatige intelligentie voor restaurants en horeca: allergenenlijst, hygiëne en keukentechniek.',
    url: `${SITE}${blogBase(lang)}`,
    inLanguage: 'nl',
    publisher: { '@type': 'Organization', name: 'AI Chef Pro', url: SITE },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/nl` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
    ],
  },
];
---

<BaseLayout
  title="Blog AI voor restaurants | AI Chef Pro"
  description="Praktische gidsen voor de Nederlandse en Vlaamse horeca: allergenenlijst, voedselveiligheid en keukentechniek. De blog van AI Chef Pro."
  lang={lang}
  basePath="/blog"
  locales={['nl']}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Blog AI Chef Pro" href={`${SITE}${blogBase(lang)}/rss.xml`} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold text-foreground md:text-5xl">De blog van AI Chef Pro</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Gidsen voor de horeca: allergenenlijst, voedselveiligheid en techniek die je op de pass gebruikt.
      </p>
    </header>

    {catsWithPosts.length > 0 && (
      <nav aria-label="Categorieën van de blog" class="mb-10 flex flex-wrap justify-center gap-3">
        {catsWithPosts.map((c) => (
          <a
            href={categoryPath(c.slug, lang)}
            class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
          >{c.name}</a>
        ))}
      </nav>
    )}

    {pagePosts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {pagePosts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
      </div>
    ) : (
      <p class="text-center text-muted-foreground">De eerste artikelen komen eraan.</p>
    )}

    {totalPages > 1 && (
      <nav aria-label="Paginering" class="mt-12 flex items-center justify-center gap-4">
        <span class="text-sm text-muted-foreground">Pagina 1 van {totalPages}</span>
        <a
          href={listPagePath(2, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Volgende →</a>
      </nav>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>
