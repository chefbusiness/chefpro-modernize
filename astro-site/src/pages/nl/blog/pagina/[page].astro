---
// Pagina 2+ van /nl/blog/pagina/{n}. Pagina 1 is /nl/blog.
// Blijft leeg zolang er hooguit 24 posts zijn: getStaticPaths geeft dan [].
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { blogBase, getPublishedPosts, listPagePath, POSTS_PER_PAGE } from '../../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('nl');
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  const paths = [];
  for (let n = 2; n <= totalPages; n++) {
    paths.push({
      params: { page: String(n) },
      props: {
        posts: posts.slice((n - 1) * POSTS_PER_PAGE, n * POSTS_PER_PAGE),
        page: n,
        totalPages,
      },
    });
  }
  return paths;
}

const lang = 'nl';
const { posts, page, totalPages } = Astro.props;
const prevHref = listPagePath(page - 1, lang);
---

<BaseLayout
  title={`Blog AI Chef Pro — Pagina ${page}`}
  description={`Horeca en restaurants — pagina ${page} van ${totalPages} van de blog van AI Chef Pro.`}
  lang={lang}
  basePath={`/blog/pagina/${page}`}
  locales={['nl']}
>
  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-foreground">Blog AI Chef Pro — pagina {page}</h1>
      <p class="mt-2 text-muted-foreground"><a href={blogBase(lang)} class="text-primary hover:underline">← Terug naar de blog</a></p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => <PostCard post={p} />)}
    </div>

    <nav aria-label="Paginering" class="mt-12 flex items-center justify-center gap-4">
      <a
        href={prevHref}
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
      >← Vorige</a>
      <span class="text-sm text-muted-foreground">Pagina {page} van {totalPages}</span>
      {page < totalPages && (
        <a
          href={listPagePath(page + 1, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Volgende →</a>
      )}
    </nav>
  </main>

  <Footer lang={lang} />
</BaseLayout>
