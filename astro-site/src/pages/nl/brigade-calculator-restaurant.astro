---
// GENERADO por scripts/astro-migration/fase6-generate-marketing.py — NO editar a mano.
// Fase 6: la página de la SPA (src/pages/CalculadoraBrigada.tsx) se monta como island (D5,
// patrón Fase 5); el head SEO sale server-side del head-module (claves i18n
// verbatim de la SPA — SEOHead/Helmet son la spec).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../i18n/config';
import { head } from '../../lib/marketing-heads/calculadora-brigada';
import CalculadoraBrigadaIsland from '../../islands/marketing/CalculadoraBrigadaIsland';

const lang = 'nl';
const h = head(lang);
---

<BaseLayout
  title={h.title}
  description={h.description}
  keywords={h.keywords}
  lang={lang}
  alternates={{"es": "/calculadora-brigada-restaurante", "en": "/en/restaurant-brigade-calculator", "fr": "/fr/calculateur-brigade-restaurant", "de": "/de/brigaden-rechner-restaurant", "it": "/it/calcolatore-brigata-ristorante", "pt": "/pt/calculadora-brigada-restaurante", "nl": "/nl/brigade-calculator-restaurant"}}
  ogImage={`${SITE}${h.ogImage ?? '/og-image.jpg'}`}
>
  {h.schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <CalculadoraBrigadaIsland client:load lang={lang} pathname={Astro.url.pathname} />
</BaseLayout>
