---
// GENERADO por scripts/astro-migration/fase6-generate-marketing.py — NO editar a mano.
// Fase 6: la página de la SPA (src/pages/ChatGPTRestaurantes.tsx) se monta como island (D5,
// patrón Fase 5); el head SEO sale server-side del head-module (claves i18n
// verbatim de la SPA — SEOHead/Helmet son la spec).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../i18n/config';
import { head } from '../../lib/marketing-heads/chat-g-p-t-restaurantes';
import ChatGPTRestaurantesIsland from '../../islands/marketing/ChatGPTRestaurantesIsland';

const lang = 'nl';
const h = head(lang);
---

<BaseLayout
  title={h.title}
  description={h.description}
  keywords={h.keywords}
  lang={lang}
  alternates={{"es": "/chatgpt-para-restaurantes", "en": "/en/chatgpt-for-restaurants", "fr": "/fr/chatgpt-pour-restaurants", "de": "/de/chatgpt-fuer-restaurants", "it": "/it/chatgpt-per-ristoranti", "pt": "/pt/chatgpt-para-restaurantes", "nl": "/nl/chatgpt-voor-restaurants"}}
  ogImage={`${SITE}${h.ogImage ?? '/og-image.jpg'}`}
>
  {h.schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
  <ChatGPTRestaurantesIsland client:load lang={lang} pathname={Astro.url.pathname} />
</BaseLayout>
