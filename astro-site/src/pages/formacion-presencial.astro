---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormacionPresencialPage from '../components/pages/FormacionPresencialPage.astro';
import { SITE } from '../i18n/config';
import { ALL_LOCALES, alternatesFor } from '../lib/institutional';

// SOLO ES: la SPA (FormacionPresencial.tsx) hardcodea el SEOHead en español y esta ruta
// NO tiene variantes de idioma (el sitemap solo lista /formacion-presencial). Por eso
// locales={['es']} → BaseLayout emite hreflang es + x-default y NADA más.
const lang = 'es';
---

<BaseLayout
  title="Formación presencial con agentes de IA | AI Chef Pro"
  description="Formación presencial con agentes de IA para tu brigada: workshops y programas in-house. John Guerrero lleva los 75+ agentes a tu cocina. Pide fecha."
  keywords="formación IA restaurantes, curso inteligencia artificial hostelería, workshop IA cocina profesional, consultoría IA restaurantes, formación presencial IA gastronomía"
  lang={lang}
  basePath="/formacion-presencial"
  locales={ALL_LOCALES}
  alternates={alternatesFor('training')}
  ogImage={`${SITE}/og-image.jpg`}
>
  <FormacionPresencialPage lang={lang} />
</BaseLayout>
