---
// /pack-appcc — LÍNEA KITS EXCEL. Thin wrapper: pasa el objeto data al template
// KitExcelLandingPage y el SEO a BaseLayout.
//
// SOLO ES: la SPA (PackAppcc.tsx) hardcodea el Helmet en español y esta ruta NO tiene
// variantes de idioma → locales={['es']} (BaseLayout emite hreflang es + x-default y nada más).
// Canonical: https://aichef.pro/pack-appcc. Meta robots se OMITE (desviación cross-cutting;
// se añade en el cutover). Patrón = kit-escandallos.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import KitExcelLandingPage from '../components/pages/KitExcelLandingPage.astro';
import data from '../data/productos/kits/pack-appcc';

const lang = 'es';

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO como la SPA, mismo fallback) para que
// Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se resuelve literal.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_APPCC || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={['es']}
  ogImage={data.seo.ogImage}
>
  <KitExcelLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
