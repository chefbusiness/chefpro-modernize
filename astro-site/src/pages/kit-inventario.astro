---
// /kit-inventario — LÍNEA KITS EXCEL. Thin wrapper: pasa el objeto data al template
// KitExcelLandingPage y el SEO a BaseLayout.
//
// hreflang: alternatesFamilia('kit-inventario') (lib/tienda.ts). Con el gemelo EN vivo
// (Restaurant Inventory Kit Pro, /en/digital-products/restaurant-inventory-templates) emite
// es + en + x-default recíprocos; si EN volviera a vivo:false, devuelve locales ['es'] sin
// alternates y el HTML sería el de antes (hreflang es + x-default). Patrón = kit-escandallos.astro.
// Canonical: https://aichef.pro/kit-inventario. Meta robots se OMITE (desviación cross-cutting;
// se añade en el cutover). Patrón = kit-escandallos.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import KitExcelLandingPage from '../components/pages/KitExcelLandingPage.astro';
import data from '../data/productos/kits/kit-inventario';
import { alternatesFamilia } from '../lib/tienda';

const lang = 'es';
const hreflang = alternatesFamilia('kit-inventario');

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO como la SPA, mismo fallback) para que
// Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se resuelve literal.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_INVENTARIO || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={hreflang.locales}
  alternates={hreflang.alternates}
  ogImage={data.seo.ogImage}
>
  <KitExcelLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
