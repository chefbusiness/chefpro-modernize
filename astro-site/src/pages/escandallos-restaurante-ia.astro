---
// Landing de captación ES, reescrita a mano. No la regenere fase6-generate-marketing.py
// (el script salta este path). Los otros seis idiomas siguen en island.
// Mismo BaseLayout, Header y Footer que /recetas-ia-restaurantes y /precios.
// hreflang: los siete slugs de la familia. Canonical a sí misma.
// Title, description, H1, FAQ y JSON-LD de esta URL viven en esta página.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../i18n/config';
import { appCtaUrl } from '../lib/app-url';

const lang = 'es';
const basePath = '/escandallos-restaurante-ia';
const canonical = `${SITE}${basePath}`;

const title = 'Escandallos de restaurante con IA | AI Chef Pro';
const description =
  'Escandallo con IA: la herramienta deja el coste por ración con los precios que tú escribes. Mermas GenCal anota el rendimiento y el chef lo contrasta con el albarán antes del servicio.';
const keywords =
  'escandallo con IA, escandallos de restaurante con IA, food cost con IA, coste por ración, Mermas GenCal';
const h1 = 'Escandallos de restaurante con IA';

const cta = (content: string) => appCtaUrl(lang, 'landing-escandallos-ia', content);

const alternates = {
  es: '/escandallos-restaurante-ia',
  en: '/en/food-cost-calculator-restaurant-ai',
  fr: '/fr/calcul-food-cost-restaurant-ia',
  de: '/de/food-cost-rechner-restaurant-ki',
  it: '/it/food-cost-ristorante-ia',
  pt: '/pt/escandallo-restaurante-ia',
  nl: '/nl/food-cost-berekening-restaurant-ai',
};

const fields = [
  {
    name: 'Ingredientes y cantidades',
    detail: 'Los escribe el chef, o llegan de la receta y de la ficha técnica.',
  },
  {
    name: 'Precio de compra',
    detail: 'El que tú copias del albarán o de la factura. El coste sale de esos precios.',
  },
  {
    name: 'Coste por ración',
    detail: 'La suma de cada cantidad por su precio, repartida entre las raciones del plato.',
  },
  {
    name: 'Rendimiento',
    detail: 'Si hay merma de limpieza o de cocción, Mermas GenCal anota el peso que queda.',
  },
];

const review = [
  'Pesa lo que entra en la receta. Si el borrador dice una cosa y la báscula otra, manda la báscula.',
  'Sustituye cada precio por el de tu albarán o tu factura. Con los precios del ejemplo, el coste no es el de tu casa.',
  'Si el género merma al limpiarlo o al cocinarlo, anota con Mermas GenCal el peso que queda.',
  'Si cambias el número de comensales, Calcula Pax prepara las cantidades para ese número. El coste de esas raciones sale otra vez de los precios que ya escribiste.',
  'El coste que te cuadra pasa a la ficha técnica, junto al resto del plato.',
];

const rows = [
  { ingredient: 'Patata', qty: '400 g', price: '1,00 €/kg', cost: '0,40 €' },
  { ingredient: 'Huevo', qty: '200 g', price: '4,00 €/kg', cost: '0,80 €' },
  { ingredient: 'Cebolla', qty: '80 g', price: '1,00 €/kg', cost: '0,08 €' },
  { ingredient: 'Aceite de oliva', qty: '40 g', price: '5,00 €/kg', cost: '0,20 €' },
  { ingredient: 'Sal', qty: '4 g', price: '0,50 €/kg', cost: '< 0,01 €' },
];

const agents = [
  {
    name: 'Mermas GenCal',
    detail: 'Anota la merma de limpieza o de cocción y el rendimiento que queda. El chef contrasta ese peso con la báscula.',
  },
  {
    name: 'Calcula Pax',
    detail: 'Pasa las cantidades de la receta a otro número de comensales. El coste de esas raciones vuelve a salir de los precios que tú escribiste.',
  },
];

const faqs = [
  {
    q: '¿Qué hace el escandallo con IA de AI Chef Pro?',
    a: 'Calcula el coste por ración con los precios que copias del albarán o de la factura. Tú lo contrastas con el albarán antes del servicio.',
  },
  {
    q: '¿De dónde salen los precios del escandallo?',
    a: 'Del albarán o de la factura. Los escribes tú, y el coste por ración sale de esos precios.',
  },
  {
    q: '¿Qué anota Mermas GenCal?',
    a: 'La merma de limpieza o de cocción y el rendimiento que queda. El chef revisa ese peso con la báscula antes del servicio.',
  },
  {
    q: '¿Para qué sirve Calcula Pax en el escandallo?',
    a: 'Pasa las cantidades a otro número de comensales. El coste de esas raciones se calcula otra vez con los precios que ya escribiste.',
  },
  {
    q: '¿Puedo calcular un solo plato sin registrarme?',
    a: 'Sí. La calculadora de food cost hace el porcentaje de un plato, sin registro. Los agentes de la suite van en un plan de pago, con créditos.',
  },
  {
    q: '¿Dónde queda el coste de la ración?',
    a: 'En la ficha técnica del plato, junto a los ingredientes y la elaboración. El chef lo revisa antes de usarla en el servicio.',
  },
  {
    q: '¿Cuánto cuestan los planes?',
    a: 'El plan Miembro cuesta 10 €/mes e incluye 10.000 créditos. Premium Pro cuesta 25 €/mes e incluye 85.000 créditos. Premium Plus cuesta 50 €/mes e incluye 175.000 créditos. Premium Max cuesta 95 €/mes, con créditos ilimitados. La opción anual de Premium Max cuesta 950 € al año. Los planes mensuales no tienen permanencia: puedes cambiarlos o cancelarlos cuando quieras.',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: SITE },
      { '@type': 'ListItem', position: 2, name: h1, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    headline: h1,
    description,
    url: canonical,
    inLanguage: 'es',
    isPartOf: { '@type': 'WebSite', name: 'AI Chef Pro', url: SITE },
  },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  lang={lang}
  alternates={alternates}
  ogImage={`${SITE}/og-image.jpg`}
>
  <Fragment slot="head">
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-7xl px-4 py-14">
    <header class="mx-auto mb-16 max-w-3xl text-center">
      <p class="mb-4 inline-flex rounded-full border border-border bg-card px-3 py-1 text-sm font-medium text-foreground">
        Coste por ración con tus precios
      </p>
      <h1 class="text-4xl font-bold tracking-tight text-foreground text-balance sm:text-5xl">
        {h1}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground text-balance">
        La herramienta deja el coste por ración a partir de los ingredientes y de los precios que tú escribes. Mermas GenCal anota el rendimiento que queda. Tú contrastas el borrador con la báscula y el albarán antes de que el plato salga al servicio.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={cta('hero')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center justify-center rounded-md bg-accent px-6 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark"
        >
          Calcular el escandallo en la app
        </a>
        <a
          href="/precios"
          class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-6 text-base font-semibold text-foreground transition-colors hover:bg-muted"
        >
          Ver precios
        </a>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">
        Plan Miembro · 10 €/mes · 10.000 créditos
      </p>
    </header>

    <section class="mx-auto max-w-3xl" aria-labelledby="que-calcula">
      <h2 id="que-calcula" class="text-3xl font-bold text-foreground">Qué calcula la herramienta</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Esto es lo que cubre el escandallo con IA, y lo que tú cierras antes del servicio.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {fields.map((item) => (
          <li class="rounded-xl border border-border bg-card p-5">
            <h3 class="text-lg font-semibold text-foreground">{item.name}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{item.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="revision">
      <h2 id="revision" class="text-3xl font-bold text-foreground">Cómo lo revisa el chef</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        El escandallo que se usa en el servicio es el que tú has comprobado.
      </p>
      <ol class="mt-6 list-decimal space-y-3 pl-5 text-muted-foreground leading-7">
        {review.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="ejemplo">
      <h2 id="ejemplo" class="text-3xl font-bold text-foreground">Ejemplo: tortilla de patatas, 4 raciones</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Ejemplo para ver la forma del escandallo. No es una salida guardada de la app. Los precios no son de mercado: sirven para enseñar la cuenta. En tu cocina los cambias por los del albarán.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-[640px] border-collapse text-sm">
          <caption class="border-b border-border bg-muted/50 px-4 py-3 text-left text-base font-semibold text-foreground">
            Ejemplo de escandallo de un plato
          </caption>
          <thead>
            <tr class="border-b border-border text-left">
              <th scope="col" class="p-4 font-semibold text-foreground">Ingrediente</th>
              <th scope="col" class="p-4 font-semibold text-foreground">Cantidad</th>
              <th scope="col" class="p-4 font-semibold text-foreground">Precio de ejemplo</th>
              <th scope="col" class="p-4 font-semibold text-foreground">Coste</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {rows.map((row) => (
              <tr>
                <th scope="row" class="p-4 text-left font-medium text-foreground">{row.ingredient}</th>
                <td class="p-4 text-muted-foreground">{row.qty}</td>
                <td class="p-4 text-muted-foreground">{row.price}</td>
                <td class="p-4 text-muted-foreground">{row.cost}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-border">
              <th scope="row" colspan="3" class="p-4 text-left font-semibold text-foreground">Receta, 4 raciones</th>
              <td class="p-4 font-semibold text-foreground">1,48 €</td>
            </tr>
            <tr class="border-t border-border">
              <th scope="row" colspan="3" class="p-4 text-left font-semibold text-foreground">Coste por ración</th>
              <td class="p-4 font-semibold text-foreground">0,37 €</td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="mt-4 text-sm text-muted-foreground leading-6">
        El coste sale de la patata que compras. Si merma al pelarla o al confitarla, con Mermas GenCal calculas el rendimiento y sabes cuánto pesa de verdad cada ración. Para 12 raciones, Calcula Pax prepara las cantidades y el coste se mira otra vez con los precios de tu albarán.
      </p>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="mermas">
      <h2 id="mermas" class="text-3xl font-bold text-foreground">Mermas y raciones</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Dos agentes cubren el rendimiento y el cambio de comensales. El precio de compra sigue siendo el que tú escribes.
      </p>
      <ul class="mt-6 space-y-4">
        {agents.map((agent) => (
          <li class="rounded-xl border border-border bg-card p-5">
            <h3 class="text-lg font-semibold text-foreground">{agent.name}</h3>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">{agent.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="ficha">
      <h2 id="ficha" class="text-3xl font-bold text-foreground">El coste en la ficha técnica</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        El coste de la ración va en la ficha del plato, con los ingredientes, la elaboración y los alérgenos. Esa hoja se trabaja en la
        <a href="/ficha-tecnica-cocina-ia" class="font-semibold text-primary hover:underline">ficha técnica de cocina con IA</a>.
      </p>
      <p class="mt-4 text-muted-foreground leading-7">
        Si partes de una receta, las cantidades las sacas en
        <a href="/recetas-ia-restaurantes" class="font-semibold text-primary hover:underline">recetas con IA para restaurantes</a>.
        Los platos que salen a sala se preparan en la
        <a href="/carta-menu-restaurante-ia" class="font-semibold text-primary hover:underline">carta del restaurante con IA</a>.
      </p>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="calculadora">
      <h2 id="calculadora" class="text-3xl font-bold text-foreground">Calculadora de un plato y agentes de la suite</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        Para un plato suelto, la
        <a href="/calculadora-food-cost-restaurante" class="font-semibold text-primary hover:underline">calculadora de food cost</a>
        hace el porcentaje, sin registro. En la suite, el escandallo parte de los mismos precios que tú escribes. Mermas GenCal anota el rendimiento y Calcula Pax cambia el número de raciones.
      </p>
      <p class="mt-4 text-muted-foreground leading-7">
        Los agentes de la suite van en un plan de pago, con créditos. La comparación de planes está en
        <a href="/precios" class="font-semibold text-primary hover:underline">precios</a>.
      </p>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="planes">
      <h2 id="planes" class="text-3xl font-bold text-foreground">Planes</h2>
      <p class="mt-4 text-muted-foreground leading-7">
        El plan Miembro cuesta 10 €/mes e incluye 10.000 créditos. Premium Pro cuesta 25 €/mes e incluye 85.000 créditos. Premium Plus cuesta 50 €/mes e incluye 175.000 créditos. Premium Max cuesta 95 €/mes, con créditos ilimitados. La opción anual de Premium Max cuesta 950 € al año. Los planes mensuales no tienen permanencia: puedes cambiarlos o cancelarlos cuando quieras. La comparación está en
        <a href="/precios" class="font-semibold text-primary hover:underline">precios</a>.
      </p>
      <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row">
        <a
          href={cta('planes')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center justify-center rounded-md bg-accent px-6 text-base font-semibold text-accent-foreground shadow-md transition-colors hover:bg-accent-dark"
        >
          Calcular el escandallo en la app
        </a>
        <a
          href="/precios"
          class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-6 text-base font-semibold text-foreground transition-colors hover:bg-muted"
        >
          Ver precios
        </a>
      </div>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="faq">
      <h2 id="faq" class="text-3xl font-bold text-foreground">Preguntas frecuentes</h2>
      <div class="mt-6 space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-xl border border-border bg-card p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-foreground">
              {faq.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 flex-shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
