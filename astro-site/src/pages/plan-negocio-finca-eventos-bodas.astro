---
// /plan-negocio-finca-eventos-bodas — LÍNEA PLANES (sub-línea A). Thin wrapper: pasa el objeto data al
// template PlanNegocioLandingPage y el SEO a BaseLayout.
//
// hreflang: página mono-idioma (sin gemelo EN todavía) → locales=['es'] (patrón /formacion-presencial).
// Si nace el gemelo EN, pasar a alternatesFamilia('plan-negocio-finca-eventos-bodas') (lib/tienda.ts).
// Canonical: https://aichef.pro/plan-negocio-finca-eventos-bodas. Meta robots se OMITE (desviación
// cross-cutting; se añade en el cutover). Patrón = plan-negocio-bar-restaurante.astro. Build format 'file'.
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanNegocioLandingPage from '../components/pages/PlanNegocioLandingPage.astro';
import data from '../data/productos/planes/plan-negocio-finca-eventos-bodas';

const lang = 'es';

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO como la SPA, mismo fallback) para que
// Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se resuelve literal.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_PLAN_FINCA_EVENTOS || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={['es']}
  ogImage={data.seo.ogImage}
>
  <PlanNegocioLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
