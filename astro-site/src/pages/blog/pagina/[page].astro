---
// Fase 8B — Páginas 2+ del listado del blog: /blog/pagina/{n}.
// La página 1 es /blog (no se genera /blog/pagina/1 para evitar duplicado).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getPublishedPosts, POSTS_PER_PAGE } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('es');
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  const paths = [];
  for (let n = 2; n <= totalPages; n++) {
    paths.push({
      params: { page: String(n) },
      props: {
        posts: posts.slice((n - 1) * POSTS_PER_PAGE, n * POSTS_PER_PAGE),
        page: n,
        totalPages,
      },
    });
  }
  return paths;
}

const { posts, page, totalPages } = Astro.props;
const prevHref = page === 2 ? '/blog' : `/blog/pagina/${page - 1}`;
---

<BaseLayout
  title={`Blog de AI Chef Pro — Página ${page}`}
  description={`Artículos de IA para restaurantes y hostelería — página ${page} de ${totalPages} del blog de AI Chef Pro.`}
  lang="es"
  basePath={`/blog/pagina/${page}`}
  locales={['es']}
>
  <Header lang="es" />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-foreground">Blog de AI Chef Pro — Página {page}</h1>
      <p class="mt-2 text-muted-foreground"><a href="/blog" class="text-primary hover:underline">← Volver a la portada del blog</a></p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => <PostCard post={p} />)}
    </div>

    <nav aria-label="Paginación" class="mt-12 flex items-center justify-center gap-4">
      <a
        href={prevHref}
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
      >← Anterior</a>
      <span class="text-sm text-muted-foreground">Página {page} de {totalPages}</span>
      {page < totalPages && (
        <a
          href={`/blog/pagina/${page + 1}`}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Siguiente →</a>
      )}
    </nav>
  </main>

  <Footer lang="es" />
</BaseLayout>
