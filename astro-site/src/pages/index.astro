---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustedByLogos from '../components/TrustedByLogos.astro';
import ScreenshotSection from '../components/ScreenshotSection.astro';
import SocialProofStrip from '../components/SocialProofStrip.astro';
import IntegracionesShowcase from '../components/IntegracionesShowcase.astro';
import AppsCategories from '../components/AppsCategories.astro';
import AIImageGallery from '../components/AIImageGallery.astro';
import AppsFinder from '../components/AppsFinder.astro';
import CreatividadShowcase from '../components/CreatividadShowcase.astro';
import WorldCookbooks from '../components/WorldCookbooks.astro';
import BusinessToolsShowcase from '../components/BusinessToolsShowcase.astro';
import CityResourcesStrip from '../components/CityResourcesStrip.astro';
import AIToolsBanner from '../components/AIToolsBanner.astro';
import ModernFeatures from '../components/ModernFeatures.astro';
import FeaturedApps from '../components/FeaturedApps.astro';
import ModernChefSection from '../components/ModernChefSection.astro';
import Pricing from '../components/Pricing.astro';
import CategoryCTAs from '../components/CategoryCTAs.astro';
import FAQ from '../components/FAQ.astro';
import ConversionNotifications from '../components/ConversionNotifications.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/translations';
import { trialCtaUrl } from '../lib/app-url';

const lang = 'es';
const trialHref = trialCtaUrl('header');
---

<BaseLayout
  title="AI Chef Pro: agentes de negocio para restaurantes — food cost, alérgenos y mermas"
  description="Suite de IA para restaurantes. Empieza el trial con créditos: mermas, alérgenos, pax y 75+ agentes. Prueba ahora en la plataforma ES."
  lang="es"
  basePath="/"
>
  <!-- Home ES: Business/Tools sube justo después de categorías para priorizar
       agentes de negocio (ticket embudo trial créditos). Creatividad queda debajo. -->
  <div class="min-h-screen bg-background overflow-x-clip">
    <Header lang={lang} appCtaHref={trialHref} appCtaLabel={t(lang, 'hero.cta_trial')} />
    <main>
      <Hero lang={lang} />
      <TrustedByLogos lang={lang} />
      <ScreenshotSection lang={lang} />
      <SocialProofStrip lang={lang} />
      <IntegracionesShowcase lang={lang} />
      <AppsCategories lang={lang} />
      <BusinessToolsShowcase lang={lang} />
      <AIImageGallery lang={lang} />
      <AppsFinder lang={lang} />
      <CreatividadShowcase lang={lang} />
      <WorldCookbooks lang={lang} />
      <CityResourcesStrip lang={lang} />
      <AIToolsBanner lang={lang} />
      <ModernFeatures lang={lang} />
      <FeaturedApps lang={lang} />
      <ModernChefSection lang={lang} />
      <Pricing lang={lang} />
      <CategoryCTAs lang={lang} />
      <FAQ lang={lang} />
      <ConversionNotifications lang={lang} />
    </main>
    <Footer lang={lang} />
  </div>
</BaseLayout>
