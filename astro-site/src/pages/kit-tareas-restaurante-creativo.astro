---
// /kit-tareas-restaurante-creativo — LÍNEA TAREAS. Thin wrapper: pasa el objeto data
// al template KitTareasLandingPage y el SEO a BaseLayout.
//
// hreflang: alternatesFamilia('kit-tareas-restaurante-creativo') (lib/tienda.ts). Con el gemelo EN vivo (Fine Dining Checklists Kit Pro,
// /en/digital-products/fine-dining-checklist-templates, 31-oct-2026) emite es + en + x-default recíprocos; si EN volviera a vivo:false,
// devuelve locales ['es'] sin alternates y el HTML sería el de antes (hreflang es + x-default).
// Canonical: https://aichef.pro/kit-tareas-restaurante-creativo. Meta robots se OMITE (desviación cross-cutting; se añade en el
// cutover). Patrón = kit-tareas-taqueria.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import KitTareasLandingPage from '../components/pages/KitTareasLandingPage.astro';
import data from '../data/productos/tareas/kit-tareas-restaurante-creativo';
import { alternatesFamilia } from '../lib/tienda';

const lang = 'es';
const hreflang = alternatesFamilia('kit-tareas-restaurante-creativo');

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO como la SPA, mismo fallback) para que
// Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se resuelve literal.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_TAREAS_RESTAURANTE_CREATIVO || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={hreflang.locales}
  alternates={hreflang.alternates}
  ogImage={data.seo.ogImage}
>
  <KitTareasLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
