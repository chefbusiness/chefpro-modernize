---
// /guia-food-cost-ingenieria-menu — LÍNEA GUÍAS, producto 45 (2026-09-03).
// Thin wrapper: pasa el objeto data al template GuiaLandingPage y el SEO a BaseLayout.
//
// SOLO ES: producto de fiscalidad española y sin variantes de idioma → locales={['es']}
// (BaseLayout emite hreflang es + x-default y nada más). Canonical:
// https://aichef.pro/guia-food-cost-ingenieria-menu. Patrón calcado de
// guia-restaurante-gastronomico.astro; a diferencia de las 8 guías anteriores, esta
// landing NACE en Astro (no hay página SPA de la que portarla).
import BaseLayout from '../layouts/BaseLayout.astro';
import GuiaLandingPage from '../components/pages/GuiaLandingPage.astro';
import data from '../data/productos/guias/guia-food-cost-ingenieria-menu';

const lang = 'es';

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO, mismo fallback que la familia)
// para que Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se
// resuelve literal porque import.meta.env[clave] NO es fiable.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_GUIA_FOOD_COST || '#comprar';
---

<BaseLayout
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={['es']}
  ogImage={data.seo.ogImage}
>
  <GuiaLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
