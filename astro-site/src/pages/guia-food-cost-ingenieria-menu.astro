---
// /guia-food-cost-ingenieria-menu — LÍNEA GUÍAS, producto 45 (2026-09-03).
// Thin wrapper: pasa el objeto data al template GuiaLandingPage y el SEO a BaseLayout.
//
// hreflang: alternatesFamilia('guia-food-cost-ingenieria-menu') (lib/tienda.ts). Con el gemelo EN vivo
// (Food Cost + Menu Engineering Guide, /en/digital-products/food-cost-menu-engineering-guide, 15-oct-2026)
// emite es + en + x-default recíprocos; si EN volviera a vivo:false, devuelve locales ['es'] sin
// alternates y el HTML sería el de antes (hreflang es + x-default). Patrón = plan-negocio-cocteleria-eventos.astro.
// Canonical: https://aichef.pro/guia-food-cost-ingenieria-menu. Patrón calcado de
// guia-restaurante-gastronomico.astro; a diferencia de las 8 guías anteriores, esta
// landing NACE en Astro (no hay página SPA de la que portarla).
import BaseLayout from '../layouts/BaseLayout.astro';
import GuiaLandingPage from '../components/pages/GuiaLandingPage.astro';
import data from '../data/productos/guias/guia-food-cost-ingenieria-menu';
import { alternatesFamilia } from '../lib/tienda';

const lang = 'es';
const hreflang = alternatesFamilia('guia-food-cost-ingenieria-menu');

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO, mismo fallback que la familia)
// para que Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se
// resuelve literal porque import.meta.env[clave] NO es fiable.
// whatsapp={false}: GuiaLandingPage monta su PROPIO botón flotante de WhatsApp
// (mensaje de soporte prerellenado, bottom-20 en móvil por la barra sticky). Sin
// esto saldría también el global de BaseLayout y serían DOS superpuestos
// (whatsapp-gate.py exige exactamente 1 por página).
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_GUIA_FOOD_COST || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={hreflang.locales}
  alternates={hreflang.alternates}
  ogImage={data.seo.ogImage}
>
  <GuiaLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
