---
// Fase 9-FR (2026-08-16) — Páginas 2+ del listado del blog FR: /fr/blog/page/{n}.
// La página 1 es /fr/blog (no se genera /fr/blog/page/1 para no duplicarla).
// El segmento sale del nombre de ESTE directorio y debe coincidir con
// ROUTE_SEGMENTS de src/lib/blog.ts, de donde salen todos los enlaces. Que
// 'page' se escriba igual en francés y en inglés es coincidencia del idioma: la
// entrada `fr` de ROUTE_SEGMENTS es obligatoria de todas formas, porque el
// segmento de categoría sí difiere ('categorie' vs 'category').
//
// Con 0 posts, getStaticPaths devuelve [] y esta ruta no emite ninguna página:
// es el estado esperado de un blog recién abierto, no un error.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { blogBase, getPublishedPosts, listPagePath, POSTS_PER_PAGE } from '../../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('fr');
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  const paths = [];
  for (let n = 2; n <= totalPages; n++) {
    paths.push({
      params: { page: String(n) },
      props: {
        posts: posts.slice((n - 1) * POSTS_PER_PAGE, n * POSTS_PER_PAGE),
        page: n,
        totalPages,
      },
    });
  }
  return paths;
}

const lang = 'fr';
const { posts, page, totalPages } = Astro.props;
const prevHref = listPagePath(page - 1, lang);
---

<BaseLayout
  title={`Blog AI Chef Pro — Page ${page}`}
  description={`L'IA pour les restaurants et la restauration — page ${page} sur ${totalPages} du blog d'AI Chef Pro.`}
  lang={lang}
  basePath={`/blog/page/${page}`}
  locales={['fr']}
>
  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-foreground">Blog AI Chef Pro — Page {page}</h1>
      <p class="mt-2 text-muted-foreground"><a href={blogBase(lang)} class="text-primary hover:underline">← Retour à l'accueil du blog</a></p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => <PostCard post={p} />)}
    </div>

    <nav aria-label="Pagination" class="mt-12 flex items-center justify-center gap-4">
      <a
        href={prevHref}
        class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
      >← Précédent</a>
      <span class="text-sm text-muted-foreground">Page {page} sur {totalPages}</span>
      {page < totalPages && (
        <a
          href={listPagePath(page + 1, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Suivant →</a>
      )}
    </nav>
  </main>

  <Footer lang={lang} />
</BaseLayout>
