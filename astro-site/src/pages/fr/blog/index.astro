---
// Fase 9-FR (2026-08-16) — Hub del blog FR /fr/blog: página 1 del listado +
// navegación por categorías. Las páginas 2+ viven en /fr/blog/page/{n}.
// Clon del árbol italiano (src/pages/it/blog/), que es la referencia de un blog
// que nace de cero, con los segmentos y el copy en francés nativo.
//
// SEGMENTOS: 'categorie' (sin acento: es un segmento de URL, y acentuarlo
// obligaría a percent-encoding) y 'page'. Salen de ROUTE_SEGMENTS
// (src/lib/blog.ts); sin la entrada `fr` el árbol caería al fallback inglés y
// serviría /fr/blog/category/…. Que 'page' coincida con el inglés es una
// coincidencia del idioma, no un fallback.
//
// hreflang: locales={['fr']} — el blog FR es contenido NATIVO escrito a partir
// del keyword research de Google.fr (ROADMAP_BLOG_FRANCES.md), no la traducción
// del ES ni del EN. Declarar un par ES↔FR sería falso.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { SITE } from '../../../i18n/config';
import {
  blogBase,
  categoryPath,
  getCategories,
  getPublishedPosts,
  listPagePath,
  POSTS_PER_PAGE,
} from '../../../lib/blog';

const lang = 'fr';
const posts = await getPublishedPosts(lang);
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const catsWithPosts = getCategories(lang).filter((c) =>
  posts.some((p) => p.data.category === c.slug)
);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog AI Chef Pro',
    description:
      "L'intelligence artificielle au service des restaurants : guides, outils, prompts et technique de cuisine professionnelle.",
    url: `${SITE}${blogBase(lang)}`,
    inLanguage: 'fr',
    publisher: { '@type': 'Organization', name: 'AI Chef Pro', url: SITE },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE}/fr` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}${blogBase(lang)}` },
    ],
  },
];
---

<BaseLayout
  title="Blog IA pour Restaurants | AI Chef Pro"
  description="L'intelligence artificielle appliquée aux restaurants : outils IA, prompts professionnels, fiches techniques et coût de revient, hygiène alimentaire et gestion de cuisine. Le blog d'AI Chef Pro."
  lang={lang}
  basePath="/blog"
  locales={['fr']}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Blog AI Chef Pro" href={`${SITE}${blogBase(lang)}/rss.xml`} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10 text-center">
      <h1 class="text-4xl font-bold text-foreground md:text-5xl">Le Blog d'AI Chef Pro</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        L'intelligence artificielle au service des restaurants : guides pratiques,
        prompts professionnels, maîtrise des coûts et technique de cuisine.
      </p>
    </header>

    {catsWithPosts.length > 0 && (
      <nav aria-label="Catégories du blog" class="mb-10 flex flex-wrap justify-center gap-3">
        {catsWithPosts.map((c) => (
          <a
            href={categoryPath(c.slug, lang)}
            class="rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"
          >{c.name}</a>
        ))}
      </nav>
    )}

    {pagePosts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {pagePosts.map((p, i) => <PostCard post={p} eager={i < 3} />)}
      </div>
    ) : (
      <p class="text-center text-muted-foreground">Bientôt en ligne : nous préparons les premiers articles.</p>
    )}

    {totalPages > 1 && (
      <nav aria-label="Pagination" class="mt-12 flex items-center justify-center gap-4">
        <span class="text-sm text-muted-foreground">Page 1 sur {totalPages}</span>
        <a
          href={listPagePath(2, lang)}
          class="rounded-lg border border-border px-4 py-2 text-sm font-medium hover:border-primary hover:text-primary"
        >Suivant →</a>
      </nav>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>
