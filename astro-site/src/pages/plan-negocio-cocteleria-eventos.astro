---
// /plan-negocio-cocteleria-eventos — LÍNEA PLANES (sub-línea B "eventos"). Thin wrapper: pasa el objeto
// data al MISMO template PlanNegocioLandingPage (prueba de que 1 template sirve a ambas sub-líneas).
//
// SOLO ES: la SPA (PlanNegocioCocteleriaEventos.tsx) hardcodea el Helmet en español y esta ruta NO tiene
// variantes de idioma → locales={['es']}. Canonical: https://aichef.pro/plan-negocio-cocteleria-eventos.
// Meta robots se OMITE (desviación cross-cutting; se añade en el cutover). Build format 'file'.
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanNegocioLandingPage from '../components/pages/PlanNegocioLandingPage.astro';
import data from '../data/productos/planes/plan-negocio-cocteleria-eventos';

const lang = 'es';

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO como la SPA, mismo fallback) para que
// Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se resuelve literal.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_PLAN_COCTELERIA || '#comprar';
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={['es']}
  ogImage={data.seo.ogImage}
>
  <PlanNegocioLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
