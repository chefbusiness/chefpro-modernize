---
// /kit-tareas-chocolateria — LÍNEA TAREAS. Thin wrapper: pasa el objeto data al
// template KitTareasLandingPage y el SEO a BaseLayout.
//
// hreflang: alternatesFamilia('kit-tareas-chocolateria') (lib/tienda.ts). Con el gemelo EN vivo (Chocolate Shop Checklists Kit Pro,
// /en/digital-products/chocolate-shop-checklist-templates, 24-oct-2026) emite es + en + x-default recíprocos; si EN volviera a
// vivo:false, devuelve locales ['es'] sin alternates y el HTML sería el de antes (hreflang es + x-default).
// Patrón = kit-tareas-heladeria.astro. Canonical: https://aichef.pro/kit-tareas-chocolateria. Meta robots se OMITE
// (desviación cross-cutting; se añade en el cutover). Patrón = kit-tareas-asador.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import KitTareasLandingPage from '../components/pages/KitTareasLandingPage.astro';
import data from '../data/productos/tareas/kit-tareas-chocolateria';
import { alternatesFamilia } from '../lib/tienda';

const lang = 'es';
const hreflang = alternatesFamilia('kit-tareas-chocolateria');

// DINERO: acceso ESTÁTICO a la env var (nombre EXACTO como la SPA, mismo fallback) para que
// Vite la inline en build. data.stripeEnvKey documenta cuál es; aquí se resuelve literal.
const stripeLink = import.meta.env.VITE_STRIPE_PAYMENT_LINK_TAREAS_CHOCOLATERIA || '#comprar';
---

<BaseLayout
  whatsapp={false}
  omitGlobalApp
  title={data.seo.title}
  description={data.seo.description}
  keywords={data.seo.keywords}
  lang={lang}
  basePath={`/${data.slug}`}
  locales={hreflang.locales}
  alternates={hreflang.alternates}
  ogImage={data.seo.ogImage}
>
  <KitTareasLandingPage data={data} stripeLink={stripeLink} />
</BaseLayout>
