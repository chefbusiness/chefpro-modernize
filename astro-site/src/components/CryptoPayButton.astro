  /** productId = slug de la landing (verificado 48/48 en zona-app.ts). */
  productId: string;
  /** Nombre del producto tal como lo pinta el hero. */
  productName: string;
  /** Precio de display de la landing, p. ej. "€12". */
  priceLabel: string;
  /** Ruta de la landing, para volver si el comprador cancela. */
  landingPath: string;
  /** Dónde va el botón. Los tres puntos de compra de la landing. */
  variant?: 'hero' | 'buybox' | 'cta';
  /** Idioma de la tienda (el `lang` de la plantilla). Default 'es'. Solo 'en' tiene copy propio;
   *  cualquier otro valor pinta el ES, como los diccionarios de la plantilla. */
  lang?: string;
}

