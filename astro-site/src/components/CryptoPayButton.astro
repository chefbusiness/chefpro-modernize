      .aicp-crypto__pay:focus-visible { outline: 2px solid var(--nowp); outline-offset: 3px; }
      /* Hero y CTA final: el dorado de al lado es w-full md:w-auto px-10 py-4. */
      .aicp-crypto--hero .aicp-crypto__pay, .aicp-crypto--cta .aicp-crypto__pay { padding: 1rem 2.5rem; }
      @media (min-width: 768px) {
        .aicp-crypto--hero .aicp-crypto__pay, .aicp-crypto--cta .aicp-crypto__pay { width: auto; }
      }

      /* Sello: el equivalente de /powered-by-stripe.png (w-full max-w-[260px], mt-5). */
      .aicp-crypto__seal {
        display: inline-flex; flex-direction: column; align-items: center; gap: 0.3rem;
        /* Mismas medidas que /powered-by-stripe.png: w-full, max-w-[260px], rounded-lg,
           px-3 py-1.5 y mt-5. Puestas una debajo de otra tienen que parecer dos sellos
           del mismo juego, no un sello y un adorno. */
        width: 100%; max-width: 260px; margin-top: 1.25rem; padding: 0.375rem 0.75rem;
        border: 1px solid rgba(100, 172, 255, 0.45); border-radius: 0.5rem;
        background: var(--nowp-navy);
      }
      .aicp-crypto__wordmark { display: flex; align-items: baseline; justify-content: center; gap: 0.4rem; }
      .aicp-crypto__wordmark-pre {
        color: #94a3b8; font-size: 0.5rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
      }
      .aicp-crypto__wordmark-now { color: var(--nowp); font-size: 0.8125rem; font-weight: 800; }
      .aicp-crypto__wordmark-pay { color: #ffffff; font-size: 0.8125rem; font-weight: 500; }
      /* 8 círculos de 24 px + 7 huecos de 3 px = 213 px sobre los 236 de interior de la
         pastilla (260 − 2×0.75rem): entran holgados y a un tamaño en el que se reconoce
         cada moneda. El wrap es la red por si el zoom o una fuente distinta aprietan. */
      .aicp-crypto__coins { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 3px; }
      /* En el diálogo hay 30 rem de ancho: caben las diez y con más aire. */
      .aicp-crypto__coins--dialog { justify-content: flex-start; gap: 5px; margin: 0.1rem 0 0.4rem; }
      .aicp-coin {
        display: inline-flex; align-items: center; justify-content: center; flex: none;
        width: 24px; height: 24px; border-radius: 999px; background: #ffffff; color: var(--coin-c);
      }
      .aicp-coin svg { display: block; width: 16px; height: 16px; }
      /* BTC, LTC y TON ya son un disco completo: llenan el círculo en vez de flotar
         dentro de él, que es como se leen en cualquier listado de monedas. */
      .aicp-coin--full svg { width: 24px; height: 24px; }
      /* Teselas (USDC y TRX no están en Simple Icons): el color va al fondo y la sigla en
