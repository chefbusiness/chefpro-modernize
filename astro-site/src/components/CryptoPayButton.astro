const PAISES_RESTO = PAISES.slice(PAISES_FRECUENTES_N);

/**
 * Monedas del sello, en el orden en que las pinta NOWPayments en su propio banner: las
 * dos estables primero (son las que resuelven el problema real —volatilidad cero entre
 * que el comprador pulsa y paga— y las que más se usan en LATAM), después las grandes.
 * `usdc` y `tron` no existen en Simple Icons: CryptoCoinIcon las pinta como tesela.
 */
const MONEDAS = ['tether', 'usdc', 'bitcoin', 'ethereum', 'litecoin', 'solana', 'tron', 'binance', 'ton', 'polygon'];
/**
 * ⚠️ En el SELLO caben 8, no 10. La pastilla replica la del sello de Stripe —max-w-[260px]
 * con px-3—, así que su interior son 236 px: diez círculos legibles (24 px + 3 de hueco)
 * piden 267 y sólo entran apretándolos a 22 px con 1,5 de hueco, que es justo lo que John
 * pidió evitar («iconos legibles a 260 px»). Se muestran 8 y las dos últimas —TON y
 * MATIC— se ven en el diálogo, que mide 30 rem y las admite todas de sobra.
 */
const MONEDAS_SELLO = MONEDAS.slice(0, 8);

/**
 * El argumento de venta va en el TEXTO, nunca dentro del botón (John, 2026-09-06).
 *
 * ⚠️ Y NO es «cripto para quien no tiene banco». Cripto la elige tanto quien compra desde
 * México, Colombia, Venezuela, Guatemala o Chile —donde una tarjeta que funcione fuera no
 * se da por hecha— como quien en la UE o EE. UU. sencillamente prefiere pagar desde su
 * wallet. Por eso la pregunta tiene DOS mitades y ninguna de las dos habla de países.
 */
const TITULAR = '¿Sin tarjeta internacional o prefieres pagar desde tu wallet?';

/** Bajo el precio de la tarjeta: lo que de verdad frena la compra es pensar que cripto
 *  cuesta más o que el precio baila. Las dos cosas se responden aquí. */
const SIN_RECARGO = 'Mismo precio que con tarjeta, sin recargo. Pagas el equivalente en USDT, USDC, BTC o ETH al cambio del momento.';

/** Hero y CTA final no llevan tarjeta: el argumento entero cabe en una línea. */
const NOTA_CORTA = '¿Sin tarjeta internacional o prefieres tu wallet? Mismo precio, sin recargo.';

/**
 * Las tres dudas que quedan cuando alguien ya ha decidido pagar en cripto: cuándo llega
 * el producto, qué moneda le va a salir más barata y desde dónde puede pagar. Sin jerga
 * —ni «blockchain», ni «on-chain», ni «Web3»—: el comprador es un hostelero, no un trader.
 */
const CONFIANZA = [
  'Entrega automática por email en cuanto la red confirma (normalmente 1-10 min)',
  'Recomendado: USDT en red TRON (TRC-20), comisiones de céntimos',
  'Desde Binance, Trust Wallet, MetaMask o Phantom',
];
---

{enabled && (
  <div
    class:list={['aicp-crypto', `aicp-crypto--${variant}`]}
    data-crypto-product={productId}
    data-crypto-landing={landingPath}
    data-crypto-variant={variant}
  >
    {/* Las TRES puertas llevan el separador: Stripe → «o» → cripto tiene que leerse igual
        en el hero, en el BuyBox y en el CTA final (John, 2026-09-06, sobre el preview). */}
    <div class="aicp-crypto__sep" aria-hidden="true"><span>o</span></div>

    <div class="aicp-crypto__box">
      {variant === 'buybox' ? (
        <Fragment>
          <p class="aicp-crypto__eyebrow">Pago con criptomonedas</p>
          <p class="aicp-crypto__headline">{TITULAR}</p>
          {/* Sin precio grande: ya va dentro del botón y repetirlo era redundante (John). */}
          <p class="aicp-crypto__note">{SIN_RECARGO}</p>
        </Fragment>
      ) : (
        <Fragment>
          {variant === 'hero' && <p class="aicp-crypto__eyebrow">Pago con criptomonedas</p>}
          <p class="aicp-crypto__note">{NOTA_CORTA}</p>
        </Fragment>
      )}

      <button
        type="button"
        class="aicp-crypto__pay"
        data-crypto-open
        aria-haspopup="dialog"
        aria-controls={dialogId}
      >Pagar con cripto — {priceLabel}</button>

      {/* Equivalente del sello "Powered by Stripe": mismo ancho (260 px) y mismo mt-5,
          pero con el wordmark en TEXTO y las monedas en SVG inline — cero imágenes
          externas en una página de pago. El wordmark no lleva espacio entre NOW y
          Payments a propósito: es una sola palabra en dos colores. */}
      <div class="aicp-crypto__seal">
        <span class="aicp-crypto__wordmark">
          <span class="aicp-crypto__wordmark-pre">Powered by</span>
          <span><span class="aicp-crypto__wordmark-now">NOW</span><span class="aicp-crypto__wordmark-pay">Payments</span></span>
        </span>
        <span class="aicp-crypto__coins" role="img" aria-label={`Criptomonedas aceptadas: ${CRYPTO_COINS_LABEL}`}>
          {MONEDAS_SELLO.map((moneda) => <CryptoCoinIcon name={moneda} decorative />)}
        </span>
      </div>

      {/* Sólo en la tarjeta del BuyBox: ahí es donde se decide y hay sitio. En hero y CTA
          final el bloque tiene que pesar lo mismo que el CTA dorado de al lado. */}
      {variant === 'buybox' && (
        <ul class="aicp-crypto__trust">
