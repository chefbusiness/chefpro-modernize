      .aicp-crypto__input option, .aicp-crypto__input optgroup { background: #111111; color: #ffffff; }
      .aicp-crypto__check { display: flex; align-items: flex-start; gap: 0.6rem; color: #d1d5db; font-size: 0.84rem; line-height: 1.45; cursor: pointer; }
      .aicp-crypto__check input { flex: none; width: 1.05rem; height: 1.05rem; margin: 0.15rem 0 0; accent-color: #64ACFF; }
      /* Los enlaces legales siguen en dorado: es el color de enlace de todo el sitio y
