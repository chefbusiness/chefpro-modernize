// Mismo conjunto de códigos en los dos idiomas: si alguien añade un país a una lista y no a la
// otra, el build falla aquí en lugar de dejar un país que un idioma no puede elegir.
{
  const codigos = new Set(PAISES.map((p) => p.code));
  if (PAISES_EN.length !== PAISES.length || PAISES_EN.some((p) => !codigos.has(p.code))) {
    throw new Error('CryptoPayButton: PAISES_EN y PAISES no tienen los mismos códigos ISO');
  }
}

const CRYPTO_COINS_LABEL_EN = 'USDT · USDC · BTC · ETH and more';
const TITULAR_EN = 'No international card, or prefer to pay from your wallet?';
const SIN_RECARGO_EN = 'Same price as by card, no surcharge. You pay the equivalent in USDT, USDC, BTC or ETH at the current rate.';
const NOTA_CORTA_EN = 'No international card, or prefer your wallet? Same price, no surcharge.';
const CONFIANZA_EN = [
  'Automatic delivery by email as soon as the gateway confirms the payment: usually a few minutes; Bitcoin can take longer',
  'Recommended: USDT on the TRON network (TRC-20), with fees of a few cents',
  'From Binance, Trust Wallet or any wallet that supports the network you choose',
];

// Lo que pinta el markup: las constantes ES tal cual, o su versión EN.
const paisesFrecuentes = en ? PAISES_EN.slice(0, PAISES_EN_FRECUENTES_N) : PAISES_FRECUENTES;
const paisesResto = en ? PAISES_EN.slice(PAISES_EN_FRECUENTES_N) : PAISES_RESTO;
const coinsLabel = en ? CRYPTO_COINS_LABEL_EN : CRYPTO_COINS_LABEL;
const titular = en ? TITULAR_EN : TITULAR;
const sinRecargo = en ? SIN_RECARGO_EN : SIN_RECARGO;
const notaCorta = en ? NOTA_CORTA_EN : NOTA_CORTA;
const confianza = en ? CONFIANZA_EN : CONFIANZA;
---

{enabled && (
  <div
    class:list={['aicp-crypto', `aicp-crypto--${variant}`]}
    data-crypto-product={productId}
    data-crypto-landing={landingPath}
    data-crypto-variant={variant}
  >
    {/* Las TRES puertas llevan el separador: Stripe → «o» → cripto tiene que leerse igual
        en el hero, en el BuyBox y en el CTA final (John, 2026-09-06, sobre el preview). */}
    <div class="aicp-crypto__sep" aria-hidden="true"><span>{en ? 'or' : 'o'}</span></div>

    <div class="aicp-crypto__box">
      {variant === 'buybox' ? (
        <Fragment>
          <p class="aicp-crypto__eyebrow">{en ? 'Crypto payment' : 'Pago con criptomonedas'}</p>
          <p class="aicp-crypto__headline">{titular}</p>
          {/* Sin precio grande: ya va dentro del botón y repetirlo era redundante (John). */}
          <p class="aicp-crypto__note">{sinRecargo}</p>
        </Fragment>
      ) : (
        <p class="aicp-crypto__note">{notaCorta}</p>
      )}

      <button
        type="button"
        class="aicp-crypto__pay"
        data-crypto-open
        aria-haspopup="dialog"
        aria-controls={dialogId}
      >{en ? 'Pay with crypto — ' : 'Pagar con cripto — '}{priceLabel}</button>

      {/* Equivalente del sello "Powered by Stripe": mismo ancho (260 px) y mismo mt-5,
          pero con el wordmark en TEXTO y las monedas en SVG inline — cero imágenes
          externas en una página de pago. El wordmark no lleva espacio entre NOW y
          Payments a propósito: es una sola palabra en dos colores. */}
      <div class="aicp-crypto__seal">
        <span class="aicp-crypto__wordmark">
          <span class="aicp-crypto__wordmark-pre">Powered by</span>
          <span><span class="aicp-crypto__wordmark-now">NOW</span><span class="aicp-crypto__wordmark-pay">Payments</span></span>
        </span>
        <span class="aicp-crypto__coins" role="img" aria-label={en ? `Accepted cryptocurrencies: ${coinsLabel}` : `Criptomonedas aceptadas: ${CRYPTO_COINS_LABEL}`}>
          {MONEDAS_SELLO.map((moneda) => <CryptoCoinIcon name={moneda} decorative />)}
        </span>
      </div>

      {/* Sólo en la tarjeta del BuyBox: ahí es donde se decide y hay sitio. En hero y CTA
          final el bloque tiene que pesar lo mismo que el CTA dorado de al lado. */}
      {variant === 'buybox' && (
        <ul class="aicp-crypto__trust">
          {confianza.map((linea) => <li>{linea}</li>)}
        </ul>
      )}
    </div>

    {/* El diálogo lo emite SÓLO el BuyBox y lo comparten las tres puertas: es la pieza
        pesada (la lista de ~250 países y los 10 iconos) y con una por instancia el HTML
        de la landing pasaba de 194 a 273 KB. Los botones del hero y del CTA final llegan
        hasta aquí por `aria-controls`. */}
    {variant === 'buybox' && (
      <dialog id={dialogId} class="aicp-crypto__dialog" data-crypto-dialog data-crypto-product={productId} aria-labelledby={titleId}>
        <form class="aicp-crypto__form" data-crypto-form>
          <button type="button" class="aicp-crypto__close" data-crypto-close aria-label={en ? 'Close' : 'Cerrar'}>✕</button>

          {/* «paso 1 de 2» porque la elección de moneda y red pasa en NOWPayments: sin
              decirlo, este formulario parece el pago entero y la redirección desconcierta. */}
          <h2 id={titleId} class="aicp-crypto__title">{en ? 'Pay with crypto · step 1 of 2' : 'Paga con cripto · paso 1 de 2'}</h2>
          <p class="aicp-crypto__product">
            <span>{productName}</span>
            <span class="aicp-crypto__product-price">{priceLabel}</span>
          </p>
          {/* ES y EN por elemento entero: la rama ES es el marcado de siempre, byte a byte (con
              compressHTML, una expresión dentro del <p> se come los saltos de línea del texto). */}
          {en ? (
            <p class="aicp-crypto__price">
              One-time payment, lifetime access. You pay the equivalent in the crypto you choose, with no surcharge.
            </p>
          ) : (
          <p class="aicp-crypto__price">
            Pago único, acceso vitalicio. Pagas su equivalente en la cripto que elijas, sin recargo.
          </p>
          )}
          <span class="aicp-crypto__coins aicp-crypto__coins--dialog" role="img" aria-label={en ? `Accepted cryptocurrencies: ${coinsLabel}` : `Criptomonedas aceptadas: ${CRYPTO_COINS_LABEL}`}>
            {MONEDAS.map((moneda) => <CryptoCoinIcon name={moneda} decorative />)}
          </span>

          <div class="aicp-crypto__field">
            <label class="aicp-crypto__label" for={emailId}>{en ? "Your email (we'll send your access there)" : 'Tu email (ahí te enviamos el acceso)'}</label>
            <input
              class="aicp-crypto__input"
              id={emailId}
              type="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder={en ? 'you@example.com' : 'tucorreo@ejemplo.com'}
              data-crypto-email
            />
          </div>

          <div class="aicp-crypto__field">
            <label class="aicp-crypto__label" for={countryId}>{en ? 'Billing country' : 'País de facturación'}</label>
            <select class="aicp-crypto__input" id={countryId} name="country" required data-crypto-country>
              <option value="">{en ? 'Choose your country…' : 'Elige tu país…'}</option>
              <optgroup label={en ? 'Most common' : 'Más frecuentes'}>
                {paisesFrecuentes.map((p) => <option value={p.code}>{p.name}</option>)}
              </optgroup>
              <optgroup label={en ? 'All other countries' : 'Resto de países'}>
                {paisesResto.map((p) => <option value={p.code}>{p.name}</option>)}
              </optgroup>
            </select>
          </div>

          <label class="aicp-crypto__check">
            <input type="checkbox" required data-crypto-accept />
            {en ? (
              <span>
                I have read and accept the <a href="/en/terminos" target="_blank" rel="noopener noreferrer">terms of purchase and refunds</a>
              </span>
            ) : (
            <span>
              He leído y acepto las <a href="/terminos" target="_blank" rel="noopener noreferrer">condiciones de compra y devoluciones</a>
            </span>
            )}
          </label>

          <label class="aicp-crypto__check">
            <input type="checkbox" required data-crypto-waive />
            {en ? (
              <span>
                I request immediate access to the digital content and understand that, once I receive it, I lose the 14-day cancellation right where it applies (EU/UK). This does not affect our satisfaction guarantee.
              </span>
            ) : (
            <span>
              Solicito el acceso inmediato al contenido digital y entiendo que, al recibirlo, pierdo el derecho de desistimiento de 14 días. Esto no afecta a nuestra garantía de satisfacción.
            </span>
            )}
          </label>

          {en ? (
            <p class="aicp-crypto__notice">
              Send the exact amount the payment page shows. If you pay from an exchange, add its withdrawal fee: an incomplete payment isn't delivered automatically; if that happens, email info@aichef.pro with your order number and we'll sort it out.
            </p>
          ) : (
          <p class="aicp-crypto__notice">
            Envía el importe exacto que te indique la pasarela. Si retiras desde un exchange, súmale su comisión de retirada: un pago incompleto no se entrega automáticamente; si te pasa, escríbenos a info@aichef.pro con tu número de pedido y lo resolvemos.
          </p>
          )}

          {en ? (
            <p class="aicp-crypto__next">
              Next, we take you to NOWPayments' secure page, where you choose the coin and network.
            </p>
          ) : (
          <p class="aicp-crypto__next">
            Después te llevamos a la página segura de NOWPayments, donde eliges moneda y red.
          </p>
          )}

          <p class="aicp-crypto__error" data-crypto-error role="alert" hidden></p>

          <button type="submit" class="aicp-crypto__submit" data-crypto-submit disabled>{en ? 'Continue to payment' : 'Continuar al pago'}</button>

          {en ? (
            <p class="aicp-crypto__legal">
              The payment is processed by NOWPayments. We receive the confirmation and send your access link to the email you give us; we only use it for that (<a href="/en/privacidad" target="_blank" rel="noopener noreferrer">privacy policy</a>).
            </p>
          ) : (
          <p class="aicp-crypto__legal">
            El cobro lo procesa NOWPayments. Nosotros recibimos la confirmación y te enviamos el enlace de acceso al email que nos dejes; lo tratamos solo para eso (<a href="/privacidad" target="_blank" rel="noopener noreferrer">política de privacidad</a>).
          </p>
          )}
        </form>
      </dialog>
    )}

    <style is:inline>
      /* Estilos SIN scope de Astro a propósito (is:inline): así no se emiten en las
         landings donde el botón está apagado. Todas las clases van prefijadas
         `aicp-crypto` / `aicp-coin` para no chocar con Tailwind ni con la plantilla.
         Ni una utilidad de Tailwind en el markup por la misma razón: una clase nueva
         generaría CSS en el bundle GLOBAL que sí cargan las 18 landings hermanas. */

      /* Paleta NOWPayments. El azul es el de su marca; el navy, el fondo de su banner.
         Deliberadamente NO es el #FFD700 del sitio: si las dos puertas de pago comparten
         color, la segunda parece una nota al pie de la primera (que es lo que pasaba). */
      .aicp-crypto {
        --nowp: #64ACFF;          /* azul pastel de NOWPayments */
        --nowp-hover: #7FBBFF;
        --nowp-ink: #0B1220;      /* texto sobre el azul, como el negro sobre el dorado */
        --nowp-navy: #0F1524;     /* fondo del sello */
        --nowp-line: rgba(100, 172, 255, 0.55);
        --nowp-veil: rgba(100, 172, 255, 0.06);
        text-align: center;
      }
      /* Desde el 2026-09-06 el hero TAMBIÉN lleva separador, así que su aire superior es
         exactamente el del CTA final: el `margin: 1.5rem 0` de la propia línea con la «o».
         Sumarle aquí el 1.25rem que llevaba antes dejaba el doble de hueco que las otras
         dos puertas. Se deja escrito, y no borrado, para que se lea la decisión. */
      .aicp-crypto--hero { margin-top: 0; }

      /* Separador: la línea con la «o» que pedía John para despegar las dos puertas. */
      .aicp-crypto__sep {
        display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0;
