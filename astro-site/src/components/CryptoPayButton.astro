        color: #9ca3af; font-family: inherit; font-size: 0.95rem; line-height: 1; cursor: pointer;
      }
      .aicp-crypto__close:hover { background: rgba(255, 255, 255, 0.12); color: #ffffff; }
      .aicp-crypto__title { margin: 0; padding-right: 2rem; color: #ffffff; font-size: 1.15rem; font-weight: 700; }
      /* Nombre y precio en la misma línea: en un diálogo de pago el importe tiene que
         verse sin leer nada, y a la derecha es donde se busca. */
      .aicp-crypto__product {
        display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;
        margin: 0; color: #e5e7eb; font-size: 0.95rem; font-weight: 600;
      }
      .aicp-crypto__product-price { flex: none; color: #64ACFF; font-size: 1.15rem; font-weight: 800; }
      .aicp-crypto__price { margin: 0 0 0.2rem; color: #9ca3af; font-size: 0.82rem; line-height: 1.5; }
      .aicp-crypto__field { display: flex; flex-direction: column; gap: 0.3rem; }
      .aicp-crypto__label { color: #d1d5db; font-size: 0.8rem; font-weight: 600; }
      .aicp-crypto__input {
