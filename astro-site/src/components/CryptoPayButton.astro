      }

      .aicp-crypto__note { margin: 0 0 1.5rem; color: #9ca3af; font-size: 0.875rem; line-height: 1.6; }
      /* Hero y CTA final: una sola línea encima del botón, más pequeña. */
      .aicp-crypto--hero .aicp-crypto__note,
      .aicp-crypto--cta .aicp-crypto__note { margin: 0 0 0.8rem; font-size: 0.82rem; }

