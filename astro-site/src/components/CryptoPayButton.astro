      .aicp-crypto__submit:disabled { opacity: 0.45; cursor: not-allowed; }
      .aicp-crypto__legal { margin: 0; color: #6b7280; font-size: 0.72rem; line-height: 1.45; text-align: center; }
    </style>

    {/* El script va con el diálogo: uno por página, no uno por puerta. */}
    {variant === 'buybox' && (
      <script is:inline>
        /* Vanilla, sin framework y sin bundle (is:inline): mismo patrón de fetch que el
           formulario "¿Ya compraste?" de la plantilla. El guard sigue puesto —el script se
           emite una sola vez por página, pero una plantilla con dos BuyBox lo duplicaría—;
           inicializa el diálogo compartido y engancha las tres puertas. */
        (function () {
          if (window.__aicpCryptoPayInit) return;
          window.__aicpCryptoPayInit = true;

          var MSG = {
            gateway: 'Ahora mismo la pasarela cripto no está disponible; puedes pagar con tarjeta.',
            rate: 'Demasiados intentos, espera un minuto y vuelve a probar.',
            notEnabled: 'Este producto todavía no admite cripto.',
            consent: 'Marca las dos casillas para continuar.',
            email: 'Revisa el email: ahí es donde te enviamos el acceso.',
            country: 'Elige tu país de facturación.',
            invalid: 'No hemos podido validar la compra desde esta página. Recárgala e inténtalo de nuevo, o escríbenos a info@aichef.pro y lo resolvemos.',
            generic: 'No hemos podido abrir la pasarela. Vuelve a intentarlo en un minuto o escríbenos a info@aichef.pro y lo resolvemos.'
          };

          function messageFor(status, data) {
            var code = data && (data.error || data.code) ? String(data.error || data.code) : '';
            if (status === 503 || status === 501) return MSG.gateway;
            if (status === 429) return MSG.rate;
            if (status === 403 && code === 'product_not_enabled') return MSG.notEnabled;
            /* El formulario ya valida en el navegador, así que estos 400 sólo saltan si
               algo se cuela; aun así merece la pena decir QUÉ revisar. */
            if (status === 400 && code === 'invalid_email') return MSG.email;
            if (status === 400 && code === 'invalid_country') return MSG.country;
            if (status === 400 && code === 'consent_required') return MSG.consent;
            /* El resto de 4xx (unknown_product, origin_not_allowed…) no se arregla reintentando. */
            if (status >= 400 && status < 500) return MSG.invalid;
            return MSG.generic;
          }

          /* Un solo diálogo por producto y página. Se inicializa UNA vez y el `product`
             del payload sale de SU `data-crypto-product`, no del botón que lo abrió. */
          function initDialog(dialog) {
            if (dialog.__aicpCryptoReady) return;
            var form = dialog.querySelector('[data-crypto-form]');
            if (!form) return;
            dialog.__aicpCryptoReady = true;

            var closeBtn = form.querySelector('[data-crypto-close]');
            var email = form.querySelector('[data-crypto-email]');
            var country = form.querySelector('[data-crypto-country]');
            var accept = form.querySelector('[data-crypto-accept]');
            var waive = form.querySelector('[data-crypto-waive]');
            var submit = form.querySelector('[data-crypto-submit]');
            var errorEl = form.querySelector('[data-crypto-error]');
            var loading = false;
            var opener = null;

            /* Al volver con «Atrás» desde NOWPayments, el bfcache restaura la página tal
               cual se dejó: con el submit bloqueado en «Abriendo la pasarela…». */
            window.addEventListener('pageshow', function (ev) {
              if (!ev.persisted) return;
              loading = false;
              submit.textContent = 'Continuar al pago';
              syncSubmit();
            });

            function setError(msg) {
              if (!msg) { errorEl.textContent = ''; errorEl.hidden = true; return; }
              errorEl.textContent = msg;
              errorEl.hidden = false;
            }

            function syncSubmit() {
              submit.disabled = loading || !(accept.checked && waive.checked);
            }

            /* El foco vuelve al botón que abrió el diálogo: con tres puertas en la página,
               devolverlo al principio del documento perdería al comprador. */
            function restoreFocus() {
              var btn = opener;
              opener = null;
              if (btn && typeof btn.focus === 'function') { try { btn.focus(); } catch (err) {} }
            }

            function closeDialog() {
              if (typeof dialog.close === 'function' && dialog.open) { dialog.close(); return; }
              dialog.removeAttribute('open');
              restoreFocus();
            }

            /* `close` cubre las tres salidas nativas: ✕, Esc y clic en el fondo. */
            dialog.addEventListener('close', restoreFocus);

            accept.addEventListener('change', syncSubmit);
            waive.addEventListener('change', syncSubmit);
            syncSubmit();

            if (closeBtn) closeBtn.addEventListener('click', closeDialog);
            /* Clic en el fondo oscuro (el propio dialog ocupa el viewport; el formulario no).
               Se exige que el gesto EMPIECE en el fondo: al arrastrar desde un campo y soltar
               fuera, el `click` resultante también tiene el dialog como target. */
            var downOnBackdrop = false;
            dialog.addEventListener('pointerdown', function (ev) { downOnBackdrop = ev.target === dialog; });
            dialog.addEventListener('click', function (ev) {
              var onBackdrop = downOnBackdrop && ev.target === dialog;
              downOnBackdrop = false;
              if (onBackdrop) closeDialog();
            });

            dialog.__aicpCryptoOpen = function (btn) {
              opener = btn || null;
              setError('');
              if (typeof dialog.showModal === 'function') dialog.showModal();
              else dialog.setAttribute('open', '');
              try { email.focus(); } catch (err) {}
            };

            form.addEventListener('submit', function (ev) {
              ev.preventDefault();
              if (loading) return;
              if (!accept.checked || !waive.checked) { setError(MSG.consent); return; }
              if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;

              var payload = {
                product: dialog.getAttribute('data-crypto-product'),
                email: (email.value || '').trim(),
                country: (country.value || '').trim().toUpperCase(),
                acceptPolicy: true,
                waiveWithdrawal: true
              };

              loading = true;
              syncSubmit();
              submit.textContent = 'Abriendo la pasarela…';
              setError('');

              fetch('/.netlify/functions/crypto-checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              })
                .then(function (res) {
                  return res.json().catch(function () { return null; }).then(function (data) {
                    if (res.ok && data && data.url) {
                      window.location.assign(data.url);
                      return true;
                    }
                    setError(messageFor(res.status, data));
                    return false;
                  });
                })
                .catch(function () { setError(MSG.generic); return false; })
                .then(function (redirected) {
                  if (redirected) return;
                  loading = false;
                  submit.textContent = 'Continuar al pago';
                  syncSubmit();
                });
            });
          }

          /* Cada botón abre el diálogo que dice su `aria-controls`. Si no lo encuentra —una
             plantilla sin BuyBox, que es quien lo emite—, lleva al bloque de compra en vez
             de quedarse muerto bajo el dedo del comprador. */
          function bindOpener(btn) {
            if (btn.__aicpCryptoBound) return;
            btn.__aicpCryptoBound = true;
            btn.addEventListener('click', function () {
              var id = btn.getAttribute('aria-controls');
              var dialog = id ? document.getElementById(id) : null;
              if (dialog && typeof dialog.__aicpCryptoOpen === 'function') { dialog.__aicpCryptoOpen(btn); return; }
              var c = document.getElementById('comprar');
              if (c) c.scrollIntoView({ behavior: 'smooth' });
            });
          }

          function start() {
            var dialogs = document.querySelectorAll('[data-crypto-dialog]');
            for (var i = 0; i < dialogs.length; i++) initDialog(dialogs[i]);
            var openers = document.querySelectorAll('[data-crypto-open]');
            for (var j = 0; j < openers.length; j++) bindOpener(openers[j]);
          }

          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
          else start();
        })();
      </script>
    )}
  </div>
)}
