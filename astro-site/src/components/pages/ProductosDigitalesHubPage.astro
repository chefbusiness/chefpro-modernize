      'Hornos de piso, rotativo y convección con vapor',
      'Campañas Navidad, Reyes y Semana Santa',
    ],
    iconName: 'Wheat',
    image: '/lovable-uploads/ai-gallery/use-case-panadero-hero.jpg',
    badge: 'Nuevo',
    badgeColor: 'bg-purple-500/20 text-purple-400',
    tags: ['excel', 'plantillas', 'gestion', 'panaderia', 'obrador', 'masas-madre'],
  },
];

const comingSoon = [
  { iconName: 'Utensils', name: 'Cómo Montar una Pastelería', desc: 'Guía paso a paso: obrador, vitrina, maquinaria, proveedores, licencias y lanzamiento.', tags: ['pdf', 'guias', 'pasteleria'], phase: 'Mayo 2026' },
  { iconName: 'Utensils', name: 'Cómo Montar una Chocolatería', desc: 'Temperado, obrador, vitrina, proveedores de cacao, licencias y modelo de negocio.', tags: ['pdf', 'guias', 'chocolateria'], phase: 'Junio 2026' },
  { iconName: 'ChefHat', name: 'Manual del Chef Ejecutivo', desc: 'Responsabilidades, KPIs, protocolos, checklists y evaluación de equipo de cocina.', tags: ['pdf', 'manuales', 'gestion', 'restaurante'], phase: 'Junio 2026' },
];

const PRODUCTS_PER_PAGE = 12;

// Etiqueta de un tag (paridad ALL_TAGS.find(t => t.id === tagId)?.label; los tags sin
// entrada en ALL_TAGS — 'bundle', 'obrador', 'tapas'… — no renderizan pill, igual que la SPA).
const tagLabel = (id: string) => ALL_TAGS.find((t) => t.id === id)?.label;

// ── Buscador: índice de texto por card (data-search) ────────────────────────────────
// Se pre-normaliza AQUÍ (servidor) con `indiceBusqueda` de src/lib/normalizar-busqueda.ts:
// minúsculas, sin acentos/ñ, puntuación → espacios y tokens DEDUPLICADOS. Así el script
// del cliente solo normaliza lo que teclea el usuario y compara contra una cadena ya
// limpia (nada de leer textContent, que arrastraría precio, badge y "Ver").
//
// A los productos se les suman los ALIAS por slug (vocabulario que el visitante teclea y
// no está en la ficha: «stock» para el kit de inventario, «rentabilidad» para la Guía Food
// Cost). Sin ellos, un grupo de sinónimos correcto no puede disparar nunca.
const indiceProducto = (p: { name: string; description: string; features: string[]; tags: string[]; slug: string }) =>
  indiceBusqueda([p.name, p.description, ...p.features, ...p.tags, ...p.tags.map(tagLabel), p.slug, ALIAS_BUSQUEDA[p.slug]]);

// GATE DE BUILD: un grupo de sinónimos cuyos miembros no aparecen en NINGÚN índice está
// muerto — el visitante teclea «planilla», ve «No tenemos nada para…» y el registro anota
// una demanda no cubierta que es falsa. Le pasaba al grupo nomina/planilla. Si el gate
// salta: o se quita el grupo del JSON, o se le da cuerpo con un alias en ese mismo JSON.
const _huerfanos = gruposHuerfanos([
  ...products.map(indiceProducto),
  ...comingSoon.map((c) => indiceBusqueda([c.name, c.desc, ...c.tags, ...c.tags.map(tagLabel)])),
]);
if (_huerfanos.length) {
  throw new Error(
    'Buscador del hub: grupos de sinónimos MUERTOS (ningún miembro aparece en el índice de ninguna card): ' +
      _huerfanos.map((g) => g.join('/')).join(' · ') +
      ' — arréglalo en astro-site/src/lib/sinonimos-buscador.json (quita el grupo o añade un alias).',
  );
}

// Contadores del badge del hero (VERBATIM products.length / comingSoon.length).
const productsCount = products.length;
const comingSoonCount = comingSoon.length;

// WhatsApp (paridad WhatsAppProductSupport.tsx).
