// FAQ VISIBLE (paridad líneas 1292-1300 de la SPA; \u escapes → UTF-8, copy correcto).
const faqs = [
  { q: '¿Qué formato tienen los productos digitales?', a: 'La mayoría son plantillas en formato Excel (.xlsx) compatibles con Microsoft Excel, Google Sheets, LibreOffice y Apple Numbers. También incluimos guías y fichas en formato PDF listas para imprimir. Todos los archivos se descargan desde tu dashboard privado.' },
  { q: '¿Cómo recibo los productos después de comprar?', a: 'El acceso es inmediato. Tras el pago con Stripe, te redirigimos a tu dashboard privado donde puedes descargar todos los archivos. Además, recibirás un email con un enlace mágico para acceder siempre que quieras.' },
  { q: '¿Puedo comprar desde fuera de España?', a: 'Sí. Los productos están en español y diseñados pensando en normativa española y europea, pero el contenido es aplicable a cualquier país hispanohablante. Puedes comprar desde cualquier parte del mundo con tarjeta, Apple Pay o Google Pay.' },
  { q: '¿Las plantillas incluyen fórmulas automáticas?', a: 'Sí. Todas las plantillas Excel vienen con fórmulas precargadas que calculan automáticamente: food cost, PVP sugerido, alertas de temperatura, control de mermas. Solo introduces tus datos y el Excel hace el resto.' },
  { q: '¿Hay garantía de devolución?', a: '30 días de garantía completa en todos los productos. Si no estás satisfecho, te devolvemos el 100% sin preguntas. Contacta a info@aichef.pro.' },
  { q: '¿Incluyen actualizaciones futuras?', a: 'Sí. Todos los productos incluyen acceso de por vida al dashboard online. Cuando añadamos nuevas plantillas, mejoras o actualicemos por cambios normativos, las recibirás sin coste adicional.' },
  { q: '¿Puedo usar las plantillas en varios restaurantes?', a: 'Sí. La licencia es personal — puedes usar las plantillas en todos los establecimientos que gestiones. Ideal para consultores, grupos de restauración y gerentes multi-unidad.' },
  { q: '¿Qué métodos de pago aceptan?', a: 'Procesamos pagos con Stripe, la plataforma de pagos más segura del mundo. Aceptamos tarjeta de crédito/débito (Visa, Mastercard, Amex), Apple Pay, Google Pay y Link (pago rápido de Stripe).' },
];

// pSEO cities cross-link (paridad líneas 1329-1339 de la SPA).
const cities = [
  { slug: 'madrid', label: 'Madrid' },
  { slug: 'barcelona', label: 'Barcelona' },
  { slug: 'valencia', label: 'Valencia' },
