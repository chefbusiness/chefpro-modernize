  .animate-ping { animation: pd-ping 1s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @keyframes pd-ping { 75%, 100% { transform: scale(2); opacity: 0; } }

  /* La X nativa de un input[type="search"] (Chrome/Safari) sobra: el buscador pinta la
     suya en #pd-search-clear y las dos se solapan en la esquina derecha del campo. */
  #pd-search-input::-webkit-search-cancel-button,
  #pd-search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
