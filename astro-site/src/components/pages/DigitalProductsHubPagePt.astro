// FAQ VISIBLE (y fuente del FAQPage JSON-LD).
const faqs = [
  { q: 'Em que formato estão os produtos digitais?', a: 'A maioria são modelos Excel (.xlsx) que funcionam no Microsoft Excel, Google Sheets, LibreOffice e Apple Numbers. Também incluímos guias e listas de verificação prontas para impressão em PDF. Descarregue todos os ficheiros a partir do seu painel privado.' },
  { q: 'Como recebo os produtos depois de comprar?', a: 'O acesso é instantâneo. Assim que pagar através da Stripe, será encaminhado para o seu painel privado, onde pode descarregar todos os ficheiros. Também recebe um e-mail com uma ligação mágica para poder voltar sempre que quiser.' },
  { q: 'Posso comprar de qualquer lugar do mundo?', a: 'Sim. Pode comprar de qualquer lugar com cartão, Apple Pay ou Google Pay. O catálogo atual está escrito em espanhol e foi concebido de acordo com os regulamentos espanhóis e da UE; as edições em português estão a caminho e aparecerão nesta página assim que cada uma estiver pronta.' },
  { q: 'Os modelos incluem fórmulas automáticas?', a: 'Sim. Todos os modelos Excel incluem fórmulas incorporadas que fazem as contas por si: custo alimentar, preço de ementa sugerido, alertas de temperatura e controlo de desperdício. Introduza os seus números e a folha de cálculo faz o resto.' },
  { q: 'Existe garantia de reembolso?', a: 'Todos os produtos incluem uma garantia total de 30 dias. Se não estiver satisfeito, reembolsamos 100%, sem perguntas. Basta escrever para info@aichef.pro.' },
  { q: 'As atualizações futuras estão incluídas?', a: 'Sim. Todos os produtos incluem acesso vitalício ao painel online. Quando adicionamos novos modelos, fazemos melhorias ou atualizamos devido a alterações regulamentares, recebe-os sem custo adicional.' },
  { q: 'Posso usar os modelos em mais do que um restaurante?', a: 'Sim. A licença é pessoal: pode utilizar os modelos em todos os espaços que gere. Ideal para consultores, grupos de restauração e gestores de múltiplas unidades.' },
  { q: 'Que métodos de pagamento aceitam?', a: 'Os pagamentos são processados pela Stripe, uma das plataformas de pagamento mais seguras do mundo. Aceitamos cartões de crédito e débito (Visa, Mastercard, Amex), Apple Pay, Google Pay e Link (checkout rápido da Stripe).' },
];

// pSEO cities (las guías por ciudad solo existen en español: se listan sin enlace).
const cities = [
  { slug: 'madrid', label: 'Madrid' },
  { slug: 'barcelona', label: 'Barcelona' },
  { slug: 'valencia', label: 'Valência' },
  { slug: 'ciudad-de-mexico', label: 'Cidade do México' },
  { slug: 'monterrey', label: 'Monterrey' },
  { slug: 'bogota', label: 'Bogotá' },
  { slug: 'medellin', label: 'Medellín' },
  { slug: 'buenos-aires', label: 'Buenos Aires' },
  { slug: 'santiago', label: 'Santiago' },
];

// ── JSON-LD (CollectionPage + FAQPage + BreadcrumbList, en portugués y sin ofertas ni rating) ──
const HUB_URL = 'https://aichef.pro/pt/produtos-digitais';
const collectionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Produtos Digitais para Restaurantes e Hotelaria — AI Chef Pro',
  description: 'Modelos Excel, guias HACCP, prompts de IA e ferramentas digitais para chefs, gestores de restaurantes e proprietários.',
  url: HUB_URL,
  inLanguage: 'pt',
  publisher: {
    '@type': 'Organization',
    name: 'AI Chef Pro',
    url: 'https://aichef.pro/pt',
  },
};
// El ItemList solo lista productos VIVOS en portugués (hoy ninguno → sin mainEntity).
if (liveCards.length) {
  collectionSchema.mainEntity = {
    '@type': 'ItemList',
    itemListElement: liveCards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://aichef.pro${c.href}`,
      name: c.name,
    })),
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'pt',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: 'https://aichef.pro/pt' },
    { '@type': 'ListItem', position: 2, name: 'Produtos Digitais', item: HUB_URL },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<div class="min-h-screen bg-[#0a0a0a]">
  {/* ===== SaasDiscoveryBanner ===== */}
  <div class="bg-gradient-to-r from-[#FFD700]/10 via-[#FFD700]/5 to-[#FFD700]/10 border-b border-[#FFD700]/20">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-2 sm:gap-3 text-center">
      <Icon name="Sparkles" class="h-3.5 w-3.5 text-[#FFD700] flex-shrink-0 hidden sm:block" />
      <p class="text-xs sm:text-sm text-gray-300">
        <span class="hidden sm:inline">Estes produtos digitais complementam a </span>
        <a href="/pt" class="font-semibold text-[#FFD700] hover:text-[#FFD700]/80 transition-colors">AI Chef Pro</a>
        <span class="hidden sm:inline"> — o SaaS de IA para restauração com 55+ ferramentas</span>
        <span class="sm:hidden"> — SaaS de IA para restauração</span>
      </p>
      <a href="/pt" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#FFD700]/15 border border-[#FFD700]/30 text-[#FFD700] text-xs font-semibold hover:bg-[#FFD700]/25 transition-colors whitespace-nowrap flex-shrink-0">
        Descobrir
        <Icon name="ArrowRight" class="h-3 w-3" />
      </a>
    </div>
  </div>

  {/* ===== Hero ===== */}
  <section class="relative px-4 pt-6 pb-12 md:pt-8 md:pb-16 overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,215,0,0.08) 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto text-center z-10">
      {/* LogoBadge (isHub → no back pill, just the white logo card) */}
      <div>
        <div class="flex justify-center py-6 md:py-8">
          <a href="/pt" class="inline-flex items-center px-6 py-3 bg-white rounded-2xl shadow-lg shadow-white/5 hover:shadow-white/10 transition-shadow">
            <img src="/logo-ai-chef-pro.svg" alt="AI Chef Pro" class="h-8 md:h-9 w-auto" />
          </a>
        </div>
      </div>
      <span class="inline-block mt-4 mb-6 px-4 py-1.5 rounded-full bg-[#FFD700]/10 border border-[#FFD700]/30 text-[#FFD700] text-sm font-medium">
        {productsCount} produtos · {comingSoonCount} em desenvolvimento
      </span>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        A Loja de Produtos <span class="text-[#FFD700]">Digitais</span> para a Restauração de Hoje
      </h1>

      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        eBooks, modelos Excel, guias de segurança alimentar e prompts de IA concebidos por e para profissionais da restauração. Download instantâneo, acesso vitalício.
      </p>
    </div>
  </section>

  {/* ===== Buscador (filtra las MISMAS cards que los chips; la lógica va en el script del final) =====
       El panel de «no hay resultados» NO vive aquí: está debajo del grid (#pd-search-empty).
       Si estuviera encima de los chips, aparecer y desaparecer al teclear empujaría chips y
       cards ~200 px arriba y abajo, y el clic sobre una card acabaría en otra cosa. */}
  <section id="pd-search-section" class="px-4 pb-6">
    <div class="max-w-2xl mx-auto" role="search">
      <label for="pd-search-input" class="sr-only">Pesquisar produtos por nome, tema ou tipo de negócio</label>
      {/* Descripción ESTÁTICA del campo, separada del contador a propósito: si el
          aria-describedby apuntara a la región viva, el lector de pantalla leería el
          conteo al enfocar Y otra vez en cada mutación (una por pausa de tecleo). */}
      <span id="pd-search-ayuda" class="sr-only">
        Escreva pelo menos duas letras. A lista filtra à medida que escreve; prima Escape para limpar a pesquisa.
      </span>

      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-[#FFD700]">
          <Icon name="Search" class="w-5 h-5" />
        </span>
        <input
          id="pd-search-input"
          type="search"
          maxlength="120"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-describedby="pd-search-ayuda"
          placeholder="Pesquisar por tema ou negócio: ficha técnica, HACCP, food truck…"
          class="w-full h-14 pl-5 pr-16 rounded-2xl bg-white/5 border-2 border-[#FFD700]/70 shadow-[0_0_24px_rgba(255,215,0,0.12)] text-white text-base placeholder:text-gray-400 outline-none transition-colors duration-200 focus:border-[#FFD700] focus:bg-white/[0.07] focus:ring-2 focus:ring-[#FFD700]/30"
        />
        <button
          id="pd-search-clear"
          type="button"
          aria-label="Limpar a pesquisa"
          class="hidden absolute inset-y-0 right-11 items-center pr-1 text-gray-500 hover:text-[#FFD700] transition-colors"
        >
          <Icon name="X" class="w-5 h-5" />
        </button>
      </div>

      {/* Contador VISIBLE (se actualiza al instante, sin aria-live) + región viva SOLO
          para lectores de pantalla, con su propio retardo: anunciar en cada pausa de
          tecleo encola avisos que se pisan unos a otros. */}
      <p id="pd-search-status" class="mt-2.5 text-center text-xs text-gray-500 break-words">
        {productsCount} produtos
      </p>
      <p id="pd-search-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>

  {/* ===== Tag Filter ===== */}
  <section class="px-4 pb-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap justify-center gap-2">
        {ALL_TAGS.map((tag) => (
          <button
            type="button"
            data-tag-btn
            data-tag={tag.id}
            class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 ${tag.id === 'all' ? 'bg-[#FFD700] text-black' : 'bg-white/5 text-gray-400 border border-white/10 hover:border-[#FFD700]/30 hover:text-white'}`}
          >
            {(tag as any).iconName && <Icon name={(tag as any).iconName} class="w-3.5 h-3.5 inline mr-1.5 -mt-0.5" />}
            {tag.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Products Grid — 3 columns (todas las cards en el DOM; JS pagina/filtra) ===== */}
  <section id="pd-products-section" class="px-4 pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((product, idx) => {
        const Card = product.href ? 'a' : 'div';
        const featured = (product as any).featured;
        const cls = product.href
          ? `group relative bg-white/[0.03] rounded-2xl overflow-hidden hover:bg-white/[0.05] transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 hover:border-emerald-400/70 ring-1 ring-emerald-500/20' : 'border border-white/10 hover:border-[#FFD700]/30'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`
