                    <Icon name="ArrowRight" class="w-3.5 h-3.5" />
                  </div>
                </>
              ) : (
                <span class="text-xs text-gray-500">Edição em português a caminho</span>
              )}
            </div>
          </div>
        </Card>
        );
      })}
