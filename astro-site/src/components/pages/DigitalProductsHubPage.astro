const PRODUCTS_PER_PAGE = 12;

// Etiqueta de un tag (los tags sin entrada en ALL_TAGS — 'bundle', 'production-kitchen', 'tapas'… —
// no renderizan pill, igual que en el hub ES).
const tagLabel = (id: string) => ALL_TAGS.find((t) => t.id === id)?.label;

// ── Tarjeta → producto EN vivo (FAMILIAS de lib/tienda.ts) ───────────────────────────
// Sin familia o con `en.vivo: false` → null: la tarjeta se pinta sin enlace ni precio y con el
// badge «Coming soon in English». Con familia viva → landing EN + precio USD (el que cobra el checkout).
const enVivo = (slugEs: string) => {
  const f = FAMILIAS.find((x) => x.productos.es?.slug === slugEs.replace(/^\//, ''));
  const en = f?.productos.en;
  return en && en.vivo ? en.slug : null;
};
const precioUsd = (id: string) => {
  const v = PRODUCT_PRICES[id]?.usd;
  return typeof v === 'number' ? `$${v}` : null;
};
const cards = products.map((p) => {
  const enSlug = enVivo(p.slug);
  return {
    ...p,
    enSlug,
    href: enSlug ? tiendaProductoPath('en', enSlug) : null,
    price: enSlug ? precioUsd(enSlug) : null,
  };
});
const liveCards = cards.filter((c) => c.href);

// ── Buscador: índice de texto por card (data-search) ────────────────────────────────
// Misma normalización que el hub ES (indiceBusqueda). Sin el slug ES ni sus alias en español.
const indiceProducto = (p: { name: string; description: string; features: string[]; tags: string[] }) =>
  indiceBusqueda([p.name, p.description, ...p.features, ...p.tags, ...p.tags.map(tagLabel)]);

// Contadores del badge del hero.
const productsCount = products.length;
const comingSoonCount = comingSoon.length;

// WhatsApp (mismo número que el hub ES; mensaje prerellenado en inglés).
const waPhone = '34744717942';
const waMessage = encodeURIComponent('Hi, I need help with my AI Chef Pro purchase. ');
const waUrl = `https://wa.me/${waPhone}?text=${waMessage}`;

// Worldwide countries.
const countries = ['Spain', 'Mexico', 'Colombia', 'Argentina', 'Chile', 'Peru', 'Ecuador', 'USA', 'Germany', 'France'];

// FAQ VISIBLE (y fuente del FAQPage JSON-LD).
const faqs = [
  { q: 'What format are the digital products in?', a: 'Most are Excel templates (.xlsx) that work in Microsoft Excel, Google Sheets, LibreOffice and Apple Numbers. We also include print-ready guides and checklists in PDF. You download every file from your private dashboard.' },
  { q: 'How do I get the products after I buy?', a: 'Access is instant. Once you pay through Stripe, we take you to your private dashboard, where you can download every file. You also get an email with a magic link so you can come back whenever you like.' },
  { q: 'Can I buy from anywhere in the world?', a: 'Yes. You can buy from anywhere with a card, Apple Pay or Google Pay. The current catalog is written in Spanish and built around Spanish and EU regulations; the English editions are on their way and will appear on this page as each one is ready.' },
  { q: 'Do the templates include automatic formulas?', a: 'Yes. Every Excel template comes with built-in formulas that do the math for you: food cost, suggested menu price, temperature alerts and waste tracking. You enter your numbers and the spreadsheet does the rest.' },
  { q: 'Is there a money-back guarantee?', a: 'Every product comes with a full 30-day guarantee. If you are not happy, we refund 100%, no questions asked. Just write to info@aichef.pro.' },
  { q: 'Are future updates included?', a: 'Yes. Every product includes lifetime access to the online dashboard. When we add new templates, make improvements or update for regulatory changes, you get them at no extra cost.' },
  { q: 'Can I use the templates in more than one restaurant?', a: 'Yes. The license is personal: you can use the templates in every venue you manage. Ideal for consultants, restaurant groups and multi-unit managers.' },
  { q: 'What payment methods do you accept?', a: 'Payments are processed by Stripe, one of the most secure payment platforms in the world. We accept credit and debit cards (Visa, Mastercard, Amex), Apple Pay, Google Pay and Link (Stripe fast checkout).' },
];

// pSEO cities (las guías por ciudad solo existen en español: se listan sin enlace).
const cities = [
  { slug: 'madrid', label: 'Madrid' },
  { slug: 'barcelona', label: 'Barcelona' },
  { slug: 'valencia', label: 'Valencia' },
  { slug: 'ciudad-de-mexico', label: 'Mexico City' },
  { slug: 'monterrey', label: 'Monterrey' },
  { slug: 'bogota', label: 'Bogota' },
  { slug: 'medellin', label: 'Medellin' },
  { slug: 'buenos-aires', label: 'Buenos Aires' },
  { slug: 'santiago', label: 'Santiago' },
];

// ── JSON-LD (CollectionPage + FAQPage + BreadcrumbList, en inglés y sin ofertas ni rating) ──
const HUB_URL = 'https://aichef.pro/en/digital-products';
const collectionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Digital Products for Restaurants and Hospitality — AI Chef Pro',
  description: 'Excel templates, HACCP guides, AI prompts and digital tools for chefs, restaurant managers and owners.',
  url: HUB_URL,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'AI Chef Pro',
    url: 'https://aichef.pro/en',
  },
};
// El ItemList solo lista productos VIVOS en inglés (hoy ninguno → sin mainEntity).
if (liveCards.length) {
  collectionSchema.mainEntity = {
    '@type': 'ItemList',
    itemListElement: liveCards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://aichef.pro${c.href}`,
      name: c.name,
    })),
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: 'https://aichef.pro/en' },
    { '@type': 'ListItem', position: 2, name: 'Digital Products', item: HUB_URL },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<div class="min-h-screen bg-[#0a0a0a]">
  {/* ===== SaasDiscoveryBanner ===== */}
  <div class="bg-gradient-to-r from-[#FFD700]/10 via-[#FFD700]/5 to-[#FFD700]/10 border-b border-[#FFD700]/20">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-2 sm:gap-3 text-center">
      <Icon name="Sparkles" class="h-3.5 w-3.5 text-[#FFD700] flex-shrink-0 hidden sm:block" />
      <p class="text-xs sm:text-sm text-gray-300">
        <span class="hidden sm:inline">These digital products complement </span>
        <a href="/en" class="font-semibold text-[#FFD700] hover:text-[#FFD700]/80 transition-colors">AI Chef Pro</a>
        <span class="hidden sm:inline"> — the AI SaaS for hospitality with 55+ apps</span>
        <span class="sm:hidden"> — AI SaaS for hospitality</span>
      </p>
      <a href="/en" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#FFD700]/15 border border-[#FFD700]/30 text-[#FFD700] text-xs font-semibold hover:bg-[#FFD700]/25 transition-colors whitespace-nowrap flex-shrink-0">
        Discover
        <Icon name="ArrowRight" class="h-3 w-3" />
      </a>
    </div>
  </div>

  {/* ===== Hero ===== */}
  <section class="relative px-4 pt-6 pb-12 md:pt-8 md:pb-16 overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,215,0,0.08) 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto text-center z-10">
      {/* LogoBadge (isHub → no back pill, just the white logo card) */}
      <div>
        <div class="flex justify-center py-6 md:py-8">
          <a href="/en" class="inline-flex items-center px-6 py-3 bg-white rounded-2xl shadow-lg shadow-white/5 hover:shadow-white/10 transition-shadow">
            <img src="/logo-ai-chef-pro.svg" alt="AI Chef Pro" class="h-8 md:h-9 w-auto" />
          </a>
        </div>
      </div>
      <span class="inline-block mt-4 mb-6 px-4 py-1.5 rounded-full bg-[#FFD700]/10 border border-[#FFD700]/30 text-[#FFD700] text-sm font-medium">
        {productsCount} products · {comingSoonCount} in development
      </span>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        The <span class="text-[#FFD700]">Digital</span> Products Store for Today&rsquo;s Hospitality
      </h1>

      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        eBooks, Excel templates, food safety guides and AI prompts designed by and for hospitality professionals. Instant download, lifetime access.
      </p>
    </div>
  </section>

  {/* ===== Buscador (filtra las MISMAS cards que los chips; la lógica va en el script del final) =====
       El panel de «no hay resultados» NO vive aquí: está debajo del grid (#pd-search-empty).
       Si estuviera encima de los chips, aparecer y desaparecer al teclear empujaría chips y
       cards ~200 px arriba y abajo, y el clic sobre una card acabaría en otra cosa. */}
  <section id="pd-search-section" class="px-4 pb-6">
    <div class="max-w-2xl mx-auto" role="search">
      <label for="pd-search-input" class="sr-only">Search products by name, topic or type of business</label>
      {/* Descripción ESTÁTICA del campo, separada del contador a propósito: si el
          aria-describedby apuntara a la región viva, el lector de pantalla leería el
          conteo al enfocar Y otra vez en cada mutación (una por pausa de tecleo). */}
      <span id="pd-search-ayuda" class="sr-only">
        Type at least two letters. The list filters as you type; press Escape to clear the search.
      </span>

      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-[#FFD700]">
          <Icon name="Search" class="w-5 h-5" />
        </span>
        <input
          id="pd-search-input"
          type="search"
          maxlength="120"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-describedby="pd-search-ayuda"
          placeholder="Search by topic or business: recipe costing, HACCP, food truck…"
          class="w-full h-14 pl-5 pr-16 rounded-2xl bg-white/5 border-2 border-[#FFD700]/70 shadow-[0_0_24px_rgba(255,215,0,0.12)] text-white text-base placeholder:text-gray-400 outline-none transition-colors duration-200 focus:border-[#FFD700] focus:bg-white/[0.07] focus:ring-2 focus:ring-[#FFD700]/30"
        />
        <button
          id="pd-search-clear"
          type="button"
          aria-label="Clear the search"
          class="hidden absolute inset-y-0 right-11 items-center pr-1 text-gray-500 hover:text-[#FFD700] transition-colors"
        >
          <Icon name="X" class="w-5 h-5" />
        </button>
      </div>

      {/* Contador VISIBLE (se actualiza al instante, sin aria-live) + región viva SOLO
          para lectores de pantalla, con su propio retardo: anunciar en cada pausa de
          tecleo encola avisos que se pisan unos a otros. */}
      <p id="pd-search-status" class="mt-2.5 text-center text-xs text-gray-500 break-words">
        {productsCount} products
      </p>
      <p id="pd-search-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>

  {/* ===== Tag Filter ===== */}
  <section class="px-4 pb-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap justify-center gap-2">
        {ALL_TAGS.map((tag) => (
          <button
            type="button"
            data-tag-btn
            data-tag={tag.id}
            class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 ${tag.id === 'all' ? 'bg-[#FFD700] text-black' : 'bg-white/5 text-gray-400 border border-white/10 hover:border-[#FFD700]/30 hover:text-white'}`}
          >
            {(tag as any).iconName && <Icon name={(tag as any).iconName} class="w-3.5 h-3.5 inline mr-1.5 -mt-0.5" />}
            {tag.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Products Grid — 3 columns (todas las cards en el DOM; JS pagina/filtra) ===== */}
  <section id="pd-products-section" class="px-4 pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((product, idx) => {
        const Card = product.href ? 'a' : 'div';
        const featured = (product as any).featured;
        const cls = product.href
          ? `group relative bg-white/[0.03] rounded-2xl overflow-hidden hover:bg-white/[0.05] transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 hover:border-emerald-400/70 ring-1 ring-emerald-500/20' : 'border border-white/10 hover:border-[#FFD700]/30'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`
          : `relative bg-white/[0.03] rounded-2xl overflow-hidden transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 ring-1 ring-emerald-500/20' : 'border border-white/10'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`;
        return (
        <Card
          href={product.href ?? undefined}
          target={product.href ? '_blank' : undefined}
          rel={product.href ? 'noopener noreferrer' : undefined}
          data-product
          data-en-live={product.href ? 'true' : 'false'}
          data-tags={product.tags.join(' ')}
          data-search={indiceProducto(product)}
          class={cls}
        >
          {/* Badge */}
          <div class="absolute top-3 right-3 z-10">
            {product.href ? (
              <span class={`px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm ${product.badgeColor}`}>
                {product.badge}
              </span>
            ) : (
              <span class="px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm bg-[#FFD700]/15 text-[#FFD700] ring-1 ring-[#FFD700]/30">Coming soon in English</span>
            )}
          </div>

          {/* Image */}
          <div class="relative h-40 overflow-hidden bg-gradient-to-b from-white/[0.05] to-transparent">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
          </div>

          {/* Content */}
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-9 h-9 rounded-xl bg-[#FFD700]/10 flex items-center justify-center flex-shrink-0">
                <Icon name={product.iconName} class="w-4.5 h-4.5 text-[#FFD700]" />
              </div>
              <h2 class="text-lg md:text-base lg:text-lg font-bold text-white group-hover:text-[#FFD700] transition-colors leading-tight">
                {product.name}
              </h2>
            </div>

            <p class="text-gray-400 text-sm leading-relaxed mb-4">
              {product.description}
            </p>

            {/* Features */}
            <ul class="space-y-1.5 mb-5 flex-1">
              {product.features.map((feature) => (
                <li class="flex items-start gap-2 text-xs text-gray-300">
                  <Icon name="Check" class="w-3.5 h-3.5 text-[#FFD700] flex-shrink-0 mt-0.5" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            {/* Tags */}
            <div class="flex flex-wrap gap-1.5 mb-4">
              {product.tags.map((tagId) => {
                const label = tagLabel(tagId);
                return label ? (
                  <span class="px-2 py-0.5 rounded-full bg-white/5 text-gray-500 text-[10px] font-medium">
                    {label}
                  </span>
                ) : null;
              })}
            </div>

            {/* Price + CTA (solo con producto vivo en EN: precio USD, sin tachado ni descuento) */}
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
              {product.href ? (
                <>
                  <div class="flex items-center gap-2">
                    {product.price && <span class="text-2xl font-extrabold text-[#FFD700]">{product.price}</span>}
                  </div>
                  <div class="flex items-center gap-1 text-[#FFD700] text-xs font-medium group-hover:gap-2 transition-all">
                    View
                    <Icon name="ArrowRight" class="w-3.5 h-3.5" />
                  </div>
                </>
              ) : (
                <span class="text-xs text-gray-500">English edition in progress</span>
              )}
            </div>
          </div>
        </Card>
        );
      })}
    </div>

    {/* Cargar más */}
    <div id="pd-loadmore-block" class="max-w-6xl mx-auto mt-10 flex flex-col items-center gap-3">
      <button
        id="pd-loadmore-btn"
        type="button"
        class="px-8 py-3 rounded-full bg-[#FFD700]/10 border border-[#FFD700]/30 text-[#FFD700] text-sm font-semibold hover:bg-[#FFD700]/20 hover:border-[#FFD700]/60 transition-all duration-200"
      >Load more products ({productsCount - PRODUCTS_PER_PAGE} remaining)</button>
      <p id="pd-showing-line" class="text-xs text-gray-500">
        Showing {PRODUCTS_PER_PAGE} of {productsCount}
      </p>
    </div>
  </section>

  {/* ===== Búsqueda con resultados FUERA del chip activo =====
       El 0 lo provoca el filtro de categoría, no el catálogo: el producto existe y está a
       un clic. Enseñar aquí la captación de demanda sería perder la venta Y registrar un
       hueco falso en el informe (medido: 66 combinaciones chip×consulta caían ahí). */}
  <section id="pd-search-fuera" class="hidden px-4 pb-16 md:pb-24">
    <div class="max-w-2xl mx-auto rounded-2xl border border-[#FFD700]/25 bg-[#FFD700]/[0.04] p-6 text-center">
      <p id="pd-search-fuera-txt" class="text-white font-semibold mb-4 break-words"></p>
      <button
        id="pd-search-fuera-btn"
        type="button"
        class="px-5 py-2.5 rounded-full bg-[#FFD700] text-black text-sm font-semibold hover:bg-[#FFD700]/90 transition-colors"
      >
        Search all categories
      </button>
    </div>
  </section>

  {/* ===== Sin resultados DE BÚSQUEDA (el panel del filtro por tag sigue siendo #pd-noresults) =====
       Va debajo del grid a propósito: encima de los chips empujaría toda la página al teclear. */}
  <section id="pd-search-empty" class="hidden px-4 pb-16 md:pb-24">
    <div class="max-w-2xl mx-auto rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-center">
      <p class="text-white font-semibold mb-1.5 break-words">
        We don&rsquo;t have anything (yet) for &ldquo;<span id="pd-search-empty-q" class="text-[#FFD700] break-all"></span>&rdquo;
      </p>
      <p class="text-gray-500 text-sm mb-5">
        Tell us what you need and we will keep it in mind for upcoming products.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <button
          id="pd-ask-toggle"
          type="button"
          class="px-5 py-2.5 rounded-full bg-[#FFD700] text-black text-sm font-semibold hover:bg-[#FFD700]/90 transition-colors"
        >
          Tell us what you were looking for
        </button>
        <a
          id="pd-wa-empty"
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/5 border border-white/10 text-gray-300 text-sm font-medium hover:border-[#FFD700]/30 hover:text-white transition-colors"
        >
          <Icon name="MessageSquare" class="w-4 h-4" />
          Message us on WhatsApp
        </a>
      </div>

      {/* Salidas secundarias: quien no encuentra un producto todavía puede encontrar valor
          (y volver). Un callejón sin salida es tráfico tirado. */}
      <p class="mt-5 text-xs text-gray-500">
        In the meantime:
        <button id="pd-ver-todos" type="button" class="underline hover:text-[#FFD700] transition-colors">see the full catalog</button>
        <span class="mx-1.5 text-gray-700">·</span>
        <a href="/en/prompt-libraries" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#FFD700] transition-colors">prompt libraries</a>
        <span class="mx-1.5 text-gray-700">·</span>
        <a href="/en/blog" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#FFD700] transition-colors">blog</a>
      </p>

      <div id="pd-ask-form" class="hidden mt-5 text-left">
        <label for="pd-ask-detalle" class="block text-xs text-gray-400 mb-1.5">What exactly do you need? (optional)</label>
        <textarea
          id="pd-ask-detalle"
          rows="3"
          maxlength="500"
          aria-describedby="pd-ask-hint"
          placeholder="E.g. a tip-tracking template for a tapas bar"
          class="w-full rounded-xl bg-white/5 border border-white/10 text-white text-base p-3 outline-none transition-colors placeholder:text-gray-400 focus:border-[#FFD700]/60"
        ></textarea>

        <label for="pd-ask-email" class="block text-xs text-gray-400 mt-3 mb-1.5">Your email, if you want us to let you know (optional)</label>
        <input
          id="pd-ask-email"
          type="email"
          maxlength="120"
          autocomplete="email"
          aria-describedby="pd-ask-hint"
          placeholder="yourname@yourrestaurant.com"
          class="w-full h-11 rounded-xl bg-white/5 border border-white/10 text-white text-base px-3 outline-none transition-colors placeholder:text-gray-400 focus:border-[#FFD700]/60"
        />

        {/* Honeypot REAL: el comentario de log-search.ts decía que el formulario lo pintaba
            y no existía. Ninguna persona lo ve ni lo rellena; si llega con algo, el backend
            responde 204 y no escribe nada. */}
        <input
          type="text"
          id="pd-ask-website"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="hidden"
        />

        <p id="pd-ask-hint" role="alert" class="hidden mt-2 text-xs text-[#FFD700]">
          Tell us what you need or leave your email so we can let you know.
        </p>

        <button
          id="pd-ask-send"
          type="button"
          class="mt-3 px-5 py-2.5 rounded-full bg-[#FFD700] text-black text-sm font-semibold hover:bg-[#FFD700]/90 transition-colors"
        >
          Send
        </button>

        {/* Dato personal: finalidad, uso y política, junto al campo que lo pide. */}
        <p class="mt-2.5 text-xs text-gray-500">
          We only use your email to let you know if we launch this product; we never share it and we never
          add you to any list. <a href="/en/privacidad" target="_blank" rel="noopener noreferrer" class="underline hover:text-[#FFD700] transition-colors">Privacy policy</a>.
        </p>
      </div>

      <p id="pd-ask-thanks" role="status" tabindex="-1" class="hidden mt-5 text-sm text-[#FFD700] font-medium outline-none">
        Thanks, we will keep it in mind.
      </p>
    </div>
  </section>

  {/* ===== Coming Soon ===== */}
  {/* D6: sin productos en cola, la sección no se sirve (paridad con la SPA, ProductosDigitales.tsx:1265). */}
  {comingSoon.length > 0 && (
    <section id="pd-coming-section" class="px-4 pb-16 md:pb-24">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-8">
          <span class="inline-block mb-4 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-gray-400 text-sm font-medium">
            <Icon name="Clock" class="w-4 h-4 inline mr-2" />
            In Development
          </span>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">
            Upcoming <span class="text-[#FFD700]">Products</span>
          </h2>
          <p class="text-gray-500 text-sm max-w-2xl mx-auto">
            Same quality standard: instant access, lifetime updates and a 30-day guarantee.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {comingSoon.map((item) => (
            <div
              data-coming
              data-tags={item.tags.join(' ')}
