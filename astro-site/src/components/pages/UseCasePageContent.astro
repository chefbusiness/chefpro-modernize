            </div>

            <div class={`${BADGE_DEFAULT} mb-6 text-sm px-4 py-2`}>{content.badge}</div>
            <div class={`w-20 h-20 ${theme.bg} rounded-2xl flex items-center justify-center mx-auto mb-6`}>
              <Icon name={uc.iconKey} class={`h-10 w-10 ${theme.text}`} />
            </div>
            <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl mb-6 text-balance">
              {content.h1}
            </h1>
            <p class="text-xl text-muted-foreground mb-4 max-w-3xl mx-auto text-balance" set:html={linkifyHtml(content.heroSubtitle, APP_URL)} />
            <p class={`text-lg font-semibold ${theme.text} mb-10`}>{content.heroTagline}</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href={APP_URL} target="_blank" rel="noopener noreferrer" class={btnGoldLg}>
                {ui.ctaPrimary} <Icon name="ArrowRight" class="ml-2 h-5 w-5" />
              </a>
              <a href={APP_URL} target="_blank" rel="noopener noreferrer" class={btnOutlineLg}>
                {ui.ctaSeePlans}
              </a>
            </div>
            <p class="text-sm text-muted-foreground mt-4">{ui.ctaFreeUses}</p>
          </div>
        </div>
      </section>

      {/* Authority — solo Consultoría Gastro Pro */}
      {type === 'consultor' && <AuthorityBackedBy lang={lang} />}

      {/* Gallery — opcional */}
      {content.galleryImages && content.galleryImages.length > 0 && (
        <section class="py-20 bg-muted/30">
          <div class="container mx-auto px-4">
            <div class="text-center mb-10 max-w-3xl mx-auto">
              {content.galleryTitle && <h2 class="text-3xl font-bold text-foreground mb-3">{content.galleryTitle}</h2>}
              {content.gallerySubtitle && <p class="text-muted-foreground">{content.gallerySubtitle}</p>}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto">
              {content.galleryImages.map((src, i) => (
                <div class="relative aspect-[16/10] overflow-hidden rounded-xl shadow-md hover:shadow-xl transition-shadow group">
                  <img
                    src={src}
                    alt={`${content.h1} — ${ui.galleryAltSuffix.replace('%N', String(i + 1))}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
            </div>
          </div>
          <ImageDisclaimerNote variant="gallery" lang={lang} />
        </section>
      )}

      {/* Personalization (¿Quién Soy?) — opcional */}
      {content.personalizationTitle && content.personalizationBody && (
        <section class={`py-16 bg-gradient-to-br ${theme.gradient} border-b`}>
          <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
              <div class={`${CARD} border-2 ${theme.border} shadow-xl`}>
                <div class={`${CARD_CONTENT} pt-10 pb-10 px-8 md:px-12`}>
                  <div class="flex items-start gap-6">
                    <div class={`hidden md:flex w-16 h-16 ${theme.bg} rounded-2xl items-center justify-center flex-shrink-0`}>
                      <Icon name="MessageSquare" class={`h-8 w-8 ${theme.text}`} />
                    </div>
                    <div>
                      <div class={`${BADGE_DEFAULT} mb-3 text-xs`}>{ui.onboardingBadge}</div>
                      <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-4 text-balance">{content.personalizationTitle}</h2>
                      <p class="text-base md:text-lg text-muted-foreground leading-relaxed" set:html={linkifyHtml(content.personalizationBody, APP_URL)} />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* Métricas — opcional */}
      {content.metrics && content.metrics.length > 0 && (
        <section class="py-16 bg-gradient-to-r from-primary/90 to-primary">
          <div class="container mx-auto px-4">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 max-w-5xl mx-auto text-center">
              {content.metrics.map((m) => (
                <div>
                  <div class="text-4xl md:text-5xl font-bold text-white mb-2">{m.value}</div>
                  <div class="text-sm text-primary-foreground/80">{m.label}</div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Pains */}
      <section class="py-20">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12 max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-foreground mb-4">{content.painsTitle}</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
            {content.pains.map((pain, i) => (
              <div class={`${CARD} border-2 ${theme.border} shadow-md`}>
                <div class={`${CARD_CONTENT} pt-6 flex items-start gap-3`}>
                  <div class={`w-8 h-8 ${theme.bg} rounded-lg flex items-center justify-center flex-shrink-0`}>
                    <span class={`font-bold ${theme.text}`}>{i + 1}</span>
                  </div>
                  <p class="text-foreground">{pain}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Features */}
      <section class="py-20 bg-muted/30">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12 max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-foreground mb-4">{content.featuresTitle}</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {content.features.map((feature) => (
              <div class={`${CARD} border-none shadow-lg hover:shadow-xl transition-shadow`}>
                <div class={CARD_HEADER}>
                  <div class={`w-14 h-14 ${theme.bg} rounded-xl flex items-center justify-center mb-4`}>
                    <Icon name={feature.icon} class={`h-7 w-7 ${theme.text}`} />
                  </div>
                  <h3 class={`${CARD_TITLE} text-xl`} set:html={linkifyHtml(feature.title, APP_URL)} />
                </div>
                <div class={CARD_CONTENT}>
                  <p class="text-muted-foreground" set:html={linkifyHtml(feature.description, APP_URL)} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Apps destacadas — opcional */}
      {content.apps && content.apps.length > 0 && (
        <section class="py-20">
          <div class="container mx-auto px-4">
            <div class="text-center mb-12 max-w-3xl mx-auto">
              <h2 class="text-3xl font-bold text-foreground mb-4">{content.appsTitle || ui.defaultAppsTitle}</h2>
              <p class="text-muted-foreground">{ui.appsSubtitle}</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto">
              {content.apps.map((app) => (
                <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="block group">
                  <div class={`${CARD} h-full border-l-4 ${theme.border} shadow-sm hover:shadow-lg hover:border-primary transition-all`} style="border-left-color: currentColor;">
                    <div class={`${CARD_CONTENT} pt-5 pb-5`}>
                      <div class="flex items-start justify-between gap-3 mb-2">
                        <h3 class={`font-bold text-base leading-tight ${theme.text} group-hover:underline`}>{app.name}</h3>
                        <Icon name="ArrowRight" class={`h-4 w-4 ${theme.text} flex-shrink-0 mt-1 opacity-60 group-hover:opacity-100 group-hover:translate-x-1 transition-transform`} />
                      </div>
                      <div class={`${BADGE_SECONDARY} text-xs mb-2`}>{app.category}</div>
                      <p class="text-sm text-muted-foreground leading-snug" set:html={linkifyHtml(app.description, APP_URL)} />
                    </div>
                  </div>
                </a>
              ))}
            </div>
            <div class="text-center mt-10">
              <a href={APP_URL} target="_blank" rel="noopener noreferrer" class={btnGoldLg}>
                {ui.seeAllAppsBtn} <Icon name="ArrowRight" class="ml-2 h-4 w-4" />
              </a>
            </div>
          </div>
        </section>
      )}

      {/* Workflow */}
      <section class="py-20">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12 max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-foreground mb-4">{content.workflowTitle}</h2>
          </div>
          <div class="max-w-3xl mx-auto space-y-4">
            {content.workflow.map((step, i) => (
              <div class={`${CARD} border-l-4 shadow-sm`} style="border-left-color: currentColor;">
                <div class={`${CARD_CONTENT} pt-6 flex items-start gap-4`}>
                  <div class={`w-10 h-10 rounded-full ${theme.bg} flex items-center justify-center font-bold ${theme.text} flex-shrink-0`}>
                    {i + 1}
                  </div>
                  <p class="text-foreground pt-1" set:html={linkifyHtml(step, APP_URL)} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Antes vs Después — opcional */}
      {content.beforeAfter && (
        <section class="py-20 bg-muted/30">
          <div class="container mx-auto px-4">
            <div class="text-center mb-12 max-w-3xl mx-auto">
              <h2 class="text-3xl font-bold text-foreground mb-4">{ui.beforeAfterTitle}</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
              <div class={`${CARD} border-2 border-red-200 shadow-md`}>
                <div class={CARD_HEADER}>
                  <h3 class={`${CARD_TITLE} text-xl flex items-center gap-2 text-red-700`}>
                    <Icon name="X" class="h-5 w-5" /> {content.beforeAfter.beforeTitle}
                  </h3>
                </div>
                <div class={CARD_CONTENT}>
                  <ul class="space-y-3">
                    {content.beforeAfter.beforeItems.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-muted-foreground">
                        <Icon name="X" class="h-4 w-4 text-red-500 flex-shrink-0 mt-0.5" />
                        <span set:html={linkifyHtml(item, APP_URL)} />
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class={`${CARD} border-2 border-emerald-200 shadow-md`}>
                <div class={CARD_HEADER}>
                  <h3 class={`${CARD_TITLE} text-xl flex items-center gap-2 text-emerald-700`}>
                    <Icon name="Check" class="h-5 w-5" /> {content.beforeAfter.afterTitle}
                  </h3>
                </div>
                <div class={CARD_CONTENT}>
                  <ul class="space-y-3">
                    {content.beforeAfter.afterItems.map((item) => (
                      <li class="flex items-start gap-2 text-sm text-foreground">
                        <Icon name="Check" class="h-4 w-4 text-emerald-600 flex-shrink-0 mt-0.5" />
                        <span set:html={linkifyHtml(item, APP_URL)} />
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* Productos recomendados */}
      <section class="py-20 bg-muted/30">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12 max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-foreground mb-4">{content.productsTitle}</h2>
            <p class="text-muted-foreground">{ui.productsSubtitle}</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {products.map((p) => (
              <a href={p.url} class="block">
                <div class={`${CARD} h-full border-2 hover:border-primary transition-colors shadow-md hover:shadow-lg`}>
                  <div class={CARD_HEADER}>
                    <div class="flex justify-between items-start mb-2">
                      <h3 class={`${CARD_TITLE} text-lg`}>{p.name}</h3>
                      <div class={`${BADGE_SECONDARY} ml-2`}>{p.price}</div>
                    </div>
                  </div>
                  <div class={CARD_CONTENT}>
                    <p class="text-muted-foreground text-sm mb-4">{p.description}</p>
                    <div class="flex items-center text-primary text-sm font-semibold">
                      {ui.productCardCta} <Icon name="ArrowRight" class="ml-1 h-4 w-4" />
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
          <div class="text-center mt-12">
            <a href={productsHubHref} class={btnOutlineLg}>
              {ui.seeAllProductsBtn} <Icon name="ArrowRight" class="ml-2 h-4 w-4" />
            </a>
          </div>
        </div>
      </section>

      {/* Testimonio */}
      <section class="py-20">
        <div class="container mx-auto px-4">
          <div class={`${CARD} max-w-3xl mx-auto border-2 ${theme.border} shadow-xl`}>
            <div class={`${CARD_CONTENT} pt-10 pb-10 text-center`}>
              <Icon name="Sparkles" class={`h-10 w-10 ${theme.text} mx-auto mb-4`} />
              <p class="text-xl text-foreground italic mb-6 text-balance">"{content.testimonialQuote}"</p>
              <div>
                <p class="font-bold text-foreground">{content.testimonialAuthor}</p>
                <p class="text-sm text-muted-foreground">{content.testimonialRole}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* FAQ */}
      <section class="py-20 bg-muted/30">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12 max-w-3xl mx-auto">
            <h2 class="text-3xl font-bold text-foreground mb-4">{content.faqTitle}</h2>
          </div>
          <div class="max-w-3xl mx-auto space-y-4">
            {content.faqs.map((faq) => (
              <div class={`${CARD} shadow-sm`}>
                <div class={`${CARD_CONTENT} pt-6`}>
                  <h3 class="font-bold text-lg text-foreground mb-2">{faq.q}</h3>
                  <p class="text-muted-foreground" set:html={linkifyHtml(faq.a, APP_URL)} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Spokes hermanos */}
      {siblingUseCases.length > 0 && (
        <section class="py-20">
          <div class="container mx-auto px-4">
            <div class="text-center mb-12">
              <h2 class="text-2xl font-bold text-foreground mb-2">{siblingHeading}</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
              {siblingUseCases.map((sib) => {
                const sibContent = sib.content[lang] || sib.content.es;
                const sibTheme = COLOR_THEMES[sib.colorTheme] || COLOR_THEMES.amber;
                return (
                  <a href={useCasePath(sib, lang)}>
                    <div class={`${CARD} h-full hover:shadow-lg transition-shadow`}>
                      <div class={CARD_HEADER}>
                        <div class={`w-12 h-12 ${sibTheme.bg} rounded-xl flex items-center justify-center mb-3`}>
                          <Icon name={sib.iconKey} class={`h-6 w-6 ${sibTheme.text}`} />
                        </div>
                        <h3 class={`${CARD_TITLE} text-lg`}>{sibContent.h1}</h3>
                      </div>
                      <div class={CARD_CONTENT}>
                        <p class="text-sm text-muted-foreground">{sibContent.heroTagline}</p>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* CTA final */}
      <section class={`py-20 bg-gradient-to-br ${theme.gradient}`}>
        <div class="container mx-auto px-4 text-center">
          <h2 class="text-3xl lg:text-4xl font-bold text-foreground mb-4 text-balance">{content.ctaTitle}</h2>
          <p class="text-lg text-muted-foreground mb-8 max-w-2xl mx-auto">{content.ctaSubtitle}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={APP_URL} target="_blank" rel="noopener noreferrer" class={btnGoldLg}>
              {ui.ctaPrimary} <Icon name="ArrowRight" class="ml-2 h-5 w-5" />
            </a>
            {type === 'consultor' ? (
              <a href={consultorHubPath(lang)} class={btnOutlineLg}>
                <Icon name="Sparkles" class="mr-2 h-4 w-4" /> {ui.consultorHubCta}
              </a>
            ) : (
              <a href={hubPath(lang)} class={btnOutlineLg}>
                <Icon name="CheckCircle" class="mr-2 h-4 w-4" /> {ui.finalCtaSeeAllUseCases}
              </a>
            )}
          </div>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
    <WhatsAppFloatingButton lang={lang} />
  </div>
</BaseLayout>
