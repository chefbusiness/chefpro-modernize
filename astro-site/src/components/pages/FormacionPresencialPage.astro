<script is:inline>
  // Réplica del submit FALSO de la SPA (react-hook-form: setTimeout 1s -> toast -> reset).
  // Sin backend: preventDefault, deshabilita el botón 1s, muestra aviso y resetea el form.
  (function () {
    var form = document.getElementById('formacion-contact-form');
    if (!form) return;
    var status = document.getElementById('formacion-form-status');
    var btn = document.getElementById('formacion-submit-btn');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (btn) btn.setAttribute('disabled', 'disabled');
      setTimeout(function () {
        if (status) status.classList.remove('hidden');
        form.reset();
        if (btn) btn.removeAttribute('disabled');
      }, 1000);
    });
  })();
</script>
