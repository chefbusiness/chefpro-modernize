// FormacionPresencialPage.astro — port 1:1 de src/pages/FormacionPresencial.tsx (la SPA es la spec).
// SOLO español: la SPA hardcodea TODO el copy en español (no usa i18n en el cuerpo ni en el SEOHead),
// por lo que aquí se reproduce el mismo texto literal (no se traduce ni se inventa nada).
//
// Interactividad de la SPA reproducida con el patrón establecido (mentoria):
//   - Botones "scroll to" (scrollToForm / #servicios) -> <a href="#ancla"> nativo.
//   - shadcn Button/Card/Badge inlineados con las clases YA resueltas por twMerge (cn) que la SPA
//     emite en el DOM (los estilos por defecto cuentan; los overrides del call site ganan).
//   - Radix Accordion -> <details name> nativo single-open + chevron con group-open:rotate-180.
//   - Radix Select -> <select> nativo con las clases del SelectTrigger.
//   - react-hook-form + zod + toast (submit FALSO en la SPA: setTimeout + toast + reset, sin backend)
//     -> <form> nativo + script inline mínimo que replica el efecto (preventDefault, aviso, reset).
//   - iconos lucide-react inline sin client: (mismo patrón que AIImageGallery.astro).
import {
  Mic, Clock, Users, GraduationCap, Building2, CheckCircle2, Award, BookOpen,
  Headphones, FileText, Shield, Star, ChefHat, Utensils, Hotel, School,
  FlaskConical, Send, MapPin, Sparkles, Brain, Target,
} from 'lucide-react';
import type { Locale } from '../../i18n/config';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import AIImageGallery from '../AIImageGallery.astro';
import WhatsAppFloatingButton from '../WhatsAppFloatingButton.astro';

interface Props { lang?: Locale }
const { lang = 'es' } = Astro.props;

// ---- JSON-LD (equivalentes a los <script> del Helmet en FormacionPresencial.tsx, literales) ----
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://aichef.pro' },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://aichef.pro/servicios' },
    { '@type': 'ListItem', position: 3, name: 'Formación Presencial', item: 'https://aichef.pro/formacion-presencial' },
  ],
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'AI Chef Pro Academy',
  description: 'Formación presencial especializada en Inteligencia Artificial aplicada a la gastronomía profesional',
  url: 'https://aichef.pro/formacion-presencial',
  provider: { '@type': 'Organization', name: 'AI Chef Pro', url: 'https://aichef.pro' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Formación Presencial',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Course', name: 'Conferencia Magistral', description: 'La Revolución de la IA en la Cocina Profesional' }, price: '990', priceCurrency: 'EUR' },
      { '@type': 'Offer', itemOffered: { '@type': 'Course', name: 'Workshop Intensivo', description: 'Domina la IA en tu Cocina' }, price: '1490', priceCurrency: 'EUR' },
      { '@type': 'Offer', itemOffered: { '@type': 'Course', name: 'Programa Formativo Completo', description: 'Transformación Digital de tu Cocina con IA' }, price: '2490', priceCurrency: 'EUR' },
      { '@type': 'Offer', itemOffered: { '@type': 'Course', name: 'Programa Institucional', description: 'IA en la Educación Gastronómica' }, price: '4990', priceCurrency: 'EUR' },
      { '@type': 'Offer', itemOffered: { '@type': 'Course', name: 'Consultoría Estratégica In-House', description: 'Transformación Digital Total' }, priceSpecification: { '@type': 'PriceSpecification', minPrice: '4990', priceCurrency: 'EUR' } },
    ],
  },
};

// ---- Clases shadcn "mergeadas" (cn + tailwind-merge) reproduciendo el DOM de la SPA ----
const BTN_BASE = 'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0';
// variante con text-size del call site (text-sm base eliminado)
const BTN_BASE_NT = 'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0';

const btnHeroPrimary = `${BTN_BASE_NT} bg-primary hover:bg-primary/90 h-11 w-full sm:w-auto text-base sm:text-lg px-4 sm:px-8 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white`;
const btnHeroOutline = `${BTN_BASE} border bg-background hover:text-accent-foreground h-11 px-8 w-full sm:w-auto border-amber-500/50 hover:bg-amber-50`;
const btnServicePrefix = `${BTN_BASE} bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-4 py-2 w-full bg-gradient-to-r`;
const btnFormSubmit = `${BTN_BASE_NT} bg-primary hover:bg-primary/90 h-11 px-8 w-full bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white text-lg`;
const btnCtaPrimary = `${BTN_BASE_NT} bg-primary hover:bg-primary/90 h-11 px-8 text-lg bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white`;
const btnCtaOutline = `${BTN_BASE_NT} border bg-background hover:text-accent-foreground h-11 px-8 text-lg border-amber-500/50 text-amber-400 hover:bg-amber-500/10`;

const BADGE_BASE = 'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2';
// badge sólido pastel: el className fija bg + text + border-color (border-transparent del variant se descarta)
const badgeSolid = `${BADGE_BASE} hover:bg-primary/80`;
// badge sólido cuyo className NO fija border-color (chef badges): border-transparent se conserva
const badgeChip = `${BADGE_BASE} border-transparent hover:bg-primary/80`;
// badge variant=outline con display flex del call site
const badgeOutline = 'flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 text-foreground gap-1';
// hero badge: override de px/py -> se descartan px-2.5/py-0.5 base
const badgeHero = 'inline-flex items-center rounded-full border text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 hover:bg-primary/80 mb-4 px-3 sm:px-4 py-2 bg-amber-100 text-amber-800 border-amber-300 max-w-full flex-wrap';
// badge "Más Solicitado": override de rounded (rounded-full descartado), border-transparent conservado
const badgePopular = 'inline-flex items-center border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent hover:bg-primary/80 rounded-none rounded-bl-lg bg-blue-500 text-white';

// ---- Datos (paridad con FormacionPresencial.tsx) ----
const serviceColors: Record<string, { gradient: string; iconBg: string; iconColor: string; border: string; price: string }> = {
  conferencia: { gradient: 'from-amber-500/10 to-orange-500/10', iconBg: 'bg-amber-500/20', iconColor: 'text-amber-600', border: 'border-amber-500/30', price: 'text-amber-600' },
  workshop: { gradient: 'from-emerald-500/10 to-teal-500/10', iconBg: 'bg-emerald-500/20', iconColor: 'text-emerald-600', border: 'border-emerald-500/30', price: 'text-emerald-600' },
  'programa-completo': { gradient: 'from-blue-500/10 to-indigo-500/10', iconBg: 'bg-blue-500/20', iconColor: 'text-blue-600', border: 'border-blue-500/30', price: 'text-blue-600' },
  institucional: { gradient: 'from-purple-500/10 to-violet-500/10', iconBg: 'bg-purple-500/20', iconColor: 'text-purple-600', border: 'border-purple-500/30', price: 'text-purple-600' },
  consultoria: { gradient: 'from-pink-500/10 to-rose-500/10', iconBg: 'bg-pink-500/20', iconColor: 'text-pink-600', border: 'border-pink-500/30', price: 'text-pink-600' },
};

const services = [
  { id: 'conferencia', icon: Mic, name: 'Conferencia Magistral', subtitle: '"La Revolución de la IA en la Cocina Profesional"', duration: '90-120 minutos', attendees: 'Hasta 200 personas', price: '990€', popular: false, idealFor: 'Eventos, congresos, jornadas de asociaciones, inauguraciones de curso', includes: ['Material digital para asistentes', 'Código de prueba AI Chef Pro (7 días)', 'Certificado de asistencia personalizado'] },
  { id: 'workshop', icon: Users, name: 'Workshop Intensivo', subtitle: '"Domina la IA en tu Cocina"', duration: '4 horas', attendees: '12-25 personas', price: '1.490€', popular: false, idealFor: 'Equipos de cocina, estudiantes avanzados, mandos intermedios', includes: ['Licencia AI Chef Pro Premium (1 mes) por asistente', 'Manual de implementación digital', 'Biblioteca de prompts optimizados', 'Soporte post-formación (15 días)'] },
  { id: 'programa-completo', icon: GraduationCap, name: 'Programa Formativo Completo', subtitle: '"Transformación Digital de tu Cocina con IA"', duration: '8 horas (jornada completa)', attendees: '10-20 personas', price: '2.490€', popular: true, idealFor: 'Equipos completos de restaurantes, brigadas de cocina', includes: ['Licencia AI Chef Pro Premium Plus (2 meses) por asistente', 'Manual de implementación completo (físico + digital)', 'Biblioteca completa de prompts profesionales', 'Sesión de seguimiento online (1h) a los 30 días', 'Certificado profesional AI Chef Pro Academy', 'Soporte prioritario (30 días)'] },
  { id: 'institucional', icon: School, name: 'Programa Institucional', subtitle: '"IA en la Educación Gastronómica"', duration: '16-24 horas (2-3 días)', attendees: 'Hasta 30 personas por sesión', price: '4.990€', popular: false, idealFor: 'Escuelas de cocina, facultades gastronómicas, centros FP, universidades', includes: ['Licencias institucionales AI Chef Pro (curso académico)', 'Material didáctico adaptado al nivel formativo', 'Guía para profesores/instructores', 'Sistema de evaluación y rúbricas', 'Certificación acreditada AI Chef Pro Academy', 'Posibilidad de bonificación FUNDAE'] },
  { id: 'consultoria', icon: Building2, name: 'Consultoría Estratégica In-House', subtitle: '"Transformación Digital Total"', duration: '2-5 días (proyecto a medida)', attendees: 'Toda la organización', price: 'Desde 4.990€', popular: false, idealFor: 'Grupos de restauración, hoteles, cocinas centrales, empresas de catering', includes: ['Licencias corporativas AI Chef Pro', 'Informe de diagnóstico detallado', 'Plan de transformación digital documentado', 'Formación presencial personalizada', 'Soporte prioritario durante implementación', 'Sesiones de seguimiento trimestrales (primer año)'] },
];

const targetAudience = [
  { icon: School, name: 'Escuelas de Cocina', description: 'Facultades gastronómicas, FP y universidades', need: 'Actualizar curriculum con competencias digitales y IA', color: 'purple' },
  { icon: Utensils, name: 'Grupos de Restauración', description: 'Cadenas, franquicias y holdings gastronómicos', need: 'Estandarización, eficiencia operativa, reducción de costes', color: 'blue' },
  { icon: ChefHat, name: 'Asociaciones Profesionales', description: 'Federaciones de hostelería, colegios de chefs', need: 'Formación continua para asociados, eventos de valor', color: 'amber' },
  { icon: FlaskConical, name: 'Centros de I+D', description: 'Laboratorios alimentarios, innovación gastronómica', need: 'Integración de IA en procesos de investigación', color: 'emerald' },
  { icon: Hotel, name: 'Hoteles y Resorts', description: 'Departamentos F&B, cocinas centrales', need: 'Optimización de operaciones a escala', color: 'pink' },
];

const benefits = [
  { icon: CheckCircle2, title: 'Aprendizaje Práctico Real', description: 'Trabaja directamente con las herramientas en tu propia cocina', color: 'emerald' },
  { icon: Award, title: 'Adaptación a Tu Realidad', description: 'Contenido personalizado según tu tipo de establecimiento', color: 'amber' },
  { icon: Clock, title: 'Implementación Inmediata', description: 'Empieza a aplicar lo aprendido el mismo día', color: 'blue' },
  { icon: Users, title: 'Formación del Equipo Completo', description: 'Toda tu brigada alineada en el uso de IA', color: 'purple' },
  { icon: Headphones, title: 'Seguimiento Garantizado', description: 'No te quedas solo después de la formación', color: 'pink' },
];

const valueItems = [
  { icon: Star, text: 'Acceso a AI Chef Pro (75+ herramientas de IA gastronómica)', color: 'amber' },
  { icon: BookOpen, text: 'Material formativo físico y digital', color: 'blue' },
  { icon: FileText, text: 'Biblioteca de prompts profesionales', color: 'emerald' },
  { icon: Award, text: 'Certificación oficial AI Chef Pro Academy', color: 'purple' },
  { icon: Headphones, text: 'Soporte post-formación incluido', color: 'pink' },
  { icon: Shield, text: 'Posibilidad de bonificación FUNDAE', color: 'teal' },
];

const faqs = [
  { question: '¿Dónde se imparten las formaciones?', answer: 'Me desplazo a tus instalaciones. Toda España peninsular, Baleares, Canarias y otros países bajo consulta. Los gastos de desplazamiento y alojamiento se presupuestan según ubicación.' },
  { question: '¿Se puede bonificar por FUNDAE?', answer: 'Sí, gestionamos la bonificación según el tipo de empresa y formación. Consulta con nosotros para conocer las opciones disponibles para tu organización.' },
  { question: '¿Qué necesitamos para la formación?', answer: 'Un espacio con proyector/pantalla y conexión a internet. Los asistentes necesitan dispositivo (móvil, tablet o portátil) para las prácticas.' },
  { question: '¿Cuánto tiempo de antelación necesitáis?', answer: 'Recomendamos un mínimo de 2-3 semanas para preparar contenido personalizado y garantizar disponibilidad.' },
  { question: '¿Qué dispositivos necesitan los asistentes?', answer: 'Cualquier dispositivo con conexión a internet: smartphone, tablet o portátil. AI Chef Pro funciona en cualquier navegador moderno.' },
  { question: '¿IVA incluido en los precios?', answer: 'Los precios indicados no incluyen IVA (21%). Se aplicará según la normativa vigente.' },
];

const organizationTypes = ['Escuela de Cocina / Centro Formativo', 'Restaurante / Grupo de Restauración', 'Hotel / Resort', 'Asociación Profesional', 'Jornadas Gastronómicas', 'Congreso Gastronómico', 'Centro de I+D Alimentario', 'Empresa de Catering', 'Otro'];

const trainingImages = [
  { src: '/formacion/formacion-workshop.jpg', alt: 'Workshop intensivo de IA para chefs profesionales', caption: 'Workshop Intensivo' },
  { src: '/formacion/formacion-conferencia.jpg', alt: 'Conferencia magistral AI Chef Pro', caption: 'Conferencia Magistral' },
  { src: '/formacion/formacion-practica.jpg', alt: 'Sesión práctica de IA en cocina profesional', caption: 'Formación Práctica' },
  { src: '/formacion/formacion-inhouse.jpg', alt: 'Consultoría in-house en restaurante', caption: 'Consultoría In-House' },
];

type ColorClasses = { bg: string; iconBg: string; text: string; border: string };
const COLOR_MAP: Record<string, ColorClasses> = {
  emerald: { bg: 'bg-emerald-50', iconBg: 'bg-emerald-500/20', text: 'text-emerald-600', border: 'border-emerald-500/30' },
  amber: { bg: 'bg-amber-50', iconBg: 'bg-amber-500/20', text: 'text-amber-600', border: 'border-amber-500/30' },
  blue: { bg: 'bg-blue-50', iconBg: 'bg-blue-500/20', text: 'text-blue-600', border: 'border-blue-500/30' },
  purple: { bg: 'bg-purple-50', iconBg: 'bg-purple-500/20', text: 'text-purple-600', border: 'border-purple-500/30' },
  pink: { bg: 'bg-pink-50', iconBg: 'bg-pink-500/20', text: 'text-pink-600', border: 'border-pink-500/30' },
  teal: { bg: 'bg-teal-50', iconBg: 'bg-teal-500/20', text: 'text-teal-600', border: 'border-teal-500/30' },
};
const getColorClasses = (color: string): ColorClasses => COLOR_MAP[color] || COLOR_MAP.amber;
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<div class="min-h-screen bg-background overflow-x-hidden">
  <Header lang={lang} />

  <!-- Hero Section -->
  <section class="relative py-12 sm:py-16 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-amber-50 via-background to-orange-50"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-amber-100/40 via-transparent to-transparent"></div>

    <div class="container relative px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <div class="text-center lg:text-left max-w-full">
          <div class={badgeHero}>
            <GraduationCap className="h-4 w-4 mr-2 flex-shrink-0" />
            <span class="text-xs sm:text-sm">AI Chef Pro Academy - Formación Presencial</span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight text-balance break-words">
            Llevamos la Revolución de la IA{' '}
            <span class="block sm:inline bg-gradient-to-r from-amber-600 to-orange-600 bg-clip-text text-transparent">
              Directamente a Tu Negocio
            </span>
          </h1>

          <p class="text-lg sm:text-xl md:text-2xl text-muted-foreground mb-8">
            Formación presencial especializada en Inteligencia Artificial aplicada a la gastronomía profesional.
            Workshops, conferencias y programas in-house para escuelas de cocina, grupos de restauración y equipos de hostelería.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start mb-8 sm:mb-12">
            <a href="#contacto-formacion" class={btnHeroPrimary}>
              <Send className="mr-2 h-5 w-5 flex-shrink-0" />
              Solicitar Propuesta
            </a>
            <a href="#servicios" class={btnHeroOutline}>
              Ver Servicios y Precios
            </a>
          </div>

          <!-- Stats with color - Responsive -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-4">
            <div class="bg-amber-100/80 rounded-xl p-3 sm:p-4 text-center border border-amber-200 min-w-0">
              <div class="text-2xl sm:text-3xl font-bold text-amber-700">75+</div>
              <div class="text-xs sm:text-sm text-amber-600">Herramientas IA</div>
            </div>
            <div class="bg-emerald-100/80 rounded-xl p-3 sm:p-4 text-center border border-emerald-200 min-w-0">
              <div class="text-2xl sm:text-3xl font-bold text-emerald-700">100%</div>
              <div class="text-xs sm:text-sm text-emerald-600">IA Gastronómica</div>
            </div>
            <div class="bg-blue-100/80 rounded-xl p-3 sm:p-4 text-center border border-blue-200 min-w-0">
              <div class="text-2xl sm:text-3xl font-bold text-blue-700">Único</div>
              <div class="text-xs sm:text-sm text-blue-600">en España</div>
            </div>
            <div class="bg-purple-100/80 rounded-xl p-3 sm:p-4 text-center border border-purple-200 min-w-0">
              <div class="text-2xl sm:text-3xl font-bold text-purple-700">ROI</div>
              <div class="text-xs sm:text-sm text-purple-600">Inmediato</div>
            </div>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="hidden lg:block">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-r from-amber-400/20 to-orange-400/20 rounded-3xl blur-2xl"></div>
            <img src="/formacion/formacion-conferencia.jpg" alt="Conferencia AI Chef Pro" class="relative rounded-2xl shadow-2xl border-4 border-white/50" />
            <div class="absolute -bottom-4 -right-4 bg-white rounded-xl shadow-lg p-4 border border-amber-100">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center">
                  <Brain className="h-6 w-6 text-white" />
                </div>
                <div>
                  <div class="font-bold text-slate-900">75+ Agentes IA</div>
                  <div class="text-sm text-slate-500">Especializadas</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Por qué Formación Presencial -->
  <section class="py-16 bg-gradient-to-b from-amber-50/50 to-background">
    <div class="container">
      <div class="text-center mb-12">
        <div class={`${badgeSolid} mb-4 bg-emerald-100 text-emerald-800 border-emerald-300`}>
          <Target className="h-3 w-3 mr-1" />
