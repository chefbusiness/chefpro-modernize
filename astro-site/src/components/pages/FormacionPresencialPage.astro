        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Por Qué Formación Presencial?</h2>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          La formación presencial ofrece ventajas únicas que marcan la diferencia en la implementación de IA
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-6">
        {benefits.map((benefit) => {
          const colors = getColorClasses(benefit.color);
          const Icon = benefit.icon;
          return (
            <div class={`rounded-lg border bg-card text-card-foreground shadow-sm text-center hover:shadow-lg transition-all hover:-translate-y-1 border-t-4 ${colors.border}`}>
              <div class="flex flex-col space-y-1.5 p-6">
                <div class={`mx-auto w-14 h-14 rounded-xl ${colors.iconBg} flex items-center justify-center mb-2`}>
                  <Icon className={`h-7 w-7 ${colors.text}`} />
                </div>
                <h3 class="font-semibold leading-none tracking-tight text-lg">{benefit.title}</h3>
              </div>
              <div class="p-6 pt-0">
                <p class="text-sm text-muted-foreground">{benefit.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Galería de Imágenes Gastronómicas (AIImageGallery) -->
  <AIImageGallery lang={lang} />

  <!-- Formación en Acción - Mini Gallery -->
  <section class="py-16 bg-gradient-to-b from-slate-900 to-slate-800">
    <div class="container">
      <div class="text-center mb-12">
        <div class={`${badgeSolid} mb-4 bg-amber-500/20 text-amber-400 border-amber-500/30`}>
          <Sparkles className="h-3 w-3 mr-1" />
          Formación en Acción
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">
          Así Son Nuestras Formaciones
        </h2>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto">
          Workshops prácticos, conferencias inspiradoras y consultoría personalizada en tu propia cocina
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {trainingImages.map((image) => (
          <div class="group relative overflow-hidden rounded-xl">
            <img src={image.src} alt={image.alt} class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <p class="text-white font-semibold text-sm md:text-base">{image.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

