---
// GuiaLandingPage.astro — Template 1:1 de la LÍNEA GUÍAS "Cómo Montar" (guia-*).
// Reproduce, server-side y parametrizado por `data`, la estructura EXACTA de la página SPA
// de referencia src/pages/GuiaRestauranteGastronomico.tsx: mismo ORDEN de secciones, mismo
// DOM de cada componente de src/components/guia-restaurante-gastronomico/*, mismos banners
// compartidos (SaaS/CompatibleApps/Testimonials/FreeTools/Worldwide/TryPlatform/WhatsApp) y
// los 3 JSON-LD ÍNTEGROS (Product + FAQPage + BreadcrumbList).
//
// Los banners compartidos (SaasDiscoveryBanner, CompatibleAppsMarquee variant="tareas",
// FreeToolsSection, WorldwideBanner, TryPlatformBanner, WhatsAppProductSupport, AlreadyBought,
// LogoBadge, PaymentBadges) son los MISMOS ficheros que consume la línea Tareas → se
// reutilizan VERBATIM del template KitTareasLandingPage.astro (slice ya cerrado con gates
// verdes). Lo GUÍA-específico (Hero rojo, ContentGrid con num, WhySection simple, Author
// "Autor", BonusSection split/single, Product schema SIN review/seller) va aquí.
//
// Animaciones FadeIn → CSS (.kt-fade + IntersectionObserver mínimo). Interacción (acordeón
// FAQ, marquee de testimonios, formulario "¿ya compraste?") en <script> vanilla.
import type { GuiaData } from '../../data/productos/guias/types';
import Icon from '../Icon.astro';

interface Props {
  data: GuiaData;
  /** Payment link Stripe YA resuelto. DINERO: el wrapper por-producto lo resuelve con acceso
   *  ESTÁTICO —import.meta.env.VITE_STRIPE_PAYMENT_LINK_<X> || '#comprar'— para que Vite lo
   *  inline en build (el acceso dinámico import.meta.env[clave] NO es fiable). */
  stripeLink: string;
}
const { data, stripeLink } = Astro.props;

const canonical = `https://aichef.pro/${data.slug}`;
const avatarAlt = data.hero.avatarAltPrefix ?? 'Professional';
const bonusLayout = data.bonus.layout ?? 'split';

// ---- JSON-LD (equivalentes íntegros a los 3 <script> del Helmet de la SPA de la línea) ----
// PARIDAD: el Product de esta línea NO lleva review[] ni seller (a diferencia de Tareas).
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.schema.productName,
  description: data.schema.productDescription,
  image: data.seo.ogImage,
  brand: { '@type': 'Brand', name: 'AI Chef Pro' },
  offers: {
    '@type': 'Offer',
    url: canonical,
    priceCurrency: 'EUR',
    price: data.schema.price,
    priceValidUntil: data.schema.priceValidUntil,
    availability: 'https://schema.org/InStock',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: data.schema.aggregateRating.ratingValue,
    reviewCount: data.schema.aggregateRating.reviewCount,
    bestRating: data.schema.aggregateRating.bestRating,
    worstRating: data.schema.aggregateRating.worstRating,
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.schema.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: data.schema.breadcrumb.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.item,
  })),
};

// ---- Testimonials (paridad TestimonialsMarquee: mid = ceil(len/2)) ----
const mid = Math.ceil(data.testimonials.items.length / 2);
const topRow = data.testimonials.items.slice(0, mid);
const bottomRow = data.testimonials.items.slice(mid);

// ---- BonusSection: split = fila de 3 (slice 0-3) + fila del resto (slice 3) ----
const bonusFirst = bonusLayout === 'split' ? data.bonus.items.slice(0, 3) : data.bonus.items;
const bonusRest = bonusLayout === 'split' ? data.bonus.items.slice(3) : [];

// ---- CompatibleAppsMarquee variant="tareas" (constante; apps ×4 para loop) ----
const apps = [
  { name: 'AI Chef Pro', src: '/logos/aichefpro-icon.png' },
  { name: 'ChatGPT', src: '/logos/openai.png' },
  { name: 'Gemini', src: '/logos/gemini.png' },
  { name: 'Google Sheets', src: '/logos/google-sheets.png' },
  { name: 'Excel', src: '/logos/excel.png' },
  { name: 'Word', src: '/logos/word.png' },
  { name: 'PDF', src: '/logos/pdf.png' },
  { name: 'Google', src: '/logos/google.png' },
  { name: 'Perplexity', src: '/logos/perplexity.png' },
];
const appsRepeated = [...apps, ...apps, ...apps, ...apps];

// ---- FreeToolsSection (constante; 8 herramientas) ----
const freeTools = [
  { icon: 'Calculator', title: 'Calculadora Food Cost', desc: 'Calcula el coste real de cada plato al céntimo', href: '/calculadora-food-cost-restaurante', color: 'text-green-400' },
  { icon: 'ShieldAlert', title: 'Detector Alérgenos', desc: 'Identifica alérgenos automáticamente en tus recetas', href: '/detector-alergenos-restaurante', color: 'text-red-400' },
  { icon: 'Calendar', title: 'Calendario Contenidos', desc: 'Plan de contenido mensual para redes sociales', href: '/calendario-contenidos-restaurante', color: 'text-purple-400' },
  { icon: 'TrendingUp', title: 'Simulador Rentabilidad', desc: 'Proyecta ingresos, costes y beneficio neto', href: '/simulador-rentabilidad-restaurante', color: 'text-yellow-400' },
  { icon: 'FileText', title: 'Generador Textos Carta', desc: 'Descripciones irresistibles para tu menú', href: '/generador-textos-carta-restaurante', color: 'text-blue-400' },
  { icon: 'Smartphone', title: 'Test Digitalización', desc: 'Evalúa el nivel digital de tu restaurante', href: '/test-digitalizacion-restaurante', color: 'text-teal-400' },
  { icon: 'Users', title: 'Calculadora Brigada', desc: 'Personal óptimo según tu volumen de servicio', href: '/calculadora-brigada-restaurante', color: 'text-orange-400' },
  { icon: 'Sparkles', title: 'Generador Menú Degustación', desc: 'Crea menús degustación con IA en segundos', href: '/generador-menu-degustacion', color: 'text-indigo-400' },
];

// ---- Hero avatars (constante: /avatars/avatar-1..8.jpg) ----
const heroAvatars = Array.from({ length: 8 }, (_, i) => `/avatars/avatar-${i + 1}.jpg`);

// ---- TryPlatformBanner language pills (constante) ----
const langPills = ['Español', 'English', 'Français', 'Deutsch', 'Italiano', 'Português', 'Nederlands'];

// WhatsApp (constante)
const waPhone = '34744717942';
const waMessage = encodeURIComponent('Hola, necesito ayuda con mi compra en AI Chef Pro. ');
const waUrl = `https://wa.me/${waPhone}?text=${waMessage}`;
---

<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<noscript><style>.kt-fade{opacity:1!important;transform:none!important;}</style></noscript>

<div class="min-h-screen bg-[#0a0a0a]">
  {/* ===== 1. SaasDiscoveryBanner ===== */}
  <div class="bg-gradient-to-r from-[#FFD700]/10 via-[#FFD700]/5 to-[#FFD700]/10 border-b border-[#FFD700]/20">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-2 sm:gap-3 text-center">
      <Icon name="Sparkles" class="h-3.5 w-3.5 text-[#FFD700] flex-shrink-0 hidden sm:block" />
      <p class="text-xs sm:text-sm text-gray-300">
        <span class="hidden sm:inline">Estos productos digitales complementan </span>
        <a href="/" class="font-semibold text-[#FFD700] hover:text-[#FFD700]/80 transition-colors">AI Chef Pro</a>
        <span class="hidden sm:inline"> — el SaaS de IA para hostelería con +55 aplicaciones</span>
        <span class="sm:hidden"> — SaaS de IA para hostelería</span>
      </p>
      <a href="/" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#FFD700]/15 border border-[#FFD700]/30 text-[#FFD700] text-xs font-semibold hover:bg-[#FFD700]/25 transition-colors whitespace-nowrap flex-shrink-0">
        Descubrir
        <Icon name="ArrowRight" class="h-3 w-3" />
      </a>
    </div>
  </div>

  {/* ===== 2. HeroSection ===== */}
  <section class="relative px-4 pt-8 pb-16 md:pt-12 md:pb-24 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.12]">
      <div class="grid grid-cols-3 md:grid-cols-6 h-full gap-1">
        {data.images.gallery.map((src) => (
          <div class="overflow-hidden">
            <img src={src} alt="" class="w-full h-full object-cover scale-110" loading="eager" />
          </div>
        ))}
      </div>
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a] via-[#0a0a0a]/80 to-[#0a0a0a]"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,215,0,0.1) 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto text-center z-10">
      {/* LogoBadge (isHub siempre false en landing de producto) */}
      <div>
        <nav class="flex justify-center pt-1 mb-2 md:mb-3">
          <div class="inline-flex items-center gap-2 md:gap-3 px-3 md:px-4 py-1.5 rounded-full bg-white/[0.04] border border-white/10 backdrop-blur-sm text-xs text-gray-400">
            <a href="/productos-digitales" class="hover:text-[#FFD700] transition-colors whitespace-nowrap">← Productos Digitales</a>
            <span class="text-white/20" aria-hidden="true">·</span>
            <a href="/" class="hover:text-[#FFD700] transition-colors">Inicio</a>
          </div>
        </nav>
        <div class="flex justify-center py-6 md:py-8">
          <a href="/" class="inline-flex items-center px-6 py-3 bg-white rounded-2xl shadow-lg shadow-white/5 hover:shadow-white/10 transition-shadow">
            <img src="/logo-ai-chef-pro.svg" alt="AI Chef Pro" class="h-8 md:h-9 w-auto" />
          </a>
        </div>
      </div>

      <div class="flex flex-col items-center gap-2 mb-6">
        <div class="flex -space-x-3 justify-center">
          {heroAvatars.map((avatar, i) => (
            <span class="relative flex shrink-0 overflow-hidden rounded-full border-2 border-[#0a0a0a] w-9 h-9 sm:w-10 sm:h-10 ring-2 ring-[#0a0a0a]">
              <img src={avatar} alt={`${avatarAlt} ${i + 1}`} class="aspect-square h-full w-full object-cover" />
            </span>
          ))}
        </div>
        <div class="flex items-center gap-0.5">
          {Array.from({ length: 5 }).map(() => (
            <Icon name="Star" class="h-4 w-4 fill-[#FFD700] text-[#FFD700]" />
          ))}
        </div>
      </div>

      <span class="inline-block mb-6 px-4 py-1.5 rounded-full bg-red-500/10 border border-red-500/30 text-red-400 text-sm font-medium animate-fade-in">
        {data.hero.badge}
      </span>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        {data.hero.titlePre}<span class="text-[#FFD700]">{data.hero.titleGold}</span>
        <span class="block text-2xl md:text-4xl lg:text-5xl mt-2 text-gray-200">
          {data.hero.subtitleLine}
        </span>
      </h1>

      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto mb-10 leading-relaxed">
        {data.hero.description}
      </p>

      <div class="flex flex-col items-center gap-3 mb-10">
        {data.hero.checkItems.map((item) => (
          <div class="flex items-center gap-3 text-gray-200">
            <Icon name="Check" class="w-5 h-5 text-[#FFD700] flex-shrink-0" />
            <span>{item}</span>
          </div>
        ))}
      </div>

      <div class="inline-block bg-white/5 border border-[#FFD700]/20 rounded-2xl p-6 md:p-8 backdrop-blur-sm">
        <div class="flex items-center justify-center gap-4 mb-3">
          <span class="text-2xl text-gray-500 line-through">{data.pricing.priceOld}</span>
          <span class="text-5xl md:text-6xl font-extrabold text-[#FFD700]">{data.pricing.price}</span>
          <span class="px-3 py-1 rounded-full bg-[#FFD700]/20 text-[#FFD700] text-sm font-bold">{data.pricing.discountBadge}</span>
        </div>
        <p class="text-sm text-gray-400 mb-5">{data.pricing.heroNote}</p>
        <a href={stripeLink} class="inline-block w-full md:w-auto px-10 py-4 bg-[#FFD700] text-black font-bold text-lg rounded-xl hover:bg-[#FFD700]/90 transition-all hover:scale-[1.02] active:scale-[0.98]">
          {data.hero.ctaLabel}
        </a>
        <div class="flex flex-col items-center gap-2 mt-4">
          <img src="/powered-by-stripe.png" alt="Powered by Stripe — Visa, Mastercard, Maestro, Google Pay, Apple Pay" class="w-full max-w-[260px] bg-white rounded-lg px-3 py-1.5" />
        </div>
      </div>
    </div>
  </section>

  {/* ===== 3. CompatibleAppsMarquee (variant tareas) — sólo si showCompatibleApps ===== */}
  {data.showCompatibleApps && (
    <section class="py-10 md:py-14 overflow-hidden">
      <div class="text-center mb-8 px-4">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-2">Imprime, Delega y <span class="text-[#FFD700]">Controla</span></h2>
        <p class="text-gray-500 text-sm md:text-base">Plantillas Excel optimizadas para imprimir en A4. Compatible con Excel, Google Sheets, LibreOffice y Numbers</p>
      </div>
      <div class="relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-16 md:w-24 bg-gradient-to-r from-[#0a0a0a] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-0 w-16 md:w-24 bg-gradient-to-l from-[#0a0a0a] to-transparent z-10 pointer-events-none"></div>
        <div class="flex items-center gap-6 md:gap-8 animate-marquee-scroll" style="width: max-content;">
          {appsRepeated.map((app) => (
            <div class="flex-shrink-0 flex flex-col items-center gap-2 group">
              <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl bg-gray-100 border border-gray-200/50 flex items-center justify-center p-3 md:p-4 group-hover:bg-white group-hover:shadow-md transition-all duration-300">
                <img src={app.src} alt={app.name} class="w-full h-full object-contain" loading="lazy" />
              </div>
              <span class="text-[10px] md:text-xs text-gray-500 group-hover:text-gray-300 whitespace-nowrap transition-colors duration-300">{app.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ===== 4. ContentGrid ===== */}
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="kt-fade">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-4xl font-bold text-white mb-3">
            <span class="text-[#FFD700]">{data.grid.countGold}</span>{data.grid.headingRest}
          </h2>
          <p class="text-gray-400 text-lg max-w-3xl mx-auto">{data.grid.subtitle}</p>
        </div>
      </div>
      <div class="kt-fade">
        <div class="grid grid-cols-3 md:grid-cols-6 gap-2 mb-12 rounded-xl overflow-hidden">
          {data.images.gallery.map((src) => (
            <div class="aspect-square overflow-hidden rounded-lg">
              <img src={src} alt="" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {data.grid.chapters.map((ch, i) => (
          <div class="kt-fade" style={`transition-delay:${i * 40}ms`}>
            <div class="group bg-white/5 border border-white/10 rounded-xl p-5 hover:border-[#FFD700]/50 transition-all duration-300 h-full">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-[#FFD700] text-xs font-bold opacity-50">{ch.num}</span>
                <Icon name={ch.icon} class="w-6 h-6 text-[#FFD700]" />
              </div>
              <h3 class="text-white font-semibold text-sm mb-1.5">{ch.title}</h3>
              <p class="text-gray-400 text-xs leading-relaxed">{ch.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== 5. TestimonialsMarquee ===== */}
  <section class="py-16 md:py-24 overflow-hidden">
    <div class="text-center mb-10 px-4">
      <h2 class="text-2xl md:text-4xl font-bold text-white mb-3">Lo Que Dicen los <span class="text-[#FFD700]">{data.testimonials.titleGold}</span></h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">{data.testimonials.subtitle}</p>
    </div>
    <div class="space-y-4">
      {[{ items: topRow, direction: 'left', duration: 45 }, { items: bottomRow, direction: 'right', duration: 50 }].map((row) => (
        <div class="overflow-hidden relative">
          <div class="absolute left-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-r from-[#0a0a0a] to-transparent z-10 pointer-events-none"></div>
          <div class="absolute right-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-l from-[#0a0a0a] to-transparent z-10 pointer-events-none"></div>
          <div class="flex gap-4 will-change-transform" data-marquee data-direction={row.direction} data-duration={row.duration}>
            {[...row.items, ...row.items].map((t) => (
              <div class="flex-shrink-0 w-[300px] md:w-[360px] relative group">
                <div class="absolute inset-0 rounded-xl bg-[#FFD700]/20 translate-y-1 translate-x-1 opacity-0 group-hover:opacity-100 transition-all duration-300"></div>
                <div class="relative bg-[#0a0a0a] border border-white/10 rounded-xl p-5 group-hover:border-[#FFD700]/40 group-hover:-translate-y-0.5 group-hover:-translate-x-0.5 transition-all duration-300">
                  <div class="flex items-center gap-3 mb-3">
                    <img src={t.avatar} alt={t.name} class="w-10 h-10 rounded-full object-cover border border-white/10" />
                    <div>
                      <p class="text-white font-semibold text-sm">{t.name}</p>
                      <p class="text-gray-500 text-xs">{t.role}</p>
                    </div>
                  </div>
                  <p class="text-gray-300 text-sm leading-relaxed">"{t.text}"</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* ===== 6. WhySection ===== */}
  <section class="py-16 md:py-24 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.04]">
      <img src={data.images.whyBg} alt="" class="w-full h-full object-cover" loading="lazy" />
    </div>
    <div class="absolute inset-0 bg-[#0a0a0a]/95"></div>
    <div class="relative max-w-6xl mx-auto z-10">
      <div class="kt-fade">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-4xl font-bold text-white mb-3">
            ¿Por Qué Esta <span class="text-[#FFD700]">Guía</span>?
          </h2>
        </div>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {data.why.reasons.map((reason, i) => (
          <div class="kt-fade" style={`transition-delay:${i * 100}ms`}>
            <div class="text-center">
              <div class="w-14 h-14 rounded-2xl bg-[#FFD700]/20 flex items-center justify-center mx-auto mb-4">
                <Icon name={reason.icon} class="w-7 h-7 text-[#FFD700]" />
              </div>
              <h3 class="text-white font-bold mb-2">{reason.title}</h3>
              <p class="text-gray-400 text-sm leading-relaxed">{reason.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== 7. AuthorSection ===== */}
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="kt-fade">
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center gap-8">
          <div class="flex-shrink-0">
            <div class="w-28 h-28 md:w-36 md:h-36 rounded-full overflow-hidden border-[3px] border-[#FFD700]/40 shadow-lg shadow-[#FFD700]/10">
              <img src="/chef-john-guerrero-ebook.jpg" alt="Chef John Guerrero" class="w-full h-full object-cover" />
            </div>
          </div>
          <div class="text-center md:text-left">
            <p class="text-[#FFD700] text-xs font-bold tracking-[0.2em] uppercase mb-2">Autor</p>
            <h3 class="text-white text-xl md:text-2xl font-bold mb-3">Chef John Guerrero</h3>
            <p class="text-gray-400 leading-relaxed text-sm md:text-base mb-4">{data.author.bio}</p>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
              <span class="px-3 py-1 rounded-full bg-[#FFD700]/10 border border-[#FFD700]/20 text-[#FFD700] text-xs font-medium">CEO AI Chef Pro</span>
              <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-gray-400 text-xs font-medium">Consultor Gastronómico</span>
              <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-gray-400 text-xs font-medium">{data.author.badge3}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 8. BonusSection ===== */}
  <section class="py-16 md:py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="kt-fade">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-4xl font-bold text-white mb-3">Bonus <span class="text-[#FFD700]">Incluidos</span></h2>
          <p class="text-gray-400 text-lg">{data.bonus.subtitle}</p>
        </div>
      </div>
      {bonusLayout === 'split' ? (
        <Fragment>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto mb-8">
            {bonusFirst.map((b, i) => (
              <div class="kt-fade" style={`transition-delay:${i * 100}ms`}>
                <div class="bg-white/5 border border-white/10 rounded-xl overflow-hidden hover:border-[#FFD700]/40 transition-all group h-full">
                  <div class="h-28 overflow-hidden relative">
                    <img src={b.image} alt="" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#0a0a0a]"></div>
                    <span class="absolute bottom-3 left-4 text-[#FFD700] text-xs font-bold tracking-wider uppercase">{b.label}</span>
                  </div>
                  <div class="p-4">
                    <div class="flex items-center gap-2 mb-2">
