  { iconName: 'Fish', name: 'Hoe opent u een visrestaurant', desc: 'Levende vistanks, vismarkt, zuivering en eetzaal: de complete gids voor het openen van een visrestaurant, met bijbehorende sjablonen.', tags: ['pdf', 'guides', 'restaurant'], phase: 'Binnenkort' },
  { iconName: 'Store', name: 'Hoe opent u een boutique-slagerij', desc: 'Dry aging, slagerij en een signature toonbank: de gids voor het openen van een premium slagerij met een keuken.', tags: ['pdf', 'guides', 'management'], phase: 'Binnenkort' },
];

const PRODUCTS_PER_PAGE = 12;

// Etiqueta de un tag (los tags sin entrada en ALL_TAGS — 'bundle', 'production-kitchen', 'tapas'… —
// no renderizan pill, igual que en el hub ES).
const tagLabel = (id: string) => ALL_TAGS.find((t) => t.id === id)?.label;

// ── Tarjeta → producto NL vivo (FAMILIAS de lib/tienda.ts) ───────────────────────────
// Sin familia o con `nl.vivo: false` → null: la tarjeta se pinta sin enlace ni precio y con el
// badge «Binnenkort in het Nederlands». Con familia viva → landing NL + precio EUR (el que cobra el checkout).
const nlVivo = (slugEs: string) => {
  const f = FAMILIAS.find((x) => x.productos.es?.slug === slugEs.replace(/^\//, ''));
  const nl = f?.productos.nl;
  return nl && nl.vivo ? nl.slug : null;
};
const precioEur = (id: string) => {
  const v = PRODUCT_PRICES[id]?.eur;
  return typeof v === 'number' ? `€${v}` : null;
};
const cards = products.map((p) => {
  const nlSlug = nlVivo(p.slug);
  return {
    ...p,
    nlSlug,
    href: nlSlug ? tiendaProductoPath('nl', nlSlug) : null,
    price: nlSlug ? precioEur(nlSlug) : null,
  };
});
const liveCards = cards.filter((c) => c.href);

// ── Buscador: índice de texto por card (data-search) ────────────────────────────────
// Misma normalización que el hub ES (indiceBusqueda). Sin el slug ES ni sus alias en español.
const indiceProducto = (p: { name: string; description: string; features: string[]; tags: string[] }) =>
  indiceBusqueda([p.name, p.description, ...p.features, ...p.tags, ...p.tags.map(tagLabel)]);

// Contadores del badge del hero.
const productsCount = products.length;
const comingSoonCount = comingSoon.length;

// WhatsApp (mismo número que el hub ES; mensaje prerellenado en neerlandés).
const waPhone = '34744717942';
const waMessage = encodeURIComponent('Hallo, ik heb hulp nodig met mijn aankoop van AI Chef Pro. ');
const waUrl = `https://wa.me/${waPhone}?text=${waMessage}`;

// Países del mundo.
const countries = ['Spanje', 'Mexico', 'Colombia', 'Argentinië', 'Chili', 'Peru', 'Ecuador', 'Verenigde Staten', 'Duitsland', 'Frankrijk'];

// FAQ VISIBLE (y fuente del FAQPage JSON-LD).
const faqs = [
  { q: 'In welk formaat zijn de digitale producten?', a: 'De meeste zijn Excel-sjablonen (.xlsx) die werken in Microsoft Excel, Google Sheets, LibreOffice en Apple Numbers. We leveren ook printklare handleidingen en checklists in PDF. U downloadt elk bestand vanaf uw persoonlijke dashboard.' },
  { q: 'Hoe krijg ik de producten na aankoop?', a: 'Toegang is onmiddellijk. Zodra u via Stripe betaalt, brengen wij u naar uw persoonlijke dashboard, waar u elk bestand kunt downloaden. U ontvangt ook een e-mail met een magische link, zodat u altijd kunt terugkeren.' },
  { q: 'Kan ik overal ter wereld kopen?', a: 'Ja. U kunt overal kopen met een kaart, Apple Pay of Google Pay. De huidige catalogus is in het Spaans geschreven en is opgebouwd rond Spaanse en EU-regelgeving; de Nederlandse edities komen eraan en verschijnen op deze pagina zodra elke editie klaar is.' },
  { q: 'Bevatten de sjablonen automatische formules?', a: 'Ja. Elk Excel-sjabloon wordt geleverd met ingebouwde formules die het rekenwerk voor u doen: food cost, voorgestelde menuprijs, temperatuurmeldingen en afvalregistratie. U voert uw cijfers in en het spreadsheet doet de rest.' },
  { q: 'Is er een geld-terug-garantie?', a: 'Elk product wordt geleverd met een volledige garantie van 30 dagen. Als u niet tevreden bent, vergoeden wij 100% terug, zonder vragen. Schrijf gewoon naar info@aichef.pro.' },
  { q: 'Zijn toekomstige updates inbegrepen?', a: 'Ja. Elk product omvat levenslange toegang tot het online dashboard. Wanneer we nieuwe sjablonen toevoegen, verbeteringen aanbrengen of actualiseren vanwege regelgeving, ontvangt u deze zonder extra kosten.' },
  { q: 'Kan ik de sjablonen in meer dan één restaurant gebruiken?', a: 'Ja. De licentie is persoonlijk: u kunt de sjablonen gebruiken in elke locatie die u beheert. Ideaal voor consultants, restaurantgroepen en managers van meerdere vestigingen.' },
  { q: 'Welke betaalmethoden accepteert u?', a: 'Betalingen worden verwerkt door Stripe, een van de meest beveiligde betaalplatforms ter wereld. We accepteren credit- en debetkaarten (Visa, Mastercard, Amex), Apple Pay, Google Pay en Link (Stripe fast checkout).' },
];

// pSEO cities (las guías por ciudad solo existen en español: se listan sin enlace).
const cities = [
  { slug: 'madrid', label: 'Madrid' },
  { slug: 'barcelona', label: 'Barcelona' },
  { slug: 'valencia', label: 'Valencia' },
  { slug: 'ciudad-de-mexico', label: 'Mexico-Stad' },
  { slug: 'monterrey', label: 'Monterrey' },
  { slug: 'bogota', label: 'Bogotá' },
  { slug: 'medellin', label: 'Medellín' },
  { slug: 'buenos-aires', label: 'Buenos Aires' },
  { slug: 'santiago', label: 'Santiago' },
];

// ── JSON-LD (CollectionPage + FAQPage + BreadcrumbList, en neerlandés y sin ofertas ni rating) ──
const HUB_URL = 'https://aichef.pro/nl/digitale-producten';
const collectionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Digitale producten voor restaurants en horeca — AI Chef Pro',
  description: 'Excel-sjablonen, HACCP-handleidingen, AI-prompts en digitale tools voor chefs, restaurantmanagers en eigenaren.',
  url: HUB_URL,
  inLanguage: 'nl',
  publisher: {
    '@type': 'Organization',
    name: 'AI Chef Pro',
    url: 'https://aichef.pro/nl',
  },
};
// El ItemList solo lista productos VIVOS en neerlandés (hoy ninguno → sin mainEntity).
if (liveCards.length) {
  collectionSchema.mainEntity = {
    '@type': 'ItemList',
    itemListElement: liveCards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://aichef.pro${c.href}`,
      name: c.name,
    })),
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'nl',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: 'https://aichef.pro/nl' },
    { '@type': 'ListItem', position: 2, name: 'Digitale producten', item: HUB_URL },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<div class="min-h-screen bg-[#0a0a0a]">
  {/* ===== SaasDiscoveryBanner ===== */}
  <div class="bg-gradient-to-r from-[#FFD700]/10 via-[#FFD700]/5 to-[#FFD700]/10 border-b border-[#FFD700]/20">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-2 sm:gap-3 text-center">
      <Icon name="Sparkles" class="h-3.5 w-3.5 text-[#FFD700] flex-shrink-0 hidden sm:block" />
      <p class="text-xs sm:text-sm text-gray-300">
        <span class="hidden sm:inline">Deze digitale producten vormen een aanvulling op </span>
        <a href="/nl" class="font-semibold text-[#FFD700] hover:text-[#FFD700]/80 transition-colors">AI Chef Pro</a>
        <span class="hidden sm:inline"> — de AI SaaS voor de horeca met 55+ apps</span>
        <span class="sm:hidden"> — AI SaaS voor de horeca</span>
      </p>
      <a href="/nl" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#FFD700]/15 border border-[#FFD700]/30 text-[#FFD700] text-xs font-semibold hover:bg-[#FFD700]/25 transition-colors whitespace-nowrap flex-shrink-0">
        Ontdek
        <Icon name="ArrowRight" class="h-3 w-3" />
      </a>
    </div>
  </div>

  {/* ===== Hero ===== */}
  <section class="relative px-4 pt-6 pb-12 md:pt-8 md:pb-16 overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,215,0,0.08) 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto text-center z-10">
      {/* LogoBadge (isHub → no back pill, just the white logo card) */}
      <div>
        <div class="flex justify-center py-6 md:py-8">
          <a href="/nl" class="inline-flex items-center px-6 py-3 bg-white rounded-2xl shadow-lg shadow-white/5 hover:shadow-white/10 transition-shadow">
            <img src="/logo-ai-chef-pro.svg" alt="AI Chef Pro" class="h-8 md:h-9 w-auto" />
          </a>
        </div>
      </div>
      <span class="inline-block mt-4 mb-6 px-4 py-1.5 rounded-full bg-[#FFD700]/10 border border-[#FFD700]/30 text-[#FFD700] text-sm font-medium">
        {productsCount} producten · {comingSoonCount} in ontwikkeling
      </span>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        De <span class="text-[#FFD700]">Digitale</span> Productenwinkel voor de Horeca van Vandaag
      </h1>

      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        E-books, Excel-sjablonen, voedselveiligheidsgidsen en AI-prompts ontworpen door en voor horecaprofessionals. Directe download, levenslange toegang.
      </p>
    </div>
  </section>

  {/* ===== Buscador (filtra las MISMAS cards que los chips; la lógica va en el script del final) =====
       El panel de «no hay resultados» NO vive aquí: está debajo del grid (#pd-search-empty).
       Si estuviera encima de los chips, aparecer y desaparecer al teclear empujaría chips y
       cards ~200 px arriba y abajo, y el clic sobre una card acabaría en otra cosa. */}
  <section id="pd-search-section" class="px-4 pb-6">
    <div class="max-w-2xl mx-auto" role="search">
      <label for="pd-search-input" class="sr-only">Zoek producten op naam, onderwerp of type bedrijf</label>
      {/* Descripción ESTÁTICA del campo, separada del contador a propósito: si el
          aria-describedby apuntara a la región viva, el lector de pantalla leería el
          conteo al enfocar Y otra vez en cada mutación (una por pausa de tecleo). */}
      <span id="pd-search-ayuda" class="sr-only">
        Typ ten minste twee letters. De lijst filtert terwijl u typt; druk op Escape om de zoekopdracht te wissen.
      </span>

      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-[#FFD700]">
          <Icon name="Search" class="w-5 h-5" />
        </span>
        <input
          id="pd-search-input"
          type="search"
          maxlength="120"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-describedby="pd-search-ayuda"
          placeholder="Zoek op onderwerp of bedrijfstype: kostprijsberekening, HACCP, foodtruck…"
          class="w-full h-14 pl-5 pr-16 rounded-2xl bg-white/5 border-2 border-[#FFD700]/70 shadow-[0_0_24px_rgba(255,215,0,0.12)] text-white text-base placeholder:text-gray-400 outline-none transition-colors duration-200 focus:border-[#FFD700] focus:bg-white/[0.07] focus:ring-2 focus:ring-[#FFD700]/30"
        />
        <button
          id="pd-search-clear"
          type="button"
          aria-label="Zoekopdracht wissen"
          class="hidden absolute inset-y-0 right-11 items-center pr-1 text-gray-500 hover:text-[#FFD700] transition-colors"
        >
          <Icon name="X" class="w-5 h-5" />
        </button>
      </div>

      {/* Contador VISIBLE (se actualiza al instante, sin aria-live) + región viva SOLO
          para lectores de pantalla, con su propio retardo: anunciar en cada pausa de
          tecleo encola avisos que se pisan unos a otros. */}
      <p id="pd-search-status" class="mt-2.5 text-center text-xs text-gray-500 break-words">
        {productsCount} producten
      </p>
      <p id="pd-search-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>

  {/* ===== Tag Filter ===== */}
  <section class="px-4 pb-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap justify-center gap-2">
        {ALL_TAGS.map((tag) => (
          <button
            type="button"
            data-tag-btn
            data-tag={tag.id}
            class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 ${tag.id === 'all' ? 'bg-[#FFD700] text-black' : 'bg-white/5 text-gray-400 border border-white/10 hover:border-[#FFD700]/30 hover:text-white'}`}
          >
            {(tag as any).iconName && <Icon name={(tag as any).iconName} class="w-3.5 h-3.5 inline mr-1.5 -mt-0.5" />}
            {tag.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Products Grid — 3 columns (todas las cards en el DOM; JS pagina/filtra) ===== */}
  <section id="pd-products-section" class="px-4 pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((product, idx) => {
        const Card = product.href ? 'a' : 'div';
        const featured = (product as any).featured;
        const cls = product.href
          ? `group relative bg-white/[0.03] rounded-2xl overflow-hidden hover:bg-white/[0.05] transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 hover:border-emerald-400/70 ring-1 ring-emerald-500/20' : 'border border-white/10 hover:border-[#FFD700]/30'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`
          : `relative bg-white/[0.03] rounded-2xl overflow-hidden transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 ring-1 ring-emerald-500/20' : 'border border-white/10'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`;
        return (
        <Card
          href={product.href ?? undefined}
          target={product.href ? '_blank' : undefined}
          rel={product.href ? 'noopener noreferrer' : undefined}
          data-product
          data-nl-live={product.href ? 'true' : 'false'}
          data-tags={product.tags.join(' ')}
          data-search={indiceProducto(product)}
          class={cls}
        >
          {/* Badge */}
          <div class="absolute top-3 right-3 z-10">
            {product.href ? (
              <span class={`px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm ${product.badgeColor}`}>
                {product.badge}
              </span>
            ) : (
              <span class="px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm bg-[#FFD700]/15 text-[#FFD700] ring-1 ring-[#FFD700]/30">Binnenkort in het Nederlands</span>
            )}
          </div>

          {/* Image */}
