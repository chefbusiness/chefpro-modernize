              </div>
              <h2 class="text-lg md:text-base lg:text-lg font-bold text-white group-hover:text-[#FFD700] transition-colors leading-tight">
                {product.name}
              </h2>
            </div>

            <p class="text-gray-400 text-sm leading-relaxed mb-4">
              {product.description}
            </p>

            {/* Features */}
            <ul class="space-y-1.5 mb-5 flex-1">
              {product.features.map((feature) => (
                <li class="flex items-start gap-2 text-xs text-gray-300">
                  <Icon name="Check" class="w-3.5 h-3.5 text-[#FFD700] flex-shrink-0 mt-0.5" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            {/* Tags */}
            <div class="flex flex-wrap gap-1.5 mb-4">
              {product.tags.map((tagId) => {
                const label = tagLabel(tagId);
                return label ? (
                  <span class="px-2 py-0.5 rounded-full bg-white/5 text-gray-500 text-[10px] font-medium">
                    {label}
                  </span>
                ) : null;
              })}
            </div>

            {/* Price + CTA (solo con producto vivo en EN: precio USD, sin tachado ni descuento) */}
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
              {product.href ? (
                <>
                  <div class="flex items-center gap-2">
                    {product.price && <span class="text-2xl font-extrabold text-[#FFD700]">{product.price}</span>}
                  </div>
                  <div class="flex items-center gap-1 text-[#FFD700] text-xs font-medium group-hover:gap-2 transition-all">
                    Bekijken
                    <Icon name="ArrowRight" class="w-3.5 h-3.5" />
                  </div>
                </>
              ) : (
                <span class="text-xs text-gray-500">Nederlandse editie in voorbereiding</span>
              )}
            </div>
          </div>
        </Card>
        );
      })}
    </div>

