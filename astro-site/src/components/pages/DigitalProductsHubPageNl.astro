  { iconName: 'Truck', name: 'Businessplan: mobiele houtovenpizza', desc: 'Een houtoven op een aanhanger voor bruiloften en beurzen: apparatuur, deeg, tarieven en logistiek.', tags: ['business-plan', 'pizzeria', 'mobile-catering'], phase: 'Binnenkort' },
  { iconName: 'Star', name: 'AI Review Analyse Kit', desc: 'Een sjabloon en prompts voor uw agents: exporteer of plak uw reviews, sorteer ze op onderwerp en zie wat steeds terugkomt.', tags: ['excel', 'ai', 'management'], phase: 'Binnenkort' },
  { iconName: 'Users', name: 'Personeelshandboek voor de horeca', desc: 'Onboardinghandboek, huisregels, hygiëne, training per functie en voorbeelddocumenten die u kunt aanpassen aan uw cao.', tags: ['manuals', 'management', 'pdf'], phase: 'Binnenkort' },
