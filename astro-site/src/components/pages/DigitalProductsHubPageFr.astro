  { iconName: 'ConciergeBell', name: 'Plan d\'affaires : Service de découpe de jambon pour événements', desc: 'Mettez en place votre service de découpe de jambon pour mariages et foires : tarifs, équipement et portions par événement.', tags: ['business-plan', 'catering', 'mobile-catering'], phase: 'Bientôt disponible' },
  { iconName: 'Coffee', name: 'Plan d\'affaires : Bar à café mobile pour événements', desc: 'Café de spécialité pour événements d\'entreprise, mariages et foires : investissement minimal, tarifs et logistique.', tags: ['business-plan', 'cafe', 'mobile-catering'], phase: 'Bientôt disponible' },
  { iconName: 'Truck', name: 'Plan d\'affaires : Pizzeria mobile au feu de bois', desc: 'Un four à bois sur remorque pour mariages et foires : équipement, pâtes, tarifs et logistique.', tags: ['business-plan', 'pizzeria', 'mobile-catering'], phase: 'Bientôt disponible' },
  { iconName: 'Star', name: 'Kit d\'analyse des avis par IA', desc: 'Un modèle et des prompts pour vos agents : exportez ou collez vos avis, triez-les par thème et voyez ce qui revient le plus souvent.', tags: ['excel', 'ai', 'management'], phase: 'Bientôt disponible' },
  { iconName: 'Users', name: 'Manuel de l\'employé en hôtellerie-restauration', desc: 'Manuel d\'intégration, règles internes, hygiène, formation par poste et documents types à adapter à votre convention collective.', tags: ['manuals', 'management', 'pdf'], phase: 'Bientôt disponible' },
  { iconName: 'CakeSlice', name: 'Plan d\'affaires : Pâtisserie et laboratoire de production', desc: 'Le plan financier de votre laboratoire de pâtisserie : investissement, production, comptoir de vente et prix de vente.', tags: ['business-plan', 'pastry', 'excel'], phase: 'Bientôt disponible' },
  { iconName: 'Thermometer', name: 'Livre numérique professionnel de cuisson sous vide', desc: 'Tableaux de temps et de température par produit, pasteurisation, HACCP pour la mise sous vide et le réchauffage.', tags: ['pdf', 'restaurant', 'food-safety'], phase: 'Bientôt disponible' },
  { iconName: 'Fish', name: 'Comment ouvrir un restaurant de fruits de mer', desc: 'Bassins d\'eau de mer, mareyage, purification et salle : le guide complet pour ouvrir un restaurant de fruits de mer, avec ses modèles de documents.', tags: ['pdf', 'guides', 'restaurant'], phase: 'Bientôt disponible' },
  { iconName: 'Store', name: 'Comment ouvrir une boucherie haut de gamme', desc: 'Maturation à sec, boucherie et comptoir signature : le guide pour ouvrir une boucherie haut de gamme avec cuisine.', tags: ['pdf', 'guides', 'management'], phase: 'Bientôt disponible' },
];

const PRODUCTS_PER_PAGE = 12;

// Etiqueta de un tag (los tags sin entrada en ALL_TAGS — 'bundle', 'production-kitchen', 'tapas'… —
// no renderizan pill, igual que en el hub ES).
const tagLabel = (id: string) => ALL_TAGS.find((t) => t.id === id)?.label;

// ── Tarjeta → producto FR vivo (FAMILIAS de lib/tienda.ts) ───────────────────────────
// Sin familia o con `fr.vivo: false` → null: la tarjeta se pinta sin enlace ni precio y con el
// badge «Bientôt disponible en français». Con familia viva → landing FR + precio EUR (el que cobra el checkout).
const frVivo = (slugEs: string) => {
  const f = FAMILIAS.find((x) => x.productos.es?.slug === slugEs.replace(/^\//, ''));
  const fr = f?.productos.fr;
  return fr && fr.vivo ? fr.slug : null;
};
const precioEur = (id: string) => {
  const v = PRODUCT_PRICES[id]?.eur;
  return typeof v === 'number' ? `${v} €` : null;
};
const cards = products.map((p) => {
  const frSlug = frVivo(p.slug);
  return {
    ...p,
    frSlug,
    href: frSlug ? tiendaProductoPath('fr', frSlug) : null,
    price: frSlug ? precioEur(frSlug) : null,
  };
});
const liveCards = cards.filter((c) => c.href);

// ── Buscador: índice de texto por card (data-search) ────────────────────────────────
// Misma normalización que el hub ES (indiceBusqueda). Sin el slug ES ni sus alias en español.
const indiceProducto = (p: { name: string; description: string; features: string[]; tags: string[] }) =>
  indiceBusqueda([p.name, p.description, ...p.features, ...p.tags, ...p.tags.map(tagLabel)]);

// Contadores del badge del hero.
const productsCount = products.length;
const comingSoonCount = comingSoon.length;

// WhatsApp (mismo número que el hub ES; mensaje prerellenado en francés).
const waPhone = '34744717942';
const waMessage = encodeURIComponent('Bonjour, j\'ai besoin d\'aide avec mon achat sur AI Chef Pro. ');
const waUrl = `https://wa.me/${waPhone}?text=${waMessage}`;

// Worldwide countries.
const countries = ['Espagne', 'Mexique', 'Colombie', 'Argentine', 'Chili', 'Pérou', 'Équateur', 'États-Unis', 'Allemagne', 'France'];

// FAQ VISIBLE (y fuente del FAQPage JSON-LD).
const faqs = [
  { q: 'Sous quel format sont livrés les produits numériques ?', a: 'La plupart sont des modèles Excel (.xlsx) compatibles avec Microsoft Excel, Google Sheets, LibreOffice et Apple Numbers. Nous incluons également des guides et des listes de contrôle prêts à imprimer au format PDF. Vous téléchargez chaque fichier depuis votre tableau de bord privé.' },
  { q: 'Comment puis-je obtenir les produits après l\'achat ?', a: 'L\'accès est instantané. Dès que vous payez via Stripe, nous vous redirigeons vers votre tableau de bord privé, où vous pouvez télécharger chaque fichier. Vous recevez également un e-mail avec un lien magique pour y revenir quand vous le souhaitez.' },
  { q: 'Puis-je acheter depuis n\'importe où dans le monde ?', a: 'Oui. Vous pouvez acheter depuis n\'importe où avec une carte bancaire, Apple Pay ou Google Pay. Le catalogue actuel est rédigé en espagnol et conçu autour des réglementations espagnoles et européennes ; les éditions françaises arrivent et apparaîtront sur cette page dès que chacune sera prête.' },
  { q: 'Les modèles incluent-ils des formules automatiques ?', a: 'Oui. Chaque modèle Excel est livré avec des formules intégrées qui font les calculs pour vous : coût matière, prix de vente suggéré, alertes de température et suivi des pertes. Vous saisissez vos chiffres et le tableur fait le reste.' },
  { q: 'Y a-t-il une garantie de remboursement ?', a: 'Chaque produit est couvert par une garantie intégrale de 30 jours. Si vous n\'êtes pas satisfait, nous vous remboursons à 100 %, sans aucune question. Écrivez simplement à info@aichef.pro.' },
  { q: 'Les mises à jour futures sont-elles incluses ?', a: 'Oui. Chaque produit inclut un accès à vie au tableau de bord en ligne. Lorsque nous ajoutons de nouveaux modèles, apportons des améliorations ou mettons à jour en fonction des évolutions réglementaires, vous les recevez sans frais supplémentaires.' },
  { q: 'Puis-je utiliser les modèles dans plus d\'un restaurant ?', a: 'Oui. La licence est personnelle : vous pouvez utiliser les modèles dans tous les établissements que vous gérez. Idéal pour les consultants, les groupes de restauration et les gestionnaires multi-sites.' },
  { q: 'Quels moyens de paiement acceptez-vous ?', a: 'Les paiements sont traités par Stripe, l\'une des plateformes de paiement les plus sécurisées au monde. Nous acceptons les cartes de crédit et de débit (Visa, Mastercard, Amex), Apple Pay, Google Pay et Link (paiement rapide Stripe).' },
];

// pSEO cities (las guías por ciudad solo existen en español: se listan sin enlace).
const cities = [
  { slug: 'madrid', label: 'Madrid' },
  { slug: 'barcelona', label: 'Barcelone' },
  { slug: 'valencia', label: 'Valence' },
  { slug: 'ciudad-de-mexico', label: 'Mexico' },
  { slug: 'monterrey', label: 'Monterrey' },
  { slug: 'bogota', label: 'Bogotá' },
  { slug: 'medellin', label: 'Medellín' },
  { slug: 'buenos-aires', label: 'Buenos Aires' },
  { slug: 'santiago', label: 'Santiago' },
];

// ── JSON-LD (CollectionPage + FAQPage + BreadcrumbList, en francés y sin ofertas ni rating) ──
const HUB_URL = 'https://aichef.pro/fr/produits-numeriques';
const collectionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Produits numériques pour la restauration et l\'hôtellerie — AI Chef Pro',
  description: 'Modèles Excel, guides HACCP, prompts d\'IA et outils numériques pour chefs, directeurs et propriétaires de restaurants.',
  url: HUB_URL,
  inLanguage: 'fr',
  publisher: {
    '@type': 'Organization',
    name: 'AI Chef Pro',
    url: 'https://aichef.pro/fr',
  },
};
// El ItemList solo lista productos VIVOS en francés (hoy ninguno → sin mainEntity).
if (liveCards.length) {
  collectionSchema.mainEntity = {
    '@type': 'ItemList',
    itemListElement: liveCards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://aichef.pro${c.href}`,
      name: c.name,
    })),
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fr',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: 'https://aichef.pro/fr' },
    { '@type': 'ListItem', position: 2, name: 'Produits numériques', item: HUB_URL },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<div class="min-h-screen bg-[#0a0a0a]">
  {/* ===== SaasDiscoveryBanner ===== */}
  <div class="bg-gradient-to-r from-[#FFD700]/10 via-[#FFD700]/5 to-[#FFD700]/10 border-b border-[#FFD700]/20">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-2 sm:gap-3 text-center">
      <Icon name="Sparkles" class="h-3.5 w-3.5 text-[#FFD700] flex-shrink-0 hidden sm:block" />
      <p class="text-xs sm:text-sm text-gray-300">
        <span class="hidden sm:inline">Ces produits numériques complètent </span>
        <a href="/fr" class="font-semibold text-[#FFD700] hover:text-[#FFD700]/80 transition-colors">AI Chef Pro</a>
        <span class="hidden sm:inline"> — l'IA SaaS pour l'hôtellerie-restauration avec plus de 55 applications</span>
        <span class="sm:hidden"> — IA SaaS pour l'hôtellerie-restauration</span>
      </p>
      <a href="/fr" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#FFD700]/15 border border-[#FFD700]/30 text-[#FFD700] text-xs font-semibold hover:bg-[#FFD700]/25 transition-colors whitespace-nowrap flex-shrink-0">
        Découvrir
        <Icon name="ArrowRight" class="h-3 w-3" />
      </a>
    </div>
  </div>

  {/* ===== Hero ===== */}
  <section class="relative px-4 pt-6 pb-12 md:pt-8 md:pb-16 overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,215,0,0.08) 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto text-center z-10">
      {/* LogoBadge (isHub → no back pill, just the white logo card) */}
      <div>
        <div class="flex justify-center py-6 md:py-8">
          <a href="/fr" class="inline-flex items-center px-6 py-3 bg-white rounded-2xl shadow-lg shadow-white/5 hover:shadow-white/10 transition-shadow">
            <img src="/logo-ai-chef-pro.svg" alt="AI Chef Pro" class="h-8 md:h-9 w-auto" />
          </a>
        </div>
      </div>
      <span class="inline-block mt-4 mb-6 px-4 py-1.5 rounded-full bg-[#FFD700]/10 border border-[#FFD700]/30 text-[#FFD700] text-sm font-medium">
        {productsCount} produits · {comingSoonCount} en développement
      </span>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        La Boutique de <span class="text-[#FFD700]">Produits Numériques</span> pour l&rsquo;Hôtellerie-Restauration d&rsquo;Aujourd&rsquo;hui
      </h1>

      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        eBooks, modèles Excel, guides de sécurité alimentaire et prompts IA conçus par et pour les professionnels de l'hôtellerie-restauration. Téléchargement instantané, accès à vie.
      </p>
    </div>
  </section>

  {/* ===== Buscador (filtra las MISMAS cards que los chips; la lógica va en el script del final) =====
       El panel de «no hay resultados» NO vive aquí: está debajo del grid (#pd-search-empty).
       Si estuviera encima de los chips, aparecer y desaparecer al teclear empujaría chips y
       cards ~200 px arriba y abajo, y el clic sobre una card acabaría en otra cosa. */}
  <section id="pd-search-section" class="px-4 pb-6">
    <div class="max-w-2xl mx-auto" role="search">
      <label for="pd-search-input" class="sr-only">Rechercher des produits par nom, thème ou type d'établissement</label>
      {/* Descripción ESTÁTICA del campo, separada del contador a propósito: si el
          aria-describedby apuntara a la región viva, el lector de pantalla leería el
          conteo al enfocar Y otra vez en cada mutación (una por pausa de tecleo). */}
      <span id="pd-search-ayuda" class="sr-only">
        Saisissez au moins deux lettres. La liste se filtre au fur et à mesure que vous tapez ; appuyez sur Échap pour effacer la recherche.
      </span>

      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-[#FFD700]">
          <Icon name="Search" class="w-5 h-5" />
        </span>
        <input
          id="pd-search-input"
          type="search"
          maxlength="120"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-describedby="pd-search-ayuda"
          placeholder="Rechercher par thème ou type d'établissement : coût matière, HACCP, food truck…"
          class="w-full h-14 pl-5 pr-16 rounded-2xl bg-white/5 border-2 border-[#FFD700]/70 shadow-[0_0_24px_rgba(255,215,0,0.12)] text-white text-base placeholder:text-gray-400 outline-none transition-colors duration-200 focus:border-[#FFD700] focus:bg-white/[0.07] focus:ring-2 focus:ring-[#FFD700]/30"
        />
        <button
          id="pd-search-clear"
          type="button"
          aria-label="Effacer la recherche"
          class="hidden absolute inset-y-0 right-11 items-center pr-1 text-gray-500 hover:text-[#FFD700] transition-colors"
        >
          <Icon name="X" class="w-5 h-5" />
        </button>
      </div>

      {/* Contador VISIBLE (se actualiza al instante, sin aria-live) + región viva SOLO
          para lectores de pantalla, con su propio retardo: anunciar en cada pausa de
          tecleo encola avisos que se pisan unos a otros. */}
      <p id="pd-search-status" class="mt-2.5 text-center text-xs text-gray-500 break-words">
        {productsCount} produits
      </p>
      <p id="pd-search-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>

  {/* ===== Tag Filter ===== */}
  <section class="px-4 pb-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap justify-center gap-2">
        {ALL_TAGS.map((tag) => (
          <button
            type="button"
            data-tag-btn
            data-tag={tag.id}
            class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 ${tag.id === 'all' ? 'bg-[#FFD700] text-black' : 'bg-white/5 text-gray-400 border border-white/10 hover:border-[#FFD700]/30 hover:text-white'}`}
          >
            {(tag as any).iconName && <Icon name={(tag as any).iconName} class="w-3.5 h-3.5 inline mr-1.5 -mt-0.5" />}
            {tag.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Products Grid — 3 columns (todas las cards en el DOM; JS pagina/filtra) ===== */}
  <section id="pd-products-section" class="px-4 pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((product, idx) => {
        const Card = product.href ? 'a' : 'div';
        const featured = (product as any).featured;
        const cls = product.href
          ? `group relative bg-white/[0.03] rounded-2xl overflow-hidden hover:bg-white/[0.05] transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 hover:border-emerald-400/70 ring-1 ring-emerald-500/20' : 'border border-white/10 hover:border-[#FFD700]/30'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`
          : `relative bg-white/[0.03] rounded-2xl overflow-hidden transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 ring-1 ring-emerald-500/20' : 'border border-white/10'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`;
        return (
        <Card
          href={product.href ?? undefined}
          target={product.href ? '_blank' : undefined}
          rel={product.href ? 'noopener noreferrer' : undefined}
          data-product
          data-fr-live={product.href ? 'true' : 'false'}
          data-tags={product.tags.join(' ')}
          data-search={indiceProducto(product)}
          class={cls}
        >
          {/* Badge */}
          <div class="absolute top-3 right-3 z-10">
            {product.href ? (
              <span class={`px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm ${product.badgeColor}`}>
                {product.badge}
              </span>
            ) : (
              <span class="px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm bg-[#FFD700]/15 text-[#FFD700] ring-1 ring-[#FFD700]/30">Bientôt disponible en français</span>
            )}
          </div>

          {/* Image */}
          <div class="relative h-40 overflow-hidden bg-gradient-to-b from-white/[0.05] to-transparent">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
