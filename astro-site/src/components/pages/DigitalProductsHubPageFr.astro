const comingSoon = [
  { iconName: 'Coffee', name: 'Comment ouvrir une boutique de churros et chocolat chaud', desc: 'Chocolat chaud épais et churros : locaux, laboratoire de production, carte, licences et chiffres clés pour ouvrir l\'esprit tranquille.', tags: ['pdf', 'guides', 'chocolate'], phase: 'T4 2026' },
  { iconName: 'IceCream', name: 'Plan d\'affaires : Gelateria artisanale', desc: 'Plan financier Excel, investissement de départ, saisonnalité et liste de contrôle pour l\'ouverture de votre gelateria.', tags: ['business-plan', 'ice-cream', 'excel'], phase: 'T4 2026' },
  { iconName: 'BarChart3', name: 'Kit de tableau de bord des opérations', desc: 'Ventes par créneau horaire et par zone de salle, ticket moyen, rotation des tables et productivité horaire, dans un seul tableau de bord.', tags: ['excel', 'management', 'templates'], phase: 'T4 2026' },
  { iconName: 'Sandwich', name: 'Plan d\'affaires : Restaurant de smash burgers', desc: 'Du concept smash au seuil de rentabilité : investissement, carte, coûts et prévision mois par mois.', tags: ['business-plan', 'burger', 'excel'], phase: 'T4 2026' },
