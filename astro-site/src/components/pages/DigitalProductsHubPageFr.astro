  { iconName: 'Utensils', name: 'Tâches récurrentes : Areperia', desc: 'Pâte, garnitures, plancha et fermeture : la routine quotidienne d\'une areperia écrite noir sur blanc, service par service.', tags: ['templates', 'excel', 'restaurant'], phase: 'T1 2027' },
  { iconName: 'Pizza', name: 'Plan d\'affaires : Pizzeria napolitaine', desc: 'Levain, four et rotation des tables : le plan complet pour ouvrir une pizzeria napolitaine.', tags: ['business-plan', 'pizzeria', 'excel'], phase: 'T1 2027' },
  { iconName: 'Beef', name: 'Plan d\'affaires : Steakhouse', desc: 'Un local fixe avec une armoire de maturation à sec et un grill au charbon de bois : investissement, carte, coût matière des recettes et prévisionnel.', tags: ['business-plan', 'restaurant', 'excel'], phase: 'T1 2027' },
