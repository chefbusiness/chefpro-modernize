  { iconName: 'CakeSlice', name: 'Business Plan: Pasticceria e Laboratorio di Produzione', desc: 'Il piano finanziario per il tuo laboratorio di pasticceria: investimento, produzione, banco vendita e prezzi di listino.', tags: ['business-plan', 'pastry', 'excel'], phase: 'Prossimamente' },
  { iconName: 'Thermometer', name: 'eBook Professionale sulla Cottura Sous Vide', desc: 'Tabelle di tempo e temperatura per prodotto, pastorizzazione, HACCP per il sottovuoto e il riscaldamento.', tags: ['pdf', 'restaurant', 'food-safety'], phase: 'Prossimamente' },
  { iconName: 'Fish', name: 'Come Aprire un Ristorante di Pesce', desc: 'Vasche vive, pescheria, depurazione e sala: la guida completa per aprire un ristorante di pesce, con i relativi template.', tags: ['pdf', 'guides', 'restaurant'], phase: 'Prossimamente' },
  { iconName: 'Store', name: 'Come Aprire una Macelleria di Qualità', desc: 'Frollatura, macelleria e un banco di eccellenza: la guida per aprire una macelleria premium con cucina.', tags: ['pdf', 'guides', 'management'], phase: 'Prossimamente' },
];

const PRODUCTS_PER_PAGE = 12;

// Etiqueta de un tag (los tags sin entrada en ALL_TAGS — 'bundle', 'production-kitchen', 'tapas'… —
// no renderizan pill, igual que en el hub ES).
const tagLabel = (id: string) => ALL_TAGS.find((t) => t.id === id)?.label;

// ── Tarjeta → producto IT vivo (FAMILIAS de lib/tienda.ts) ───────────────────────────
// Sin familia o con `it.vivo: false` → null: la tarjeta se pinta sin enlace ni precio y con el
// badge «Presto disponibile in italiano». Con familia viva → landing IT + precio EUR (el que cobra el checkout).
const itVivo = (slugEs: string) => {
  const f = FAMILIAS.find((x) => x.productos.es?.slug === slugEs.replace(/^\//, ''));
  const it = f?.productos.it;
  return it && it.vivo ? it.slug : null;
};
const precioEur = (id: string) => {
  const v = PRODUCT_PRICES[id]?.eur;
  return typeof v === 'number' ? `€${v}` : null;
};
const cards = products.map((p) => {
  const itSlug = itVivo(p.slug);
  return {
    ...p,
    itSlug,
    href: itSlug ? tiendaProductoPath('it', itSlug) : null,
    price: itSlug ? precioEur(itSlug) : null,
  };
});
const liveCards = cards.filter((c) => c.href);

// ── Buscador: índice de texto por card (data-search) ────────────────────────────────
// Misma normalización que el hub ES (indiceBusqueda). Sin el slug ES ni sus alias en español.
const indiceProducto = (p: { name: string; description: string; features: string[]; tags: string[] }) =>
  indiceBusqueda([p.name, p.description, ...p.features, ...p.tags, ...p.tags.map(tagLabel)]);

// Contadores del badge del hero.
const productsCount = products.length;
const comingSoonCount = comingSoon.length;

// WhatsApp (mismo número que el hub ES; mensaje prerellenado en italiano).
const waPhone = '34744717942';
const waMessage = encodeURIComponent('Ciao, ho bisogno di aiuto con il mio acquisto AI Chef Pro. ');
const waUrl = `https://wa.me/${waPhone}?text=${waMessage}`;

// Worldwide countries.
const countries = ['Spagna', 'Messico', 'Colombia', 'Argentina', 'Cile', 'Perù', 'Ecuador', 'USA', 'Germania', 'Francia'];

// FAQ VISIBLE (y fuente del FAQPage JSON-LD).
const faqs = [
  { q: 'In che formato sono i prodotti digitali?', a: 'La maggior parte sono template Excel (.xlsx) compatibili con Microsoft Excel, Google Sheets, LibreOffice e Apple Numbers. Sono incluse anche guide operative e checklist in PDF, pronte per la stampa. Scarichi tutti i file direttamente dalla tua area riservata.' },
  { q: 'Come ricevo i prodotti dopo l\'acquisto?', a: 'L\'accesso è immediato. Non appena il pagamento viene elaborato tramite Stripe, vieni reindirizzato alla tua area riservata, dove puoi scaricare tutti i file. Ricevi inoltre un\'email con un link diretto per accedere in qualsiasi momento.' },
  { q: 'Posso acquistare da qualsiasi parte del mondo?', a: 'Sì. Puoi acquistare da qualsiasi paese con carta, Apple Pay o Google Pay. Il catalogo attuale è redatto in spagnolo e strutturato secondo la normativa spagnola e UE; le edizioni in italiano sono in lavorazione e verranno pubblicate su questa pagina man mano che saranno disponibili.' },
  { q: 'I template includono formule automatiche?', a: 'Sì. Ogni template Excel integra formule preimpostate che calcolano automaticamente food cost, prezzo di vendita consigliato, alert di temperatura e monitoraggio degli sprechi. Inserisci i tuoi dati e il foglio di calcolo fa tutto il resto.' },
  { q: 'È prevista una garanzia soddisfatti o rimborsati?', a: 'Ogni prodotto è coperto da garanzia soddisfatti o rimborsati di 30 giorni. Se non sei soddisfatto, rimborsiamo il 100% dell\'importo, senza fare domande. Scrivi a info@aichef.pro.' },
  { q: 'Gli aggiornamenti futuri sono inclusi?', a: 'Sì. Ogni prodotto include accesso a vita all\'area riservata online. Quando aggiungiamo nuovi template, apportiamo miglioramenti o aggiorniamo i contenuti in base a variazioni normative, li ricevi senza costi aggiuntivi.' },
  { q: 'Posso usare i template in più di un locale?', a: 'Sì. La licenza è personale: puoi utilizzare i template in tutti i locali che gestisci. La soluzione ideale per consulenti, gruppi di ristorazione e responsabili multi-sede.' },
  { q: 'Quali metodi di pagamento accettate?', a: 'I pagamenti sono gestiti da Stripe, una delle piattaforme di pagamento più sicure al mondo. Accettiamo carte di credito e debito (Visa, Mastercard, Amex), Apple Pay, Google Pay e Link (checkout rapido Stripe).' },
];

// pSEO cities (las guías por ciudad solo existen en español: se listan sin enlace).
const cities = [
  { slug: 'madrid', label: 'Madrid' },
  { slug: 'barcelona', label: 'Barcellona' },
  { slug: 'valencia', label: 'Valencia' },
  { slug: 'ciudad-de-mexico', label: 'Città del Messico' },
  { slug: 'monterrey', label: 'Monterrey' },
  { slug: 'bogota', label: 'Bogotà' },
  { slug: 'medellin', label: 'Medellín' },
  { slug: 'buenos-aires', label: 'Buenos Aires' },
  { slug: 'santiago', label: 'Santiago' },
];

// ── JSON-LD (CollectionPage + FAQPage + BreadcrumbList, en italiano y sin ofertas ni rating) ──
const HUB_URL = 'https://aichef.pro/it/prodotti-digitali';
const collectionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Prodotti Digitali per Ristoranti e Ospitalità — AI Chef Pro',
  description: 'Template Excel, guide HACCP, prompt per l\'IA e strumenti digitali per chef, responsabili di sala e titolari di ristorante.',
  url: HUB_URL,
  inLanguage: 'it',
  publisher: {
    '@type': 'Organization',
    name: 'AI Chef Pro',
    url: 'https://aichef.pro/it',
  },
};
// El ItemList solo lista productos VIVOS en italiano (hoy ninguno → sin mainEntity).
if (liveCards.length) {
  collectionSchema.mainEntity = {
    '@type': 'ItemList',
    itemListElement: liveCards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://aichef.pro${c.href}`,
      name: c.name,
    })),
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'it',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: 'https://aichef.pro/it' },
    { '@type': 'ListItem', position: 2, name: 'Prodotti Digitali', item: HUB_URL },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<div class="min-h-screen bg-[#0a0a0a]">
  {/* ===== SaasDiscoveryBanner ===== */}
  <div class="bg-gradient-to-r from-[#FFD700]/10 via-[#FFD700]/5 to-[#FFD700]/10 border-b border-[#FFD700]/20">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-2 sm:gap-3 text-center">
      <Icon name="Sparkles" class="h-3.5 w-3.5 text-[#FFD700] flex-shrink-0 hidden sm:block" />
      <p class="text-xs sm:text-sm text-gray-300">
        <span class="hidden sm:inline">Questi prodotti digitali completano </span>
        <a href="/it" class="font-semibold text-[#FFD700] hover:text-[#FFD700]/80 transition-colors">AI Chef Pro</a>
        <span class="hidden sm:inline"> — il SaaS di IA per la ristorazione con oltre 55 app</span>
        <span class="sm:hidden"> — SaaS di IA per la ristorazione</span>
      </p>
      <a href="/it" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#FFD700]/15 border border-[#FFD700]/30 text-[#FFD700] text-xs font-semibold hover:bg-[#FFD700]/25 transition-colors whitespace-nowrap flex-shrink-0">
        Scopri
        <Icon name="ArrowRight" class="h-3 w-3" />
      </a>
    </div>
  </div>

  {/* ===== Hero ===== */}
  <section class="relative px-4 pt-6 pb-12 md:pt-8 md:pb-16 overflow-hidden">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,215,0,0.08) 0%, transparent 70%);"></div>

    <div class="relative max-w-4xl mx-auto text-center z-10">
      {/* LogoBadge (isHub → no back pill, just the white logo card) */}
      <div>
        <div class="flex justify-center py-6 md:py-8">
          <a href="/it" class="inline-flex items-center px-6 py-3 bg-white rounded-2xl shadow-lg shadow-white/5 hover:shadow-white/10 transition-shadow">
            <img src="/logo-ai-chef-pro.svg" alt="AI Chef Pro" class="h-8 md:h-9 w-auto" />
          </a>
        </div>
      </div>
      <span class="inline-block mt-4 mb-6 px-4 py-1.5 rounded-full bg-[#FFD700]/10 border border-[#FFD700]/30 text-[#FFD700] text-sm font-medium">
        {productsCount} prodotti · {comingSoonCount} in sviluppo
      </span>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
        Il Negozio di Prodotti <span class="text-[#FFD700]">Digitali</span> per la Ristorazione di Oggi
      </h1>

      <p class="text-lg md:text-xl text-gray-300 max-w-3xl mx-auto leading-relaxed">
        eBook, modelli Excel, guide sulla sicurezza alimentare e prompt di IA pensati da e per professionisti della ristorazione. Download immediato, accesso a vita.
      </p>
    </div>
  </section>

  {/* ===== Buscador (filtra las MISMAS cards que los chips; la lógica va en el script del final) =====
       El panel de «no hay resultados» NO vive aquí: está debajo del grid (#pd-search-empty).
       Si estuviera encima de los chips, aparecer y desaparecer al teclear empujaría chips y
       cards ~200 px arriba y abajo, y el clic sobre una card acabaría en otra cosa. */}
  <section id="pd-search-section" class="px-4 pb-6">
    <div class="max-w-2xl mx-auto" role="search">
      <label for="pd-search-input" class="sr-only">Cerca prodotti per nome, argomento o tipo di attività</label>
      {/* Descripción ESTÁTICA del campo, separada del contador a propósito: si el
          aria-describedby apuntara a la región viva, el lector de pantalla leería el
          conteo al enfocar Y otra vez en cada mutación (una por pausa de tecleo). */}
      <span id="pd-search-ayuda" class="sr-only">
        Digita almeno due lettere. L'elenco si filtra mentre scrivi; premi Esc per cancellare la ricerca.
      </span>

      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-[#FFD700]">
          <Icon name="Search" class="w-5 h-5" />
        </span>
        <input
          id="pd-search-input"
          type="search"
          maxlength="120"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-describedby="pd-search-ayuda"
          placeholder="Cerca per argomento o attività: distinta base, HACCP, food truck…"
          class="w-full h-14 pl-5 pr-16 rounded-2xl bg-white/5 border-2 border-[#FFD700]/70 shadow-[0_0_24px_rgba(255,215,0,0.12)] text-white text-base placeholder:text-gray-400 outline-none transition-colors duration-200 focus:border-[#FFD700] focus:bg-white/[0.07] focus:ring-2 focus:ring-[#FFD700]/30"
        />
        <button
          id="pd-search-clear"
          type="button"
          aria-label="Cancella la ricerca"
          class="hidden absolute inset-y-0 right-11 items-center pr-1 text-gray-500 hover:text-[#FFD700] transition-colors"
        >
          <Icon name="X" class="w-5 h-5" />
        </button>
      </div>

      {/* Contador VISIBLE (se actualiza al instante, sin aria-live) + región viva SOLO
          para lectores de pantalla, con su propio retardo: anunciar en cada pausa de
          tecleo encola avisos que se pisan unos a otros. */}
      <p id="pd-search-status" class="mt-2.5 text-center text-xs text-gray-500 break-words">
        {productsCount} prodotti
      </p>
      <p id="pd-search-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>

  {/* ===== Tag Filter ===== */}
  <section class="px-4 pb-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap justify-center gap-2">
        {ALL_TAGS.map((tag) => (
          <button
            type="button"
            data-tag-btn
            data-tag={tag.id}
            class={`px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 ${tag.id === 'all' ? 'bg-[#FFD700] text-black' : 'bg-white/5 text-gray-400 border border-white/10 hover:border-[#FFD700]/30 hover:text-white'}`}
          >
            {(tag as any).iconName && <Icon name={(tag as any).iconName} class="w-3.5 h-3.5 inline mr-1.5 -mt-0.5" />}
            {tag.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* ===== Products Grid — 3 columns (todas las cards en el DOM; JS pagina/filtra) ===== */}
  <section id="pd-products-section" class="px-4 pb-16 md:pb-24">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((product, idx) => {
        const Card = product.href ? 'a' : 'div';
        const featured = (product as any).featured;
        const cls = product.href
          ? `group relative bg-white/[0.03] rounded-2xl overflow-hidden hover:bg-white/[0.05] transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 hover:border-emerald-400/70 ring-1 ring-emerald-500/20' : 'border border-white/10 hover:border-[#FFD700]/30'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`
          : `relative bg-white/[0.03] rounded-2xl overflow-hidden transition-all duration-300 flex flex-col ${featured ? 'border-2 border-emerald-500/50 ring-1 ring-emerald-500/20' : 'border border-white/10'}${idx >= PRODUCTS_PER_PAGE ? ' hidden' : ''}`;
        return (
        <Card
          href={product.href ?? undefined}
          target={product.href ? '_blank' : undefined}
          rel={product.href ? 'noopener noreferrer' : undefined}
          data-product
          data-it-live={product.href ? 'true' : 'false'}
          data-tags={product.tags.join(' ')}
          data-search={indiceProducto(product)}
          class={cls}
        >
          {/* Badge */}
          <div class="absolute top-3 right-3 z-10">
            {product.href ? (
              <span class={`px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm ${product.badgeColor}`}>
                {product.badge}
              </span>
            ) : (
              <span class="px-3 py-1 rounded-full text-xs font-bold shadow-lg shadow-black/40 backdrop-blur-sm bg-[#FFD700]/15 text-[#FFD700] ring-1 ring-[#FFD700]/30">Presto disponibile in italiano</span>
            )}
          </div>

          {/* Image */}
          <div class="relative h-40 overflow-hidden bg-gradient-to-b from-white/[0.05] to-transparent">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
          </div>

          {/* Content */}
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-9 h-9 rounded-xl bg-[#FFD700]/10 flex items-center justify-center flex-shrink-0">
