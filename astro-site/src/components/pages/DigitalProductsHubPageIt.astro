  { iconName: 'Utensils', name: 'Attività Ricorrenti: Areperia', desc: 'Impasto, farciture, piastra e chiusura: la routine quotidiana di un locale di arepas scritta turno per turno.', tags: ['templates', 'excel', 'restaurant'], phase: 'Q1 2027' },
  { iconName: 'Pizza', name: 'Business Plan: Pizzeria Napoletana', desc: 'Lievito madre, forno e rotazione dei tavoli: il piano completo per aprire una pizzeria napoletana.', tags: ['business-plan', 'pizzeria', 'excel'], phase: 'Q1 2027' },
  { iconName: 'Beef', name: 'Business Plan: Steakhouse', desc: 'Un locale fisso con cella di frollatura e griglia a carbonella: investimento, menù, distinta base e previsionale.', tags: ['business-plan', 'restaurant', 'excel'], phase: 'Q1 2027' },
