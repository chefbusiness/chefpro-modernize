  { iconName: 'Leaf', name: 'Attività Ricorrenti: Poke Bowl / Healthy Bowl', desc: 'Preparazione di basi e topping, catena del freddo, turni e chiusura per un bowl restaurant.', tags: ['templates', 'excel', 'restaurant'], phase: 'Prossimamente' },
  { iconName: 'Sprout', name: 'Attività Ricorrenti: Ristorante Vegetariano / Plant-Based', desc: 'Produzione di basi plant-based, allergeni, turni e chiusura per un ristorante vegetale.', tags: ['templates', 'excel', 'restaurant'], phase: 'Prossimamente' },
