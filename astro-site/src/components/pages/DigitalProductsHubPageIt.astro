const comingSoon = [
  { iconName: 'Coffee', name: 'Come Aprire una Churreria con Cioccolata Calda', desc: 'Cioccolata calda densa e churros: locale, laboratorio di produzione, menù, licenze e numeri per aprire con le idee chiare.', tags: ['pdf', 'guides', 'chocolate'], phase: 'Q4 2026' },
  { iconName: 'IceCream', name: 'Business Plan: Gelateria Artigianale', desc: 'Piano finanziario in Excel, investimento iniziale, stagionalità e checklist di apertura per la tua gelateria.', tags: ['business-plan', 'ice-cream', 'excel'], phase: 'Q4 2026' },
  { iconName: 'BarChart3', name: 'Kit Cruscotto Operativo', desc: 'Vendite per fascia oraria e area di servizio, scontrino medio, rotazione dei tavoli e produttività oraria, tutto in un\'unica dashboard.', tags: ['excel', 'management', 'templates'], phase: 'Q4 2026' },
  { iconName: 'Sandwich', name: 'Business Plan: Smash Burger', desc: 'Dal concetto smash burger al break-even: investimento, menù, costi e previsionale mese per mese.', tags: ['business-plan', 'burger', 'excel'], phase: 'Q4 2026' },
