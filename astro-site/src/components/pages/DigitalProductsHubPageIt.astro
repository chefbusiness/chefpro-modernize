  { iconName: 'Coffee', name: 'Business Plan: Bar Mobile da Caffetteria per Eventi', desc: 'Specialty coffee per eventi aziendali, matrimoni e fiere: investimento minimo, tariffe e logistica.', tags: ['business-plan', 'cafe', 'mobile-catering'], phase: 'Prossimamente' },
  { iconName: 'Truck', name: 'Business Plan: Pizza al Forno a Legna su Ruote', desc: 'Un forno a legna su rimorchio per matrimoni e fiere: attrezzatura, impasti, tariffe e logistica.', tags: ['business-plan', 'pizzeria', 'mobile-catering'], phase: 'Prossimamente' },
  { iconName: 'Star', name: 'Kit di Analisi Recensioni con IA', desc: 'Un template e prompt per i tuoi agenti: esporta o incolla le tue recensioni, classificale per argomento e scopri cosa si ripete.', tags: ['excel', 'ai', 'management'], phase: 'Prossimamente' },
