          {/* Image */}
          <div class="relative h-40 overflow-hidden bg-gradient-to-b from-white/[0.05] to-transparent">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
          </div>

          {/* Content */}
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center gap-2.5 mb-2">
              <div class="w-9 h-9 rounded-xl bg-[#FFD700]/10 flex items-center justify-center flex-shrink-0">
                <Icon name={product.iconName} class="w-4.5 h-4.5 text-[#FFD700]" />
              </div>
              <h2 class="text-lg md:text-base lg:text-lg font-bold text-white group-hover:text-[#FFD700] transition-colors leading-tight">
                {product.name}
              </h2>
            </div>

            <p class="text-gray-400 text-sm leading-relaxed mb-4">
              {product.description}
