  <a href={waUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp-Support" class="group fixed bottom-6 right-4 md:right-6 z-40">
    <div class="absolute right-full mr-3 top-1/2 -translate-y-1/2 bg-white/95 backdrop-blur-sm shadow-lg rounded-lg px-3 py-2 whitespace-nowrap transition-all duration-300 opacity-0 translate-x-2 pointer-events-none group-hover:opacity-100 group-hover:translate-x-0">
      <span class="text-xs font-medium text-gray-800">Problem mit Ihrem Kauf? Schreiben Sie uns</span>
      <div class="absolute left-full top-1/2 -translate-y-1/2 border-8 border-transparent border-l-white/95"></div>
    </div>
    <div class="relative transition-transform duration-300 hover:scale-110">
      <div class="absolute inset-0 rounded-full bg-green-500/30 animate-ping"></div>
      <div class="relative w-12 h-12 sm:w-14 sm:h-14 rounded-full border-2 border-white shadow-xl overflow-hidden bg-white">
        <img src="/assets/chef-john-guerrero-optimized.jpg" alt="Chef John Guerrero" loading="lazy" width="56" height="56" class="w-full h-full object-cover" />
      </div>
      <div class="absolute -bottom-1 -right-1 w-5 h-5 sm:w-6 sm:h-6 bg-green-500 rounded-full flex items-center justify-center shadow-lg border-2 border-white">
        <svg viewBox="0 0 24 24" fill="white" class="w-3 h-3 sm:w-3.5 sm:h-3.5">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
      </div>
    </div>
  </a>
</div>

<style>
  /* Pulso del botón WhatsApp (animate-ping de la SPA) */
  .animate-ping { animation: pd-ping 1s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @keyframes pd-ping { 75%, 100% { transform: scale(2); opacity: 0; } }

  /* La X nativa de un input[type="search"] (Chrome/Safari) sobra: el buscador pinta la
     suya en #pd-search-clear y las dos se solapan en la esquina derecha del campo. */
  #pd-search-input::-webkit-search-cancel-button,
  #pd-search-input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
</style>

<script>
  // Filtro por tag + BUSCADOR + paginación "Cargar más" (sustituye useState de la SPA).
  // TODAS las cards están en el DOM; este script solo muestra/oculta (nunca borra nodos).
  // El criterio de texto vive DENTRO de matches(), que es la única función que comparten
  // las cards de producto y las de "próximamente": así las dos reaccionan igual.
  //
  // La normalización y los sinónimos NO se definen aquí: vienen del módulo compartido con
  // el frontmatter (que genera los data-search) y con buscador-report.py. Duplicarlos fue
  // el defecto original: dos copias idénticas que nadie cruzaba.
  import { normalizarBusqueda, GRUPOS_SINONIMOS, FRASES_SINONIMAS } from '../../lib/normalizar-busqueda';

  const PER_PAGE = 12;
  let activeTag = 'all';
  let visibleCount = PER_PAGE;

  const tagBtns = Array.from(document.querySelectorAll('[data-tag-btn]'));
  const prodCards = Array.from(document.querySelectorAll('[data-product]'));
  const comingCards = Array.from(document.querySelectorAll('[data-coming]'));
  const productsSection = document.getElementById('pd-products-section');
  const comingSection = document.getElementById('pd-coming-section');
  const noResults = document.getElementById('pd-noresults');
  const loadMoreBlock = document.getElementById('pd-loadmore-block');
  const loadMoreBtn = document.getElementById('pd-loadmore-btn');
  const showingLine = document.getElementById('pd-showing-line');

  const TAG_ACTIVE = ['bg-[#FFD700]', 'text-black'];
  const TAG_INACTIVE = ['bg-white/5', 'text-gray-400', 'border', 'border-white/10', 'hover:border-[#FFD700]/30', 'hover:text-white'];

  // ── Buscador ──────────────────────────────────────────────────────────────────────
  const searchInput = document.getElementById('pd-search-input');
  const searchClear = document.getElementById('pd-search-clear');
  const searchStatus = document.getElementById('pd-search-status');
  const searchAnnounce = document.getElementById('pd-search-announce');
  const searchEmpty = document.getElementById('pd-search-empty');
  const searchEmptyQ = document.getElementById('pd-search-empty-q');
  const searchFuera = document.getElementById('pd-search-fuera');
  const searchFueraTxt = document.getElementById('pd-search-fuera-txt');
  const searchFueraBtn = document.getElementById('pd-search-fuera-btn');
  const waEmpty = document.getElementById('pd-wa-empty');
  const askToggle = document.getElementById('pd-ask-toggle');
  const askForm = document.getElementById('pd-ask-form');
  const askDetalle = document.getElementById('pd-ask-detalle');
  const askEmail = document.getElementById('pd-ask-email');
  const askWebsite = document.getElementById('pd-ask-website');
  const askHint = document.getElementById('pd-ask-hint');
  const askSend = document.getElementById('pd-ask-send');
  const askThanks = document.getElementById('pd-ask-thanks');
  const verTodos = document.getElementById('pd-ver-todos');

  const WA_BASE = 'https://wa.me/34744717942?text=';

  let searchRaw = '';        // lo que ve el usuario (para los mensajes)
  let searchNorm = '';       // normalizado (para deduplicar el registro)
  let searchVariantes = [];  // [[token, token…], …] — basta con que UNA variante case entera

  // Etiqueta visible de cada chip, para poder decir "…fuera de la categoría PDF / eBook".
  const etiquetaTag = {};
  tagBtns.forEach((btn) => { etiquetaTag[btn.dataset.tag || ''] = (btn.textContent || '').replace(/\s+/g, ' ').trim(); });

  function variantesDeConsulta(q) {
    const variantes = [q];
    for (let i = 0; i < FRASES_SINONIMAS.length; i++) {
      const a = FRASES_SINONIMAS[i][0];
      const b = FRASES_SINONIMAS[i][1];
      const previas = variantes.slice();
      for (let j = 0; j < previas.length; j++) {
        const v = previas[j];
        if (v.indexOf(a) !== -1) variantes.push(v.split(a).join(b));
        else if (v.indexOf(b) !== -1) variantes.push(v.split(b).join(a));
      }
    }
    return variantes.slice(0, 6);
  }

  function construirConsulta(valor) {
    searchRaw = (valor || '').trim();
    searchNorm = normalizarBusqueda(valor);
    searchVariantes = [];
    if (!searchNorm) return;
    const variantes = variantesDeConsulta(searchNorm);
    for (let i = 0; i < variantes.length; i++) {
      const tokens = variantes[i].split(' ').filter(function (t) { return t.length >= 2; });
      if (tokens.length) searchVariantes.push(tokens);
    }
  }

  function buscando() {
    return searchVariantes.length > 0;
  }

  // hayPad = ' ' + data-search → indexOf(' ' + token) exige inicio de palabra
  // (así "rol" no casa dentro de "control" y "escandall" sí casa con "escandallos").
  function tokenEn(hayPad, token) {
    if (hayPad.indexOf(' ' + token) !== -1) return true;
    if (token.length < 3) return false;
    for (let i = 0; i < GRUPOS_SINONIMOS.length; i++) {
      const grupo = GRUPOS_SINONIMOS[i];
      let dispara = false;
      for (let j = 0; j < grupo.length; j++) {
        if (grupo[j].indexOf(token) === 0) { dispara = true; break; }
      }
      if (!dispara) continue;
      for (let k = 0; k < grupo.length; k++) {
        if (hayPad.indexOf(' ' + grupo[k]) !== -1) return true;
      }
    }
    return false;
  }

  function coincideTexto(card) {
    if (!buscando()) return true;
    const hayPad = ' ' + (card.dataset.search || '');
    for (let i = 0; i < searchVariantes.length; i++) {
      const tokens = searchVariantes[i];
      let todos = true;
      for (let j = 0; j < tokens.length; j++) {
        if (!tokenEn(hayPad, tokens[j])) { todos = false; break; }
      }
      if (todos) return true;
    }
    return false;
  }

  function coincideTag(card) {
    if (activeTag === 'all') return true;
    return (card.dataset.tags || '').split(' ').includes(activeTag);
  }

  function matches(card) {
    return coincideTag(card) && coincideTexto(card);
  }

  // Conteos SIN tocar el DOM. `global` ignora el chip a propósito: es el que dice si el
  // producto EXISTE en la tienda, y es el que se registra (un 0 causado por el filtro no
  // es demanda no cubierta, es un filtro puesto).
  function contar() {
    let global = 0;
    let filtrado = 0;
    for (let i = 0; i < prodCards.length; i++) {
      if (!coincideTexto(prodCards[i])) continue;
      global += 1;
      if (coincideTag(prodCards[i])) filtrado += 1;
    }
    let coming = 0;
    for (let i = 0; i < comingCards.length; i++) if (matches(comingCards[i])) coming += 1;
    return { global: global, filtrado: filtrado, coming: coming };
  }

  function updateTagButtons() {
    tagBtns.forEach((btn) => {
      const active = btn.dataset.tag === activeTag;
      btn.classList.remove(...(active ? TAG_INACTIVE : TAG_ACTIVE));
      btn.classList.add(...(active ? TAG_ACTIVE : TAG_INACTIVE));
    });
  }

  function apply() {
    const enBusqueda = buscando();
    const matching = prodCards.filter(matches);
    const total = matching.length;
    // Con búsqueda activa se enseñan TODOS los resultados (la paginación se aparca).
    const limite = enBusqueda ? total : visibleCount;

    prodCards.forEach((c) => c.classList.add('hidden'));
    matching.slice(0, limite).forEach((c) => c.classList.remove('hidden'));

    const showing = Math.min(limite, total);
    const hasMore = !enBusqueda && visibleCount < total;

    if (productsSection) productsSection.classList.toggle('hidden', total === 0);
    if (loadMoreBlock) {
      loadMoreBlock.classList.toggle('hidden', !hasMore);
      loadMoreBlock.classList.toggle('flex', hasMore);
    }
    if (hasMore && loadMoreBtn) loadMoreBtn.textContent = `Weitere Produkte laden (${total - visibleCount} verbleibend)`;
    if (hasMore && showingLine) showingLine.textContent = `${showing} von ${total} angezeigt`;

    const matchingComing = comingCards.filter(matches);
    comingCards.forEach((c) => c.classList.toggle('hidden', !matches(c)));
    if (comingSection) comingSection.classList.toggle('hidden', matchingComing.length === 0);

    // Cuántos productos casarían con el texto SIN el chip. Si hay alguno, el 0 de arriba lo
    // provoca la categoría, no el catálogo: se ofrece quitar el filtro en vez de pedir que
    // nos cuente qué buscaba (el producto existe y está a un clic).
    const sinChip = enBusqueda && activeTag !== 'all' ? prodCards.filter(coincideTexto).length : total;
    const vacio = total === 0 && matchingComing.length === 0;
    const fueraDeCategoria = vacio && enBusqueda && sinChip > 0;

    // Sin texto → panel clásico del filtro por tag. Con texto → panel del buscador.
    if (noResults) noResults.classList.toggle('hidden', !(vacio && !enBusqueda));
    if (searchFuera) searchFuera.classList.toggle('hidden', !fueraDeCategoria);
    if (searchEmpty) searchEmpty.classList.toggle('hidden', !(vacio && enBusqueda && !fueraDeCategoria));

    if (fueraDeCategoria && searchFueraTxt) {
      const etiqueta = etiquetaTag[activeTag] || activeTag;
      searchFueraTxt.textContent =
        (sinChip === 1 ? '1 Produkt entspricht' : sinChip + ' Produkte entsprechen') +
        ' „' + consultaVisible() + '“, ' + (sinChip === 1 ? 'liegt' : 'liegen') + ' außerhalb der Kategorie ' + etiqueta + '.';
    }
    if (vacio && enBusqueda && !fueraDeCategoria) {
      if (searchEmptyQ) searchEmptyQ.textContent = consultaVisible();
      // El mensaje de WhatsApp por defecto es de SOPORTE POST-VENTA ("ayuda con mi compra"),
      // que no es lo que quiere decir quien no ha encontrado nada. Se reescribe con lo que
      // buscaba, que además es la única información valiosa de ese contacto.
      if (waEmpty) {
        waEmpty.href = WA_BASE + encodeURIComponent(
          'Hallo, ich habe im Shop nach „' + searchRaw.slice(0, 80) + '“ gesucht und nichts gefunden. Haben Sie etwas Ähnliches?',
        );
      }
    }

    actualizarEstado(total, matchingComing.length, enBusqueda);
  }

  // Lo tecleado se pinta recortado: una consulta larguísima no debe descuadrar la línea.
  // Además se parten los tokens interminables (una URL pegada, "aaaaaa…"): sin espacios,
  // 60 caracteres son ~530 px contra los ~280 px útiles de un móvil de 360 px, y el CSS
  // por sí solo no evita que el panel se desborde en navegadores viejos.
  function consultaVisible() {
    const partido = searchRaw.split(/(\s+)/).map(function (t) {
      return t.length > 24 ? t.slice(0, 24) + '…' : t;
    }).join('');
    return partido.length > 60 ? partido.slice(0, 60) + '…' : partido;
  }

  // El contador visible se actualiza al instante; el ANUNCIO al lector de pantalla va con
  // su propio retardo (600 ms) y solo si el texto cambió de verdad — si no, cada pulsación
  // que no altera el conteo encola un aviso que pisa al anterior.
  let tAnuncio = 0;
  function actualizarEstado(total, coming, enBusqueda) {
    if (!searchStatus) return;
    const q = consultaVisible();
    let texto;
    if (!enBusqueda) {
      texto = total === 1 ? '1 Produkt' : total + ' Produkte';
    } else if (total === 0) {
      texto = 'Keine Produkte entsprechen „' + q + '“';
    } else if (total === 1) {
      texto = '1 Produkt entspricht „' + q + '“';
    } else {
      texto = total + ' Produkte entsprechen „' + q + '“';
    }
    if (enBusqueda && coming > 0) texto += ' · ' + coming + ' in Entwicklung';
    if (searchStatus.textContent === texto) return;
    searchStatus.textContent = texto;
    if (!searchAnnounce) return;
    clearTimeout(tAnuncio);
    tAnuncio = setTimeout(function () {
      if (searchAnnounce.textContent !== texto) searchAnnounce.textContent = texto;
    }, 600);
  }

  // ── Registro anónimo de búsquedas (nunca bloquea la UI; si falla, silencio) ──────
  const LOG_URL = '/.netlify/functions/log-search';
  const LOG_KEY = 'pd-busquedas-registradas';
  let tRegistro = 0;

  function listaRegistradas() {
    try {
      const guardado = sessionStorage.getItem(LOG_KEY) || '';
      return guardado ? guardado.split('|') : [];
    } catch (e) {
      return [];
    }
  }

  // Duplicada = la misma consulta, o una de la que ésta es PREFIJO. Tecleando en móvil,
  // una pausa de 1,2 s a media palabra registraba "escandall" y luego "escandallos" como
  // dos consultas distintas: dos filas en el informe y un falso "sin resultados".
  function yaRegistrada(q) {
    const lista = listaRegistradas();
    for (let i = 0; i < lista.length; i++) {
      if (lista[i] === q || lista[i].indexOf(q) === 0) return true;
    }
    return false;
  }

  function marcarRegistrada(q) {
    try {
      // Al registrar la consulta larga se olvidan sus prefijos: si el visitante borra
      // letras y vuelve a "escandall", ya no se registra otra vez.
      const lista = listaRegistradas().filter(function (p) { return q.indexOf(p) !== 0; });
      lista.push(q);
      sessionStorage.setItem(LOG_KEY, lista.slice(-60).join('|'));
    } catch (e) {
      /* modo privado o storage bloqueado: se pierde el dedup, nada más */
    }
  }

  function enviarLog(datos) {
    try {
      const cuerpo = JSON.stringify(datos);
      if (navigator.sendBeacon) {
        navigator.sendBeacon(LOG_URL, new Blob([cuerpo], { type: 'application/json' }));
      } else if (window.fetch) {
        fetch(LOG_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: cuerpo,
          keepalive: true,
        }).catch(() => {});
      }
    } catch (e) {
      /* el buscador nunca depende del backend */
    }
  }

  function registrarBusqueda() {
    if (!searchInput) return;
    const q = searchRaw.slice(0, 120);
    if (searchNorm.length < 3) return;
    if (yaRegistrada(searchNorm)) return;
    marcarRegistrada(searchNorm);
    // Se cuenta AQUÍ, no se lee el último render: el registro puede dispararse antes de
    // que el debounce de 200 ms haya aplicado el filtro (blur, Enter).
    const c = contar();
    enviarLog({
      q: q,
      n: c.global,          // sin el chip: el dato que dice si el producto existe
      n_filtrado: c.filtrado, // con el chip puesto (lo que vio en pantalla)
      coming: c.coming,
      tag: activeTag === 'all' ? '' : activeTag,
      lang: 'de',
      path: location.pathname,
      ts: Date.now(),
      website: askWebsite && askWebsite.value ? askWebsite.value : '',
    });
  }

  function programarRegistro() {
    clearTimeout(tRegistro);
    tRegistro = setTimeout(registrarBusqueda, 1200);
  }

  // ── Estado visual del buscador ───────────────────────────────────────────────────
  function sincronizarBotonLimpiar() {
    if (!searchClear || !searchInput) return;
    const hayTexto = searchInput.value.length > 0;
    searchClear.classList.toggle('hidden', !hayTexto);
    searchClear.classList.toggle('flex', hayTexto);
  }

  function reiniciarPanelPregunta() {
    if (askThanks && !askThanks.classList.contains('hidden')) {
      askThanks.classList.add('hidden');
      if (askToggle) askToggle.classList.remove('hidden');
      if (askDetalle) askDetalle.value = '';
      if (askEmail) askEmail.value = '';
    }
    if (askHint) askHint.classList.add('hidden');
    marcarInvalido(false);
  }

  let tFiltro = 0;
  // Clave de la búsqueda EFECTIVA: '' cuando lo tecleado no llega a filtrar nada
  // (`construirConsulta` descarta los tokens de menos de 2 caracteres, así que «5», «a»
  // o un símbolo suelto dejan la lista igual que si no hubiera búsqueda).
  let claveAplicada = '';
  function claveBusqueda() {
    return buscando() ? searchNorm : '';
  }
  function filtrar() {
    construirConsulta(searchInput ? searchInput.value : '');
    // La paginación se reinicia SOLO si la búsqueda efectiva cambia. Antes se reiniciaba
    // siempre: el visitante pulsaba «Cargar más» hasta ver los 46, tecleaba una letra y
    // el grid colapsaba a 12 con el botón de vuelta, mientras el contador seguía diciendo
    // «46 productos». Nada explicaba el colapso.
    const clave = claveBusqueda();
    if (clave !== claveAplicada) visibleCount = PER_PAGE;
    claveAplicada = clave;
    reiniciarPanelPregunta();
    apply();
  }

  function aplicarBusqueda() {
    filtrar();
    programarRegistro();
  }

  function limpiarBusqueda(devolverFoco) {
    if (searchInput) searchInput.value = '';
    clearTimeout(tFiltro);
    construirConsulta('');
    visibleCount = PER_PAGE;
    claveAplicada = '';
    sincronizarBotonLimpiar();
    reiniciarPanelPregunta();
    apply();
    if (devolverFoco && searchInput) searchInput.focus();
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      sincronizarBotonLimpiar();
      clearTimeout(tFiltro);
      tFiltro = setTimeout(aplicarBusqueda, 200);
    });
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        limpiarBusqueda(true);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        clearTimeout(tFiltro);
        filtrar();
        clearTimeout(tRegistro);
        registrarBusqueda();
      }
    });
    // OJO: aquí NO se re-filtra. `blur` se dispara en el mousedown, antes del mouseup: si
    // el grid se re-renderizara ahora, la card sobre la que el visitante está pinchando
    // podría ocultarse o moverse y el clic se perdería (o abriría otro producto).
    // El registro sí puede correr: `contar()` no toca el DOM.
    searchInput.addEventListener('blur', () => {
      if (!searchInput.value.trim()) return;
      if (searchInput.value.trim() !== searchRaw) construirConsulta(searchInput.value);
      clearTimeout(tRegistro);
      registrarBusqueda();
    });
  }

  searchClear?.addEventListener('click', () => limpiarBusqueda(true));

  // Atajo: "/" enfoca el buscador (salvo si ya se está escribiendo en otro campo).
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey || !searchInput) return;
    const destino = e.target;
    const etiqueta = destino && destino.tagName ? destino.tagName.toLowerCase() : '';
    if (etiqueta === 'input' || etiqueta === 'textarea' || etiqueta === 'select') return;
    if (destino && destino.isContentEditable) return;
    e.preventDefault();
    searchInput.focus();
    searchInput.select();
  });

  // Quitar el chip sin perder lo tecleado (panel "están fuera de la categoría").
  searchFueraBtn?.addEventListener('click', () => {
    activeTag = 'all';
    visibleCount = PER_PAGE;
    updateTagButtons();
    apply();
    if (searchInput) searchInput.focus();
  });

  // "Ver el catálogo completo" desde el panel de vacío.
  verTodos?.addEventListener('click', () => {
    activeTag = 'all';
    updateTagButtons();
    limpiarBusqueda(true);
  });

  // ── "Dinos qué buscabas" (solo se ve cuando la búsqueda no devuelve nada) ────────
  function marcarInvalido(mal) {
    [askDetalle, askEmail].forEach((el) => {
      if (!el) return;
      if (mal) el.setAttribute('aria-invalid', 'true');
      else el.removeAttribute('aria-invalid');
    });
  }

  function avisar(texto, foco) {
    if (askHint) {
      askHint.textContent = texto;
      askHint.classList.remove('hidden');
    }
    marcarInvalido(true);
    if (foco) foco.focus();
  }

  askToggle?.addEventListener('click', () => {
    if (askForm) askForm.classList.remove('hidden');
    askToggle.classList.add('hidden');
    if (askDetalle) askDetalle.focus();
  });

  function enviarPeticion() {
    const detalle = (askDetalle && askDetalle.value ? askDetalle.value : '').trim().slice(0, 500);
    const email = (askEmail && askEmail.value ? askEmail.value : '').trim().slice(0, 120);
    if (!detalle && !email) {
      avisar('Teilen Sie uns mit, was Sie benötigen, oder hinterlassen Sie Ihre E-Mail, damit wir Sie informieren können.', askDetalle);
      return;
    }
    // Validación nativa: funciona igual en un input suelto que dentro de un <form>. Sin
    // esto, "asdf" pasaba como email, se decía "Gracias" y quedaba un contacto inservible.
    if (email && askEmail && typeof askEmail.checkValidity === 'function' && !askEmail.checkValidity()) {
      avisar('Bitte überprüfen Sie Ihre E-Mail-Adresse: Es scheint etwas zu fehlen.', askEmail);
      return;
    }
    if (askHint) askHint.classList.add('hidden');
    marcarInvalido(false);
    const c = contar();
    enviarLog({
      q: searchRaw.slice(0, 120),
      n: c.global,
      n_filtrado: c.filtrado,
      coming: c.coming,
      tag: activeTag === 'all' ? '' : activeTag,
      lang: 'de',
      path: location.pathname,
      ts: Date.now(),
      detalle: detalle,
      email: email,
      sin_resultados: true,
      // El evento del formulario repite una `q` que ya se registró 1,2 s antes: lo nuevo
      // son el detalle y el email. `origen` permite al informe no contarlo dos veces.
      origen: 'form',
      website: askWebsite && askWebsite.value ? askWebsite.value : '',
    });
    // El foco va a la confirmación ANTES de ocultar el formulario: si se oculta primero,
    // el botón enfocado desaparece y el foco cae a <body> (el usuario de teclado acaba al
    // principio del documento y no se entera de que su petición salió).
    if (askThanks) {
      askThanks.classList.remove('hidden');
      askThanks.focus();
    }
    if (askForm) askForm.classList.add('hidden');
  }

  askSend?.addEventListener('click', enviarPeticion);
  // Sin <form> no hay envío con Enter: sin esto, el teclado se queda sin salida.
  askEmail?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); enviarPeticion(); }
  });
  askDetalle?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); enviarPeticion(); }
  });

  // ── Chips, paginación y reset ────────────────────────────────────────────────────
  tagBtns.forEach((btn) => btn.addEventListener('click', () => {
    activeTag = btn.dataset.tag || 'all';
    visibleCount = PER_PAGE;
    updateTagButtons();
    apply();
  }));

  loadMoreBtn?.addEventListener('click', () => { visibleCount += PER_PAGE; apply(); });
  document.getElementById('pd-reset')?.addEventListener('click', () => {
    activeTag = 'all';
    if (searchInput) searchInput.value = '';
    construirConsulta('');
    visibleCount = PER_PAGE;
    claveAplicada = '';
    sincronizarBotonLimpiar();
    reiniciarPanelPregunta();
    updateTagButtons();
    apply();
  });

  // Estado inicial (el navegador puede restaurar el valor del input al volver atrás).
  construirConsulta(searchInput ? searchInput.value : '');
  claveAplicada = claveBusqueda();
  sincronizarBotonLimpiar();
  apply();
  // ── Placeholder animado (John, 2026-09-05): escribe ejemplos de búsqueda letra a letra
  //    para que el buscador llame la atención. Se detiene al enfocar o al escribir, y con
  //    «prefers-reduced-motion» deja el placeholder estático.
  (function placeholderAnimado() {
    const input = document.getElementById('pd-search-input');
    if (!(input instanceof HTMLInputElement)) return;
    const estatico = input.getAttribute('placeholder') || '';
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // Ejemplos CORTOS (≤ 22 caracteres): en un móvil de 360 px el campo deja ~26 caracteres
    // visibles y un ejemplo largo se recortaba a media palabra (John, 2026-09-05).
    const ejemplos = [
      'Kalkulation',
      'Wareneinsatz',
      'HACCP',
      'Restaurantleitung',
      'Businessplan',
      'Warenwirtschaft',
      'Prompts für Köche',
      'Dienstplanung',
      'Konditorei eröffnen',
      'Food Truck',
      'Finanzplan',
    ];
    let i = 0, pos = 0, borrando = false, parado = false, timer = 0;
    const parar = () => { parado = true; clearTimeout(timer); input.setAttribute('placeholder', estatico); };
    const paso = () => {
      if (parado || document.activeElement === input || input.value) return parar();
      const texto = ejemplos[i % ejemplos.length];
      if (!borrando) {
        pos += 1;
        input.setAttribute('placeholder', texto.slice(0, pos) + (pos < texto.length ? '|' : ''));
        if (pos >= texto.length) { borrando = true; timer = window.setTimeout(paso, 1400); return; }
        timer = window.setTimeout(paso, 55 + Math.round(Math.random() * 45));
      } else {
        pos -= 2;
        if (pos <= 0) { pos = 0; borrando = false; i += 1; input.setAttribute('placeholder', ''); timer = window.setTimeout(paso, 350); return; }
        input.setAttribute('placeholder', texto.slice(0, pos));
        timer = window.setTimeout(paso, 28);
      }
    };
    input.addEventListener('focus', parar, { once: true });
    input.addEventListener('input', parar, { once: true });
    timer = window.setTimeout(paso, 900);
  })();
</script>
