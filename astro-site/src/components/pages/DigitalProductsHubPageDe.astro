const PRODUCTS_PER_PAGE = 12;

// Etiqueta de un tag (los tags sin entrada en ALL_TAGS — 'bundle', 'production-kitchen', 'tapas'… —
// no renderizan pill, igual que en el hub ES/EN).
const tagLabel = (id: string) => ALL_TAGS.find((t) => t.id === id)?.label;

// ── Tarjeta → producto DE vivo (FAMILIAS de lib/tienda.ts) ───────────────────────────
// Sin familia o con `de.vivo: false` → null: la tarjeta se pinta sin enlace ni precio y con el
// badge «Bald auf Deutsch verfügbar». Con familia viva → landing DE + precio EUR (el que cobra el checkout).
const deVivo = (slugEs: string) => {
  const f = FAMILIAS.find((x) => x.productos.es?.slug === slugEs.replace(/^\//, ''));
  const de = f?.productos.de;
  return de && de.vivo ? de.slug : null;
};
const precioEur = (id: string) => {
  const v = PRODUCT_PRICES[id]?.eur;
  return typeof v === 'number' ? `€${v}` : null;
};
const cards = products.map((p) => {
  const deSlug = deVivo(p.slug);
  return {
    ...p,
    deSlug,
    href: deSlug ? tiendaProductoPath('de', deSlug) : null,
    price: deSlug ? precioEur(deSlug) : null,
  };
});
const liveCards = cards.filter((c) => c.href);

// ── Buscador: índice de texto por card (data-search) ────────────────────────────────
// Misma normalización que el hub ES/EN. Sin el slug ES ni sus alias en español.
const indiceProducto = (p: { name: string; description: string; features: string[]; tags: string[] }) =>
  indiceBusqueda([p.name, p.description, ...p.features, ...p.tags, ...p.tags.map(tagLabel)]);

// Contadores del badge del hero.
