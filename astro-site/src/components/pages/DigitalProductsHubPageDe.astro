  { q: 'Kann ich die Vorlagen in mehr als einem Restaurant verwenden?', a: 'Ja. Die Lizenz ist persönlich: Sie können die Vorlagen in jedem Betrieb verwenden, den Sie leiten. Ideal für Berater, Restaurantgruppen und Manager mehrerer Standorte.' },
  { q: 'Welche Zahlungsmethoden akzeptieren Sie?', a: 'Zahlungen werden von Stripe abgewickelt, einer der sichersten Zahlungsplattformen der Welt. Wir akzeptieren Kredit- und Debitkarten (Visa, Mastercard, Amex), Apple Pay, Google Pay und Link (Stripe-Schnellkasse).' },
];

// pSEO cities (las guías por ciudad solo existen en español: se listan sin enlace).
const cities = [
  { slug: 'madrid', label: 'Madrid' },
  { slug: 'barcelona', label: 'Barcelona' },
  { slug: 'valencia', label: 'Valencia' },
  { slug: 'ciudad-de-mexico', label: 'Mexiko-Stadt' },
  { slug: 'monterrey', label: 'Monterrey' },
  { slug: 'bogota', label: 'Bogotá' },
  { slug: 'medellin', label: 'Medellín' },
  { slug: 'buenos-aires', label: 'Buenos Aires' },
  { slug: 'santiago', label: 'Santiago' },
];

// ── JSON-LD (CollectionPage + FAQPage + BreadcrumbList, en alemán y sin ofertas ni rating) ──
const HUB_URL = 'https://aichef.pro/de/digitale-produkte';
const collectionSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Digitale Produkte für Restaurants und Gastronomie — AI Chef Pro',
  description: 'Excel-Vorlagen, HACCP-Leitfäden, KI-Prompts und digitale Werkzeuge für Köche, Restaurantleiter und Inhaber.',
  url: HUB_URL,
  inLanguage: 'de',
  publisher: {
    '@type': 'Organization',
    name: 'AI Chef Pro',
    url: 'https://aichef.pro/de',
  },
};
// El ItemList solo lista productos VIVOS en alemán (hoy ninguno → sin mainEntity).
if (liveCards.length) {
  collectionSchema.mainEntity = {
    '@type': 'ItemList',
    itemListElement: liveCards.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://aichef.pro${c.href}`,
      name: c.name,
    })),
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'de',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: 'https://aichef.pro/de' },
    { '@type': 'ListItem', position: 2, name: 'Digitale Produkte', item: HUB_URL },
  ],
};
---

