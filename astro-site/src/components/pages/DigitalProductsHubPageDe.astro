            {/* Features */}
            <ul class="space-y-1.5 mb-5 flex-1">
              {product.features.map((feature) => (
                <li class="flex items-start gap-2 text-xs text-gray-300">
                  <Icon name="Check" class="w-3.5 h-3.5 text-[#FFD700] flex-shrink-0 mt-0.5" />
