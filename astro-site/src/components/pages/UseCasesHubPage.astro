    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="min-h-screen bg-background">
    <Header lang={lang} />

    <main>
      {/* Hero */}
      <section class="relative overflow-hidden bg-gradient-to-br from-primary/10 via-background to-secondary/5 py-20 lg:py-28">
        <div class="container mx-auto px-4">
          <div class="mx-auto max-w-4xl text-center">
            {/* HeroSocialProof */}
            <div class="flex flex-col items-center gap-2 mb-4">
              <div class="flex -space-x-3 justify-center">
                {socialAvatars.map((i) => (
                  <span class="relative flex h-10 w-10 shrink-0 overflow-hidden rounded-full border-2 border-background w-9 h-9 sm:w-10 sm:h-10 ring-2 ring-background">
                    <img class="aspect-square h-full w-full" src={`/avatars/avatar-${i}.jpg`} alt={`Professional ${i}`} loading="lazy" />
                  </span>
                ))}
              </div>
              <div class="flex flex-col items-center gap-0.5">
                <div class="flex items-center gap-0.5">
                  {[0, 1, 2, 3, 4].map((i) => (
                    <Icon name="Star" class={`h-4 w-4 ${i < 4 ? 'fill-accent text-accent' : 'fill-accent/50 text-accent'}`} />
                  ))}
                </div>
                <span class="text-sm text-muted-foreground">
                  <span class="font-bold text-foreground" data-social-count>{socialCount}</span><SocialCountLive />{' '}
                  {t(lang, 'hero.social_proof_label')}
                </span>
              </div>
            </div>

            <div class={`${BADGE_DEFAULT} mb-6 text-sm px-4 py-2`}>{ui.badge}</div>
            <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl mb-6 text-balance">
              {ui.h1}
            </h1>
            <p class="text-xl text-muted-foreground mb-8 max-w-3xl mx-auto text-balance">
              {ui.heroSubtitle}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href={APP_URL} target="_blank" rel="noopener noreferrer" class={btnGoldLg}>
                {ui.ctaPrimary} <Icon name="ArrowRight" class="ml-2 h-5 w-5" />
              </a>
              <a href={productsHref} class={btnOutlineLg}>
                {ui.ctaSecondary} <Icon name="ArrowRight" class="ml-2 h-4 w-4" />
              </a>
            </div>
            <p class="text-sm text-muted-foreground mt-4">{ui.ctaNote}</p>
