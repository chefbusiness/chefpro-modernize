const BADGE_SECONDARY = `${BADGE} border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80`;
const CARD = 'rounded-lg border bg-card text-card-foreground shadow-sm';
const CARD_HEADER = 'flex flex-col space-y-1.5 p-6';
const CARD_TITLE = 'text-2xl font-semibold leading-none tracking-tight';
const CARD_CONTENT = 'p-6 pt-0';

// Tab buttons — variant default(+btn-gold)/outline como la SPA (activeTab controla el swap).
const TAB_BTN_BASE = `${BTN} h-11 rounded-md px-8 w-full sm:w-auto`;
const TAB_ACTIVE = 'bg-primary text-primary-foreground hover:bg-primary/90 btn-gold';
const TAB_INACTIVE = 'border border-input bg-background hover:bg-accent hover:text-accent-foreground';

// ── HeroSocialProof (inline) — getDynamicCount() VERBATIM (idéntico a UseCasePageContent) ──
function getDynamicCount(): number {
  const BASE_DATE = new Date('2026-02-12');
  const BASE_COUNT = 48149;
  const today = new Date();
  const diffTime = today.getTime() - BASE_DATE.getTime();
  const diffDays = Math.max(0, Math.floor(diffTime / (1000 * 60 * 60 * 24)));
  let total = BASE_COUNT;
  for (let i = 1; i <= diffDays; i++) {
    const seed = (i * 7 + 13) % 21;
    total += 60 + seed;
  }
  return total;
}
const socialCount = getDynamicCount().toLocaleString(lang === 'en' ? 'en-US' : 'es-ES');
const socialAvatars = [1, 2, 3, 4, 5, 6, 7, 8];

// ── Derivados (mismos cálculos que UseCasesHub.tsx) ──
const ui = UI[lang] || UI.es;
const segs = SEGMENTS[lang] || SEGMENTS.es;
const canonicalUrl = `${SITE_URL}${hubPath(lang)}`;
const productsHref = lang === 'es' ? '/productos-digitales' : `/${lang}/productos-digitales`;

// Solo cards con traducción real en el idioma (hasNativeContent); en es se muestran todas.
const allRoles = getUseCasesByType('role');
const allConcepts = getUseCasesByType('concept');
const roles = lang === 'es' ? allRoles : allRoles.filter((uc) => hasNativeContent(uc.id, lang as LangCode));
const concepts = lang === 'es' ? allConcepts : allConcepts.filter((uc) => hasNativeContent(uc.id, lang as LangCode));

// pSEO cities (ES only) — label VERBATIM de UseCasesHub.tsx (líneas 259-266).
const cityCrossLinkSlugs = ['madrid', 'barcelona', 'ciudad-de-mexico', 'bogota', 'medellin', 'buenos-aires', 'santiago'];
const cityLabel = (slug: string) =>
  slug === 'ciudad-de-mexico' ? 'CDMX' : slug === 'buenos-aires' ? 'Buenos Aires' : slug.charAt(0).toUpperCase() + slug.slice(1);

// ── JSON-LD — breadcrumbSchema VERBATIM (2 ítems; el 2º SIN item, igual que la SPA) ──
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Chef Pro', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: segs.hubLabel },
  ],
};
