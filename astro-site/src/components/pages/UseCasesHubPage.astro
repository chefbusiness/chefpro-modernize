                      </div>
                      <h3 class={`${CARD_TITLE} text-xl`}>{content.h1.replace(ui.h1StripPrefix, '')}</h3>
                    </div>
                    <div class={CARD_CONTENT}>
                      <p class="text-sm text-muted-foreground mb-4">{content.heroTagline}</p>
                      <div class="flex items-center text-primary text-sm font-semibold">
                        {ui.cardCta} <Icon name="ArrowRight" class="ml-1 h-4 w-4" />
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
          <div id="uc-grid-concept" class="grid hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {concepts.map((uc) => {
              const content = uc.content[lang] || uc.content.es;
              const theme = COLOR_THEMES[uc.colorTheme] || COLOR_THEMES.amber;
              return (
                <a href={useCasePath(uc, lang)}>
                  <div class={`${CARD} h-full border-2 hover:border-primary transition-all hover:shadow-xl`}>
                    <div class={CARD_HEADER}>
                      <div class={`w-14 h-14 ${theme.bg} rounded-xl flex items-center justify-center mb-3`}>
                        <Icon name={uc.iconKey} class={`h-7 w-7 ${theme.text}`} />
                      </div>
                      <h3 class={`${CARD_TITLE} text-xl`}>{content.h1.replace(ui.h1StripPrefix, '')}</h3>
                    </div>
                    <div class={CARD_CONTENT}>
                      <p class="text-sm text-muted-foreground mb-4">{content.heroTagline}</p>
                      <div class="flex items-center text-primary text-sm font-semibold">
                        {ui.cardCta} <Icon name="ArrowRight" class="ml-1 h-4 w-4" />
                      </div>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      {/* pSEO Cities cross-link (ES only) */}
      {lang === 'es' && (
        <section class="py-16 bg-muted/30">
          <div class="container mx-auto px-4 max-w-5xl">
            <div class="text-center mb-8">
              <h2 class="text-2xl lg:text-3xl font-bold mb-3">
                ¿Buscas Recursos por Ciudad?
              </h2>
              <p class="text-muted-foreground max-w-2xl mx-auto">
                Costes reales, licencias específicas, salarios sectoriales y mejores barrios para 15 ciudades de España y LATAM.
              </p>
            </div>
            <div class="flex flex-wrap justify-center gap-2 mb-6">
              {cityCrossLinkSlugs.map((slug) => (
                <a
                  href={`/abrir-restaurante/${slug}`}
                  class="px-4 py-2 bg-background hover:bg-accent/15 hover:text-accent rounded-full text-sm font-medium transition-colors border border-border"
                >
                  Abrir restaurante en {cityLabel(slug)}
                </a>
              ))}
            </div>
            <div class="text-center">
              <a href="/seo-restaurantes-por-ciudad" class={btnOutlineLg}>
                Ver todas las ciudades + 5 recursos <Icon name="ArrowRight" class="ml-2 h-4 w-4" />
              </a>
            </div>
          </div>
        </section>
      )}

      {/* CTA */}
      <section class="py-20 bg-gradient-to-br from-primary/10 via-background to-secondary/5">
        <div class="container mx-auto px-4 text-center">
          <Icon name="Sparkles" class="h-10 w-10 text-primary mx-auto mb-4" />
          <h2 class="text-3xl lg:text-4xl font-bold text-foreground mb-4 text-balance">
            {ui.finalH2}
          </h2>
          <p class="text-lg text-muted-foreground mb-8 max-w-2xl mx-auto">
            {ui.finalBody}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={APP_URL} target="_blank" rel="noopener noreferrer" class={btnGoldLg}>
              {ui.ctaPrimary} <Icon name="ArrowRight" class="ml-2 h-5 w-5" />
            </a>
            <a href={productsHref} class={btnOutlineLg}>{ui.finalSecondary}</a>
          </div>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
    <WhatsAppFloatingButton lang={lang} />
  </div>
</BaseLayout>

<script define:vars={{ roleDesc: ui.tabRoleDesc, conceptDesc: ui.tabConceptDesc }}>
  // Switch de pestaña Por Rol / Por Concepto (sustituye el useState de la SPA).
  const btnRole = document.getElementById('uc-tab-role');
  const btnConcept = document.getElementById('uc-tab-concept');
  const gridRole = document.getElementById('uc-grid-role');
  const gridConcept = document.getElementById('uc-grid-concept');
  const descEl = document.getElementById('uc-tab-desc');
  const ACTIVE = ['bg-primary', 'text-primary-foreground', 'hover:bg-primary/90', 'btn-gold'];
  const INACTIVE = ['border', 'border-input', 'bg-background', 'hover:bg-accent', 'hover:text-accent-foreground'];

  function activate(tab) {
    const roleActive = tab === 'role';
    btnRole.classList.remove(...(roleActive ? INACTIVE : ACTIVE));
    btnRole.classList.add(...(roleActive ? ACTIVE : INACTIVE));
    btnConcept.classList.remove(...(roleActive ? ACTIVE : INACTIVE));
    btnConcept.classList.add(...(roleActive ? INACTIVE : ACTIVE));
    gridRole.classList.toggle('hidden', !roleActive);
    gridConcept.classList.toggle('hidden', roleActive);
    descEl.textContent = roleActive ? roleDesc : conceptDesc;
  }

  btnRole?.addEventListener('click', () => activate('role'));
  btnConcept?.addEventListener('click', () => activate('concept'));
</script>
