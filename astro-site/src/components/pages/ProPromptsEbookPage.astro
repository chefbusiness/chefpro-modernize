<style>
  /* FadeIn (paridad con ../ebook/FadeIn de la SPA: opacity + translateY(24px), 700ms,
     one-shot al entrar en viewport). El stagger llega por transition-delay inline. */
  .kt-fade { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .kt-fade.kt-visible { opacity: 1; transform: none; }
  /* Badge del hero (animate-fade-in de la SPA) */
  .animate-fade-in { animation: kt-fade-in 0.6s ease-out both; }
  @keyframes kt-fade-in { from { opacity: 0; } to { opacity: 1; } }
  /* Pulso del botón WhatsApp (animate-ping de la SPA) */
  .animate-ping { animation: kt-ping 1s cubic-bezier(0, 0, 0.2, 1) infinite; }
  @keyframes kt-ping { 75%, 100% { transform: scale(2); opacity: 0; } }
</style>

<script>
  // ---- FadeIn reveal (IntersectionObserver mínimo) ----
  const faders = document.querySelectorAll('.kt-fade');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((en) => {
        if (en.isIntersecting) { en.target.classList.add('kt-visible'); obs.unobserve(en.target); }
      });
    }, { threshold: 0.15 });
    faders.forEach((el) => io.observe(el));
  } else {
    faders.forEach((el) => el.classList.add('kt-visible'));
  }

  // ---- FAQ accordion (single-open, paridad FaqAccordion.tsx). Se togglea inline
  //      gridTemplateRows (1fr/0fr) para no depender de que Tailwind genere la clase
  //      arbitraria desde el texto del script; el CSS `transition-all` anima el cambio. ----
  const faqBtns = Array.from(document.querySelectorAll('[data-faq-btn]'));
  faqBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('svg');
      const isOpen = panel.style.gridTemplateRows === '1fr';
      faqBtns.forEach((b) => {
        (b.nextElementSibling as HTMLElement).style.gridTemplateRows = '0fr';
        b.querySelector('svg')?.classList.remove('rotate-180');
        b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        panel.style.gridTemplateRows = '1fr';
        chevron?.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ---- Testimonials marquee (paridad MarqueeRow: rAF, hover pausa) ----
  document.querySelectorAll('[data-marquee]').forEach((el) => {
    const node = el as HTMLElement;
    const direction = node.dataset.direction || 'left';
    const duration = Number(node.dataset.duration) || 40;
    let raf = 0;
    let position = direction === 'left' ? 0 : -(node.scrollWidth / 2);
    const speed = (node.scrollWidth / 2) / (duration * 60);
    const animate = () => {
      if (direction === 'left') {
        position -= speed;
        if (position <= -(node.scrollWidth / 2)) position = 0;
      } else {
        position += speed;
        if (position >= 0) position = -(node.scrollWidth / 2);
      }
      node.style.transform = `translateX(${position}px)`;
      raf = requestAnimationFrame(animate);
    };
    raf = requestAnimationFrame(animate);
    node.addEventListener('mouseenter', () => cancelAnimationFrame(raf));
    node.addEventListener('mouseleave', () => { raf = requestAnimationFrame(animate); });
  });

  // ---- AlreadyBought (fetch a /.netlify/functions/resend-access) ----
  const abForm = document.querySelector('[data-ab-form]') as HTMLFormElement | null;
  if (abForm) {
    const successEl = document.querySelector('[data-ab-success]') as HTMLElement;
    const errorEl = document.querySelector('[data-ab-error]') as HTMLElement;
    const submitBtn = abForm.querySelector('[data-ab-submit]') as HTMLButtonElement;
    abForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = abForm.querySelector('input[name="email"]') as HTMLInputElement;
      const email = emailInput.value.trim();
      if (!email) return;
      submitBtn.disabled = true;
      errorEl.classList.add('hidden');
      try {
        const res = await fetch('/.netlify/functions/resend-access', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, product: abForm.dataset.abProduct }),
        });
        if (res.ok) {
          abForm.classList.add('hidden');
          successEl.classList.remove('hidden');
          successEl.classList.add('flex');
        } else {
          errorEl.classList.remove('hidden');
          submitBtn.disabled = false;
        }
      } catch {
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
      }
    });
  }
</script>
