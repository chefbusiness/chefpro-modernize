---
// Pricing.astro — v2 «Pricing cards reordered around role» (CRO Keak, 20-sep-2026).
// Spec literal: CRO_HOME_KEAK_2026-09-20.md §1 «Cambio 3» + §4 (rutas de CTA) + §5 (marcadores).
//
// Lo usan las 7 portadas (medium="home-pricing", con JSON-LD) y las 7 páginas de
// precios (medium="pricing", schema={false}: ahí el Product NO se emite, igual
// que antes de la v2 — esas páginas llevan sus propios Breadcrumb y FAQPage, y
// el Product vive en la portada del idioma).
//
// Todo el copy sale de src/i18n/locales/*.json (claves v2_*; las viejas se
// conservan porque las usan el JSON-LD, las landings y los islands). PRECIOS,
// nombres, period, original_price y discount = claves EXISTENTES, no v2_.
//
// Tailwind: `ring-4` y `ring-accent/50` sólo aparecen dentro del <script> del
// resalte de los chips. El escáner de Tailwind lee este .astro como TEXTO, así
// que las genera igual; si alguien reescribe ese script, que no las pierda.
import { t, tList } from '../i18n/translations';
import type { Locale } from '../i18n/config';
import { appCtaUrl } from '../lib/app-url';

interface Props {
  lang?: Locale;
  /** utm_medium del CTA: 'home-pricing' (portadas) | 'pricing' (páginas de precios). */
  medium?: string;
  /** Emitir el JSON-LD Product. Off en las páginas de precios, que ya traen los suyos. */
  schema?: boolean;
}
const { lang = 'es', medium = 'home-pricing', schema = true } = Astro.props;

interface PlanV2 {
  id: string;
  /** utm_content del CTA. */
  slug: string;
  name: string;
  eyebrow: string;
  description: string;
  price: string;
  period?: string;
  originalPrice?: string;
  discount?: string;
  credits: string;
  /** '∞ ' delante de los créditos en los dos planes ilimitados. */
  creditsPrefix?: string;
  hint: string;
  cta: string;
  features: string[];
  popular?: boolean;
  unlimitedBadge?: string;
}

// features.0..n son claves numéricas de objeto en los JSON (igual que en la SPA).
const feat = (id: string, n: number) =>
  Array.from({ length: n }, (_, i) => t(lang, `pricing.plans.${id}.features.${i}`));

// member es el único con lista propia v2 (v2_features[4]); si un idioma aún no la
// tiene traducida, cae a sus features de siempre en vez de quedarse sin lista.
const memberFeatures = tList(lang, 'pricing.plans.member.v2_features');

const p = (id: string, key: string) => t(lang, `pricing.plans.${id}.${key}`);

// Sólo para campos ESTRUCTURALES opcionales (period): t() devuelve la propia
// clave cuando no existe en ningún idioma, y `pricing.plans.member.period` la
// añade merge-keak-copy.py. Hasta entonces el plan se pinta sin sufijo, como en
// la v1, en vez de imprimir la clave al lado del precio. El COPY no se oculta:
// una clave v2_ sin traducir tiene que verse para que el gate la cace.
const opt = (id: string, key: string) => {
  const full = `pricing.plans.${id}.${key}`;
  const value = t(lang, full);
  return value === full ? undefined : value;
};

const member: PlanV2 = {
  id: 'member',
  slug: 'member',
  name: p('member', 'name'),
  eyebrow: p('member', 'v2_eyebrow'),
  description: p('member', 'v2_description'),
  price: p('member', 'price'),
  period: opt('member', 'period'),
  credits: p('member', 'v2_credits'),
  hint: p('member', 'v2_hint'),
  cta: p('member', 'v2_cta'),
  features: memberFeatures.length ? memberFeatures : feat('member', 4),
};

const premiumPro: PlanV2 = {
  id: 'premium_pro',
  slug: 'premium-pro',
  name: p('premium_pro', 'name'),
  eyebrow: p('premium_pro', 'v2_eyebrow'),
  description: p('premium_pro', 'v2_description'),
  price: p('premium_pro', 'price'),
  period: p('premium_pro', 'period'),
  credits: p('premium_pro', 'v2_credits'),
  hint: p('premium_pro', 'v2_hint'),
  cta: p('premium_pro', 'v2_cta'),
  features: feat('premium_pro', 5),
};

const premiumPlus: PlanV2 = {
  id: 'premium_plus',
  slug: 'premium-plus',
  name: p('premium_plus', 'name'),
  eyebrow: p('premium_plus', 'v2_eyebrow'),
  description: p('premium_plus', 'v2_description'),
  price: p('premium_plus', 'price'),
  period: p('premium_plus', 'period'),
  credits: p('premium_plus', 'v2_credits'),
  hint: p('premium_plus', 'v2_hint'),
  cta: p('premium_plus', 'v2_cta'),
  features: feat('premium_plus', 5),
  popular: true,
};

const premiumMax: PlanV2 = {
  id: 'premium_max',
  slug: 'premium-max',
  name: p('premium_max', 'name'),
  eyebrow: p('premium_max', 'v2_eyebrow'),
  description: p('premium_max', 'v2_description'),
  price: p('premium_max', 'price'),
  period: p('premium_max', 'period'),
  credits: p('premium_max', 'v2_credits'),
  creditsPrefix: '∞ ',
  hint: p('premium_max', 'v2_hint'),
  cta: p('premium_max', 'v2_cta'),
  features: feat('premium_max', 7),
  unlimitedBadge: t(lang, 'pricing.unlimited_badge'),
};

const premiumPlusAnnual: PlanV2 = {
  id: 'premium_plus_annual',
  slug: 'premium-max-annual',
  name: p('premium_plus_annual', 'name'),
  eyebrow: p('premium_plus_annual', 'v2_eyebrow'),
  description: p('premium_plus_annual', 'v2_description'),
  price: p('premium_plus_annual', 'price'),
  period: p('premium_plus_annual', 'period'),
  originalPrice: p('premium_plus_annual', 'original_price'),
  discount: p('premium_plus_annual', 'discount'),
  credits: p('premium_plus_annual', 'v2_credits'),
  creditsPrefix: '∞ ',
  hint: p('premium_plus_annual', 'v2_hint'),
  cta: p('premium_plus_annual', 'v2_cta'),
  features: feat('premium_plus_annual', 6),
};

// Fila 1 = los 3 planes mensuales de entrada; fila 2 = ilimitado y compromiso anual.
const rows = [
  { grid: 'mx-auto grid max-w-5xl gap-6 md:grid-cols-3', plans: [member, premiumPro, premiumPlus] },
  { grid: 'mx-auto grid max-w-3xl gap-6 md:grid-cols-2', plans: [premiumMax, premiumPlusAnnual] },
];

// Chips de rol → plan. Sólo los 4 mensuales (el anual no es un «rol»).
const roleChips = [
  { plan: member, role: t(lang, 'pricing.v2_role_member'), short: p('member', 'v2_short') },
  { plan: premiumPro, role: t(lang, 'pricing.v2_role_premium_pro'), short: p('premium_pro', 'v2_short') },
  { plan: premiumPlus, role: t(lang, 'pricing.v2_role_premium_plus'), short: p('premium_plus', 'v2_short') },
  { plan: premiumMax, role: t(lang, 'pricing.v2_role_premium_max'), short: p('premium_max', 'v2_short') },
];

// «Talk to us for an enterprise plan»: sólo hay página de contacto en español.
const enterpriseHref = lang === 'es' ? '/contacto' : 'mailto:info@aichef.pro';

const cardClass = (plan: PlanV2) =>
  `relative flex h-full flex-col rounded-xl p-6 scroll-mt-28 transition-shadow ${
    plan.popular
      ? 'border-2 border-accent bg-accent/10 shadow-xl'
      : 'border border-border bg-card shadow-sm hover:shadow-md'
  }`;

const ctaClass = (plan: PlanV2) =>
  `mt-5 inline-flex h-11 w-full items-center justify-center gap-1 rounded-md px-4 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ${
    plan.popular ? 'btn-gold' : 'bg-primary text-primary-foreground hover:bg-primary/90'
  }`;

// JSON-LD Product (idéntico al que emitía la v1; sólo cambia de dónde salen los planes).
const allPlans = [member, premiumPro, premiumPlus, premiumMax, premiumPlusAnnual];
const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'AI Chef Pro Subscription',
  description: t(lang, 'seo.description'),
  brand: { '@type': 'Brand', name: 'AI Chef Pro' },
  offers: allPlans.map((plan) => ({
    '@type': 'Offer',
    name: plan.name,
    price: plan.price.replace(/[^0-9.]/g, ''),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    url: 'https://aichef.pro',
  })),
};
---

<section id="pricing" data-keak="pricing-v2" aria-labelledby="pricing-heading" class="container py-8 md:py-12 lg:py-24 scroll-mt-28">
  {schema && <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />}

  <!-- Panel pastel dorado (John, 20-sep): las tarjetas blancas no contrastaban sobre blanco -->
  <div class="rounded-3xl border border-accent/15 bg-gradient-to-b from-accent/[0.07] to-accent/[0.03] px-4 py-10 sm:px-8 md:py-14">
  <div class="mx-auto flex max-w-[58rem] flex-col items-center justify-center gap-4 text-center">
    <h2 id="pricing-heading" class="text-3xl font-bold leading-[1.1] text-balance md:text-5xl">{t(lang, 'pricing.v2_title')}</h2>
    <p class="max-w-[48rem] text-balance leading-normal text-muted-foreground sm:text-lg sm:leading-7">
      {t(lang, 'pricing.v2_description')}
    </p>
  </div>

  <div class="mx-auto mt-8 flex max-w-4xl flex-wrap justify-center gap-2">
    {roleChips.map((chip) => (
      <a
        href={`#plan-${chip.plan.id}`}
        data-role-chip
        class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-accent hover:text-foreground"
      >
        <span>{chip.role} →</span>
        <strong class="font-semibold text-foreground">{chip.short} {chip.plan.price}</strong>
      </a>
    ))}
  </div>

  {rows.map((row, i) => (
    <Fragment>
      {i === 1 && (
        <div class="mx-auto mt-12 flex max-w-3xl items-center gap-4">
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          <span class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
            {t(lang, 'pricing.v2_divider')}
          </span>
          <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
        </div>
      )}

      <div class={`${row.grid} ${i === 0 ? 'mt-10' : 'mt-8'}`}>
        {row.plans.map((plan) => (
          <article id={`plan-${plan.id}`} tabindex="-1" data-plan={plan.id} data-popular={plan.popular ? 'true' : undefined} class={cardClass(plan)}>
            {plan.popular && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-accent px-3 py-1 text-xs font-semibold text-black shadow">
                🔥 {t(lang, 'pricing.most_popular')}
              </span>
            )}

            {plan.unlimitedBadge && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground shadow">
                ∞ {plan.unlimitedBadge}
              </span>
            )}

            {plan.discount && (
              <span class="absolute -top-3 right-4 whitespace-nowrap rounded-full bg-emerald-700 px-2.5 py-1 text-xs font-bold text-white shadow">
                {plan.discount}
              </span>
            )}

            <span class="inline-flex w-fit rounded-full bg-accent/15 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-accent-ink">
              {plan.eyebrow}
            </span>

            <h3 class="mt-3 text-lg font-bold text-foreground">{plan.name}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{plan.description}</p>

            <div class="mt-4">
              {plan.originalPrice && (
                <span class="block text-sm text-muted-foreground line-through">{plan.originalPrice}</span>
              )}
              <div class="flex items-baseline gap-1">
                <span class="text-4xl font-bold text-foreground">{plan.price}</span>
                {plan.period && <span class="text-muted-foreground">{plan.period}</span>}
              </div>
            </div>

            <div class="mt-4 rounded-md border-l-4 border-accent bg-muted/60 px-3 py-2">
              <strong class="text-sm text-foreground">{plan.creditsPrefix}{plan.credits}</strong>
              <span class="block text-xs text-muted-foreground">{plan.hint}</span>
            </div>

            <a
              href={appCtaUrl(lang, medium, plan.slug)}
              target="_blank"
              rel="noopener noreferrer"
              class={ctaClass(plan)}
            >
              {plan.cta} →
            </a>

            <ul class="mt-5 space-y-2.5 text-sm">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-foreground">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </Fragment>
  ))}

  <div class="mt-12 text-center">
    <p class="text-balance text-sm text-muted-foreground">
      {t(lang, 'pricing.v2_enterprise_question')}{' '}
      <a href={enterpriseHref} class="inline-flex items-center gap-1 font-semibold text-accent-ink hover:underline">
        {t(lang, 'pricing.v2_enterprise_link')}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </p>
  </div>
  </div>
</section>

<script>
  // Chips de rol: son anclas (#plan-…) y se dejan trabajar como tales. La
  // navegación NATIVA del ancla hace las tres cosas de golpe —desplazar (con
  // scroll-mt-28 en la tarjeta), mover el FOCO al destino (tiene tabindex="-1")
  // y escribir el hash en la URL, que así se puede compartir y volver atrás—.
  // La versión anterior hacía preventDefault() + scrollIntoView() y perdía el
  // foco y el hash: con teclado el chip llevaba la vista a la tarjeta pero el
  // siguiente Tab seguía en la fila de chips. Aquí sólo queda el resalte.
  document.querySelectorAll('[data-role-chip]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const target = chip.getAttribute('href');
      if (!target || target.charAt(0) !== '#') return;
      const card = document.querySelector(target);
      if (!card) return;
      card.classList.add('ring-4', 'ring-accent/50');
      window.setTimeout(() => card.classList.remove('ring-4', 'ring-accent/50'), 2000);
    });
  });
</script>
