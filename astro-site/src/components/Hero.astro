---
// Hero.astro — port de ModernHero.tsx + HeroSocialProof.tsx + CounterStat.tsx.
// La rotación de palabra y el count-up son mejoras progresivas (script vanilla);
// el estado estático ya muestra el valor final correcto sin JS.
//
// 2026-09-20 — CRO Keak, cambio 1 («hero reframed for head chefs»).
// Ver CRO_HOME_KEAK_2026-09-20.md §1. Resumen de lo que cambia frente al hero
// anterior: copy nuevo con prefijo v2_ (las claves viejas SIGUEN en los JSON
// porque las usan SocialProofStrip, el JSON-LD y varias landings), marca «AI
// Chef Pro» en negro plano (sin gradient-text), caja de cifras con número y
// etiqueta EN LÍNEA y en orden agentes → herramientas → recetarios → roles,
// CTA doble (enlace de texto a la página de precios del idioma + botón dorado a
// la plataforma, dorado PRIMERO en móvil) y microcopy de precio. Desaparece el
// botón «SEE RESOURCES» al blog.
import { t, tList } from '../i18n/translations';
import type { Locale } from '../i18n/config';
import SocialCountLive from './SocialCountLive.astro';
import { appUrl } from '../lib/app-url';
import { pricingHref } from '../lib/pricing-path';
import { dynamicSolutions, dynamicChefs } from '../lib/social-counts';

interface Props { lang?: Locale }
const { lang = 'es' } = Astro.props;

// Lista v2 (11 tipos: sin «Gestión/Management», que no encaja en «en tu …» y
// empezando por «Restaurante», que es lo que lee Google en el SSR). Mientras
// un idioma no tenga traducida la lista v2, tList() devuelve [] y caemos a la
// lista de siempre para no dejar el H1 sin palabra rotatoria.
const v2BusinessTypes = tList(lang, 'hero.v2_business_types');
const businessTypes = v2BusinessTypes.length > 0 ? v2BusinessTypes : tList(lang, 'hero.business_types').slice(1);
// Artículo con género DELANTE del negocio (de/it/pt: «in Ihrer Pizzeria» pero
// «in Ihrem Restaurant»). Va FUERA del <span> dorado: el subrayado y el color de
// marca son para el nombre del negocio, no para la preposición. es/en/fr/nl
// devuelven 11 cadenas vacías y el H1 queda exactamente igual que antes.
const businessPrefixes = tList(lang, 'hero.v2_business_prefixes');
const firstWord = businessTypes[0] ?? '';
const firstPrefix = businessPrefixes[0] ?? '';

// Contadores de prueba social — computados server-side (deterministas por fecha
// de build) desde lib/social-counts.ts, que es la fuente única de la aritmética.
// <SocialCountLive /> los recalcula en cliente si el build es de otro día.
// 2026-09-20 (John): el nº de chefs también crece a diario, ya no es una constante.
const locale = lang === 'en' ? 'en-US' : 'es-ES';
const socialCount = dynamicSolutions().toLocaleString(locale);
const chefsCount = dynamicChefs().toLocaleString(locale);

const avatars = [1, 2, 3, 4, 5, 6, 7, 8];

// CounterStat: valor final + sufijo (estado visual final estático)
// Nº de agentes por idioma (2026-08-15): es/en anuncian 75+ (las plataformas
// sirven 89/80); it/fr/de/pt/nl anuncian 50+ porque sus plataformas sirven
// 53-54 — subirlo cuando John complete esos catálogos (CATALOGO_ITALIANO_PENDIENTE.md).
const nAgentes = ['es', 'en'].includes(lang) ? 75 : 50;
// Orden Keak: agentes · herramientas · recetarios · roles.
const stats = [
  { end: nAgentes, suffix: '+', label: t(lang, 'hero.v2_stat_agents') },
  { end: 10, suffix: '+', label: t(lang, 'hero.v2_stat_tools') },
  { end: 25, suffix: '+', label: t(lang, 'hero.v2_stat_cookbooks') },
  { end: 6, suffix: '', label: t(lang, 'hero.v2_stat_roles') },
];
---

<section id="inicio" data-keak="hero-v2" class="container flex max-w-[64rem] flex-col items-center gap-4 pb-8 pt-6 md:pb-12 md:pt-10 lg:py-32">
  <!-- HeroSocialProof -->
  <div class="flex flex-col items-center gap-2 mb-4">
    <div class="flex -space-x-3 justify-center">
      {avatars.map((i) => (
        <span class="relative flex h-10 w-10 shrink-0 overflow-hidden rounded-full border-2 border-background w-9 h-9 sm:w-10 sm:h-10 ring-2 ring-background">
          <img class="aspect-square h-full w-full" src={`/avatars/avatar-${i}.jpg`} alt={`Professional ${i}`} loading="lazy" />
        </span>
      ))}
    </div>
    <div class="flex flex-col items-center gap-0.5">
      <div class="flex items-center gap-0.5">
        {[0, 1, 2, 3, 4].map((i) => (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={`h-4 w-4 ${i < 4 ? 'fill-accent text-accent' : 'fill-accent/50 text-accent'}`}><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
        ))}
      </div>
      <span class="text-sm text-muted-foreground text-center text-balance">
        {t(lang, 'hero.v2_social_prefix')}{' '}
        <strong class="font-bold text-foreground" data-social-chefs>{chefsCount}+</strong>{' '}
        {t(lang, 'hero.v2_social_chefs')}{' '}
        {t(lang, 'hero.v2_social_countries')}{' · '}
        <strong class="font-bold text-foreground" data-social-count>{socialCount}</strong><SocialCountLive />{' '}
        {t(lang, 'hero.v2_social_count')}
      </span>
    </div>
  </div>

  <h1 class="text-center text-4xl font-bold leading-tight tracking-tighter md:text-6xl lg:text-7xl lg:leading-[1.1] text-balance">
    {t(lang, 'hero.v2_title_prefix')}{' '}
    <span id="hero-dynamic-prefix">{firstPrefix}</span><span id="hero-dynamic-gap">{firstPrefix ? ' ' : ''}</span><span id="hero-dynamic-word" class="inline-block transition-all duration-300 dynamic-hero-text opacity-100 scale-100">{firstWord}</span>
    {' '}{t(lang, 'hero.v2_title_suffix')}{' '}
    <span class="text-foreground">{t(lang, 'hero.title_brand')}</span>
  </h1>

  <p class="max-w-[42rem] text-center text-lg text-accent-dark font-semibold sm:text-xl text-balance leading-7 mb-2">
    {t(lang, 'hero.v2_subtitle')}
  </p>

  <p class="max-w-[42rem] text-center text-base text-muted-foreground text-balance leading-6">
    {t(lang, 'hero.v2_description')}
  </p>

  <!-- Counter Stats — APILADAS: número grande centrado y etiqueta debajo. La versión en línea
       de Keak (número + etiqueta con base común) sólo funcionaba con etiquetas de una línea; en
       ES/DE/NL se partían en dos y el número quedaba flotando arriba a la izquierda (John, 20-sep). -->
  <div class="grid w-full max-w-3xl grid-cols-2 sm:grid-cols-4 gap-y-6 my-6 rounded-xl border bg-muted/30 p-5 sm:p-6 sm:divide-x sm:divide-border">
    {stats.map((s) => (
      <div class="flex flex-col items-center justify-start gap-1.5 px-2 text-center">
        <span class="text-3xl md:text-4xl font-bold leading-none tabular-nums text-foreground" data-counter data-target={s.end} data-suffix={s.suffix}>{s.end}{s.suffix}</span>
        <span class="max-w-[10rem] break-words hyphens-auto text-xs sm:text-sm font-medium leading-snug text-muted-foreground text-balance">{s.label}</span>
      </div>
    ))}
  </div>

  <!-- CTA doble. El botón dorado va PRIMERO en el DOM (Keak lo quiere arriba en
       móvil) y `sm:order-last` lo manda a la derecha en escritorio. Antes se
       hacía con flex-col-reverse, que invierte lo pintado pero NO el orden de
       tabulación: el teclado y los lectores de pantalla recorrían el hero al
       revés de lo que se veía. -->
  <div class="flex flex-col sm:flex-row items-center gap-4 animate-fade-up w-full sm:w-auto">
    <a href={appUrl(lang)} target="_blank" rel="noopener noreferrer" class="sm:order-last inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors h-11 px-8 btn-gold hover:shadow-gold-glow w-full sm:w-auto min-h-[3rem]">
      {t(lang, 'cta.primary')}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
    <a href={pricingHref(lang)} class="uppercase tracking-wider text-sm font-semibold inline-flex items-center gap-2 text-foreground hover:text-accent-dark transition-colors">
      {t(lang, 'hero.v2_cta_pricing')}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>

  <p class="text-xs text-muted-foreground text-center text-balance">
    {t(lang, 'hero.v2_microcopy')}
  </p>
</section>

<script define:vars={{ businessTypes, businessPrefixes }}>
  // Rotación de palabra dinámica (equivalente al useEffect de ModernHero).
  // El artículo (de/it/pt) vive en su propio <span> FUERA del dorado y rota con
  // el MISMO índice: si se desincronizaran saldría «in Ihrer Restaurant».
  const el = document.getElementById('hero-dynamic-word');
  const elPrefix = document.getElementById('hero-dynamic-prefix');
  const elGap = document.getElementById('hero-dynamic-gap');
  const prefixes = Array.isArray(businessPrefixes) ? businessPrefixes : [];
  // Lista más corta o ausente (idioma sin artículos) ⇒ prefijo vacío y sin hueco.
  const prefixAt = (i) => (typeof prefixes[i] === 'string' ? prefixes[i] : '');
  if (el && Array.isArray(businessTypes) && businessTypes.length > 1) {
    let idx = 0;
    const show = () => {
      el.classList.remove('opacity-0', 'scale-95');
      el.classList.add('opacity-100', 'scale-100');
      if (elPrefix) {
        elPrefix.classList.remove('opacity-0', 'scale-95');
        elPrefix.classList.add('opacity-100', 'scale-100');
      }
    };
    const hide = () => {
      el.classList.remove('opacity-100', 'scale-100');
      el.classList.add('opacity-0', 'scale-95');
      if (elPrefix) {
        elPrefix.classList.remove('opacity-100', 'scale-100');
        elPrefix.classList.add('opacity-0', 'scale-95');
      }
    };
    if (elPrefix) elPrefix.classList.add('inline-block', 'transition-all', 'duration-300', 'opacity-100', 'scale-100');
    // En pestañas en background el navegador throttlea los timers: el setTimeout de
    // restauración se retrasa y la palabra se quedaba invisible (opacity-0) al volver
    // a la pestaña. Guard con document.hidden + restauración en visibilitychange.
    setInterval(() => {
      if (document.hidden) return;
      hide();
      setTimeout(() => {
        idx = (idx + 1) % businessTypes.length;
        el.textContent = businessTypes[idx];
        const pre = prefixAt(idx);
        if (elPrefix) elPrefix.textContent = pre;
        if (elGap) elGap.textContent = pre ? ' ' : '';
        show();
      }, 300);
    }, 3000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) show(); });
  }

  // Count-up de las stats al entrar en viewport (equivalente a CounterStat)
  const counters = document.querySelectorAll('[data-counter]');
  const animate = (node) => {
    const target = parseInt(node.getAttribute('data-target') || '0', 10);
    const suffix = node.getAttribute('data-suffix') || '';
    const duration = 2000;
    let start;
    const step = (ts) => {
      if (!start) start = ts;
      const progress = Math.min((ts - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      node.textContent = Math.floor(eased * target) + suffix;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animate(entry.target);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    counters.forEach((c) => io.observe(c));
  }
</script>
