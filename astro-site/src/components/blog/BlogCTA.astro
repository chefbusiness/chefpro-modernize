---
// Fase 8B — CTA estándar al final de cada post del blog.
// El blog existe para alimentar de tráfico cualificado a la app: todo post lleva
// este bloque. 8B.6: variante EN (copy nativo). 2026-08-16 (apertura del blog
// FR): variantes IT y FR, y el host deja de estar cableado aquí.
//
// EL HOST SALE DE lib/app-url.ts, QUE ES LA FUENTE ÚNICA. Antes era un ternario
// `lang === 'en' ? enapp : app`, así que los posts italianos —que existen desde
// la Fase 9— mandaban al lector a la plataforma ESPAÑOLA justo en el clic que
// convierte, pese a que itapp.aichef.pro existe y está localizado. Es
// exactamente el bug que documenta el encabezado de app-url.ts, cometido en un
// componente más.
import type { Locale } from '../../i18n/config';
import { appUrl as plataforma } from '../../lib/app-url';

interface Props {
  /** UTM content para atribuir el post de origen. */
  utmContent?: string;
  lang?: Locale;
}
const { utmContent = 'blog-post', lang = 'es' } = Astro.props;
/** Inicio de invitado del idioma, nunca la ruta de un agente. ES /invitado,
 *  IT /ospite, el resto /guest. La raíz del subdominio ya redirige ahí; el
 *  CTA la nombra para que el enlace no dependa de esa redirección. */
const GUEST_PATH: Record<Locale, string> = {
  es: '/invitado',
  en: '/guest',
  fr: '/guest',
  de: '/guest',
  it: '/ospite',
  pt: '/guest',
  nl: '/guest',
};
const appUrl = `${plataforma(lang)}${GUEST_PATH[lang] ?? '/invitado'}?utm_source=blog&utm_medium=cta&utm_content=${utmContent}`;

// Copy por idioma. nl tiene blog desde 2026-10-22: sin esta entrada el CTA
// neerlandés salía en castellano. Si cae al español, el cierre del artículo
// saluda en otro idioma. Tratamiento: u.
// 2026-08-17 — FIN DEL PLAN GRATIS (fase11, 2026-08-15): este componente se
// escapó del barrido y siguió diciendo «Pruébalo gratis» en 4 idiomas hasta
// hoy. Copy nuevo con el framing de John («planes para todos los bolsillos,
// desde 10 €») y la cifra de los posts: más de 80 agentes de IA, en frase natural.
const COPY = {
  en: {
    heading: 'More than 80 culinary AI agents for the day-to-day in your kitchen',
    body:
      'Recipe costing, menus, HACCP, food marketing and a lot more. Plans for every budget, from €10/month.',
    cta: 'Discover AI Chef Pro',
  },
  it: {
    heading: 'Oltre 80 agenti IA culinari per il lavoro di ogni giorno in cucina',
    body:
      'Food cost, menu, HACCP, marketing gastronomico e molto altro. Piani per tutte le tasche, da 10 € al mese.',
    cta: 'Scopri AI Chef Pro',
  },
  fr: {
    heading: "Plus de 80 agents IA culinaires pour le quotidien de votre cuisine",
    body:
      "Fiches techniques, cartes, HACCP, marketing gastronomique et bien plus encore. Des formules pour tous les budgets, à partir de 10 €/mois.",
    cta: 'Découvrir AI Chef Pro',
  },
  // 2026-08-18 — blog DE (Sie-Form). Cifra de los posts: más de 80 agentes.
  de: {
    heading: 'Mehr als 80 kulinarische KI-Agenten für den Alltag in Ihrer Küche',
    body:
      'Kalkulation, Speisekarten, HACCP, Gastro-Marketing und vieles mehr. Tarife für jedes Budget, ab 10 €/Monat.',
    cta: 'AI Chef Pro entdecken',
  },
  // 2026-08-19 — blog PT (PT-PT: «ementas», no «cardápios»; «carteiras»).
  // Cifra de los posts: más de 80 agentes.
  pt: {
    heading: 'Mais de 80 agentes de IA culinários para o dia a dia da sua cozinha',
    body:
      'Fichas técnicas, ementas, HACCP, marketing gastronómico e muito mais. Planos para todas as carteiras, desde 10 €/mês.',
    cta: 'Descobrir o AI Chef Pro',
  },
  nl: {
    heading: 'Meer dan 80 culinaire AI-agents voor de dagelijkse gang in uw keuken',
    body:
      'Recepten, kostprijs, allergenen, marketing en meer. Formules voor elk budget, vanaf €10 per maand.',
    cta: 'Ontdek AI Chef Pro',
  },
  es: {
    heading: 'Más de 80 agentes de IA culinarios para el día a día de tu cocina',
    body:
      'Escandallos, cartas, APPCC, marketing gastronómico y mucho más. Planes para todos los bolsillos, desde 10 €/mes.',
    cta: 'Descubrir AI Chef Pro',
  },
} as const;

const copy = COPY[lang as keyof typeof COPY] ?? COPY.es;
---

<aside class="not-prose my-10 rounded-2xl border border-primary/20 bg-gradient-to-br from-primary/10 via-background to-background p-8 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-primary">AI Chef Pro</p>
  <h2 class="mt-2 text-2xl font-bold text-foreground">
    {copy.heading}
  </h2>
  <p class="mx-auto mt-3 max-w-xl text-muted-foreground">
    {copy.body}
  </p>
  <a
    href={appUrl}
    target="_blank"
    rel="noopener"
    class="mt-6 inline-block rounded-lg bg-primary px-8 py-3 font-semibold text-primary-foreground transition-opacity hover:opacity-90"
  >
    {copy.cta}
  </a>
</aside>
