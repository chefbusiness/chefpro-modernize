const tiendaUrl = tiendaHref(lang);
const tiendaLabel = TIENDA_NOMBRE[lang];

// Iconos lucide (Icon.astro, la misma librería inline del sitio). El tono de
// cada opción de Servicios conserva el color que ya identificaba la landing.
const servicioItems = [
  {
    href: mentoriaHref,
    label: t(lang, 'nav.mentoria_online'),
    desc: pick({ es: 'Sesiones 1:1 para tu cocina', en: '1:1 sessions for your kitchen', fr: 'Séances individuelles pour votre cuisine', de: 'Einzelgespräche für Ihre Küche', it: 'Sessioni individuali per la tua cucina', pt: 'Sessões individuais para a sua cozinha', nl: 'Individuele sessies voor uw keuken' }, 'Sesiones 1:1 para tu cocina'),
    icon: 'GraduationCap',
    well: 'bg-accent text-accent-foreground',
    title: 'text-foreground',
  },
  {
    href: trainingHref,
    label: t(lang, 'nav.formacion_presencial'),
    desc: pick({ es: 'Cursos presenciales con tu equipo', en: 'On-site courses with your team', fr: 'Cours sur place avec votre équipe', de: 'Präsenzkurse mit Ihrem Team', it: 'Corsi in sede con il tuo team', pt: 'Cursos presenciais com a sua equipe', nl: 'Trainingen op locatie met uw team' }, 'Cursos presenciales con tu equipo'),
    icon: 'Building2',
    well: 'bg-accent text-accent-foreground',
    title: 'text-foreground',
  },
  {
    href: aiTools,
    label: t(lang, 'nav.herramientas_ia'),
    desc: pick({ es: 'La suite de agentes para el restaurante', en: 'The agent suite for your restaurant', fr: "La suite d'agents pour votre restaurant", de: 'Die Agenten-Suite für Ihr Restaurant', it: 'La suite di agenti per il ristorante', pt: 'A suite de agentes para o restaurante', nl: 'De agentensuite voor uw restaurant' }, 'La suite de agentes para el restaurante'),
    icon: 'Sparkles',
    well: 'bg-primary/10 text-primary',
    title: 'text-primary',
  },
  {
    href: costes,
    label: t(lang, 'nav.reducir_costes'),
    desc: pick({ es: 'Food cost, mermas y escandallos', en: 'Food cost, waste and recipe costing', fr: 'Food cost, pertes et fiches techniques', de: 'Wareneinsatz, Schwund und Kalkulation', it: 'Food cost, sprechi e schede ricetta', pt: 'Food cost, desperdício e fichas técnicas', nl: 'Foodcost, derving en calculatie' }, 'Food cost, mermas y escandallos'),
    icon: 'TrendingDown',
    well: 'bg-red-500/10 text-red-600',
    title: 'text-red-600',
  },
  {
    href: menuSlug,
    label: t(lang, 'nav.carta_menu'),
    desc: pick({ es: 'Ingeniería de carta con IA', en: 'Menu engineering with AI', fr: "Ingénierie de carte avec l'IA", de: 'Speisekarten-Engineering mit KI', it: "Ingegneria del menu con l'IA", pt: 'Engenharia de cardápio com IA', nl: 'Menukaart-engineering met AI' }, 'Ingeniería de carta con IA'),
    icon: 'Utensils',
    well: 'bg-emerald-500/10 text-emerald-600',
    title: 'text-emerald-600',
  },
  {
    href: marketing,
    label: t(lang, 'nav.marketing_ia'),
    desc: pick({ es: 'Contenido y captación de clientes', en: 'Content and guest acquisition', fr: 'Contenu et acquisition de clients', de: 'Inhalte und Gästegewinnung', it: 'Contenuti e acquisizione clienti', pt: 'Conteúdo e captação de clientes', nl: 'Content en gastenwerving' }, 'Contenido y captación de clientes'),
    icon: 'Megaphone',
    well: 'bg-violet-500/10 text-violet-600',
    title: 'text-violet-600',
  },
  {
    href: chatgpt,
    label: t(lang, 'nav.chatgpt_ia'),
    desc: pick({ es: 'Usos prácticos en cocina y sala', en: 'Practical uses in kitchen and service', fr: 'Usages pratiques en cuisine et en salle', de: 'Praktische Einsätze in Küche und Service', it: 'Usi pratici in cucina e in sala', pt: 'Usos práticos na cozinha e na sala', nl: 'Praktisch gebruik in keuken en bediening' }, 'Usos prácticos en cocina y sala'),
    icon: 'MessageSquare',
    well: 'bg-indigo-500/10 text-indigo-600',
    title: 'text-indigo-600',
  },
];
const serviciosIntro = pick({ es: 'Formación, operación y captación', en: 'Training, operations and demand', fr: 'Formation, exploitation et acquisition', de: 'Schulung, Betrieb und Nachfrage', it: 'Formazione, operatività e acquisizione', pt: 'Formação, operação e captação', nl: 'Training, operatie en vraag' }, 'Formación, operación y captación');
const porRolIntro = pick({ es: 'Quién lleva el negocio', en: 'Who runs the business', fr: "Qui pilote l'activité", de: 'Wer den Betrieb führt', it: "Chi guida l'attività", pt: 'Quem conduz o negócio', nl: 'Wie de zaak leidt' }, 'Quién lleva el negocio');
const porConceptoIntro = pick({ es: 'El formato del local', en: 'The venue format', fr: "Le format de l'établissement", de: 'Das Format des Betriebs', it: 'Il formato del locale', pt: 'O formato do espaço', nl: 'Het format van de zaak' }, 'El formato del local');
const porCiudadIntro = 'Apertura en España y Latinoamérica';

const ROLE_ICON: Record<string, string> = {
  'propietario-restaurante': 'Crown',
  'gerente-restaurante': 'UserCog',
  'chef-ejecutivo-corporativo': 'BriefcaseBusiness',
  'chef-jefe-cocina': 'ChefHat',
  'chef-catering': 'Truck',
};
const CONCEPT_ICON: Record<string, string> = {
  'restaurante-casual': 'Utensils',
  pizzeria: 'Pizza',
  'dark-kitchen': 'Warehouse',
  'catering-eventos': 'PartyPopper',
  'hotel-completo-fb': 'Hotel',
  'restaurante-gastronomico-michelin': 'Award',
};

const agenteCols = [
  {
    icon: 'Sparkles',
    title: t(lang, 'categories_labels.creatividad'),
    desc: t(lang, 'categories.creativity.description'),
    items: [
      { href: sectionHref('showcase-creatividad'), label: t(lang, 'nav.creatividad'), desc: '', icon: 'Sparkles' },
      { href: sectionHref('showcase-creatividad'), label: t(lang, 'apps.creativity.pasteleria_creativa.name'), desc: t(lang, 'apps.creativity.pasteleria_creativa.description'), icon: 'Cake' },
      { href: sectionHref('showcase-creatividad'), label: t(lang, 'apps.creativity.food_pairing.name'), desc: t(lang, 'apps.creativity.food_pairing.description'), icon: 'FlaskConical' },
    ],
  },
  {
    icon: 'BookOpen',
    title: t(lang, 'categories_labels.recetarios'),
    desc: t(lang, 'categories.cookbooks.description'),
    items: [
      { href: sectionHref('recetarios'), label: t(lang, 'categories.world_cookbooks.europa.name'), desc: t(lang, 'categories.world_cookbooks.europa.count'), icon: 'Wheat' },
      { href: sectionHref('recetarios'), label: t(lang, 'categories.world_cookbooks.latinoamerica.name'), desc: t(lang, 'categories.world_cookbooks.latinoamerica.count'), icon: 'Palmtree' },
      { href: sectionHref('recetarios'), label: t(lang, 'categories.world_cookbooks.asia.name'), desc: t(lang, 'categories.world_cookbooks.asia.count'), icon: 'UtensilsCrossed' },
    ],
  },
  {
    icon: 'BriefcaseBusiness',
    title: t(lang, 'showcase.business_title'),
    desc: t(lang, 'showcase.business_description'),
    items: [
      { href: sectionHref('herramientas-business'), label: t(lang, 'apps.business.mermas_gencal.name'), desc: t(lang, 'apps.business.mermas_gencal.description'), icon: 'Recycle' },
      { href: sectionHref('herramientas-business'), label: t(lang, 'apps.business.id_alergenos.name'), desc: t(lang, 'apps.business.id_alergenos.description'), icon: 'ShieldAlert' },
      { href: sectionHref('herramientas-business'), label: t(lang, 'apps.business.mental_coach.name'), desc: t(lang, 'apps.business.mental_coach.description'), icon: 'Heart' },
    ],
  },
];
const megaTriggerClass = 'nav-mega-trigger inline-flex h-10 w-max items-center justify-center rounded-md bg-background px-3 2xl:px-4 py-2 text-sm font-medium text-foreground/60 transition-colors hover:bg-accent hover:text-foreground focus-visible:bg-accent focus-visible:text-foreground focus-visible:outline-none';
---

<div class="sticky top-0 z-50">
  <!-- AnnouncementBar -->
  <div id="announcement-bar" class="bg-chef-dark text-background text-center text-xs sm:text-sm py-2 px-10 relative">
    <a href={annHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-accent transition-colors">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-accent flex-shrink-0"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
      <span class="hidden sm:inline">{t(lang, 'announcement_bar.text')}</span>
      <span class="sm:hidden">{t(lang, 'announcement_bar.text_short')}</span>
      <span class="font-semibold text-accent whitespace-nowrap">{t(lang, 'announcement_bar.cta')} →</span>
    </a>
    <button id="announcement-close" class="absolute right-2 top-1/2 -translate-y-1/2 text-background/60 hover:text-background transition-colors p-1" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <header class="w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
    <!-- Móvil: el contenedor lleva 2rem de margen por config y el logo mide 206 px, y con el selector de idioma
         y la hamburguesa la cabecera sumaba 431 px en un móvil de 360 (medido el 21-sep-2026): Android ensancha
         el viewport de layout y la página entera se desplaza. Margen 1rem y logo h-6 por debajo de sm. -->
    <div class="container flex h-14 max-w-screen-2xl items-center px-4 sm:px-8">
      <div class="mr-2 2xl:mr-4 flex">
        <a class="mr-2 sm:mr-4 2xl:mr-6 flex shrink-0 items-center space-x-2" href="/">
          <img src="/logo-ai-chef-pro.svg" alt="AI Chef Pro Logo" class="h-6 sm:h-8 w-auto max-w-none shrink-0" />
        </a>

        <!-- Desktop nav. El <ul> no lleva "group": un hover abriría todos los paneles (bug 2026-07-03). -->
        <nav class={`relative z-10 hidden max-w-max flex-1 items-center justify-center ${deskNavShow}`}>
          <ul class="flex flex-1 list-none items-center justify-center space-x-1">
            <li class="hidden 2xl:block">
              <a class="whitespace-nowrap text-sm font-medium transition-colors hover:text-foreground/80 text-foreground/60 px-3 py-2" href={homeHref}>{t(lang, 'nav.inicio')}</a>
            </li>

            <!-- Servicios -->
            <li class="nav-mega relative" data-mega>
              <button type="button" class={megaTriggerClass} data-mega-trigger aria-expanded="false" aria-haspopup="true" aria-controls="mega-servicios">
                {t(lang, 'nav.servicios')}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-mega-chevron relative top-[1px] ml-1 h-3 w-3" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div id="mega-servicios" class="nav-mega-panel" data-mega-panel role="region" aria-label={t(lang, 'nav.servicios')}>
                <div class="w-[28rem] max-w-[calc(100vw-2rem)] overflow-hidden rounded-xl border bg-popover text-popover-foreground shadow-lg">
                  <div class="flex items-center gap-2.5 border-b px-4 py-3">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-accent-foreground" aria-hidden="true">
                      <Icon name="Briefcase" class="h-4 w-4" />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold leading-none">{t(lang, 'nav.servicios')}</span>
                      <span class="mt-1 block text-xs text-muted-foreground">{serviciosIntro}</span>
                    </span>
                  </div>
                  <div class="grid gap-0.5 p-2">
                    {servicioItems.map((item) => (
                      <a class="flex items-start gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-accent/70 focus-visible:bg-accent focus-visible:outline-none" href={item.href}>
                        <span class:list={['mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg', item.well]} aria-hidden="true">
                          <Icon name={item.icon} class="h-4 w-4" />
                        </span>
                        <span class="min-w-0">
                          <span class:list={['block text-sm font-medium leading-snug', item.title]}>{item.label}</span>
                          <span class="mt-0.5 block text-xs leading-snug text-muted-foreground">{item.desc}</span>
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </li>

            <!-- Casos de uso -->
            <li class="nav-mega relative" data-mega>
              <button type="button" class={megaTriggerClass} data-mega-trigger aria-expanded="false" aria-haspopup="true" aria-controls="mega-casos">
                {casosLabel}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-mega-chevron relative top-[1px] ml-1 h-3 w-3" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div id="mega-casos" class="nav-mega-panel" data-mega-panel role="region" aria-label={casosLabel}>
                <div class={`overflow-hidden rounded-xl border bg-popover text-popover-foreground shadow-lg ${lang === 'es' ? 'w-[min(960px,calc(100vw-2rem))]' : 'w-[min(680px,calc(100vw-2rem))]'}`}>
                  <div class={`grid gap-2 p-3 ${lang === 'es' ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
                    <div>
                      <div class="mb-1 flex items-center gap-2.5 px-2 py-1.5">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-accent-foreground" aria-hidden="true">
                          <Icon name="Users" class="h-4 w-4" />
                        </span>
                        <span class="min-w-0">
                          <span class="block text-sm font-semibold leading-none text-accent">{porRolLabel}</span>
                          <span class="mt-1 block text-xs text-muted-foreground">{porRolIntro}</span>
                        </span>
                      </div>
                      <div class="grid">
                        {roleItems.map((item) => {
                          const d = pickItem(item);
                          return (
                            <a class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm text-foreground/80 transition-colors hover:bg-accent hover:text-foreground focus-visible:bg-accent focus-visible:outline-none" href={`${rolePrefix}/${d.slug}`}>
                              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-muted text-foreground" aria-hidden="true">
                                <Icon name={ROLE_ICON[item.es.slug] || 'Users'} class="h-3.5 w-3.5" />
                              </span>
                              <span class="min-w-0 leading-snug">{d.label}</span>
                            </a>
                          );
                        })}
                        <a class="mt-1 flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" href={usosHub}>
                          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary" aria-hidden="true">
                            <Icon name="LayoutGrid" class="h-3.5 w-3.5" />
                          </span>
                          {verRolesLabel}
                        </a>
                        <a class="mt-2 flex items-start gap-2.5 rounded-lg bg-gradient-to-br from-indigo-500/10 to-purple-500/5 px-2.5 py-2 transition-colors hover:from-indigo-500/15 hover:to-purple-500/10" href={consultorHref}>
                          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-indigo-500/15 text-indigo-700" aria-hidden="true">
                            <Icon name="Sparkles" class="h-3.5 w-3.5" />
                          </span>
                          <span class="min-w-0">
                            <span class="block text-sm font-semibold text-indigo-700">{consultorTitle}</span>
                            <span class="mt-0.5 block text-xs text-muted-foreground">{consultorDesc}</span>
                          </span>
                        </a>
                      </div>
                    </div>
                    <div>
                      <div class="mb-1 flex items-center gap-2.5 px-2 py-1.5">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-accent-foreground" aria-hidden="true">
                          <Icon name="Store" class="h-4 w-4" />
                        </span>
                        <span class="min-w-0">
                          <span class="block text-sm font-semibold leading-none text-accent">{porConceptoLabel}</span>
                          <span class="mt-1 block text-xs text-muted-foreground">{porConceptoIntro}</span>
                        </span>
                      </div>
                      <div class="grid">
                        {conceptItems.map((item) => {
                          const d = pickItem(item);
                          return (
                            <a class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm text-foreground/80 transition-colors hover:bg-accent hover:text-foreground focus-visible:bg-accent focus-visible:outline-none" href={`${conceptPrefix}/${d.slug}`}>
                              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-muted text-foreground" aria-hidden="true">
                                <Icon name={CONCEPT_ICON[item.es.slug] || 'Store'} class="h-3.5 w-3.5" />
                              </span>
                              <span class="min-w-0 leading-snug">{d.label}</span>
                            </a>
                          );
                        })}
                        <a class="mt-1 flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" href={usosHub}>
                          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary" aria-hidden="true">
                            <Icon name="LayoutGrid" class="h-3.5 w-3.5" />
                          </span>
                          {verConceptosLabel}
                        </a>
                      </div>
                    </div>
                    {lang === 'es' && (
                      <div>
                        <div class="mb-1 flex items-center gap-2.5 px-2 py-1.5">
                          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-accent-foreground" aria-hidden="true">
                            <Icon name="MapPin" class="h-4 w-4" />
                          </span>
                          <span class="min-w-0">
                            <span class="block text-sm font-semibold leading-none text-accent">Por ciudad</span>
                            <span class="mt-1 block text-xs text-muted-foreground">{porCiudadIntro}</span>
                          </span>
                        </div>
                        <div class="grid">
                          {cityItems.map((c) => (
                            <a class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm text-foreground/80 transition-colors hover:bg-accent hover:text-foreground focus-visible:bg-accent focus-visible:outline-none" href={`/abrir-restaurante/${c.slug}`}>
                              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-muted text-foreground" aria-hidden="true">
                                <Icon name="MapPin" class="h-3.5 w-3.5" />
                              </span>
                              <span class="min-w-0 leading-snug">Abrir restaurante en {c.label}</span>
                            </a>
                          ))}
                          <a class="mt-1 flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" href="/seo-restaurantes-por-ciudad">
                            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary" aria-hidden="true">
                              <Icon name="Map" class="h-3.5 w-3.5" />
                            </span>
                            Ver 15 ciudades + 5 recursos →
                          </a>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </li>

            <!-- Agentes IA -->
            <li class="nav-mega relative" data-mega>
              <button type="button" class={megaTriggerClass} data-mega-trigger aria-expanded="false" aria-haspopup="true" aria-controls="mega-agentes">
                {t(lang, 'nav.aplicaciones')}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-mega-chevron relative top-[1px] ml-1 h-3 w-3" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <div id="mega-agentes" class="nav-mega-panel" data-mega-panel role="region" aria-label={t(lang, 'nav.aplicaciones')}>
                <div class="w-[min(860px,calc(100vw-2rem))] overflow-hidden rounded-xl border bg-popover text-popover-foreground shadow-lg">
                  <div class="grid gap-2 p-3 md:grid-cols-3">
                    {agenteCols.map((col) => (
                      <div>
                        <div class="mb-1 flex items-start gap-2.5 px-2 py-1.5">
                          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent text-accent-foreground" aria-hidden="true">
                            <Icon name={col.icon} class="h-4 w-4" />
                          </span>
                          <span class="min-w-0">
                            <span class="block text-sm font-semibold leading-none text-accent">{col.title}</span>
                            <span class="mt-1 block text-xs leading-snug text-muted-foreground">{col.desc}</span>
                          </span>
                        </div>
                        <div class="grid">
                          {col.items.map((item) => (
                            <a class="flex items-start gap-2.5 rounded-lg px-2 py-1.5 transition-colors hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" href={item.href}>
                              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-muted text-foreground" aria-hidden="true">
                                <Icon name={item.icon} class="h-3.5 w-3.5" />
                              </span>
                              <span class="min-w-0">
                                <span class="block text-sm font-medium leading-snug text-foreground">{item.label}</span>
                                {item.desc && <span class="mt-0.5 block text-xs leading-snug text-muted-foreground">{item.desc}</span>}
                              </span>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </li>

            <li>
              <a class="inline-flex whitespace-nowrap items-center gap-1.5 text-sm font-medium transition-colors hover:text-foreground/80 text-foreground/60 px-2.5 2xl:px-3 py-2" href={integracionesHref(lang)}>
                {t(lang, 'nav.integraciones')}
              </a>
            </li>

            <li>
