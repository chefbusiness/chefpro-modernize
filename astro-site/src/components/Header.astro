                  <span class={flagClass} set:html={FLAG_SVG[l.code]} />{l.name}
                  {lang === l.code && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto h-4 w-4"><path d="M20 6 9 17l-5-5"/></svg>
                  )}
                </a>
              ))}
            </div>
          </details>
        </div>
      </nav>
    </div>

    <div class="sticky bottom-0 bg-card/95 backdrop-blur-sm border-t p-4" style="padding-bottom: max(16px, env(safe-area-inset-bottom));">
      <div class="flex gap-2">
        <a href={loginUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground flex-1 h-10 transition-colors">{t(lang, 'nav.login')}</a>
        <a href={ctaUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-xs font-medium bg-primary text-primary-foreground hover:bg-primary/90 flex-1 h-10 transition-colors">{t(lang, 'cta.primary')}</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* El panel empieza en el borde inferior del botón. El padding es el puente:
     el hueco visual sigue dentro del <li>, así el cursor no suelta el hover. */
  .nav-mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 50;
    padding-top: 10px;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .nav-mega.is-open > .nav-mega-panel {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }
  .nav-mega-panel > div {
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
  }
  .nav-mega.is-open > .nav-mega-trigger {
    background-color: hsl(var(--accent) / 0.7);
    color: hsl(var(--foreground));
  }
  .nav-mega-chevron {
    transition: transform 180ms ease;
  }
  .nav-mega.is-open .nav-mega-chevron {
    transform: rotate(180deg);
  }
  .nav-pop-panel {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 100;
    padding-top: 6px;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-mega-chevron { transition: none; }
  }
</style>

<script>
  const CLOSE_MS = 280;

  // AnnouncementBar dismiss (localStorage, paridad con AnnouncementBar.tsx)
  const annBar = document.getElementById('announcement-bar');
  if (annBar) {
    if (localStorage.getItem('announcement-dismissed') === 'true') annBar.style.display = 'none';
    document.getElementById('announcement-close')?.addEventListener('click', () => {
      annBar.style.display = 'none';
      localStorage.setItem('announcement-dismissed', 'true');
    });
  }

  // Menú móvil (Sheet) — abrir/cerrar sin framework
  const menu = document.getElementById('mobile-menu');
  const menuBtn = document.getElementById('mobile-menu-open');
  const openMenu = () => {
    menu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    menuBtn?.setAttribute('aria-expanded', 'true');
  };
  const closeMenu = () => {
    menu?.classList.add('hidden');
    document.body.style.overflow = '';
    menuBtn?.setAttribute('aria-expanded', 'false');
  };
  menuBtn?.addEventListener('click', openMenu);
  document.getElementById('mobile-menu-close')?.addEventListener('click', closeMenu);
  document.getElementById('mobile-menu-overlay')?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));

  // Mega-menús: hover con cierre retardado, clic que fija, foco y Escape.
  const megas = Array.from(document.querySelectorAll('[data-mega]'));
  const closeTimers = new WeakMap();
  let suppressFocusOpen = false;
  const hoverOK = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  const setExpanded = (item, open) => {
    const btn = item.querySelector('[data-mega-trigger]');
    const panel = item.querySelector('[data-mega-panel]');
    item.classList.toggle('is-open', open);
    btn?.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (!panel) return;
    panel.setAttribute('aria-hidden', open ? 'false' : 'true');
    if (open) panel.removeAttribute('inert');
    else panel.setAttribute('inert', '');
  };

  const closeMega = (item) => {
    const pending = closeTimers.get(item);
    if (pending) clearTimeout(pending);
    closeTimers.delete(item);
    item.classList.remove('is-pinned');
    setExpanded(item, false);
  };

  const openMega = (item, pin = false) => {
    const pending = closeTimers.get(item);
    if (pending) clearTimeout(pending);
    closeTimers.delete(item);
    megas.forEach((other) => { if (other !== item) closeMega(other); });
    document.querySelectorAll('details.js-pop[open]').forEach((d) => { d.open = false; });
    if (pin) item.classList.add('is-pinned');
    setExpanded(item, true);
  };

  const scheduleClose = (item) => {
    if (item.classList.contains('is-pinned')) return;
    const pending = closeTimers.get(item);
    if (pending) clearTimeout(pending);
    closeTimers.set(item, setTimeout(() => {
      if (!item.classList.contains('is-pinned')) setExpanded(item, false);
    }, CLOSE_MS));
  };

  megas.forEach((item) => {
    const btn = item.querySelector('[data-mega-trigger]');
    const panel = item.querySelector('[data-mega-panel]');
    setExpanded(item, false);

    item.addEventListener('pointerenter', (e) => {
      if (!hoverOK() || e.pointerType !== 'mouse') return;
      const pending = closeTimers.get(item);
      if (pending) clearTimeout(pending);
      closeTimers.delete(item);
      if (!item.classList.contains('is-open')) openMega(item);
    });
    item.addEventListener('pointerleave', (e) => {
      if (!hoverOK() || e.pointerType !== 'mouse') return;
      scheduleClose(item);
    });
    btn?.addEventListener('click', (e) => {
      e.preventDefault();
      if (item.classList.contains('is-pinned')) closeMega(item);
      else openMega(item, true);
    });
    btn?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown') return;
      e.preventDefault();
      openMega(item, true);
      panel?.querySelector('a')?.focus();
    });
    panel?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => closeMega(item));
    });
    item.addEventListener('focusin', () => {
      if (suppressFocusOpen) return;
      const pending = closeTimers.get(item);
      if (pending) clearTimeout(pending);
      closeTimers.delete(item);
      if (!item.classList.contains('is-open')) openMega(item);
    });
    item.addEventListener('focusout', (e) => {
      if (item.contains(e.relatedTarget)) return;
      item.classList.remove('is-pinned');
      scheduleClose(item);
    });
  });

  document.querySelectorAll('details.js-pop').forEach((d) => {
    const summary = d.querySelector('summary');
    const sync = () => summary?.setAttribute('aria-expanded', d.open ? 'true' : 'false');
    d.addEventListener('toggle', () => {
      sync();
      if (d.open) megas.forEach(closeMega);
    });
    sync();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = megas.find((m) => m.classList.contains('is-open'));
    if (open) {
      const btn = open.querySelector('[data-mega-trigger]');
      closeMega(open);
      suppressFocusOpen = true;
      btn?.focus();
      setTimeout(() => { suppressFocusOpen = false; }, 0);
    }
    document.querySelectorAll('details.js-pop[open]').forEach((d) => { d.open = false; });
    if (menu && !menu.classList.contains('hidden')) closeMenu();
  });

  document.addEventListener('pointerdown', (e) => {
    const target = e.target;
    if (!(target instanceof Node)) return;
    megas.forEach((item) => { if (!item.contains(target)) closeMega(item); });
    document.querySelectorAll('details.js-pop[open]').forEach((d) => {
      if (!d.contains(target)) d.open = false;
    });
  });

  // Selector de idioma: la cookie preferred-lang significa «el usuario ELIGIÓ»
  // (contrato de lang-redirect.ts) y por eso SOLO se siembra en este click —
  // nunca por visitar una URL con prefijo de idioma, que fue el bug del
  // 2026-08-14 (abrir un enlace /it secuestraba "/" un año). Gemelo SPA:
  // ModernHeader.tsx → changeLanguage() → persistLangCookie().
  document.querySelectorAll('[data-lang-choice]').forEach((a) =>
    a.addEventListener('click', () => {
      const code = a.getAttribute('data-lang-choice');
      if (code) document.cookie = `preferred-lang=${code}; path=/; max-age=31536000; SameSite=Lax`;
    })
  );
</script>
