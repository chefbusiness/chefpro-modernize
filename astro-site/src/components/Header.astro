<script>
  // AnnouncementBar dismiss (localStorage, paridad con AnnouncementBar.tsx)
  const annBar = document.getElementById('announcement-bar');
  if (annBar) {
    if (localStorage.getItem('announcement-dismissed') === 'true') annBar.style.display = 'none';
    document.getElementById('announcement-close')?.addEventListener('click', () => {
      annBar.style.display = 'none';
      localStorage.setItem('announcement-dismissed', 'true');
    });
  }

  // Menú móvil (Sheet) — abrir/cerrar sin framework
  const menu = document.getElementById('mobile-menu');
  const openMenu = () => { menu?.classList.remove('hidden'); document.body.style.overflow = 'hidden'; };
  const closeMenu = () => { menu?.classList.add('hidden'); document.body.style.overflow = ''; };
  document.getElementById('mobile-menu-open')?.addEventListener('click', openMenu);
  document.getElementById('mobile-menu-close')?.addEventListener('click', closeMenu);
  document.getElementById('mobile-menu-overlay')?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
</script>
