---
// TiendaStrip.astro — CTA hacia la tienda de productos digitales en la portada de un idioma con
// tienda NO española (hoy solo /en). Fase 0.C de TIENDA-INTERNACIONAL.md. Si el idioma no tiene
// tienda activa no pinta nada, así que montarlo en otra portada es inocuo.
// El ES no lo lleva: su portada ya tiene su propio camino a /productos-digitales.
import Icon from './Icon.astro';
import { tiendaHref } from '../lib/tienda';
import type { Locale } from '../i18n/config';
import copyEn from '../data/tienda-hub/en.json';

interface Props { lang: Locale }
const { lang } = Astro.props;

const COPY: Partial<Record<Locale, typeof copyEn.homeStrip>> = { en: copyEn.homeStrip };
const href = tiendaHref(lang);
const c = COPY[lang];
---

{href && c && (
  <section class="container py-12 md:py-16" data-tienda-strip>
    <div class="relative overflow-hidden rounded-3xl border border-[#FFD700]/25 bg-[#0a0a0a] px-6 py-10 md:px-12 md:py-12">
      <img src="/tienda-en/tienda-en-hero.jpg" alt="" aria-hidden="true" loading="lazy" width="1600" height="893"
           class="absolute inset-0 h-full w-full object-cover opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a] via-[#0a0a0a]/85 to-transparent"></div>
      <div class="relative max-w-2xl">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#FFD700]">{c.kicker}</p>
        <h2 class="mt-3 text-2xl md:text-4xl font-bold tracking-tight text-white text-balance">{c.title}</h2>
        <p class="mt-4 text-base md:text-lg text-gray-300">{c.sub}</p>
        <a href={`${href}?utm_source=home&utm_medium=strip&utm_content=${lang}`} target="_blank"
           class="mt-7 inline-flex items-center gap-2 rounded-xl bg-[#FFD700] px-6 py-3 text-base font-bold text-black hover:bg-[#FFD700]/90 transition-colors">
          {c.cta}
          <Icon name="ArrowRight" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
)}
