const MONOGRAMS: Record<string, { color: string; title: string; text: string }> = {
  outlook:  { color: '#0078D4', title: 'Outlook',  text: 'O'  },
  canva:    { color: '#00C4CC', title: 'Canva',    text: 'C'  },
  linkedin: { color: '#0A66C2', title: 'LinkedIn', text: 'in' },
  composio: { color: '#6366F1', title: 'Composio', text: 'Cx' },
};

const icon = ICONS[name];
const mono = MONOGRAMS[name];
---

{icon && (
  <span
    class={`brand-icon inline-flex ${className}`}
    style={`--brand-c:${icon.color};--brand-cd:${icon.dark ?? icon.color}`}
    role="img"
    aria-label={icon.title}
  >
    <svg viewBox="0 0 24 24" fill="currentColor" class="h-full w-full" aria-hidden="true" set:html={icon.body} />
  </span>
)}

{!icon && mono && (
  <span
    class={`inline-flex items-center justify-center rounded-md font-bold text-white ${className}`}
    style={`background-color:${mono.color};font-size:0.7em;line-height:1`}
    role="img"
    aria-label={mono.title}
  >{mono.text}</span>
)}

<style>
  .brand-icon { color: var(--brand-c); }
  :global(.dark) .brand-icon { color: var(--brand-cd); }
</style>
