---
import '../styles/global.css';
import { LOCALES, DEFAULT_LOCALE, SITE, type Locale } from '../i18n/config';
import { t } from '../i18n/translations';
// Google Ads (AW-17829651892) + su banner de consentimiento. Van juntos a
// propósito: el tag arranca con Consent Mode DENEGADO y es el banner el único
// que lo concede, así que meter uno sin el otro rompe la medición o el RGPD.
import GoogleTag from '../components/GoogleTag.astro';
import CookieConsent from '../components/CookieConsent.astro';
// Contador determinista de usuarios (función pura, sin React pese al nombre) —
// cross-root de la SPA: misma fórmula que alimenta el aggregateRating del
// SoftwareApplication en SEOHead.tsx. En build queda congelado a la fecha del
// deploy (desviación aceptada: en la SPA se calcula en cliente; los deploys
// frecuentes lo mantienen al día).
import { useLiveUserCount } from '@/hooks/useLiveUserCount';

interface Props {
  title: string;
  /** Opcional desde Fase 5: la zona app post-pago (gates/dashboards/admin) no
   *  lleva meta description en la SPA (Helmet solo emite robots+title). */
  description?: string;
  /** meta keywords — paridad con SEOHead.tsx de la SPA (pages.*.seo_keywords). */
  keywords?: string;
  lang?: Locale;
  /** Ruta canónica SIN prefijo de idioma, con barra inicial. Ej: "/precios" */
  basePath?: string;
  /** Override para páginas con slugs nativos por idioma: { es: '/precios', en: '/en/pricing', ... } */
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string;
  /** Subconjunto de idiomas para los que ESTA ruta existe. Por defecto: TODOS (LOCALES).
   *  Páginas mono-idioma (p.ej. /formacion-presencial, solo ES) pasan locales={['es']}
   *  para NO emitir hreflang de variantes inexistentes. x-default apunta a DEFAULT_LOCALE
   *  si está en la lista, si no a la primera de la lista. Las páginas que NO pasan la prop
   *  se comportan EXACTAMENTE igual que antes. */
  locales?: Locale[];
  /** Zona app post-pago (Fase 5): emite <meta robots noindex,nofollow> y OMITE
   *  canonical + hreflang (la SPA tampoco los emite en estas páginas; señales
   *  contradictorias en páginas privadas). El default false deja el resto del
   *  site EXACTAMENTE igual que antes. */
  noindex?: boolean;
  /** Landings de PRODUCTO digital (2026-08-29, decisión de John): omiten el
   *  SoftwareApplication global del SaaS para que Google monte el rich result
   *  con el `Product` de la propia landing (sus estrellas y su precio real).
   *  Con el global presente, la SERP de /kit-tareas-hotel mostraba «4,8 (9.122)
   *  · 95,00 €» — valoraciones de la plataforma y un plan de suscripción — en un
   *  kit de 18,50 €. Organization y WebSite se siguen emitiendo. */
  omitGlobalApp?: boolean;
}

const {
  title,
  description = '',
  keywords,
  lang = DEFAULT_LOCALE,
  basePath = '/',
  alternates,
  ogImage,
  locales,
  noindex = false,
  omitGlobalApp = false,
} = Astro.props;

// Idiomas para los que se emiten hreflang/og:locale:alternate (default: todos).
const emittedLocales: readonly Locale[] = locales ?? LOCALES;
const xDefaultLocale: Locale = emittedLocales.includes(DEFAULT_LOCALE)
  ? DEFAULT_LOCALE
  : emittedLocales[0];

// og:locale por idioma (paridad exacta con getOGLocale() de SEOHead.tsx en la SPA).
const OG_LOCALE: Record<Locale, string> = {
  es: 'es_ES', en: 'en_US', fr: 'fr_FR', de: 'de_DE', it: 'it_IT', pt: 'pt_PT', nl: 'nl_NL',
};
const ogLocale = OG_LOCALE[lang];
const ogImageAlt = `${title} - AI Chef Pro`;

// hreflang + canonical nativos para TODAS las páginas — gate de Fase 0 del plan maestro
// (la SPA actual sirve 0 etiquetas hreflang; este layout lo corrige de raíz).
const urlFor = (locale: Locale): string => {
  const override = alternates?.[locale];
  if (override) return `${SITE}${override}`;
  const p = basePath === '/' ? '' : basePath;
  return locale === DEFAULT_LOCALE ? `${SITE}${p || '/'}` : `${SITE}/${locale}${p}`;
};
const canonical = urlFor(lang);

// Fase 6 — los 3 JSON-LD GLOBALES de SEOHead.tsx, replicados VERBATIM (misma
// estructura, mismos literales). En la SPA los emite cada página con SEOHead;
// aquí van en el layout para TODAS las páginas indexables (desviación aceptada
// y documentada: las pocas páginas de la SPA sin SEOHead no los emitían).
const userCount = useLiveUserCount('es').count;
const globalSchemas = noindex
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'AI Chef Pro',
        url: SITE,
        logo: `${SITE}/logo-ai-chef-pro.svg`,
        // Perfiles oficiales de la MARCA. Deben cuadrar con los que enlaza el
        // pie: si el sitio enlaza uno y el schema declara otro, se está
        // afirmando una identidad que la propia web no respalda.
        sameAs: [
          'https://x.com/aichefpro',
          'https://youtube.com/@aichefpro',
          'https://tiktok.com/aichefpro',
          'https://www.linkedin.com/company/aichefpro',
        ],
        contactPoint: {
          '@type': 'ContactPoint',
          email: 'info@aichef.pro',
          telephone: '+34744717942',
          contactType: 'customer service',
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'AI Chef Pro',
        url: SITE,
        inLanguage: [...LOCALES],
      },
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'AI Chef Pro',
        description,
        url: SITE,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        // Las 5 descripciones estaban en CASTELLANO y se emitían en las 1.122
        // URLs del sitio, también bajo <html lang="it"> y og:locale=it_IT.
        // No lo lee un humano, pero sí Google y los motores generativos.
        offers: [
          {
            '@type': 'Offer',
            name: 'AI Chef Miembro',
            description: t(lang, 'schema.offers.miembro'),
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '10',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Pro',
            description: t(lang, 'schema.offers.premium_pro'),
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '25',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Plus',
            description: t(lang, 'schema.offers.premium_plus'),
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '50',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Max',
            description: t(lang, 'schema.offers.premium_max'),
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '95',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Max Anual',
            description: t(lang, 'schema.offers.premium_max_anual'),
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '950',
            priceValidUntil: '2026-12-31',
          },
        ],
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '4.8',
          ratingCount: String(userCount),
          bestRating: '5',
          worstRating: '1',
        },
        inLanguage: [...LOCALES],
      },
    ];
// Landings de producto: fuera el SoftwareApplication global (ver prop omitGlobalApp).
const emittedSchemas = omitGlobalApp
  ? globalSchemas.filter((g) => g['@type'] !== 'SoftwareApplication')
  : globalSchemas;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Lo PRIMERO tras el charset: el Consent Mode tiene que fijarse antes de
        que cargue nada que pueda sembrar una cookie publicitaria. */}
    <GoogleTag />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="AI Chef Pro" />
    {/* Fase 7 (cutover): meta robots index,follow en páginas indexables — paridad
        con SEOHead.tsx de la SPA. En STAGING sigue mandando la cabecera
        X-Robots-Tag: noindex de su netlify.toml (más restrictiva → Google la
        respeta), así que staging permanece fuera del índice. La zona app
        post-pago (prop noindex) emite noindex server-side. */}
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && emittedLocales.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={urlFor(xDefaultLocale)} />}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Chef Pro" />
    <meta property="og:locale" content={ogLocale} />
    {emittedLocales.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aichefpro" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="theme-color" content="#f59e0b" />
    <meta name="msapplication-TileColor" content="#f59e0b" />
    {/* Fase 6: los 3 JSON-LD globales de SEOHead.tsx (Organization/WebSite/
        SoftwareApplication), en UN script con array — mismo formato que la SPA.
        Solo en páginas indexables (la zona app noindex no los lleva, igual que
        en la SPA, donde los gates/dashboards no montan SEOHead). */}
    {emittedSchemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(emittedSchemas)} />
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
    <CookieConsent lang={lang} />
  </body>
</html>
