---
import '../styles/global.css';
import { LOCALES, DEFAULT_LOCALE, SITE, type Locale } from '../i18n/config';
// Contador determinista de usuarios (función pura, sin React pese al nombre) —
// cross-root de la SPA: misma fórmula que alimenta el aggregateRating del
// SoftwareApplication en SEOHead.tsx. En build queda congelado a la fecha del
// deploy (desviación aceptada: en la SPA se calcula en cliente; los deploys
// frecuentes lo mantienen al día).
import { useLiveUserCount } from '@/hooks/useLiveUserCount';

interface Props {
  title: string;
  /** Opcional desde Fase 5: la zona app post-pago (gates/dashboards/admin) no
   *  lleva meta description en la SPA (Helmet solo emite robots+title). */
  description?: string;
  /** meta keywords — paridad con SEOHead.tsx de la SPA (pages.*.seo_keywords). */
  keywords?: string;
  lang?: Locale;
  /** Ruta canónica SIN prefijo de idioma, con barra inicial. Ej: "/precios" */
  basePath?: string;
  /** Override para páginas con slugs nativos por idioma: { es: '/precios', en: '/en/pricing', ... } */
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string;
  /** Subconjunto de idiomas para los que ESTA ruta existe. Por defecto: TODOS (LOCALES).
   *  Páginas mono-idioma (p.ej. /formacion-presencial, solo ES) pasan locales={['es']}
   *  para NO emitir hreflang de variantes inexistentes. x-default apunta a DEFAULT_LOCALE
   *  si está en la lista, si no a la primera de la lista. Las páginas que NO pasan la prop
   *  se comportan EXACTAMENTE igual que antes. */
  locales?: Locale[];
  /** Zona app post-pago (Fase 5): emite <meta robots noindex,nofollow> y OMITE
   *  canonical + hreflang (la SPA tampoco los emite en estas páginas; señales
   *  contradictorias en páginas privadas). El default false deja el resto del
   *  site EXACTAMENTE igual que antes. */
  noindex?: boolean;
}

const {
  title,
  description = '',
  keywords,
  lang = DEFAULT_LOCALE,
  basePath = '/',
  alternates,
  ogImage,
  locales,
  noindex = false,
} = Astro.props;

// Idiomas para los que se emiten hreflang/og:locale:alternate (default: todos).
const emittedLocales: readonly Locale[] = locales ?? LOCALES;
const xDefaultLocale: Locale = emittedLocales.includes(DEFAULT_LOCALE)
  ? DEFAULT_LOCALE
  : emittedLocales[0];

// og:locale por idioma (paridad exacta con getOGLocale() de SEOHead.tsx en la SPA).
const OG_LOCALE: Record<Locale, string> = {
  es: 'es_ES', en: 'en_US', fr: 'fr_FR', de: 'de_DE', it: 'it_IT', pt: 'pt_PT', nl: 'nl_NL',
};
const ogLocale = OG_LOCALE[lang];
const ogImageAlt = `${title} - AI Chef Pro`;

// hreflang + canonical nativos para TODAS las páginas — gate de Fase 0 del plan maestro
// (la SPA actual sirve 0 etiquetas hreflang; este layout lo corrige de raíz).
const urlFor = (locale: Locale): string => {
  const override = alternates?.[locale];
  if (override) return `${SITE}${override}`;
  const p = basePath === '/' ? '' : basePath;
  return locale === DEFAULT_LOCALE ? `${SITE}${p || '/'}` : `${SITE}/${locale}${p}`;
};
const canonical = urlFor(lang);

// Fase 6 — los 3 JSON-LD GLOBALES de SEOHead.tsx, replicados VERBATIM (misma
// estructura, mismos literales). En la SPA los emite cada página con SEOHead;
// aquí van en el layout para TODAS las páginas indexables (desviación aceptada
// y documentada: las pocas páginas de la SPA sin SEOHead no los emitían).
const userCount = useLiveUserCount('es').count;
const globalSchemas = noindex
  ? []
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'AI Chef Pro',
        url: SITE,
        logo: `${SITE}/logo-ai-chef-pro.svg`,
        sameAs: [
          'https://twitter.com/aichefpro',
          'https://www.linkedin.com/company/aichefpro',
        ],
        contactPoint: {
          '@type': 'ContactPoint',
          email: 'info@aichef.pro',
          telephone: '+34744717942',
          contactType: 'customer service',
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'AI Chef Pro',
        url: SITE,
        inLanguage: [...LOCALES],
      },
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'AI Chef Pro',
        description,
        url: SITE,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        offers: [
          {
            '@type': 'Offer',
            name: 'AI Chef Miembro',
            description: 'Acceso básico gratuito. 3.000 créditos/mes.',
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '0',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Pro',
            description:
              'Para Chefs de Cocina, Chefs Ejecutivos y Gerentes de Restaurantes. 85.000 créditos/mes.',
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '25',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Plus',
            description:
              'Para empresarios gastronómicos y cadenas de restaurantes. 175.000 créditos/mes.',
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '50',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Max',
            description: 'Créditos ilimitados mensuales para profesionales exigentes.',
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '95',
            priceValidUntil: '2026-12-31',
          },
          {
            '@type': 'Offer',
            name: 'AI Chef Premium Max Anual',
            description:
              'Ideal para Empresarios Gastronómicos, Dueños de Restaurantes y Directivos. Ahorra 2 meses.',
            category: 'SaaS',
            priceCurrency: 'EUR',
            price: '950',
            priceValidUntil: '2026-12-31',
          },
        ],
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: '4.8',
          ratingCount: String(userCount),
          bestRating: '5',
          worstRating: '1',
        },
        inLanguage: [...LOCALES],
      },
    ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="AI Chef Pro" />
    {/* Para páginas indexables, <meta name="robots"> se OMITE deliberadamente: en
        staging el noindex site-wide lo aplica netlify.toml (X-Robots-Tag: noindex)
        hasta el cutover (Fase 7). La SPA (SEOHead.tsx) emite index,follow en
        producción → añadir aquí SOLO en el cutover, junto con la retirada de la
        cabecera X-Robots-Tag. La zona app post-pago (prop noindex) SÍ lo emite
        server-side desde ya — mejora sobre la SPA, donde dependía de JS (Helmet). */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && emittedLocales.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={urlFor(xDefaultLocale)} />}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Chef Pro" />
    <meta property="og:locale" content={ogLocale} />
    {emittedLocales.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aichefpro" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="theme-color" content="#f59e0b" />
    <meta name="msapplication-TileColor" content="#f59e0b" />
    {/* Fase 6: los 3 JSON-LD globales de SEOHead.tsx (Organization/WebSite/
        SoftwareApplication), en UN script con array — mismo formato que la SPA.
        Solo en páginas indexables (la zona app noindex no los lleva, igual que
        en la SPA, donde los gates/dashboards no montan SEOHead). */}
    {globalSchemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(globalSchemas)} />
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
