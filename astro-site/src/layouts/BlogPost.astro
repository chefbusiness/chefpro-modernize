---
// Fase 8B — Layout de artículo del blog (/blog/{slug}).
// Envuelve BaseLayout (que ya emite canonical/hreflang/OG + los 3 JSON-LD
// globales) y añade: BlogPosting + BreadcrumbList (+ FAQPage si el post trae
// faq en frontmatter), migas visibles, meta del post, cuerpo prose, CTA y
// posts relacionados de la misma categoría.
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCTA from '../components/blog/BlogCTA.astro';
import PostCard from '../components/blog/PostCard.astro';
import { SITE } from '../i18n/config';
import {
  formatDateEs,
  getCategory,
  getPublishedPosts,
  postSlug,
  readingTime,
  type BlogPost,
} from '../lib/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, modDate, image, imageAlt, faq, category } = post.data;
const slug = postSlug(post);
const cat = getCategory(category);
const canonicalPath = `/blog/${slug}`;
const minutes = readingTime(post.body ?? '');

const related = (await getPublishedPosts(post.data.lang))
  .filter((p) => p.data.category === category && postSlug(p) !== slug)
  .slice(0, 3);

const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: `${SITE}${canonicalPath}`,
    datePublished: pubDate.toISOString(),
    dateModified: (modDate ?? pubDate).toISOString(),
    inLanguage: post.data.lang,
    ...(image ? { image: `${SITE}${image}` } : {}),
    author: {
      '@type': 'Person',
      name: 'John Guerrero',
      url: `${SITE}/blog`,
      description:
        'Chef y consultor gastronómico: 29 años en alta hostelería y 15 en consultoría de restaurantes.',
    },
    publisher: {
      '@type': 'Organization',
      name: 'AI Chef Pro',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}/og-image.jpg` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE}${canonicalPath}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE}/blog` },
      ...(cat
        ? [{
            '@type': 'ListItem',
            position: 3,
            name: cat.name,
            item: `${SITE}/blog/categoria/${cat.slug}`,
          }]
        : []),
      {
        '@type': 'ListItem',
        position: cat ? 4 : 3,
        name: title,
        item: `${SITE}${canonicalPath}`,
      },
    ],
  },
  ...(faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
];
---

<BaseLayout
  title={`${title} | Blog AI Chef Pro`}
  description={description}
  lang={post.data.lang}
  basePath={canonicalPath}
  locales={[post.data.lang]}
  ogImage={image ? `${SITE}${image}` : undefined}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={post.data.lang} />

  <main class="container mx-auto max-w-4xl px-4 py-10">
    <nav aria-label="Migas de pan" class="mb-6 text-sm text-muted-foreground">
      <a href="/" class="hover:text-primary">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:text-primary">Blog</a>
      {cat && (
        <>
          <span class="mx-2">/</span>
          <a href={`/blog/categoria/${cat.slug}`} class="hover:text-primary">{cat.name}</a>
        </>
      )}
    </nav>

    <article>
      <header class="mb-8">
        {cat && (
          <a
            href={`/blog/categoria/${cat.slug}`}
            class="text-sm font-semibold uppercase tracking-wide text-primary"
          >{cat.name}</a>
        )}
        <h1 class="mt-2 text-3xl font-bold leading-tight text-foreground md:text-4xl">{title}</h1>
        <p class="mt-4 text-lg text-muted-foreground">{description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
          <span>Por <strong class="text-foreground">John Guerrero</strong></span>
          <time datetime={pubDate.toISOString().slice(0, 10)}>{formatDateEs(pubDate)}</time>
          {modDate && modDate.valueOf() !== pubDate.valueOf() && (
            <span>· Actualizado el {formatDateEs(modDate)}</span>
          )}
          <span>· {minutes} min de lectura</span>
        </div>
      </header>

      {image && (
        <img
          src={image}
          alt={imageAlt ?? title}
          width="1200"
          height="675"
          class="mb-8 w-full rounded-xl object-cover"
          loading="eager"
          decoding="async"
        />
      )}

      <div class="blog-prose prose prose-lg max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-primary prose-img:rounded-xl">
        <slot />
      </div>

      {faq.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold text-foreground">Preguntas frecuentes</h2>
          <div class="mt-4 divide-y divide-border rounded-xl border border-border">
            {faq.map((f) => (
              <details class="group p-5">
                <summary class="cursor-pointer list-none font-semibold text-foreground marker:content-none">
                  {f.q}
                </summary>
                <p class="mt-3 text-muted-foreground">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <BlogCTA utmContent={slug} />
    </article>

    {related.length > 0 && (
      <section class="mt-12 border-t border-border pt-10">
        <h2 class="mb-6 text-2xl font-bold text-foreground">Sigue leyendo</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )}
  </main>

  <Footer lang={post.data.lang} />
</BaseLayout>

<style is:global>
  /* Fase 8B — contenido portado de WP: nada puede desbordar el viewport.
     Las tablas (948 en el catálogo) van envueltas en .table-scroll por el
     conversor: scroll horizontal PROPIO, la página nunca se ensancha. */
  .blog-prose {
    overflow-wrap: break-word;
  }
  .blog-prose .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.5em 0;
    max-width: 100%;
    border-radius: 0.5rem;
  }
  .blog-prose .table-scroll > table {
    margin: 0;
    width: max-content;
    min-width: 100%;
  }
  .blog-prose .table-scroll th,
  .blog-prose .table-scroll td {
    min-width: 8rem;
  }
  /* Cinturón por si algún HTML trae tablas sin envolver o <pre> anchos */
  .blog-prose > table,
  .blog-prose figure > table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }
  .blog-prose pre {
    overflow-x: auto;
    max-width: 100%;
  }
  .blog-prose img,
  .blog-prose video,
  .blog-prose iframe {
    max-width: 100%;
    height: auto;
  }
</style>
