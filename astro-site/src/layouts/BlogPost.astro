---
// Fase 8B — Layout de artículo del blog (/blog/{slug} en ES, /en/blog/{slug} en EN).
// Envuelve BaseLayout (que ya emite canonical/hreflang/OG + los 3 JSON-LD
// globales) y añade: BlogPosting + BreadcrumbList (+ FAQPage si el post trae
// faq en frontmatter), migas visibles, meta del post, cuerpo prose, CTA y
// posts relacionados de la misma categoría.
//
// 8B.6 — Multi-idioma. Dos cosas que NO se pueden confundir:
//   · `basePath` que recibe BaseLayout va SIN prefijo de idioma (BaseLayout le
//     antepone /{lang} al construir canonical/hreflang).
//   · las URLs de los JSON-LD y de los enlaces visibles van CON prefijo → se
//     construyen con los helpers de lib/blog (postPath/categoryPath/blogBase).
// hreflang: los posts EN no son traducción de los ES (contenido distinto, slugs
// distintos), así que se pasa locales={[lang]} → BaseLayout emite solo el
// hreflang del propio idioma + x-default apuntando a esa misma URL. Nunca se
// declara un par ES↔EN que no existe.
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCTA from '../components/blog/BlogCTA.astro';
import PostCard from '../components/blog/PostCard.astro';
import { SITE } from '../i18n/config';
import {
  blogBase,
  categoryPath,
  formatDate,
  getCategory,
  getPublishedPosts,
  homePath,
  postPath,
  postSlug,
  readingTime,
  type BlogPost,
} from '../lib/blog';

interface Props {
  post: BlogPost;
}

/** Marca personal del autor. Toda mención con nombre enlaza aquí, en pestaña
 *  nueva: es sitio externo y no queremos sacar al lector del artículo. */
const AUTOR_URL = 'https://johnguerrero.es';

const { post } = Astro.props;
const { title, description, pubDate, modDate, image, imageAlt, faq, category } = post.data;
const lang = post.data.lang;
const isEn = lang === 'en';
const slug = postSlug(post);
const cat = getCategory(category, lang);
/** Ruta SIN prefijo de idioma — la que espera BaseLayout para canonical/hreflang. */
const canonicalPath = `/blog/${slug}`;
/** Ruta REAL (con prefijo) — la que va en JSON-LD y enlaces. */
const urlPath = postPath(slug, lang);
const homeUrl = lang === 'es' ? SITE : `${SITE}${homePath(lang)}`;
const minutes = readingTime(post.body ?? '');

const T = isEn
  ? {
      titleSuffix: 'AI Chef Pro Blog',
      breadcrumbLabel: 'Breadcrumb',
      home: 'Home',
      blog: 'Blog',
      by: 'By',
      updated: '· Updated on',
      readingTime: 'min read',
      faqHeading: 'Frequently asked questions',
      related: 'Keep reading',
      authorBio:
        'Chef and hospitality consultant: 29 years in high-end kitchens and 15 advising restaurants.',
    }
  : {
      titleSuffix: 'Blog AI Chef Pro',
      breadcrumbLabel: 'Migas de pan',
      home: 'Inicio',
      blog: 'Blog',
      by: 'Por',
      updated: '· Actualizado el',
      readingTime: 'min de lectura',
      faqHeading: 'Preguntas frecuentes',
      related: 'Sigue leyendo',
      authorBio:
        'Chef y consultor gastronómico: 29 años en alta hostelería y 15 en consultoría de restaurantes.',
    };

const related = (await getPublishedPosts(lang))
  .filter((p) => p.data.category === category && postSlug(p) !== slug)
  .slice(0, 3);

const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url: `${SITE}${urlPath}`,
    datePublished: pubDate.toISOString(),
    dateModified: (modDate ?? pubDate).toISOString(),
    inLanguage: lang,
    ...(image ? { image: `${SITE}${image}` } : {}),
    author: {
      '@type': 'Person',
      name: 'John Guerrero',
      // `url` es la página de identidad del autor, no el listado donde publica:
      // apunta a su marca personal, que es la que consolida su E-E-A-T fuera de
      // este dominio. `sameAs` la enlaza con el perfil del canal.
      url: AUTOR_URL,
      sameAs: [AUTOR_URL, 'https://youtube.com/@aichefpro'],
      description: T.authorBio,
    },
    publisher: {
      '@type': 'Organization',
      name: 'AI Chef Pro',
      url: SITE,
      logo: { '@type': 'ImageObject', url: `${SITE}/og-image.jpg` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE}${urlPath}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: T.home, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: T.blog, item: `${SITE}${blogBase(lang)}` },
      ...(cat
        ? [{
            '@type': 'ListItem',
            position: 3,
            name: cat.name,
            item: `${SITE}${categoryPath(cat.slug, lang)}`,
          }]
        : []),
      {
        '@type': 'ListItem',
        position: cat ? 4 : 3,
        name: title,
        item: `${SITE}${urlPath}`,
      },
    ],
  },
  ...(faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }]
    : []),
];
---

<BaseLayout
  title={`${title} | ${T.titleSuffix}`}
  description={description}
  lang={lang}
  basePath={canonicalPath}
  locales={[lang]}
  ogImage={image ? `${SITE}${image}` : undefined}
>
  <Fragment slot="head">
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </Fragment>

  <Header lang={lang} />

  <main class="container mx-auto max-w-4xl px-4 py-10">
    <nav aria-label={T.breadcrumbLabel} class="mb-6 text-sm text-muted-foreground">
      <a href={homePath(lang)} class="hover:text-primary">{T.home}</a>
      <span class="mx-2">/</span>
      <a href={blogBase(lang)} class="hover:text-primary">{T.blog}</a>
      {cat && (
        <>
          <span class="mx-2">/</span>
          <a href={categoryPath(cat.slug, lang)} class="hover:text-primary">{cat.name}</a>
        </>
      )}
    </nav>

    <article>
      <header class="mb-8">
        {cat && (
          <a
            href={categoryPath(cat.slug, lang)}
            class="text-sm font-semibold uppercase tracking-wide text-primary"
          >{cat.name}</a>
        )}
        <h1 class="mt-2 text-3xl font-bold leading-tight text-foreground md:text-4xl">{title}</h1>
        <p class="mt-4 text-lg text-muted-foreground">{description}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
          <span>
            {T.by}{' '}
            <a
              href={AUTOR_URL}
              target="_blank"
              rel="noopener noreferrer author"
              class="font-semibold text-foreground hover:text-primary transition-colors"
            >John Guerrero</a>
          </span>
          <time datetime={pubDate.toISOString().slice(0, 10)}>{formatDate(pubDate, lang)}</time>
          {modDate && modDate.valueOf() !== pubDate.valueOf() && (
            <span>{T.updated} {formatDate(modDate, lang)}</span>
          )}
          <span>· {minutes} {T.readingTime}</span>
        </div>
      </header>

      {image && (
        <img
          src={image}
          alt={imageAlt ?? title}
          width="1200"
          height="675"
          class="mb-8 w-full rounded-xl object-cover"
          loading="eager"
          decoding="async"
        />
      )}

      <div class="blog-prose prose prose-lg max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-primary prose-img:rounded-xl">
        <slot />
      </div>

      {faq.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-bold text-foreground">{T.faqHeading}</h2>
          <div class="mt-4 divide-y divide-border rounded-xl border border-border">
            {faq.map((f) => (
              <details class="group p-5">
                <summary class="cursor-pointer list-none font-semibold text-foreground marker:content-none">
                  {f.q}
                </summary>
                <p class="mt-3 text-muted-foreground">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <BlogCTA utmContent={slug} lang={lang} />
    </article>

    {related.length > 0 && (
      <section class="mt-12 border-t border-border pt-10">
        <h2 class="mb-6 text-2xl font-bold text-foreground">{T.related}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )}
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style is:global>
  /* Fase 8B — contenido portado de WP: nada puede desbordar el viewport.
     Las tablas (948 en el catálogo) van envueltas en .table-scroll por el
     conversor: scroll horizontal PROPIO, la página nunca se ensancha. */
  .blog-prose {
    overflow-wrap: break-word;
  }
  .blog-prose .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1.5em 0;
    max-width: 100%;
    border-radius: 0.5rem;
  }
  .blog-prose .table-scroll > table {
    margin: 0;
    width: max-content;
    min-width: 100%;
  }
  .blog-prose .table-scroll th,
  .blog-prose .table-scroll td {
    min-width: 8rem;
  }
  /* Cinturón por si algún HTML trae tablas sin envolver o <pre> anchos */
  .blog-prose > table,
  .blog-prose figure > table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }
  .blog-prose pre {
    overflow-x: auto;
    max-width: 100%;
  }
  .blog-prose img,
  .blog-prose video,
  .blog-prose iframe {
    max-width: 100%;
    height: auto;
  }
</style>
