{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    // '@/*' → src/ de la RAÍZ del repo (igual que el alias Vite de astro.config.mjs):
    // lo usan los componentes de la SPA importados cross-root por los islands de la
    // zona app (Fase 5). astro-site NO usa '@/' en código propio (usa relativos).
    "paths": { "@/*": ["../src/*"] },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
