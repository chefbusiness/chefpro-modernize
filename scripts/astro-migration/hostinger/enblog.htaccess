RewriteRule ^robots\.txt/?$ https://aichef.pro/robots.txt [R=301,L]
RewriteRule ^favicon\.ico/?$ https://aichef.pro/favicon.ico [R=301,L]
RewriteRule ^sitemap\.xml/?$ https://aichef.pro/sitemap-index.xml [R=301,L]
RewriteRule ^post\-sitemap\.xml/?$ https://aichef.pro/sitemap-index.xml [R=301,L]
RewriteRule ^page\-sitemap\.xml/?$ https://aichef.pro/sitemap-index.xml [R=301,L]
RewriteRule ^category\-sitemap\.xml/?$ https://aichef.pro/sitemap-index.xml [R=301,L]
